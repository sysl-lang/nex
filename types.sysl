// nex's types, as the elaborator knows them once every name in a type has been resolved.
//
// **A numeric type is a family and a width.** `int8` … `int64`, `uint8` … `uint64`, `real16` …
// `real64` and `complex[real16]` … `complex[real64]` are four families, and the aliases `integer`,
// `real` and `complex` are the 64-bit members of three of them, not types of their own (DESIGN §2.1).
// The promotion lattice of DESIGN §2.2 is two questions asked of a pair of these: `promotes` (may a
// value of one stand where the other is expected) and `common` (what type does an operator on the two
// compute in).
//
// **The aggregate, generic and measured forms are here with their shape**, so that every phase that
// walks a type already has a case for them: an array is its element type and one `Extent` per axis
// (DESIGN §3), a tuple its element types, a struct or an enum its name and type arguments, a generic
// parameter its name and constraint, and a measured type a numeric type with a `Unit` (DESIGN §13).
// `Error` stands where a type could not be decided; it is compatible with everything, so one mistake
// is reported once rather than at every use it reaches.

import sysl.buf.{Buf, buf}
import sysl.text.join

// The parameters and result of a function type, `(int64, inout real64) -> bool`, with each
// parameter's mode as the tree's `Mode` gives it.
struct FnSig
    params: Buf[Ty]
    modes: Buf[Mode]
    ret: Ty

// One axis of an array type: `:`, known at run time, or a static extent.
enum Extent
    Dynamic
    Fixed(n: u64)
    // A `const` extent or a `Rank` parameter, by name.
    Named(name: string)

// An exact rational, `num / den` in lowest terms with `den` positive: a unit's exponent or its
// scale factor.
struct Ratio
    num: i64
    den: i64

// A unit of measure: an exponent over each of the seven SI base dimensions (m, kg, s, A, K, mol, cd,
// in that order) and the exact factor that relates it to the coherent SI unit of that dimension
// (`mm` is length to the power 1 with factor 1/1000).
struct Unit
    exps: Buf[Ratio]
    factor: Ratio

enum Ty
    // `int8` … `int64` (`signed`) and `uint8` … `uint64`.
    Int(bits: int, signed: bool)
    Real(bits: int)
    // A complex whose parts are `real` of `bits`: `complex[real32]` is `Complex(32)`.
    Complex(bits: int)
    Bool
    Str
    Void
    // The type of an expression that never yields: `return`, `exit`, `cycle`, `stop`. It stands
    // wherever any type is expected.
    Never
    Fn(sig: &FnSig)
    Array(elem: &Ty, axes: Buf[Extent])
    Tuple(elems: Buf[Ty])
    // A struct or an enum, with its type arguments.
    Nominal(name: string, args: Buf[Ty])
    // A generic type parameter, `T: Numeric`. In a generic's own signature it is a pattern a use
    // infers an argument for; `bound` where it stands in the generic's body as it is checked, an
    // abstract type of which nothing is known but what its constraint admits (DESIGN §2.6).
    Param(name: string, constraint: string, bound: bool)
    Measured(base: &Ty, unit: &Unit)
    Error
end Ty

val INTEGER = Int(64, true)
val REAL = Real(64)
val COMPLEX = Complex(64)

fn_type(params: Buf[Ty], modes: Buf[Mode], ret: Ty) -> Ty = Fn(FnSig(params, modes, ret))

// -- classification ---------------------------------------------------------------------------------

// The kinds of type, one bit each: what a constraint admits (DESIGN §2.6) is a set of them, and a
// type parameter is classified by its constraint's set. It is an integer only where every type its
// constraint admits is one, numeric only where every one is numeric.
val KIND_INT = 1
val KIND_REAL = 2
val KIND_COMPLEX = 4
val KIND_BOOL = 8
val KIND_STR = 16
val KIND_OTHER = 32

val KINDS_NUMERIC = KIND_INT | KIND_REAL | KIND_COMPLEX

// The kinds a constraint admits; an unknown one admits nothing.
constraint_kinds(c: string) -> int
    if c == "Any" then return KINDS_NUMERIC | KIND_BOOL | KIND_STR | KIND_OTHER
    if c == "Numeric" then return KINDS_NUMERIC
    if c == "Integral" then return KIND_INT
    if c == "Real" || c == "Ord" then return KIND_INT | KIND_REAL
    if c == "Float" then return KIND_REAL
    if c == "Complex" then return KIND_COMPLEX
    if c == "Eq" then return KINDS_NUMERIC | KIND_BOOL | KIND_STR

    0

// The kinds a type may be: one for a concrete type, its constraint's for a type parameter.
kinds_of(t: Ty) -> int = t match
    Int(_, _) -> KIND_INT
    Real(_) -> KIND_REAL
    Complex(_) -> KIND_COMPLEX
    Bool -> KIND_BOOL
    Str -> KIND_STR
    Param(_, c, _) -> constraint_kinds(c)
    _ -> KIND_OTHER

// Whether every type `t` may be is among `kinds`.
private within(t: Ty, kinds: int) -> bool
    val k = kinds_of(t)

    k != 0 && (k | kinds) == kinds

is_param(t: Ty) -> bool = t match
    Param(_, _, _) -> true
    _ -> false

is_int(t: Ty) -> bool = t match
    Int(_, _) -> true
    Param(_, _, _) -> kinds_of(t) == KIND_INT
    _ -> false

is_array(t: Ty) -> bool = t match
    Array(_, _) -> true
    _ -> false

is_dynamic(x: Extent) -> bool = x match
    Dynamic -> true
    _ -> false

is_signed(t: Ty) -> bool = t match
    Int(_, s) -> s
    _ -> false

is_real(t: Ty) -> bool = t match
    Real(_) -> true
    Param(_, _, _) -> kinds_of(t) == KIND_REAL
    _ -> false

is_complex(t: Ty) -> bool = t match
    Complex(_) -> true
    Param(_, _, _) -> kinds_of(t) == KIND_COMPLEX
    _ -> false

is_numeric(t: Ty) -> bool = within(t, KINDS_NUMERIC)

// The integer and real types: the ones `<` orders.
is_ordered(t: Ty) -> bool = within(t, KIND_INT | KIND_REAL)

// The types `==` compares: the numeric ones, `bool` and `string`.
is_equatable(t: Ty) -> bool = within(t, KINDS_NUMERIC | KIND_BOOL | KIND_STR)

is_error(t: Ty) -> bool = t match
    Error -> true
    _ -> false

is_never(t: Ty) -> bool = t match
    Never -> true
    _ -> false

is_void(t: Ty) -> bool = t match
    Void -> true
    _ -> false

// Whether `Error` stands anywhere inside a type, as a function's result whose body was refused.
has_error(t: Ty) -> bool = t match
    Error -> true
    Fn(sig) ->
        var any = has_error(sig.ret)

        for p in sig.params
            if has_error(p) then any = true

        any
    Array(elem, _) -> has_error(*elem)
    Tuple(elems) ->
        var any = false

        for e in elems
            if has_error(e) then any = true

        any
    Measured(base, _) -> has_error(*base)
    _ -> false

// Whether a type stands for anything at all: `Error` and `Never` agree with every other type.
is_wild(t: Ty) -> bool = is_error(t) || is_never(t)

bits_of(t: Ty) -> int = t match
    Int(b, _) -> b
    Real(b) -> b
    Complex(b) -> b
    _ -> 0

ty_eq(a: Ty, b: Ty) -> bool = a match
    Int(ab, asg) -> b match
        Int(bb, bsg) -> ab == bb && asg == bsg
        _ -> false
    Real(ab) -> b match
        Real(bb) -> ab == bb
        _ -> false
    Complex(ab) -> b match
        Complex(bb) -> ab == bb
        _ -> false
    Bool -> b match
        Bool -> true
        _ -> false
    Str -> b match
        Str -> true
        _ -> false
    Void -> b match
        Void -> true
        _ -> false
    Never -> b match
        Never -> true
        _ -> false
    Fn(x) -> b match
        Fn(y) -> sig_eq(*x, *y)
        _ -> false
    Array(ae, ax) -> b match
        Array(be, bx) -> ty_eq(*ae, *be) && axes_eq(ax, bx)
        _ -> false
    Tuple(xs) -> b match
        Tuple(ys) -> tys_eq(xs, ys)
        _ -> false
    Nominal(an, aa) -> b match
        Nominal(bn, ba) -> an == bn && tys_eq(aa, ba)
        _ -> false
    Param(an, ac, ab) -> b match
        Param(bn, bc, bb) -> an == bn && ac == bc && ab == bb
        _ -> false
    Measured(ab, au) -> b match
        Measured(bb, bu) -> ty_eq(*ab, *bb) && unit_eq(*au, *bu)
        _ -> false
    Error -> b match
        Error -> true
        _ -> false
end ty_eq

tys_eq(xs: Buf[Ty], ys: Buf[Ty]) -> bool
    if xs.len() != ys.len() then return false

    for k in 0..<xs.len()
        if !ty_eq(xs[k], ys[k]) then return false

    true

private sig_eq(x: FnSig, y: FnSig) -> bool
    if !tys_eq(x.params, y.params) || !ty_eq(x.ret, y.ret) then return false

    for k in 0..<x.modes.len()
        if x.modes[k] != y.modes[k] then return false

    true

private axes_eq(xs: Buf[Extent], ys: Buf[Extent]) -> bool
    if xs.len() != ys.len() then return false

    for k in 0..<xs.len()
        val same = xs[k] match
            Dynamic -> ys[k] match
                Dynamic -> true
                _ -> false
            Fixed(n) -> ys[k] match
                Fixed(m) -> n == m
                _ -> false
            Named(n) -> ys[k] match
                Named(m) -> n == m
                _ -> false

        if !same then return false

    true
end axes_eq

private unit_eq(a: Unit, b: Unit) -> bool
    if a.factor.num != b.factor.num || a.factor.den != b.factor.den then return false

    for k in 0..<a.exps.len()
        if a.exps[k].num != b.exps[k].num || a.exps[k].den != b.exps[k].den then return false

    true

// -- the lattice ------------------------------------------------------------------------------------

// Whether a value of `from` may stand where `to` is expected: the same type, or a path along the
// arrows of DESIGN §2.2. `Never`, and a type with `Error` anywhere in it, go anywhere.
promotes(from: Ty, to: Ty) -> bool
    if is_wild(from) || has_error(from) || has_error(to) || ty_eq(from, to) then return true

    from match
        Int(fb, fs) -> to match
            Int(tb, ts) -> if fs == ts then tb > fb else !fs && ts && tb > fb
            Real(_) -> true
            Complex(_) -> true
            _ -> false
        Real(fb) -> to match
            Real(tb) -> tb >= fb
            Complex(tb) -> tb >= fb
            _ -> false
        Complex(fb) -> to match
            Complex(tb) -> tb >= fb
            _ -> false
        _ -> false
end promotes

// The type a binary operator on `a` and `b` computes in, by the five rules of DESIGN §2.2, or
// `None` where the two have no such type: a signed and an unsigned integer of which the signed is
// not the wider, or a pair that is not both numeric and not one type.
common(a: Ty, b: Ty) -> Option[Ty]
    if is_wild(a) then return Some(b)
    if is_wild(b) || ty_eq(a, b) then return Some(a)

    a match
        Int(ab, asg) -> b match
            Int(bb, bsg) ->
                if asg == bsg then return Some(if ab >= bb then a else b)
                if asg && ab > bb then return Some(a)
                if bsg && bb > ab then return Some(b)
                None
            Real(_) -> Some(b)
            Complex(_) -> Some(b)
            _ -> None
        Real(ab) -> b match
            Int(_, _) -> Some(a)
            Real(bb) -> Some(if ab >= bb then a else b)
            Complex(bb) -> Some(Complex(if ab >= bb then ab else bb))
            _ -> None
        Complex(ab) -> b match
            Int(_, _) -> Some(a)
            Real(bb) -> Some(Complex(if ab >= bb then ab else bb))
            Complex(bb) -> Some(Complex(if ab >= bb then ab else bb))
            _ -> None
        _ -> None
end common

// -- names ------------------------------------------------------------------------------------------

// The scalar type a prelude type name denotes, where it is one: the sized names of DESIGN §2.1,
// their aliases, `bool`, `string` and `void`. `complex[realN]` is not a single name and is read
// by `complex_of`.
scalar_named(name: string) -> Option[Ty]
    if name == "integer" then return Some(INTEGER)
    if name == "real" then return Some(REAL)
    if name == "complex" then return Some(COMPLEX)
    if name == "bool" then return Some(Bool)
    if name == "string" then return Some(Str)
    if name == "void" then return Some(Void)

    for b in [8, 16, 32, 64]
        if name == s"int${b}" then return Some(Int(b, true))
        if name == s"uint${b}" then return Some(Int(b, false))

    for b in [16, 32, 64]
        if name == s"real${b}" then return Some(Real(b))

    None
end scalar_named

// `complex[realN]` from the type `realN` inside the brackets.
complex_of(part: Ty) -> Option[Ty] = part match
    Real(b) -> Some(Complex(b))
    _ -> None

// -- printing ---------------------------------------------------------------------------------------

// A type in nex's own syntax, by its canonical name: `int64`, `complex[real32]`, `[real64; :, :]`,
// `(int64, inout real64) -> bool`.
show_ty(t: Ty) -> string = t match
    Int(b, sg) -> if sg then s"int${b}" else s"uint${b}"
    Real(b) -> s"real${b}"
    Complex(b) -> s"complex[real${b}]"
    Bool -> "bool"
    Str -> "string"
    Void -> "void"
    Never -> "never"
    Fn(sig) -> show_sig(*sig)
    Array(elem, axes) -> show_array(*elem, axes)
    Tuple(elems) -> "(" + show_tys(elems) + ")"
    Nominal(name, args) -> if args.len() == 0 then name else name + "[" + show_tys(args) + "]"
    Param(name, _, _) -> name
    Measured(base, unit) -> show_ty(*base) + "<" + show_unit(*unit) + ">"
    Error -> "?"

private show_tys(ts: Buf[Ty]) -> string
    var out: Buf[string] = buf()

    for t in ts
        out.push(show_ty(t))

    join(out.view(), ", ")

private show_sig(sig: FnSig) -> string
    var out: Buf[string] = buf()

    for k in 0..<sig.params.len()
        val mode = if sig.modes[k] == Inout then "inout " else ""

        out.push(mode + show_ty(sig.params[k]))

    "(" + join(out.view(), ", ") + ") -> " + show_ty(sig.ret)

private show_array(elem: Ty, axes: Buf[Extent]) -> string
    // `[T]` is the spelling of `[T; :]`.
    var sugar = axes.len() == 1
    var out: Buf[string] = buf()

    for a in axes
        out.push(a match
            Dynamic -> ":"
            Fixed(n) ->
                sugar = false
                s"${n}"
            Named(n) ->
                sugar = false
                n)

    if sugar then "[" + show_ty(elem) + "]" else "[" + show_ty(elem) + "; " + join(out.view(), ", ") + "]"
end show_array

private val BASE_UNITS = ["m", "kg", "s", "A", "K", "mol", "cd"]

// A unit as its base dimensions, `m kg s^-2`, with its factor in front where it is not 1.
private show_unit(u: Unit) -> string
    var out: Buf[string] = buf()

    if u.factor.num != 1 || u.factor.den != 1 then out.push(show_ratio(u.factor))

    for k in 0..<u.exps.len()
        val x = u.exps[k]

        if x.num == 0 then continue

        if x.num == 1 && x.den == 1 then out.push(BASE_UNITS[k]) else out.push(BASE_UNITS[k] + "^" + show_ratio(x))

    if out.len() == 0 then "1" else join(out.view(), " ")

private show_ratio(r: Ratio) -> string = if r.den == 1 then s"${r.num}" else s"(${r.num}/${r.den})"
