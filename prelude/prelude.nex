// The prelude nex ships as source (DESIGN §17.1): every program sees these names without an import,
// and a program's own declarations of the same names hide them in its module (§11.5). The
// functions on them — `get_or`, `is_some`, `is_none`, `is_ok`, `is_err` — and the `!` and `?` that
// take them apart are the compiler's own.

// A value that may be absent: `Some(v)`, or `None`.
enum Option[T] =
  Some(value: T)
  None
end Option

// The outcome of what may fail: `Ok(v)`, or `Err(e)` with the failure.
enum Result[T, E] =
  Ok(value: T)
  Err(error: E)
end Result
