// Emission of `@` through BLAS (DESIGN §10.4).
//
// **A product of `real32`, `real64` or complex elements goes to BLAS where it is large or where its
// shape needs it**, through the runtime's `nex_la_product` (`?gemm`, `?gemv`) and `nex_la_dot` (`?dot`,
// `?dotu_sub`: `@` does not conjugate), the functions the interpreter calls too (`runtime/…/la.sysl`).
// An operand written `transpose(X)` or `conj(transpose(X))` is `X` itself, passed with BLAS's `T` or
// `C` flag, so no transposed copy is made; such a product always dispatches. Otherwise a product
// whose extents are static is decided here, and one whose extents are not is decided at run time,
// both paths emitted under an `scf.if`: the small path is a `linalg` operation inline
// (`emit_array_fn.sysl`), which is why the decision stays in the emitted code rather than the
// runtime. Below the threshold, and for every other element type, `@` is that `linalg` operation.
//
// **An operand crosses as §10.3 says an array crosses to C**: the address of its first element where
// it lies, with the column stride as its leading dimension, or a dense copy (`nex_c_gather`) where
// nex's first axis is not at unit stride or the columns overlap. The result is a buffer the runtime
// writes, which becomes the product's tensor: a fresh one, or for `c = a @ b` the local `c`'s own
// where it has the product's extents and lies dense (`matmul_assign`).
//
// A program that calls BLAS or LAPACK says so before its module (`// nex.blas`), and the driver
// links the library.

import nex.sh.sysl.nex.*
import sysl.buf.{Buf, buf}
import sh.sysl.parsing.Span
import nex_runtime.sh.sysl.nex_runtime.SHAPE_MISMATCH

// CBLAS's flags, which the runtime takes too: an operand as it is, transposed, or conjugated and
// transposed.
private val NO_TRANS = 111
private val TRANS = 112
private val CONJ_TRANS = 113

// The size from which a product goes to BLAS (DESIGN §10.4): m·k·n for matrix by matrix, the
// matrix's m·k for a matrix and a vector, k for two vectors.
private val GEMM_AT: u64 = 262144
private val GEMV_AT: u64 = 16384
private val DOT_AT: u64 = 4096

// An operand of a product: the array BLAS reads, and how.
struct BlasOperand
    x: TExpr
    flag: int

// An array as BLAS and LAPACK take it: the address of its first element and its leading dimension,
// nex's extents of it (all `index`; a vector has one column), and where it was gathered, the copy to
// give back after the call.
struct BlasArg
    ptr: string
    ld: string
    rows: string
    cols: string
    copy: CArray

// A buffer the compiler allocates for the runtime to write, dense and column-major: its memref and
// the memref's type, the address of its first element, and nex's extents of it.
struct LBuf
    m: string
    mty: string
    ptr: string
    rows: string
    cols: string

// Whether BLAS and LAPACK have routines for the element type `t`: `real32`, `real64` and the two
// complex types.
blas_element(t: Ty) -> bool = base_of(t) match
    Real(b) -> b == 32 || b == 64
    Complex(b) -> b == 32 || b == 64
    _ -> false

// The runtime's code for the element type `t`: 0 `real32`, 1 `real64`, 2 `complex[real32]`,
// 3 `complex[real64]`.
la_kind(t: Ty) -> int = base_of(t) match
    Complex(b) -> if b == 32 then 2 else 3
    b -> if bits_of(b) == 32 then 0 else 1

// `x` as BLAS reads it: `transpose(X)` is `X` with the `T` flag, `conj(transpose(X))` with `C`.
private blas_operand(x: TExpr) -> BlasOperand = *x.kind match
    TBuiltin(name, args) -> if name == "transpose" then BlasOperand(args[0], TRANS) else BlasOperand(x, NO_TRANS)
    TArray(op) -> *op match
        TElemental(name, args) ->
            if name != "conj" || args.len() != 1 then return BlasOperand(x, NO_TRANS)

            *args[0].kind match
                TBuiltin(n, inner) -> if n == "transpose" then BlasOperand(inner[0], CONJ_TRANS) else BlasOperand(x, NO_TRANS)
                _ -> BlasOperand(x, NO_TRANS)
        _ -> BlasOperand(x, NO_TRANS)
    _ -> BlasOperand(x, NO_TRANS)

// The extents a product of operand types `lt` and `rt` is measured by: m, k, n for matrix by matrix,
// the matrix's two for a matrix and a vector, k for two vectors.
private measured_axes(lt: Ty, rt: Ty) -> Buf[Extent]
    val xs = axes_of(lt)
    val ys = axes_of(rt)
    var out: Buf[Extent] = buf()

    if xs.len() == 2 then out.push(xs[0])
    out.push(xs[xs.len() - 1])
    if ys.len() == 2 then out.push(ys[1])
    out

private threshold(n: usize) -> u64 = if n == 3 then GEMM_AT elif n == 2 then GEMV_AT else DOT_AT

// Whether a product of operand types `lt` and `rt` reaches BLAS's threshold, where its extents are
// static.
private static_blas(lt: Ty, rt: Ty) -> Option[bool]
    val axes = measured_axes(lt, rt)
    var size: u64 = 1

    for x in axes
        x match
            Fixed(n) -> size *= n
            _ -> return None

    Some(size >= threshold(axes.len()))

impl Emitter
    // `a @ b` (DESIGN §7.2, §10.4): through BLAS, through `linalg`, or through either as its size
    // decides at run time.
    matmul(*self, e: TExpr, l: TExpr, r: TExpr) -> string = self.matmul_to(e, l, r, "")

    // `a @ b` written, where `dest` is not `""`, over the array `dest` of the product's type where
    // its extents are the product's and it lies dense, as a buffer BLAS writes; else into a new one.
    // `dest` must not be read by `a` or `b`.
    matmul_to(*self, e: TExpr, l: TExpr, r: TExpr, dest: string) -> string
        if !blas_element(elem_of(e.ty)) then return self.linalg_matmul(e, l.ty, r.ty, self.ex(l), self.ex(r))

        val oa = blas_operand(l)
        val ob = blas_operand(r)

        if oa.flag != NO_TRANS || ob.flag != NO_TRANS then return self.blas_matmul(e, oa, ob, self.ex(oa.x), self.ex(ob.x), dest)

        val a = self.ex(l)
        val b = self.ex(r)

        static_blas(l.ty, r.ty) match
            Some(big) -> return if big then self.blas_matmul(e, oa, ob, a, b, dest) else self.linalg_matmul(e, l.ty, r.ty, a, b)
            None -> ()

        // The size, as `measured_axes` takes it, against the threshold.
        var dims: Buf[string] = buf()

        if rank_of(l.ty) == 2 then dims.push(self.dim(e.span, a, l.ty, 1))
        dims.push(self.dim(e.span, a, l.ty, rank_of(l.ty)))
        if rank_of(r.ty) == 2 then dims.push(self.dim(e.span, b, r.ty, 2))

        var size = dims[0]

        for k in 1..<dims.len()
            size = self.def(s"arith.muli $size, ${dims[k]} : index")

        val big = self.def(s"arith.cmpi uge, $size, ${self.index_const(usize(threshold(dims.len())))} : index")

        if rank_of(e.ty) == 0
            val t = self.ty(e.span, e.ty)
            val v = self.fresh()

            self.op(s"$v = scf.if $big -> ($t) {")
            self.op(s"scf.yield ${self.blas_matmul(e, oa, ob, a, b, "")} : $t")
            self.op("} else {")
            self.op(s"scf.yield ${self.linalg_matmul(e, l.ty, r.ty, a, b)} : $t")
            self.op("}")
            return v

        self.either_matmul(e, l.ty, r.ty, a, b, big, dest)

    // `a @ b` of operand types `lt` and `rt`, an array, through BLAS where `big` holds and through
    // `linalg` on buffers where it does not. The result's buffer is made before the choice, so the
    // product has one buffer whichever path wrote it.
    private either_matmul(*self, e: TExpr, lt: Ty, rt: Ty, a: string, b: string, big: string, dest: string) -> string
        val span = e.span
        val ra = rank_of(lt)
        val rb = rank_of(rt)
        val m = if ra == 2 then self.dim(span, a, lt, 1) else self.dim(span, b, rt, 2)
        // The destination's buffer is taken before the operands are read, so bufferization copies
        // it first where an operand still reads it.
        val c = self.product_buffer(span, e.ty, m, if ra == 2 && rb == 2 then self.dim(span, b, rt, 2) else "", dest)
        val am = self.read_buffer(span, a, lt)
        val bm = self.read_buffer(span, b, rt)

        self.op(s"scf.if $big {")

        val x = self.blas_arg(span, am, lt, false)
        val y = self.blas_arg(span, bm, rt, false)
        var copies: Buf[CArray] = buf()

        self.la_product(e.ty, x, ra, NO_TRANS, y, rb, NO_TRANS, c)
        copies.push(x.copy)
        copies.push(y.copy)
        self.give_back(copies)
        self.op("} else {")
        self.trap_if(self.def(s"arith.cmpi ne, ${self.dim(span, a, lt, ra)}, ${self.dim(span, b, rt, 1)} : index"), SHAPE_MISMATCH)
        self.op(s"linalg.fill ins(${self.one_or_zero(span, elem_of(e.ty), false)} : ${self.elem_ty(span, elem_of(e.ty))}) outs(${c.m} : ${c.mty})")

        // With the axes reversed, nex's `A @ B` is storage's `Bᵀ Aᵀ`, so the operands swap.
        val kind = if ra == 2 && rb == 2 then "matmul" elif ra == 2 then "vecmat" else "matvec"

        self.op(s"linalg.$kind ins($bm, $am : ${self.boundary_ty(span, rt)}, ${self.boundary_ty(span, lt)}) outs(${c.m} : ${c.mty})")
        self.op("}")
        self.buffer_tensor(span, c, e.ty)

    // `a @ b` through BLAS, the operands' values `a` and `b`.
    private blas_matmul(*self, e: TExpr, oa: BlasOperand, ob: BlasOperand, a: string, b: string, dest: string) -> string
        val span = e.span
        val ra = rank_of(oa.x.ty)
        val rb = rank_of(ob.x.ty)
        // The result's buffer, of op(X)'s rows and op(Y)'s columns, is taken before the operands are
        // read, so bufferization copies the destination first where an operand still reads it.
        var c: Option[LBuf] = None

        if ra == 2
            val rows = self.dim(span, a, oa.x.ty, if oa.flag == NO_TRANS then 1 else 2)

            c = if rb == 2 then Some(self.product_buffer(span, e.ty, rows, self.dim(span, b, ob.x.ty, if ob.flag == NO_TRANS then 2 else 1), dest))
                else Some(self.product_buffer(span, e.ty, rows, "", dest))
        elif rb == 2 then c = Some(self.product_buffer(span, e.ty, self.dim(span, b, ob.x.ty, if ob.flag == NO_TRANS then 2 else 1), "", dest))

        val x = self.blas_arg(span, self.read_buffer(span, a, oa.x.ty), oa.x.ty, false)
        val y = self.blas_arg(span, self.read_buffer(span, b, ob.x.ty), ob.x.ty, false)
        var out = ""

        c match
            None -> out = self.la_dot(span, e.ty, x, y)
            Some(cb) ->
                self.la_product(e.ty, x, ra, oa.flag, y, rb, ob.flag, cb)
                out = self.buffer_tensor(span, cb, e.ty)

        var copies: Buf[CArray] = buf()

        copies.push(x.copy)
        copies.push(y.copy)
        self.give_back(copies)
        out

    // `op(X) @ op(Y)` of operands of ranks `ra` and `rb` (not both vectors), of type `t`, written to
    // `c` by the runtime, which checks the extents agree.
    private la_product(*self, t: Ty, x: BlasArg, ra: usize, fx: int, y: BlasArg, rb: usize, fy: int, c: LBuf)
        var args = LaArgs(buf(), buf())

        args.code(self, la_kind(elem_of(t)))
        args.matrix(self, x)
        args.code(self, if ra == 1 then 1 else 0)
        args.code(self, fx)
        args.matrix(self, y)
        args.code(self, if rb == 1 then 1 else 0)
        args.code(self, fy)
        args.ptr(c.ptr)
        args.index(self, c.rows)
        args.index(self, c.cols)
        self.la_call("nex_la_product", args, "")

    // `x @ y` of two vectors, a scalar of type `t`.
    private la_dot(*self, span: Span, t: Ty, x: BlasArg, y: BlasArg) -> string
        val st = self.mem_ty(span, t)
        val slot = self.alloca(st)
        var args = LaArgs(buf(), buf())

        self.op(s"llvm.store ${self.def(s"llvm.mlir.zero : $st")}, $slot : $st, !llvm.ptr")
        args.code(self, la_kind(t))
        args.ptr(x.ptr)
        args.index(self, x.rows)
        args.ptr(y.ptr)
        args.index(self, y.rows)
        args.ptr(slot)
        self.la_call("nex_la_dot", args, "")
        self.from_mem(self.def(s"llvm.load $slot : !llvm.ptr -> $st"), t)

    // -- arrays crossing to BLAS and LAPACK -------------------------------------------------------

    // The buffer of the array value `v` of type `t`, which C reads and does not write.
    read_buffer(*self, span: Span, v: string, t: Ty) -> string =
        self.def(s"bufferization.to_buffer $v read_only : ${self.tensor_ty(span, t)} to ${self.boundary_ty(span, t)}")

    // The buffer `m` of an array of type `t` (rank 1 or 2) as BLAS and LAPACK address it: where it
    // lies when nex's first axis is at unit stride and the columns do not overlap, else a dense copy,
    // which is scattered back after the call where C `writes` it.
    blas_arg(*self, span: Span, m: string, t: Ty, writes: bool) -> BlasArg
        val r = rank_of(t)
        val md = self.metadata(m, t)
        val one = self.index_const(1)
        val rows = s"$md#${1 + r}"
        val cols = if r == 2 then s"$md#2" else one
        val least = self.def(s"arith.maxsi $rows, $one : index")
        var ok = self.def(s"arith.cmpi eq, $md#${1 + 2 * r}, $one : index")
        var ld = least

        if r == 2
            ok = self.def(s"arith.andi $ok, ${self.def(s"arith.cmpi sge, $md#4, $least : index")} : i1")
            ld = self.def(s"arith.select $ok, $md#4, $least : index")

        val direct = self.first_element(span, m, t)
        val dt = self.desc_ty(r)
        val desc = self.alloca(dt)
        val p = self.fresh()

        self.op(s"$p = scf.if $ok -> (!llvm.ptr) {")
        self.op(s"scf.yield $direct : !llvm.ptr")
        self.op("} else {")
        self.op(s"llvm.store ${self.def(s"builtin.unrealized_conversion_cast $m : ${self.boundary_ty(span, t)} to $dt")}, $desc : $dt, !llvm.ptr")
        self.op(s"scf.yield ${self.always("nex_c_gather", s"${self.elem_const(t)}, ${self.def(s"arith.constant $r : i64")}, $desc", "i64, i64, !llvm.ptr", "!llvm.ptr")} : !llvm.ptr")
        self.op("}")
        BlasArg(p, ld, rows, cols, CArray(m, t, p, ok, desc, writes))

    // A fresh dense buffer of elements of `et`: a matrix of extents `rows` by `cols`, or a vector of
    // `rows` where `cols` is `""`.
    fresh_buffer(*self, span: Span, et: Ty, rows: string, cols: string) -> LBuf
        val e = self.elem_ty(span, et)
        val mty = if cols == "" then s"memref<?x$e>" else s"memref<?x?x$e>"
        val m = self.def(s"memref.alloc(${if cols == "" then rows else s"$cols, $rows"}) : $mty")
        val base = self.def(s"arith.index_cast ${self.def(s"memref.extract_aligned_pointer_as_index $m : $mty -> index")} : index to i64")

        LBuf(m, mty, self.def(s"llvm.inttoptr $base : i64 to !llvm.ptr"), rows, if cols == "" then self.index_const(1) else cols)

    // The buffer a product of type `t`, of extents `rows` by `cols` (`""` for a vector), is written
    // to: the array `dest`'s own where it has those extents and lies dense from its first element,
    // else a fresh one, as it is where `dest` is `""`.
    product_buffer(*self, span: Span, t: Ty, rows: string, cols: string, dest: string) -> LBuf
        if dest == "" then return self.fresh_buffer(span, elem_of(t), rows, cols)

        val vt = self.view_ty(t)
        val bt = self.boundary_ty(span, vt)
        val dm = self.def(s"bufferization.to_buffer ${self.cast(span, dest, t, vt)} : ${self.tensor_ty(span, vt)} to $bt")
        val md = self.metadata(dm, vt)
        val one = self.index_const(1)
        // In buffer order, nex's last axis first: the sizes from `#2`, then the strides.
        var checks: Buf[string] = buf()

        if cols == ""
            checks.push(s"$md#2, $rows")
            checks.push(s"$md#3, $one")
        else
            checks.push(s"$md#3, $rows")
            checks.push(s"$md#2, $cols")
            checks.push(s"$md#5, $one")
            checks.push(s"$md#4, $rows")

        var ok = ""

        for c in checks
            val eq = self.def(s"arith.cmpi eq, $c : index")

            ok = if ok == "" then eq else self.def(s"arith.andi $ok, $eq : i1")

        val m = self.fresh()

        self.op(s"$m = scf.if $ok -> ($bt) {")
        self.op(s"scf.yield $dm : $bt")
        self.op("} else {")

        val f = self.fresh_buffer(span, elem_of(t), rows, cols)

        self.op(s"scf.yield ${self.def(s"memref.cast ${f.m} : ${f.mty} to $bt")} : $bt")
        self.op("}")
        LBuf(m, bt, self.first_element(span, m, vt), rows, if cols == "" then one else cols)

    // The buffer `b`, written, as a value of the array type `t`.
    buffer_tensor(*self, span: Span, b: LBuf, t: Ty) -> string
        val vt = self.view_ty(t)

        self.cast(span, self.def(s"bufferization.to_tensor ${b.m} restrict writable : ${b.mty} to ${self.tensor_ty(span, vt)}"), vt, t)

    // A call of the runtime's linear-algebra entry `name` with `args`, its value of MLIR type `rt`
    // (`""` for none). The module then links BLAS and LAPACK.
    la_call(*self, name: string, args: LaArgs, rt: string) -> string
        self.use_blas()
        self.call(name, joined(args.vals), joined(args.tys), rt)
end Emitter

// The arguments of a call of the runtime's linear algebra, and their MLIR types.
struct LaArgs
    vals: Buf[string]
    tys: Buf[string]

    ptr(*self, v: string)
        self.vals.push(v)
        self.tys.push("!llvm.ptr")

    // An `index` value, as the runtime's `long`.
    index(*self, e: *Emitter, i: string)
        self.vals.push(e.to_i64(i))
        self.tys.push("i64")

    // A constant: an element type's code, a flag, a choice.
    code(*self, e: *Emitter, n: int)
        self.vals.push(e.def(s"arith.constant $n : i64"))
        self.tys.push("i64")

    // A matrix as the runtime takes one: the address of element (0, 0), its rows, its columns and
    // its leading dimension.
    matrix(*self, e: *Emitter, x: BlasArg)
        self.ptr(x.ptr)
        self.index(e, x.rows)
        self.index(e, x.cols)
        self.index(e, x.ld)
