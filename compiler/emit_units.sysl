// Emission of units of measure (DESIGN §13.8). A unit is erased: a value that carries one is its
// number, so every place the emitter dispatches on a type matches on `base_of(t)`, the type under the
// unit; attaching, renaming or removing a unit emits nothing; and a conversion between two scales of
// one dimension is one multiplication by the ratio of their exact factors, rounded once, here, to the
// operand's width.

import nex.sh.sysl.nex.*
import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

impl Emitter
    // `v` converted to the scale of `e`'s unit: a multiplication by `factor` at the width of `e`'s
    // type, each part of a complex on its own, and on an array each element.
    rescale(*self, e: TExpr, v: TExpr, factor: Ratio) -> string
        val span = e.span
        val t = e.ty

        if is_arr(t)
            var operands: Buf[TExpr] = buf()

            operands.push(v)
            return self.mapped(e, operands, texpr(span, elem_of(t), TRescale(chain_leaf(v, 0), factor)))

        val x = self.ex(v)

        base_of(t) match
            Real(bits) -> self.real_binary(span, "*", x, self.real_const(factor_at(factor, bits), bits), bits)
            Complex(bits) ->
                val c = s"complex<f$bits>"
                val f = self.real_const(factor_at(factor, bits), bits)
                val re = self.real_binary(span, "*", self.def(s"complex.re $x : $c"), f, bits)
                val im = self.real_binary(span, "*", self.def(s"complex.im $x : $c"), f, bits)

                self.complex_const(re, im, bits)
            _ -> self.unsupported(span, s"a conversion of ${show_ty(t)} to another scale")
end Emitter
