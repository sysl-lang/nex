@tests

// Arrays compiled and run: the corpus categories PLAN.md's M6 counts, and what the emitted MLIR must
// become on its way down — three element-wise operators fused into one loop, and an `inout` array
// passed by its buffer with no copy. The rank-N programs are in `testdata/v2/` (`tests_run.sysl`).

import sysl.buf.{Buf, buf}
import sysl.fs.{read_text, write_text}
import sysl.process.capture
import sysl.text.{from_utf8, join, split}

private val M6_CATEGORIES = ["arrays", "auto-clone (§8.3)", "[byte] buffer"]

private val STAGES = from_utf8(embed("experiments/mlir/pipeline.txt")).unwrap().trim()

@test("every program of PLAN.md's M6 corpus categories prints its .out")
run_m6_corpus()
    val r = corpus_run(M6_CATEGORIES[..])

    assert(r.failed.len() == 0, join(r.failed.view(), "\n"))
    assert_eq(join(r.waiting.view(), "\n"), "")
    assert_eq(r.passed, 115)

// `m` lowered by the pipeline's passes up to and including the first whose text starts `last`.
lowered_until(b: Bench, m: string, last: string) -> string
    var passes: Buf[string] = buf()

    for p in split(STAGES, ",")
        passes.push(p)
        if p.starts_with(last) then break

    val input = s"${b.work}/stage.mlir"

    write_text(input, m).unwrap()

    val out = capture(s"${b.tc.llvm_bin}/mlir-opt", [input, s"--pass-pipeline=${join(passes.view(), ",")})"], stderr = true).unwrap()

    assert(out.status.ok(), out.err.unwrap_or(""))
    out.text

occurrences(text: string, what: string) -> usize = split(text, what).len - 1

@test("313-02's whole-array expression, three linalg.generic operations as emitted, is one loop after fusion")
fused_point_distance()
    val b = bench()
    val m = emitted(read_text("testdata/corpus/313-02-arrays-element-wise-fusion-point-distance.nex").unwrap()).unwrap()
    val fused = lowered_until(b, m, "func.func(linalg-fuse-elementwise-ops)")

    finish(b)
    assert_eq(occurrences(m, "linalg.generic"), 3)
    assert_eq(occurrences(fused, "linalg.generic"), 1)

@test("== on arrays, [uint8] among them, is element-wise, and all of it says whether two are equal")
run_array_equality()
    val b = bench()
    val program = "def main() =\n  var a: [uint8] = zeros(3)\n  a[2] = 7\n  val c: [uint8] = zeros(3)\n" +
        "  print(a == c)\n  print((all(a == c), any(a != c), all(a == a)))\n  print([1.0, 2.0, nan] == [1.0, 5.0, nan])\n  val d: [uint8] = zeros(2)\n  print(a == d)\n"
    val out = ran(b, program)

    finish(b)
    assert_eq(out.text, "[true, false, true]\n(false, true, true)\n[true, false, false]\n")
    assert_eq(out.err.unwrap_or(""), "trap: shape mismatch\n")

@test("a for over an array's elements gives back each pass's temporaries in the pass: a closure last, before a cycle, nested")
run_for_each_temporaries()
    val b = bench()
    val program = "def main() =\n  var t = 0.0\n  for n in [3, 70]\n    val a = [1.0 * n, 2.0]\n    t = t + a[1]\n    assert_traps(() -> print(a[3]), \"out of bounds\")\n" +
        "  for k in [1, 2, 3]\n    val f = () -> k * 10\n    if k == 2 then cycle\n    print(f())\n" +
        "  for i in [1, 2]\n    for j in [10, 20]\n      val g = () -> i + j\n      print(g())\n  print(t)\n"
    val out = ran(b, program)

    finish(b)
    assert(out.status.ok(), out.err.unwrap_or(""))
    assert_eq(out.text, "10\n30\n11\n21\n12\n22\n73.0\n")

@test("element-wise operands whose shapes differ trap at run time, also where folding learns both shapes")
run_elementwise_folded_shape_mismatch()
    val b = bench()
    var errs: Buf[string] = buf()

    for body in ["  val a: [real] = zeros(3)\n  val d: [real] = zeros(2)\n  print(a + d)\n",
                 "  val m: [real; :, :] = zeros((2, 3))\n  val n: [real; :, :] = zeros((3, 2))\n  print(m < n)\n",
                 "  val a: [real] = zeros(3)\n  val d: [real] = zeros(2)\n  print((a + a) * d)\n",
                 "  val a: [integer] = fill(2, 4)\n  print(max(a, fill(3, 1)))\n"]
        val out = ran(b, "def main() =\n" + body)

        errs.push(s"${out.text}${out.err.unwrap_or("")}")

    val same = ran(b, "def main() =\n  val a: [real] = fill(2, 1.5)\n  print(a + fill(2, 1.0))\n")

    finish(b)
    assert_eq(join(errs.view(), ""), "trap: shape mismatch\ntrap: shape mismatch\ntrap: shape mismatch\ntrap: shape mismatch\n")
    assert_eq(same.text, "[2.5, 2.5]\n")

@test("an inout array is passed as its buffer and written in place: no copy, and the callee returns nothing")
inout_array_no_copy()
    val b = bench()
    val m = emitted("def zero_first(v: inout [integer]) =\n  v[1] = 0\n  v[2] = v[3] + 1\n\ndef main() =\n  var a = fill(3, 7)\n  zero_first(a)\n  zero_first(a)\n  print(a)\n").unwrap()
    val buffers = lowered_until(b, m, "convert-bufferization-to-memref")

    finish(b)
    // As emitted the callee hands its array back; bufferized, that result is gone.
    assert(m.contains("@\"n.zero_first\"(%a0: tensor<?xi64>) -> tensor<?xi64>"), m)
    assert_eq(occurrences(buffers, "memref.copy"), 0)
    assert(buffers.contains("func.func private @n.zero_first(%arg0: memref<?xi64, strided<[?], offset: ?>>) {"), buffers)
    assert_eq(occurrences(buffers, "call @n.zero_first(%cast) : (memref<?xi64, strided<[?], offset: ?>>) -> ()"), 2)

@test("two static shapes that differ are a compile error wherever both are known")
static_shape_errors()
    assert_eq(emitted("def main() =\n  val a: [real; 2, 3] = zeros((2, 3)) * 1.0\n  val b: [real; 3, 2] = zeros((3, 2)) * 1.0\n  print(a + b)\n").err().unwrap_or(""),
              "error: `+` combines arrays of one shape; axis 1 is 2 in one and 3 in the other @4:9")
    assert_eq(emitted("def f(m: [real; 2, 2]) = m[1, 1]\ndef main() =\n  val a: [real; 3, 3] = zeros((3, 3)) * 1.0\n  print(f(a))\n").err().unwrap_or(""),
              "error: argument `m` must be [real; 2, 2], but this is [real; 3, 3]: axis 1 is 3 here, and 2 is required @4:11")
    assert_eq(emitted("def main() =\n  val a: [real; 2, 3] = zeros((2, 3)) * 1.0\n  val b: [real; 2, 2] = zeros((2, 2)) * 1.0\n  print(a @ b)\n").err().unwrap_or(""),
              "error: `@` needs the inner extents to agree; they are 3 and 2 @4:9")
    assert_eq(emitted("def main() =\n  val a = [[1, 2]]\n  print(extent(a, 3))\n").err().unwrap_or(""), "error: there is no axis 3: this array has rank 2 @3:19")
