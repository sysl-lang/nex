@tests

// Programs with structs, tuples, enums, closures and generic instances, compiled and run: the corpus
// categories PLAN.md's M4 and M5 count, and the programs of `testdata/leaks/`, which reach the
// ownership of strings, closures and the aggregates holding them in the places it can go wrong — a
// value moved between places, a region's value kept past its temporaries, an early `return` out of a
// `match`, a cell outliving its frame. Those are run three ways: plainly, under Guard Malloc (a
// released object read again faults), and under `leaks --atExit`, which must find nothing.

import sysl.buf.{Buf, buf}
import sysl.fs.{exists, read_text}
import sysl.process.{Var, capture}
import sysl.testing.skip
import sysl.text.{join, split}

private val M4_M5_CATEGORIES = ["structs", "tuple destructuring", "paren-less tuple construction", "sum types (enums)", "closure escape (§4.11)",
    "user generics", "user generic enums", "user generic structs"]

private val LEAK_PROGRAMS = ["strings-and-closures", "aggregates", "views", "arrays", "equality", "items-sliced", "items-rearranged", "traps", "linear-algebra"]

@test("every program of PLAN.md's M4 and M5 corpus categories prints its .out")
run_m4_m5_corpus()
    val r = corpus_run(M4_M5_CATEGORIES[..])

    assert(r.failed.len() == 0, join(r.failed.view(), "\n"))
    assert_eq(join(r.waiting.view(), "\n"), "")
    assert_eq(r.passed, 74)

@test("the ownership programs print their .out, read nothing freed under Guard Malloc, and leak nothing")
run_leak_programs()
    if !exists("/usr/bin/leaks") then skip("no leaks tool")

    val b = bench()
    var reports: Buf[string] = buf()

    for name in LEAK_PROGRAMS
        val expected = read_text(s"testdata/leaks/$name.out").unwrap()
        val exe = s"${b.work}/$name"

        compiled(b, read_text(s"testdata/leaks/$name.nex").unwrap(), exe)

        val plain = capture(exe, [], stderr = true).unwrap()
        val guarded = capture(exe, [], env = [Var("DYLD_INSERT_LIBRARIES", "/usr/lib/libgmalloc.dylib")], stderr = true).unwrap()
        val leaks = capture("/usr/bin/leaks", ["--atExit", "--", exe], stderr = true).unwrap()

        assert_eq(plain.text, expected)
        assert(guarded.status.ok(), s"$name under Guard Malloc: ${guarded.status}\n${guarded.err.unwrap_or("")}")
        assert_eq(guarded.text, expected)
        reports.push(s"$name: ${leaks_line(leaks.text)}")

    finish(b)
    assert_eq(join(reports.view(), "\n"), "strings-and-closures: 0 leaks for 0 total leaked bytes.\naggregates: 0 leaks for 0 total leaked bytes.\nviews: 0 leaks for 0 total leaked bytes.\narrays: 0 leaks for 0 total leaked bytes.\nequality: 0 leaks for 0 total leaked bytes.\nitems-sliced: 0 leaks for 0 total leaked bytes.\nitems-rearranged: 0 leaks for 0 total leaked bytes.\ntraps: 0 leaks for 0 total leaked bytes.\nlinear-algebra: 0 leaks for 0 total leaked bytes.")

@test("only a function holding counted values registers a frame record for a trap's catch, and it is taken off before the return")
frame_records_only_where_counts_are_held()
    val numbers = emitted("def f(n: integer): real =\n  var s = 0.0\n  for k in 1..n\n    s += real(k)\n  s\ndef main() = print(f(3))\n").unwrap_or("")
    val text = emitted("def f(n: integer) =\n  val s = s\"n$n\"\n  print(s + s)\ndef main() = f(3)\n").unwrap_or("")
    val f = split(text, "@\"n.f\"")[1]

    assert(!numbers.contains("nex_frame_enter"), numbers)
    assert(f.contains("func.call @nex_frame_enter"), f)
    assert(split(f, "func.return")[0].contains("func.call @nex_frame_leave"), f)

@test("== and != compare structs, tuples and enums field by field: strings by text, reals as == does, enums by variant first")
run_aggregate_equality()
    val b = bench()
    val program = "struct Point\n  x: real\n  y: real\nstruct Named\n  name: string\n  at: Point\nstruct Pair[T]\n  fst: T\n  snd: T\n" +
        "enum Shape =\n  Circle(r: real)\n  Rect(w: real, h: real)\n  Empty\n" +
        "def same[T: Eq](a: T, b: T): bool = a == b\n" +
        "def main() =\n  val p = Point(1.0, 2.0)\n  val r = Point(1.0, 3.0)\n" +
        "  print((p == Point(1.0, 2.0), p == r, p != r, p == Point(1, 2.0)))\n" +
        "  print((Named(\"a\", p) == Named(\"a\", p), Named(\"a\", p) == Named(\"b\", p), Named(\"a\", p) == Named(\"a\", r)))\n" +
        "  val t = 1, 2.5, \"x\"\n  print((t == (1, 2.5, \"x\"), t != (1, 2.5, \"y\"), (1, 2) == (1, 3)))\n" +
        "  val s: Shape = Empty\n" +
        "  print((Circle(1.0) == Circle(1.0), Circle(1.0) == Circle(2.0), Circle(1.0) == Rect(1.0, 1.0), Rect(1.0, 2.0) != Rect(1.0, 2.0), s == Empty, Empty != s))\n" +
        "  print((Point(nan, 0.0) == Point(nan, 0.0), Point(nan, 0.0) != Point(nan, 0.0)))\n" +
        "  print((same(Pair(1, 2), Pair(1, 2)), same((1, \"a\"), (1, \"b\")), Pair(\"a\", \"b\") == Pair(\"a\", \"b\")))\n"
    val out = ran(b, program)

    finish(b)
    assert_eq(out.text, "(true, false, true, true)\n(true, false, false)\n(true, true, false)\n(true, false, false, false, true, false)\n(false, true)\n(true, false, true)\n")

@test("== on an aggregate holding an array of non-numbers at rank 2 or 3 compares every extent, then the elements")
run_rank_n_items_equality()
    val b = bench()
    val out = ran(b, "struct Names\n  m: [string; :, :]\ndef same(a: Names, b: Names) = a == b\ndef main() =\n" +
        "  val m = [[\"a\", \"b\", \"c\"], [\"d\", \"e\", \"f\"]]\n" +
        "  print((same(Names(m), Names(m[:, :])), same(Names(m), Names(transpose(m))), same(Names(m), Names(reshape(transpose(m), (2, 3))))))\n" +
        "  print((Names(m) != Names([[\"a\", \"b\", \"c\"], [\"d\", \"e\", \"x\"]]), Names(m) == Names(m[1..1, :]), Names(m[2..1, :]) == Names(m[2..1, 1..2])))\n" +
        "  val c = reshape([\"a\", \"b\", \"c\", \"d\", \"e\", \"f\", \"g\", \"h\"], (2, 2, 2))\n" +
        "  print(((c, 1) == (permute(permute(c, (2, 3, 1)), (3, 1, 2)), 1), (c, 1) == (reshape(c, (2, 4, 1)), 1), (c, 1) == (c, 2)))\n")

    finish(b)
    assert_eq(out.text, "(true, false, false)\n(true, false, false)\n(true, false, false)\n")

// `text` compiled into `exe`.
private compiled(b: Bench, text: string, exe: string)
    val m = emitted(text) match
        Ok(m) -> m
        Err(e) -> fail_with(e)

    lower_module(m, exe, b.work, b.tc) match
        Ok(_) -> ()
        Err(e) -> fail_with(e)

// The line of a `leaks` report that counts what leaked.
private leaks_line(report: string) -> string
    for line in split(report, "\n")
        if line.contains(" leaks for ") then return split(line, ": ")[1]

    report
