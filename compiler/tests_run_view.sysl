@tests

// Views compiled and run: the corpus categories PLAN.md's views milestone counts, and what a view
// must cost on its way down — nothing. The view programs of DESIGN §5 and §6 are in `testdata/v2/`
// (`tests_run.sysl`), and the toolchain proofs of negative strides in `tests_toolchain.sysl`.

import sysl.buf.{Buf, buf}
import sysl.text.join

private val VIEW_CATEGORIES = ["view-style slicing", "rank-2 view-style slicing", "rank-2 sub-rectangle view-style slicing",
                               "rank-1 strided view-style slicing"]

@test("every program of the four view-style slicing categories prints its .out")
run_view_corpus()
    val r = corpus_run(VIEW_CATEGORIES[..])

    assert(r.failed.len() == 0, join(r.failed.view(), "\n"))
    assert_eq(join(r.waiting.view(), "\n"), "")
    assert_eq(r.passed, 35)

// Rows, columns, strided, reversed and rank-2 windows read by a callee, and `inout` windows written
// by one, all of two arrays the program allocates.
private val PASSED_VIEWS = "def total(v: [integer]) =\n  var s = 0\n  for x in v\n    s += x\n  s\n\ndef corner(v: [integer; :, :]) = v[1, 1] + v[end, end]\n\ndef bump(v: inout [integer], by: integer) =\n  for k in 1..length(v)\n    v[k] += by\n\ndef main() =\n  var a = fill(12, 1)\n  var m = zeros((3, 4))\n  bump(a[.. by -2], 1)\n  bump(m[:, 3], 2)\n  bump(m[2, 2..], 3)\n  bump(a[3..9 by 3], 4)\n  print(total(a[2..5]))\n  print(total(m[:, 2]))\n  print(total(m[2, :]))\n  print(total(a[.. by -1]))\n  print(corner(m[1..3 by 2, .. by -1]))\n  print(corner(m[2..3, 2..3]))\n  print(a)\n  print(m)\n"

@test("passing a view to a function, to read it or as an inout window, allocates and copies nothing")
views_cost_nothing()
    val b = bench()
    val m = emitted(PASSED_VIEWS).unwrap()
    val buffers = lowered_until(b, m, "buffer-deallocation-pipeline")
    val out = ran(b, PASSED_VIEWS)

    finish(b)
    assert_eq(out.text, "10\n3\n11\n30\n0\n5\n[1, 2, 5, 2, 1, 6, 1, 2, 5, 2, 1, 2]\n[[0, 0, 2, 0], [0, 3, 5, 3], [0, 0, 2, 0]]\n")
    // The two arrays of `main`, and nothing else.
    assert_eq(occurrences(buffers, "memref.alloc"), 2)
    assert_eq(occurrences(buffers, "memref.copy"), 0)
    assert_eq(occurrences(buffers, "bufferization.clone"), 0)

@test("a var initialized from an array literal gets its own buffer, so a first write through a window copies nothing")
literal_var_written_through_a_window()
    val b = bench()
    val text = "def bump(v: inout [integer]) =\n  v[1] += 10\n\ndef main() =\n  var a = [1, 2, 3, 4]\n  bump(a[2..3])\n  a[3..][1] = 0\n  print(a)\n"
    val buffers = lowered_until(b, emitted(text).unwrap(), "buffer-deallocation-pipeline")
    val out = ran(b, text)

    finish(b)
    assert_eq(out.text, "[1, 12, 0, 4]\n")
    assert_eq(occurrences(buffers, "memref.alloc"), 1)
    assert_eq(occurrences(buffers, "memref.copy"), 1)

// One-shot bufferization copies the read window before the call, though the two windows are
// constants that cannot overlap (`experiments/mlir/disjoint-read-inout.mlir`).
@test("a read window beside a disjoint inout window of the same array is passed without a copy",
      ignore: "one-shot bufferization does not see that a call's read and written subviews are disjoint")
disjoint_windows_cost_nothing()
    val b = bench()
    val text = "def axpy(alpha: integer, x: [integer], y: inout [integer]) =\n  for k in 1..length(y)\n    y[k] += alpha * x[k]\n\ndef main() =\n  var y = fill(8, 1)\n  axpy(2, y[1..4], y[5..8])\n  print(y)\n"
    val buffers = lowered_until(b, emitted(text).unwrap(), "buffer-deallocation-pipeline")

    finish(b)
    assert_eq(occurrences(buffers, "memref.alloc"), 1)
    assert_eq(occurrences(buffers, "memref.copy"), 0)

@test("reverse with no axis reverses axis 1 of an array of numbers or of non-numbers, at rank 1 and 2")
reverse_with_no_axis()
    val b = bench()
    val out = ran(b, "def main() =\n  var a = [1, 2, 3, 4]\n  val r = reverse(a)\n  a[1] = 9\n  print(r)\n  print(reverse([[1, 2], [3, 4]]))\n  print(reverse([\"a\", \"b\", \"c\"]))\n  print(reverse([[\"a\", \"b\"], [\"c\", \"d\"]]))\n  print(reverse([(1, \"x\"), (2, \"y\")]))\n")

    finish(b)
    assert_eq(out.text, "[4, 3, 2, 1]\n[[3, 4], [1, 2]]\n[c, b, a]\n[[c, d], [a, b]]\n[(2, y), (1, x)]\n")

@test("empty windows of an array of non-numbers read and write nothing, and an array written into a window of itself is read whole first")
items_empty_and_self_windows()
    val b = bench()
    val out = ran(b, "def main() =\n  var xs = [\"a\", \"b\", \"c\"]\n  print(xs[2..1])\n  xs[2..1] = \"z\"\n  xs[3..2] = xs[1..0]\n  print(xs)\n  var m = [[\"a\", \"b\"], [\"c\", \"d\"]]\n  print(m[2..1, :])\n  print(size(m[:, 2..1]))\n  xs[.. by -1] = xs\n  print(xs)\n  m[.. by -1, :] = m\n  m[:, 2] = m[:, 1]\n  print(m)\n")

    finish(b)
    assert_eq(out.text, "[]\n[a, b, c]\n[]\n0\n[c, b, a]\n[[c, c], [a, a]]\n")

@test("a negative slice stride compiles, and a stride of 0 still traps")
negative_strides_compile()
    val b = bench()
    val reversed = ran(b, "def main() =\n  val a = [1, 2, 3]\n  var k = -1\n  print(a[.. by k])\n  k = 0\n  print(a[.. by k])\n")

    finish(b)
    assert_eq(reversed.text, "[3, 2, 1]\n")
    assert_eq(reversed.err.unwrap_or(""), "trap: a slice stride of 0\n")
    assert(!reversed.status.ok(), s"${reversed.status}")
