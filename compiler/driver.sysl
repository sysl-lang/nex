// The driver: a nex source file to a native program, through the toolchain PLAN.md's architecture
// names. The source is parsed, elaborated and emitted as MLIR text; `mlir-opt` lowers it to the LLVM
// dialect with the pass list in the repository's `experiments/mlir/pipeline.txt`, `mlir-translate`
// writes LLVM IR, and `clang -O2` compiles that and links it against the runtime archive
// (`runtime/`, built by `sysl build-c`).
//
// **A program with a `parallel` construct is lowered through OpenMP, with no flag** (DESIGN §9.5):
// its module holds an `omp.parallel` region, so the pass list gains `convert-openmp-to-llvm` and
// the link gains LLVM's `libomp`. A program without one links no OpenMP runtime at all.
//
// **The link takes the command line's `-L`/`-l` options and the libraries the program's externs
// `@link`**, which the emitter writes as `// nex.link` lines before the module (DESIGN §10.1). **A
// program whose `@` or linear-algebra prelude calls BLAS or LAPACK** says so in a `// nex.blas` line,
// and links the library the runtime's `library` choice names (Accelerate on macOS and OpenBLAS
// elsewhere by default), or what `NEX_BLAS` names. **A program with
// a `@fortran` extern links gfortran's runtime**, which a `// nex.fortran` line says, and **a program
// importing `mpi` links the found MPI and the module's shim**, which a `// nex.mpi` line says.
//
// LLVM is found at `NEX_LLVM_HOME`, else Homebrew's `opt/llvm` or apt.llvm.org's `/usr/lib/llvm-23`,
// else above an `mlir-opt` on `PATH` (`llvm_home_in`); the runtime at `NEX_RUNTIME`, else
// `libnex_rt.a` beside the `nex` executable; gfortran at `NEX_GFORTRAN`, else on `PATH`.

import nex.sh.sysl.nex.*
import nex_runtime.sh.sysl.nex_runtime.{la_libraries, la_pkg_config}
import sysl.buf.{Buf, buf}
import sysl.env.get_or
import sysl.fs.{cache_dir, exists, make_dir_all, make_temp_dir, remove_dir_all, rename, write_text}
import sysl.process.{Stdio, capture}
import sysl.text.{from_utf8, replace_all, split}

private val PIPELINE = from_utf8(embed("../experiments/mlir/pipeline.txt")).unwrap().trim()

// The pass the OpenMP pipeline adds, and where: before the function conversion, which would leave
// the region's operands in types `omp.parallel` does not convert itself.
private val OPENMP_PASS = "convert-openmp-to-llvm,"
private val OPENMP_BEFORE = "convert-func-to-llvm"

// The pass list for `mlir`: the OpenMP one where it holds a parallel region.
pipeline_for(mlir: string) -> string
    if !mlir.contains("omp.parallel") then return PIPELINE

    replace_all(PIPELINE, OPENMP_BEFORE, OPENMP_PASS + OPENMP_BEFORE)

// Where the tools are, and the runtime every program links.
struct Toolchain
    llvm_bin: string
    runtime: string

// Where an LLVM with MLIR is looked for when `NEX_LLVM_HOME` does not say, in order: Homebrew's
// on macOS, apt.llvm.org's on Linux, then the other.
#if macos
val LLVM_HOMES: []const string = ["/opt/homebrew/opt/llvm", "/usr/lib/llvm-23"]
#else
val LLVM_HOMES: []const string = ["/usr/lib/llvm-23", "/opt/homebrew/opt/llvm"]
#endif

// The LLVM a program is lowered with: `given` (`NEX_LLVM_HOME`) where it is set; else the first of
// `homes` holding `bin/mlir-opt`; else the directory above the `bin/` of an `mlir-opt` on `search`
// (a `PATH`, as `module load llvm` leaves one); else the first of `homes`, which the missing
// `mlir-opt` is then reported against.
llvm_home_in(given: string, homes: []const string, search: string) -> string
    if given != "" then return given

    for h in homes
        if exists(s"$h/bin/mlir-opt") then return h

    on_path_in("mlir-opt", search) match
        Some(found) ->
            val bin = dir_of(found)

            if bin.ends_with("/bin") then return dir_of(bin)
        None -> ()

    if homes.len > 0 then homes[0] else ""

// The LLVM this environment names (`llvm_home_in`).
llvm_home() -> string = llvm_home_in(get_or("NEX_LLVM_HOME", ""), LLVM_HOMES, get_or("PATH", ""))

// The gfortran a `@fortran` program's runtime is found through: `given` (`NEX_GFORTRAN`) where it
// is set; else `gfortran` on `search` (a `PATH`); else Homebrew's, which a missing one is reported
// against.
gfortran_in(given: string, search: string) -> string
    if given != "" then return given

    on_path_in("gfortran", search).unwrap_or("/opt/homebrew/bin/gfortran")

// The gfortran this environment names (`gfortran_in`).
gfortran_path() -> string = gfortran_in(get_or("NEX_GFORTRAN", ""), get_or("PATH", ""))

// The toolchain from the environment, the runtime beside `exe` where `NEX_RUNTIME` does not name it.
find_toolchain(exe: string) -> Result[Toolchain, string]
    val bin = s"${llvm_home()}/bin"

    if !exists(s"$bin/mlir-opt") then return Err(s"nex: no mlir-opt in $bin; set NEX_LLVM_HOME to an LLVM with MLIR")

    val runtime = get_or("NEX_RUNTIME", s"${dir_of(exe)}/libnex_rt.a")

    if !exists(runtime) then return Err(s"nex: no runtime archive at $runtime; set NEX_RUNTIME, or build it with `sysl build-c runtime -o $runtime`")

    Ok(Toolchain(bin, runtime))

private dir_of(file: string) -> string
    val parts = split(file, "/")

    if parts.len <= 1 then return "."

    var out = ""

    for k in 0..<parts.len - 1
        if k > 0 then out += "/"
        out += parts[k]

    if out == "" then "/" else out

// The MLIR module for the program whose root module is `file` (the library's `load`), or its
// diagnostics, rendered.
mlir_of(file: string, fpe_trap: bool, opts: LoadOptions = LoadOptions(None, false)) -> Result[string, string]
    val l = load(file, opts)?

    emit_program(l.program, fpe_trap) match
        Ok(text) -> Ok(text)
        Err(ds) -> Err(l.project.render(ds))

// The program in `file` compiled to a native program at `out`, its intermediate files in `work`, and
// linked with the command line's `links` (`-L dir`, `-l lib`).
compile_file(file: string, out: string, work: string, tc: Toolchain, fpe_trap: bool, opts: LoadOptions = LoadOptions(None, false), links: []const string = []) -> Result[unit, string] =
    lower_module(mlir_of(file, fpe_trap, opts)?, out, work, tc, links)

// Whether this machine links Apple frameworks.
#if macos
val FRAMEWORKS = true
#else
val FRAMEWORKS = false
#endif

// The link inputs the module's `// nex.link` lines name: its externs' `@link`s. A
// `@link(framework = "…")` is refused where `frameworks` is false, as a framework is macOS's.
module_links(mlir: string, frameworks: bool = FRAMEWORKS) -> Result[Buf[string], string]
    var out: Buf[string] = buf()

    for line in split(mlir, "\n")
        if line == "module {" then break
        if !line.starts_with("// nex.link ") then continue

        val arg = line[12..]

        if arg.starts_with("-framework ")
            if !frameworks then return Err(s"nex: `@link(framework = \"${arg[11..]}\")` names a macOS framework, and this platform has none; link the library itself with `@link(\"name\")`")

            out.push("-framework")
            out.push(arg[11..])
        else
            out.push(arg)

    Ok(out)

// A run-time search path for each search directory of `links` (`-Ldir`), so that a shared library
// found at the link is found again when the program runs, as on macOS its install name does.
run_paths(links: []const string) -> Buf[string]
    var out: Buf[string] = buf()

    for a in links
        if a.starts_with("-L") && a.len > 2 then out.push(s"-Wl,-rpath,${a[2..]}")

    out

// Whether the module calls BLAS or LAPACK for `@` or the linear-algebra prelude, which its
// `// nex.blas` line says.
uses_blas(mlir: string) -> bool
    for line in split(mlir, "\n")
        if line == "module {" then return false
        if line == "// nex.blas" then return true

    false

// The link inputs of the BLAS and LAPACK a program calls (DESIGN §10.4): `NEX_BLAS`, split at its
// spaces, where it is set; else the library the runtime's `library` choice names — the one the
// interpreter in this command links — which is Accelerate on macOS and OpenBLAS elsewhere unless
// the runtime was built with `openblas`, whose options `pkg-config` gives.
blas_links() -> Result[Buf[string], string]
    var out: Buf[string] = buf()
    var chosen = get_or("NEX_BLAS", "")
    val pc = la_pkg_config()

    if chosen == "" && pc != ""
        chosen = tool("pkg-config", ["--libs", pc], Inherit)?.trim()

    if chosen != ""
        for a in split(chosen, " ")
            if a != "" then out.push(a)

        return Ok(out)

    for lib in la_libraries()
        out.push(s"-l$lib")

    Ok(out)

// The link option every program takes against the runtime archive. The archive is one object, its
// linear algebra among the rest, so a program that calls none must leave that code — and the BLAS
// and LAPACK it would need — out of its link.
#if macos
val UNUSED_CODE = "-Wl,-dead_strip"
#else
val UNUSED_CODE = "-Wl,--gc-sections"
#endif

// Whether the module's lines before it say it has a `@fortran` extern.
private calls_fortran(mlir: string) -> bool
    for line in split(mlir, "\n")
        if line == "module {" then break
        if line == "// nex.fortran" then return true

    false

// The link options for gfortran's runtime, found where the compiler `gfortran` says it lies; the
// directory is also the program's run-time search path.
fortran_runtime(gfortran: string) -> Result[Buf[string], string]
    val missing = s"nex: the program calls Fortran (`@fortran`), which links gfortran's runtime, and there is no gfortran at $gfortran; install gfortran or set NEX_GFORTRAN"

    if !exists(gfortran) then return Err(missing)

    for lib in ["libgfortran.dylib", "libgfortran.so"]
        val found = tool(gfortran, [s"-print-file-name=$lib"], Inherit)?.trim()

        // gfortran answers the bare name where it has no such file.
        if found == lib || !exists(found) then continue

        val dir = dir_of(found)
        var out: Buf[string] = buf()

        out.push(s"-L$dir")
        out.push("-lgfortran")
        out.push(s"-Wl,-rpath,$dir")
        return Ok(out)

    Err(s"nex: the program calls Fortran (`@fortran`), which links gfortran's runtime, and $gfortran finds no libgfortran")

// -- MPI ----------------------------------------------------------------------------------------------
//
// **A program importing `mpi` links the cluster's MPI** (DESIGN §9.6.7), which its `// nex.mpi` line
// says. The MPI is found as `NEX_MPICC`, else `mpicc` on `PATH`, either asked for its options
// (`--showme:compile`/`--showme:link`, Open MPI's; `-compile_info`/`-link_info`, MPICH's), else
// `pkg-config` of `ompi-c` or `mpich`. The module's shim (`mpi/nex_mpi.c`) is compiled by that
// `mpicc`, or by clang with `pkg-config`'s options, and the object is kept in nex's cache directory
// under a key of the shim's text, the compiler and its options, so each MPI compiles it once. Each
// `-L` directory of the link is also the program's run-time search path, so the program runs
// without the environment `module load` gave the build.

private val MPI_SHIM = from_utf8(embed("../mpi/nex_mpi.c")).unwrap()

// The descriptor the shim reads every buffer through (DESIGN §10.7), written beside it.
private val NEX_DESC = from_utf8(embed("../include/nex_desc.h")).unwrap()

// The MPI a program links: the `mpicc` that compiles the shim (none where `pkg-config` found the MPI,
// and the toolchain's clang compiles it), the options it compiles with, and the link's options.
struct Mpi
    cc: Option[string]
    compile: Buf[string]
    link: Buf[string]

// Whether the module's lines before it say the program imports `mpi`.
uses_mpi(mlir: string) -> bool
    for line in split(mlir, "\n")
        if line == "module {" then return false
        if line == "// nex.mpi" then return true

    false

// The MPI found as DESIGN §9.6.7 orders it, or why there is none.
find_mpi() -> Result[Mpi, string]
    val chosen = get_or("NEX_MPICC", "")

    if chosen != ""
        val cc = if chosen.contains("/") then chosen else on_path(chosen).unwrap_or(chosen)

        if !exists(cc) then return Err(s"nex: the program imports `mpi`, and NEX_MPICC names no compiler: $chosen")

        return wrapper_mpi(cc)

    on_path("mpicc") match
        Some(cc) -> return wrapper_mpi(cc)
        None -> ()

    for pc in ["ompi-c", "mpich"]
        val known = capture("pkg-config", ["--exists", pc], stderr = true) match
            Ok(out) -> out.status.ok()
            Err(_) -> false

        if known then return Ok(Mpi(None, words(tool("pkg-config", ["--cflags", pc], Inherit)?), words(tool("pkg-config", ["--libs", pc], Inherit)?)))

    Err("nex: the program imports `mpi`, which links an MPI, and none was found: NEX_MPICC is not set, there is no mpicc on PATH, and pkg-config knows neither ompi-c nor mpich; load an MPI (`module load openmpi`) or set NEX_MPICC")

// The MPI whose compiler wrapper is `cc`: Open MPI's options where it answers `--showme`, else
// MPICH's, whose answers begin with the compiler it wraps.
private wrapper_mpi(cc: string) -> Result[Mpi, string]
    val open_mpi = capture(cc, ["--showme:link"], stderr = true) match
        Ok(out) -> if out.status.ok() then Some(out.text) else None
        Err(e) -> return Err(s"nex: cannot run $cc: $e")

    open_mpi match
        Some(link) -> return Ok(Mpi(Some(cc), words(tool(cc, ["--showme:compile"], Inherit)?), words(link)))
        None -> ()

    val compile = words(tool(cc, ["-compile_info"], Inherit).map_err((e) -> s"nex: $cc answers neither Open MPI's --showme:link nor MPICH's -compile_info:\n$e")?)
    val link = words(tool(cc, ["-link_info"], Inherit)?)

    Ok(Mpi(Some(cc), after_first(compile), after_first(link)))

// The shim compiled for `mpi`, from nex's cache where it was compiled before; the object's path.
mpi_shim(mpi: Mpi, work: string, tc: Toolchain) -> Result[string, string]
    var key = MPI_SHIM + "\n" + NEX_DESC + "\n" + mpi.cc.unwrap_or(s"${tc.llvm_bin}/clang")

    for a in mpi.compile
        key += "\n" + a

    val name = s"nex_mpi-${hash_str(key)}.o"
    val cached = mpi_cache_dir()
    val obj = if cached == "" then s"$work/$name" else s"$cached/$name"

    if exists(obj) then return Ok(obj)

    val source = s"$work/nex_mpi.c"

    write_text(source, MPI_SHIM).map_err((e) -> s"nex: cannot write $source: $e")?
    write_text(s"$work/nex_desc.h", NEX_DESC).map_err((e) -> s"nex: cannot write $work/nex_desc.h: $e")?

    // Compiled beside where it is kept and moved there whole, so a build running alongside never
    // links half an object.
    val pending = if cached == "" then obj else s"$obj.${hash_str(work)}.pending"
    var args: Buf[string] = buf()

    // Each product and sum rounded on its own, as nex rounds them: no contraction into a fused one.
    for a in ["-O2", "-fPIC", "-ffp-contract=off", "-c", source, "-o", pending]
        args.push(a)

    mpi.cc match
        Some(cc) -> tool(cc, args.view(), Inherit)?
        None ->
            for a in mpi.compile
                args.push(a)

            tool(s"${tc.llvm_bin}/clang", args.view(), Inherit)?

    if pending != obj then rename(pending, obj).map_err((e) -> s"nex: cannot keep the MPI shim at $obj: $e")?

    Ok(obj)

// Where compiled shims are kept: nex's directory in the machine's cache directory, made where it is
// missing; `""` where there is none to be had, and the shim is compiled into the build's own.
private mpi_cache_dir() -> string
    val base = cache_dir() match
        Some(d) -> d
        None -> return ""
    val dir = s"$base/nex/mpi"

    make_dir_all(dir) match
        Ok(_) -> dir
        Err(_) -> ""

// The link's options for `mpi`, each `-L` directory also a run-time search path.
mpi_link_options(mpi: Mpi) -> Buf[string]
    var out: Buf[string] = buf()

    for a in mpi.link
        out.push(a)

    for a in run_paths(mpi.link.view())
        out.push(a)

    out

// The command that runs `np` copies of a program as one MPI job, before the program's path:
// `NEX_MPIRUN` split at its spaces, else `srun` inside a Slurm allocation (`SLURM_JOB_ID` set), else
// the `mpirun` beside the found MPI's `mpicc`, else `mpirun` or `mpiexec` on `PATH`; each given
// `-n np`.
mpi_launcher(np: int) -> Result[Buf[string], string]
    var out: Buf[string] = buf()
    val chosen = get_or("NEX_MPIRUN", "")

    if chosen != ""
        out = words(chosen)
    elif get_or("SLURM_JOB_ID", "") != ""
        out.push("srun")
    else
        out.push(find_mpirun()?)

    out.push("-n")
    out.push(s"$np")
    Ok(out)

private find_mpirun() -> Result[string, string]
    val chosen = get_or("NEX_MPICC", "")
    val cc = if chosen != "" then (if chosen.contains("/") then Some(chosen) else on_path(chosen)) else on_path("mpicc")

    cc match
        Some(c) ->
            val beside = s"${dir_of(c)}/mpirun"

            if exists(beside) then return Ok(beside)
        None -> ()

    for name in ["mpirun", "mpiexec"]
        on_path(name) match
            Some(p) -> return Ok(p)
            None -> ()

    Err("nex: --np runs the program as an MPI job, and there is no mpirun or mpiexec on PATH; load an MPI or set NEX_MPIRUN")

// The file `name` in the first directory of `PATH` that has one.
private on_path(name: string) -> Option[string] = on_path_in(name, get_or("PATH", ""))

// `name` in the first directory of `search`, a colon-separated list, that has it.
private on_path_in(name: string, search: string) -> Option[string]
    for d in split(search, ":")
        if d != "" && exists(s"$d/$name") then return Some(s"$d/$name")

    None

// A tool's answer split at its white space.
private words(text: string) -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(text, "\n")
        for w in split(line, " ")
            val t = w.trim()

            if t != "" then out.push(t)

    out

private after_first(ws: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for k in 1..<ws.len()
        out.push(ws[k])

    out

// An MLIR module lowered to LLVM IR in `work`; the file's path.
private translate(mlir: string, work: string, tc: Toolchain) -> Result[string, string]
    val input = s"$work/program.mlir"
    val lowered = s"$work/program.llvm.mlir"
    val ir = s"$work/program.ll"

    write_text(input, mlir).map_err((e) -> s"nex: cannot write $input: $e")?
    tool(s"${tc.llvm_bin}/mlir-opt", [input, s"--pass-pipeline=${pipeline_for(mlir)}", "-o", lowered], Inherit)?
    write_text(ir, tool(s"${tc.llvm_bin}/mlir-translate", ["--mlir-to-llvmir"], Stdio.FromPath(lowered))?).map_err((e) -> s"nex: cannot write $ir: $e")?
    Ok(ir)

// An MLIR module as the LLVM IR `clang -O2` optimizes it to, before code generation: where a loop
// shows whether it was vectorized.
optimized_ir(mlir: string, work: string, tc: Toolchain) -> Result[string, string] =
    tool(s"${tc.llvm_bin}/clang", ["-Wno-override-module", "-O2", "-S", "-emit-llvm", translate(mlir, work, tc)?, "-o", "-"], Inherit)

// An MLIR module lowered to a native program at `out`, its intermediate files in `work`, linked with
// `links` after the libraries its externs name.
lower_module(mlir: string, out: string, work: string, tc: Toolchain, links: []const string = []) -> Result[unit, string]
    val ir = translate(mlir, work, tc)?
    var args: Buf[string] = buf()

    for a in ["-Wno-override-module", "-O2", ir, tc.runtime, "-o", out]
        args.push(a)

    // The command line's search directories come first, so that the module's `@link`s find their
    // libraries in them.
    for a in links
        args.push(a)

    for a in run_paths(links)
        args.push(a)

    for a in module_links(mlir)?
        args.push(a)

    if uses_blas(mlir)
        val blas = blas_links()?

        for a in blas
            args.push(a)

        for a in run_paths(blas.view())
            args.push(a)

    args.push(UNUSED_CODE)

    if calls_fortran(mlir)
        for a in fortran_runtime(gfortran_path())?
            args.push(a)

    if uses_mpi(mlir)
        val mpi = find_mpi()?

        args.push(mpi_shim(mpi, work, tc)?)

        for a in mpi_link_options(mpi)
            args.push(a)

    args.push("-lm")

    if mlir.contains("omp.parallel")
        val lib = s"${dir_of(tc.llvm_bin)}/lib"

        args.push(s"-L$lib")
        args.push("-lomp")
        args.push(s"-Wl,-rpath,$lib")

    tool(s"${tc.llvm_bin}/clang", args.view(), Inherit)?
    Ok(())

// A tool run that must succeed, its standard output answered.
private tool(program: string, args: []const string, stdin: Stdio) -> Result[string, string]
    val out = capture(program, args, stderr = true, stdin = stdin).map_err((e) -> s"nex: cannot run $program: $e")?

    if !out.status.ok() then return Err(s"nex: $program failed (${out.status}):\n${out.err.unwrap_or("")}")

    Ok(out.text)

// `file` compiled into a fresh temporary directory, which the caller removes; the program's path.
compile_temp(file: string, tc: Toolchain, fpe_trap: bool, opts: LoadOptions = LoadOptions(None, false), links: []const string = []) -> Result[(string, string), string]
    val work = make_temp_dir("nex").map_err((e) -> s"nex: cannot make a temporary directory: $e")?
    val exe = s"$work/program"

    compile_file(file, exe, work, tc, fpe_trap, opts, links) match
        Ok(_) -> Ok((work, exe))
        Err(m) ->
            _ = remove_dir_all(work)
            Err(m)
