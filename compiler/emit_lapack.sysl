// Emission of the linear-algebra prelude through LAPACK (DESIGN §10.5).
//
// **Each function is a call of the runtime's entry of its name** (`nex_la_solve`, `nex_la_eig`, …,
// `runtime/…/la.sysl`), the one implementation the interpreter calls too: the runtime checks the
// shapes, copies the inputs LAPACK would overwrite into dense buffers, asks each routine for its
// workspace, and **traps** where `info` reports a failure, with the function's name and the cause.
// Here each argument crosses where it lies, as an operand of `@` does (`blas_arg`), and each result
// is a fresh dense buffer allocated for the runtime to write, which becomes the result's tensor.
//
// **An `inout` form works where its arrays lie**: it goes through a wrapper function, as an `extern`
// call with `inout` windows does (`emit_extern.sysl`), and answers LAPACK's `info` without trapping.

import nex.sh.sysl.nex.*
import sysl.buf.{Buf, buf}
import sh.sysl.parsing.Span

private tuple_elems(t: Ty) -> Buf[Ty] = t match
    Tuple(ts) -> ts
    _ -> buf()

private real_part(t: Ty) -> Ty = Real(bits_of(base_of(t)))

impl Emitter
    // A call of the linear-algebra prelude, of type `t`.
    lapack(*self, span: Span, name: string, args: Buf[TExpr], t: Ty) -> string
        if name.ends_with("_inplace") then return self.lapack_inout(span, name, args, t)

        val et = elem_of(args[0].ty)
        var copies: Buf[CArray] = buf()
        val a = self.lp_arg(span, self.ex(args[0]), args[0].ty, &copies)
        val k = self.def(s"arith.minsi ${a.rows}, ${a.cols} : index")
        var call = LaArgs(buf(), buf())
        var outs: Buf[LBuf] = buf()
        var tys: Buf[Ty] = buf()

        call.code(self, la_kind(et))
        call.matrix(self, a)

        if name == "solve" || name == "lstsq"
            val bt = args[1].ty
            val b = self.lp_arg(span, self.ex(args[1]), bt, &copies)
            val rows = if name == "solve" then b.rows else a.cols

            call.matrix(self, b)
            outs.push(self.fresh_buffer(span, et, rows, if rank_of(bt) == 2 then b.cols else ""))
            tys.push(t)
        elif name == "inv" || name == "chol"
            if name == "chol"
                call.vals.push(self.def(s"arith.extui ${self.ex(args[1])} : i1 to i64"))
                call.tys.push("i64")

            outs.push(self.fresh_buffer(span, et, a.rows, a.cols))
            tys.push(t)
        elif name == "det"
            return self.lp_det(span, et, call, copies)
        elif name == "lu"
            outs.push(self.fresh_buffer(span, et, a.rows, k))
            outs.push(self.fresh_buffer(span, et, k, a.cols))
            outs.push(self.fresh_buffer(span, INTEGER, a.rows, ""))
            tys = tuple_elems(t)
        elif name == "qr"
            outs.push(self.fresh_buffer(span, et, a.rows, k))
            outs.push(self.fresh_buffer(span, et, k, a.cols))
            tys = tuple_elems(t)
        elif name == "eigvals" || name == "eig"
            val ct = Complex(bits_of(base_of(et)))

            outs.push(self.fresh_buffer(span, ct, a.rows, ""))
            if name == "eig" then outs.push(self.fresh_buffer(span, ct, a.rows, a.rows))
            if name == "eig" then tys = tuple_elems(t) else tys.push(t)
        elif name == "eigh"
            outs.push(self.fresh_buffer(span, real_part(et), a.rows, ""))
            outs.push(self.fresh_buffer(span, et, a.rows, a.rows))
            tys = tuple_elems(t)
        else
            if name == "svd" then outs.push(self.fresh_buffer(span, et, a.rows, k))
            outs.push(self.fresh_buffer(span, real_part(et), k, ""))
            if name == "svd" then outs.push(self.fresh_buffer(span, et, a.cols, k))
            if name == "svd" then tys = tuple_elems(t) else tys.push(t)

        // `eigvals` and `svdvals` are `eig` and `svd` with the vectors' places null.
        if name == "svdvals" then call.ptr(self.def("llvm.mlir.zero : !llvm.ptr"))

        for o in outs
            call.ptr(o.ptr)

        if name == "eigvals" || name == "svdvals" then call.ptr(self.def("llvm.mlir.zero : !llvm.ptr"))

        self.la_call(s"nex_la_${entry(name)}", call, "")
        self.give_back(copies)

        if outs.len() == 1 then return self.buffer_tensor(span, outs[0], t)

        var vals: Buf[string] = buf()

        for i in 0..<outs.len()
            vals.push(self.buffer_tensor(span, outs[i], tys[i]))

        self.make(self.ty(span, t), vals, tys)

    // `det(A)`, a scalar the runtime writes to a slot.
    private lp_det(*self, span: Span, et: Ty, call: LaArgs, copies: Buf[CArray]) -> string
        val st = self.mem_ty(span, et)
        val slot = self.alloca(st)
        var args = call

        self.op(s"llvm.store ${self.def(s"llvm.mlir.zero : $st")}, $slot : $st, !llvm.ptr")
        args.ptr(slot)
        self.la_call("nex_la_det", args, "")
        self.give_back(copies)
        self.from_mem(self.def(s"llvm.load $slot : !llvm.ptr -> $st"), et)

    // The array value `v` of type `t` as the runtime reads it, its copy, where it was gathered, added
    // to `copies`.
    private lp_arg(*self, span: Span, v: string, t: Ty, copies: *Buf[CArray]) -> BlasArg
        val vt = self.view_ty(t)
        val x = self.blas_arg(span, self.read_buffer(span, self.cast(span, v, t, vt), vt), vt, false)

        copies.push(x.copy)
        x

    // -- the `inout` forms ------------------------------------------------------------------------

    // `name(…)`, an `inout` form: its arrays opened as windows and handed to a wrapper, LAPACK's
    // `info` answered as an `integer`.
    private lapack_inout(*self, span: Span, name: string, args: Buf[TExpr], t: Ty) -> string
        var vals: Buf[string] = buf()
        var tys: Buf[string] = buf()
        var roots: Buf[CRoot] = buf()
        var windows: Buf[CWindow] = buf()

        for a in args
            *a.kind match
                TBorrow(place) ->
                    windows.push(self.open_window(place, false, &roots))
                    vals.push("")
                    tys.push("")
                _ ->
                    vals.push(self.ex(a))
                    tys.push(self.ty(a.span, a.ty))

        self.c_wrapped(span, self.c_wrapper(span, WrapJob.Lapack(name, elem_of(args[0].ty)), vals, tys, "i64", roots, windows), "i64", t, roots)

    // Inside the wrapper of `name`, an `inout` form on elements of `et`: the windows' buffers `wms`
    // of types `wts`, each where it lies or gathered (`copies`), and the scalar arguments `inner`
    // (`""` at each array's place); LAPACK's `info` as an `i64`, from the runtime.
    lapack_in_place(*self, span: Span, name: string, et: Ty, inner: Buf[string], wms: Buf[string], wts: Buf[Ty], copies: *Buf[CArray]) -> string
        var xs: Buf[BlasArg] = buf()

        for k in 0..<wms.len()
            val x = self.blas_arg(span, wms[k], wts[k], true)

            xs.push(x)
            copies.push(x.copy)

        var call = LaArgs(buf(), buf())

        call.code(self, la_kind(et))
        call.matrix(self, xs[0])

        if name == "chol_inplace"
            call.vals.push(self.def(s"arith.extui ${inner[1]} : i1 to i64"))
            call.tys.push("i64")
        else
            call.ptr(xs[1].ptr)
            call.index(self, xs[1].rows)

        if name == "solve_inplace" then call.matrix(self, xs[2])

        self.la_call(s"nex_la_$name", call, "i64")
end Emitter

// The runtime's entry for the value form `name`: `eigvals` is `eig`'s, `svdvals` is `svd`'s.
private entry(name: string) -> string = if name == "eigvals" then "eig" elif name == "svdvals" then "svd" else name
