@tests

// Parallel programs compiled and run (DESIGN §9): the `parallel` programs of `testdata/v2/` print the
// same bytes at every thread count, a body's lines never interleave, a trap nothing catches ends the
// program from inside a region, the OpenMP runtime is linked exactly when a program has a `parallel`
// construct, and a body sharing strings and closures across threads leaks nothing and reads nothing
// freed. The emitter's refusals inside a parallel body are here too.
//
// LLVM is found as the driver finds it; without `mlir-opt` every test skips.

import sysl.buf.{Buf, buf}
import sysl.fs.{exists, read_text}
import sysl.process.{Output, Var, capture}
import sysl.testing.skip
import sysl.text.{from_utf8, join, replace_all, split}

private val V2_PARALLEL_INDEX = from_utf8(embed("../testdata/v2/index.tsv")).unwrap()

// The thread counts every parallel program runs at: one, a power of two and a prime that divides
// no block evenly.
private val THREADS = ["1", "2", "7"]

// The `parallel` programs of `testdata/v2/`.
private parallel_programs() -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(V2_PARALLEL_INDEX, "\n")
        val cols = split(line, "\t")

        if cols.len > 1 && cols[1] == "parallel" then out.push(cols[0])

    out

// `text` compiled into `exe`, for what only its executable is asked.
private build(b: Bench, text: string, exe: string)
    val m = emitted(text) match
        Ok(m) -> m
        Err(e) -> fail_with(e)

    lower_module(m, exe, b.work, b.tc) match
        Ok(_) -> ()
        Err(e) -> fail_with(e)

// `text` run on every engine (`tests_engines.sysl`), the compiled one at each of `threads`: what each
// run wrote and how it ended. The compiled executable is left at `executable(b, case)`.
private outputs(b: Bench, case: string, text: string, threads: []const string = THREADS[..]) -> Buf[Output]
    var out: Buf[Output] = buf()

    for r in runs(b, case, text, threads = threads)
        r.out match
            Ok(o) -> out.push(o)
            Err(e) -> fail_with(s"${r.on}: $e")

    out

@test("every parallel program of testdata/v2 prints its .out, bit for bit, on 1, 2 and 7 threads")
par_run_thread_counts()
    val b = bench()
    val names = parallel_programs()
    val r = check_programs(b, "v2", names.view(), threads = THREADS[..])

    finish(b)
    assert(r.failed.len() == 0 && r.waiting.len() == 0, join(r.failed.view(), "\n"))
    assert_eq(r.passed, 6)
    assert_eq(names.len(), 6)

@test("each print in a parallel body writes its whole line at once, in any order")
par_run_atomic_lines()
    val b = bench()
    val tail = "abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789"

    for out in outputs(b, "lines", "def main() =\n  parallel for i in 1..400\n    print(s\"line ${i} " + tail + " ${i * 3}\")\n    eprint(s\"err ${i} " + tail + "\")\n  print(\"after\")\n", ["7"])
        atomic_lines(out, tail)

    finish(b)

// The output of 400 iterations each printing one line and writing one to standard error, then
// `after`: every line whole and once, in any order.
private atomic_lines(out: Output, tail: string)
    val lines = split(out.text, "\n")
    var seen: Buf[bool] = buf()

    for _ in 0..<401
        seen.push(false)

    var bad: Buf[string] = buf()

    for k in 0..<lines.len - 2
        val parts = split(lines[k], " ")
        val i = if parts.len == 4 then parse_count(parts[1]) else 0

        if parts.len != 4 || parts[0] != "line" || parts[2] != tail || i < 1 || i > 400 || parts[3] != s"${i * 3}" || seen[i] then bad.push(lines[k])
        else seen.set(i, true)

    assert_eq(join(bad.view(), "\n"), "")
    assert_eq(lines.len, 402)
    assert_eq(lines[400], "after")
    assert_eq(split(out.err.unwrap_or(""), "\n").len, 401)

// The decimal count in `s`; 0 where it is not one.
private parse_count(s: string) -> usize
    var n: usize = 0

    for c in s.bytes
        if c < u8('0') || c > u8('9') then return 0
        n = n * 10 + usize(c - u8('0'))

    n

@test("a trap nothing catches in a parallel body writes its message after what was printed, and aborts")
par_run_uncaught_trap()
    val b = bench()

    for out in outputs(b, "trap", "def main() =\n  print(\"before\")\n  var y: [integer] = zeros(100000)\n  parallel for i in 1..100000\n    y[i] = 1000 div (i - 54321)\n  print(\"after\")\n")
        assert(!out.status.ok(), "the trap did not end the program")
        assert_eq(out.text, "before\n")
        assert_eq(out.err.unwrap_or(""), "trap: integer division by zero\n")

    finish(b)

@test("only a program with a parallel construct links the OpenMP runtime, and it says so in its module")
par_run_links_openmp_only_when_parallel()
    val b = bench()
    val seq = s"${b.work}/seq"
    val par = s"${b.work}/par"

    build(b, "def main() =\n  val x: [real] = linspace(0.0, 1.0, 10)\n  print(sum(x))\n", seq)
    build(b, "def main() =\n  val x: [real] = linspace(0.0, 1.0, 10)\n  print(parallel sum(x))\n", par)

    val seq_syms = capture("/usr/bin/nm", ["-u", seq], stderr = true).unwrap().text
    val par_syms = capture("/usr/bin/nm", ["-u", par], stderr = true).unwrap().text
    val seq_libs = capture("/usr/bin/otool", ["-L", seq], stderr = true).unwrap().text
    val par_libs = capture("/usr/bin/otool", ["-L", par], stderr = true).unwrap().text

    finish(b)
    assert(!seq_syms.contains("omp") && !seq_libs.contains("libomp"), seq_syms)
    assert(par_syms.contains("__kmpc_fork_call") && par_libs.contains("libomp"), par_syms)
    assert(pipeline_for("omp.parallel {").contains("convert-openmp-to-llvm,convert-func-to-llvm"))
    assert(!pipeline_for("module {}").contains("openmp"))

@test("threads sharing strings and closures leak nothing and read nothing freed under Guard Malloc")
par_run_no_leaks_or_races()
    if !exists("/usr/bin/leaks") then skip("no leaks tool")

    val b = bench()
    val name = "parallel-strings-and-closures"
    val r = check_programs(b, "leaks", [name], threads = ["7"])
    val exe = executable(b, name)
    val expected = read_text(repo(s"testdata/leaks/$name.out")).unwrap()

    assert(r.failed.len() == 0 && r.passed == 1, join(r.failed.view(), "\n"))

    val guarded = capture(exe, [], env = [Var("OMP_NUM_THREADS", "7"), Var("DYLD_INSERT_LIBRARIES", "/usr/lib/libgmalloc.dylib")], stderr = true).unwrap()
    val leaks = capture("/usr/bin/leaks", ["--atExit", "--", exe], env = [Var("OMP_NUM_THREADS", "7")], stderr = true).unwrap()

    finish(b)
    assert(guarded.status.ok(), s"under Guard Malloc: ${guarded.status}\n${guarded.err.unwrap_or("")}")
    assert_eq(guarded.text, expected)
    assert(leaks.text.contains(": 0 leaks for 0 total leaked bytes."), leaks.text)

// An axpy over arrays of any length, as a loop and as a `parallel for`, the second's body region
// `p.0`; and a call of each that reads `x` past its end.
private val AXPY = "def axpy(a: real, x: [real], y: inout [real]) =\n  for i in 1..length(y) do y[i] = a * x[i] + y[i]\n\ndef paxpy(a: real, x: [real], y: inout [real]) =\n  parallel for i in 1..length(y) do y[i] = a * x[i] + y[i]\n\ndef short_x(par: bool) =\n  val x: [real] = ones(9000)\n  var y: [real] = ones(10001)\n  if par then paxpy(0.5, x, y) else axpy(0.5, x, y)\n\ndef main() =\n  val x: [real] = linspace(0.0, 1.0, 10001)\n  var y: [real] = ones(10001)\n  axpy(0.5, x, y)\n  paxpy(0.5, x, y)\n  print(y[10001])\n  print(y[5000])\n  print(sum(y))\n  assert_traps(() -> short_x(false), \"out of bounds\")\n  assert_traps(() -> short_x(true), \"out of bounds\")\n  print(\"trapped\")\n"

// The text of function `name` in the LLVM IR `ir`, from its `define` to its closing brace.
private function_ir(ir: string, name: string) -> string
    for chunk in split(ir, "\ndefine ")
        if chunk.contains(s"@$name(") || chunk.contains(s"@\"$name\"(") then return split(chunk, "\n}\n")[0]

    ""

@test("a unit-step parallel for over arrays of any length vectorizes, as its sequential twin does")
par_emit_vectorizes()
    val m = emitted(AXPY) match
        Ok(m) -> m
        Err(e) -> fail_with(e)

    val b = bench()
    val ir = optimized_ir(m, b.work, b.tc) match
        Ok(ir) -> ir
        Err(e) -> fail_with(e)

    finish(b)

    // A trap never returns, so a failed bounds check leaves the loop and LLVM hoists the checks out.
    assert(m.contains("func.func private @nex_trap(!llvm.ptr) attributes {llvm.passthrough = [\"noreturn\", \"nounwind\"]}"), m)

    val region = function_ir(ir, "p.0")
    val sequential = function_ir(ir, "n.axpy")

    assert(region.contains(" x double>"), region)
    assert(sequential.contains(" x double>"), sequential)

@test("a vectorized loop, parallel or not, computes what the scalar one did and still traps out of bounds")
par_run_vectorized_bits_and_traps()
    val b = bench()

    for out in outputs(b, "axpy", AXPY)
        assert(out.status.ok(), s"${out.status}\n${out.err.unwrap_or("")}")
        assert_eq(out.text, "2.0\n1.4999000000000002\n15001.499999999998\ntrapped\n")

    finish(b)

@test("traps in parallel bodies, caught many times on seven threads, give back what every abandoned iteration held")
par_traps_leak_nothing()
    if !exists("/usr/bin/leaks") then skip("no leaks tool")

    val b = bench()
    val name = "parallel-traps"
    val r = check_programs(b, "leaks", [name], threads = ["7"])
    val exe = executable(b, name)
    val expected = read_text(repo(s"testdata/leaks/$name.out")).unwrap()
    val guarded = capture(exe, [], env = [Var("OMP_NUM_THREADS", "7"), Var("DYLD_INSERT_LIBRARIES", "/usr/lib/libgmalloc.dylib")], stderr = true).unwrap()
    val leaks = capture("/usr/bin/leaks", ["--atExit", "--", exe], env = [Var("OMP_NUM_THREADS", "7")], stderr = true).unwrap()

    finish(b)
    assert(r.failed.len() == 0 && r.passed == 1, join(r.failed.view(), "\n"))
    assert(guarded.status.ok(), s"under Guard Malloc: ${guarded.status}\n${guarded.err.unwrap_or("")}")
    assert_eq(guarded.text, expected)
    assert(leaks.text.contains(": 0 leaks for 0 total leaked bytes."), leaks.text)

@test("a parallel body writing a module-level array or reducing a counted value is refused by the emitter")
par_emit_refusals()
    assert_eq(emitted("var g: [real] = zeros(4)\ndef main() =\n  parallel for i in 1..4\n    g[i] = 1.0\n").err().unwrap_or(""),
        "error: a parallel body writing a module-level array is not compiled yet @3:3")
    assert_eq(emitted("def join2(a: string, b: string): string = a + b\ndef main() =\n  var s = \"\"\n  parallel for i in 1..4 reduce s: join2\n    s = join2(s, \"x\")\n  print(s)\n").err().unwrap_or(""),
        "error: a reduction over string, which holds a count, is not compiled yet @4:3")
    assert(emitted("var g: [real] = zeros(4)\ndef main() =\n  var h = g\n  parallel for i in 1..4\n    h[i] = g[i] + 1.0\n  print(h)\n").is_ok())
    assert(emitted("def main() =\n  var m = fill((2, 3), 0)\n  parallel for j in 1..3\n    m[1, j] = j\n    val f = () -> m[2, j]\n    print(f())\n").is_ok())

// A lambda made in a parallel body that captures the array the body writes: it captures the
// array's cell, so it reads what its iteration has written (DESIGN §9.5), and with a string
// captured too its counts change on several threads at once.
private val LAMBDA_IN_PARALLEL = "def main() =\n  var m = fill((3, 400), 0)\n  parallel for j in 1..400\n    m[1, j] = j\n    m[3, j] = 2 * j\n    val f = () -> m[1, j] + m[2, j] + m[3, j]\n    m[2, j] = f()\n  print(sum(m))\n  print(m[2, 7])\n  var w: [real] = zeros(1000)\n  val s = \"x\"\n  parallel for i in 1..1000\n    w[i] = real(i) / 4.0\n    val g = (k: integer) -> w[i] * real(k) + (if s + \"y\" == \"xy\" then 1.0 else 0.0)\n    w[i] = g(3)\n  print(sum(w))\n  print(w[999])\n"

@test("a lambda in a parallel body reads what its iteration wrote to the array it captures, as the sequential loop does, leaking nothing")
par_lambda_captures_written_array()
    val b = bench()
    val expected = "481200\n21\n376375.0\n750.25\n"
    val outs = outputs(b, "lambda", LAMBDA_IN_PARALLEL)
    val exe = executable(b, "lambda")
    val sequential = outputs(b, "lambda-seq", replace_all(LAMBDA_IN_PARALLEL, "parallel ", ""), ["1"])[0].text
    val guarded = capture(exe, [], env = [Var("OMP_NUM_THREADS", "7"), Var("DYLD_INSERT_LIBRARIES", "/usr/lib/libgmalloc.dylib")], stderr = true).unwrap()
    val leaks = if exists("/usr/bin/leaks") then capture("/usr/bin/leaks", ["--atExit", "--", exe], env = [Var("OMP_NUM_THREADS", "7")], stderr = true).unwrap().text
                else ": 0 leaks for 0 total leaked bytes."

    finish(b)
    assert_eq(sequential, expected)

    for o in outs
        assert_eq(o.text, expected)

    assert(guarded.status.ok(), s"under Guard Malloc: ${guarded.status}\n${guarded.err.unwrap_or("")}")
    assert_eq(guarded.text, expected)
    assert(leaks.contains(": 0 leaks for 0 total leaked bytes."), leaks)

@test("a lambda in a parallel body may not read another iteration's element of the array the body writes")
par_lambda_reads_only_own_element()
    assert_eq(emitted("def main() =\n  var m = fill((3, 400), 0)\n  parallel for j in 1..400\n    m[1, j] = j\n    val f = () -> m[1, 1]\n    print(f())\n").err().unwrap_or(""),
        "error: `m` is written by every iteration at its own element, so the body reads it only there, not at another iteration's @5:19")

// Element-wise expressions and reductions under `parallel`, fused: the in-place assignment through an
// `inout` parameter and of a local inside a loop, one whose old value a `val` still holds, a
// reduction of a fused product at ranks 1 and 2, complex `dot`, integers, a widening, and the shape
// check across a fused operand.
private val FUSED = "def axpy(a: real, x: [real], y: inout [real]) =\n  y = parallel a * x + y\n\ndef main() =\n  val n = 100003\n  val x: [real] = linspace(0.0, 1.0, n)\n  var y: [real] = linspace(2.0, -1.0, n)\n  for s in 1..3\n    y = parallel 0.5 * x + y\n  axpy(0.25, x, y)\n  print(y[n])\n  print(sum(y))\n  val keep = y\n  y = parallel exp(-y * y) + y / 3.0\n  print(keep[2])\n  print(y[2])\n  print(parallel sum(x * y))\n  print(parallel dot(x, y))\n  print(parallel minval(x - 2.0 * y))\n  print(parallel maxval(abs(x - y)))\n  val a: [real; :, :] = reshape(linspace(1.0, 12.0, 12), (3, 4))\n  print(parallel sum(2.0 * a * a))\n  var b = a\n  b = parallel sqrt(b) * 2.0 + b\n  print(b)\n  val k: [integer] = [5, -2, 9, 4]\n  print(parallel sum(k * k + 1))\n  print(parallel product(k - 1))\n  val c: [complex] = [complex(1.0, 2.0), complex(-0.5, 3.0)]\n  print(parallel dot(c, c * 2.0))\n  val i32s: [int32] = [1, 2, 3]\n  print(parallel sum(real(i32s) * 0.5))\n  val short: [real] = zeros(5)\n  assert_traps(() -> print(parallel sum(x * short)), \"shape mismatch\")\n  print(\"trapped\")\n"

@test("fused parallel element-wise expressions and reductions print the sequential program's bits on 1, 2 and 7 threads")
par_fused_bits()
    val b = bench()
    val sequential = outputs(b, "fused-seq", replace_all(FUSED, "parallel ", ""), ["1"])[0].text
    val outs = outputs(b, "fused", FUSED)
    val exe = executable(b, "fused")
    val leaks = if exists("/usr/bin/leaks") then capture("/usr/bin/leaks", ["--atExit", "--", exe], env = [Var("OMP_NUM_THREADS", "7")], stderr = true).unwrap().text
                else ": 0 leaks for 0 total leaked bytes."

    finish(b)
    assert_eq(split(sequential, "\n")[0], "0.75")
    assert(sequential.ends_with("28.5+0.0i\n3.0\ntrapped\n"), sequential)

    for o in outs
        assert_eq(o.text, sequential)

    assert(leaks.contains(": 0 leaks for 0 total leaked bytes."), leaks)

// `y = parallel a * x + y` on an `inout` array, and a `dot` and a `sum` of a product.
private val FUSED_SHAPES = "def axpy(a: real, x: [real], y: inout [real]) =\n  y = parallel a * x + y\n\ndef dots(x: [real], y: [real]): real = (parallel dot(x, y)) + (parallel sum(x * y))\n\ndef main() =\n  val x: [real] = linspace(0.0, 1.0, 10001)\n  var y: [real] = ones(10001)\n  axpy(0.5, x, y)\n  print(dots(x, y))\n"

@test("a parallel element-wise expression is one region writing its destination in place, and a reduction never builds its operand")
par_fused_one_region_no_temporary()
    val m = emitted(FUSED_SHAPES).unwrap()
    val b = bench()
    val buffers = lowered_until(b, m, "buffer-deallocation-pipeline")

    finish(b)
    // One region per construct: the axpy, the dot and the sum.
    assert_eq(occurrences(m, "omp.parallel {"), 3)
    assert_eq(occurrences(m, "func.func private @\"p."), 3)
    // `x` and `y` of `main`, and nothing else: no product, no result of the axpy, no copy of `y`.
    assert_eq(occurrences(buffers, "memref.alloc"), 2)
    assert_eq(occurrences(buffers, "memref.copy"), 0)
    assert_eq(occurrences(buffers, "bufferization.clone"), 0)

// The program of `testdata/v2/064-…` in small: windows of an array `main` allocates, passed `inout`
// in a parallel body and through a local `def` and a function value.
private val WINDOWS_IN_PARALLEL = "def bump(v: inout [integer], by: integer) =\n  for k in 1..length(v)\n    v[k] += by\n\ndef main() =\n  var m = fill((3, 4), 0)\n  def twice(v: inout [integer]) =\n    bump(v, 1)\n    bump(v, 1)\n  parallel for j in 1..4\n    bump(m[:, j], j)\n    bump(m[.. by -2, j], 10)\n  parallel for i in 1..3\n    twice(m[i, 2..])\n  val f = bump\n  f(m[2, 1..4 by 3], 100)\n  twice(m[:, 1])\n  print(m)\n"

@test("a window passed inout in a parallel body, to a local def or through a function value is written in place, the same on every thread count")
par_windows_in_place()
    val b = bench()
    val buffers = lowered_until(b, emitted(WINDOWS_IN_PARALLEL).unwrap(), "buffer-deallocation-pipeline")
    val outs = outputs(b, "windows", WINDOWS_IN_PARALLEL)

    finish(b)

    for o in outs
        assert_eq(o.text, "[[13, 14, 15, 16], [103, 4, 5, 106], [13, 14, 15, 16]]\n")

    // The one array of `main`, and nothing else.
    assert_eq(occurrences(buffers, "memref.alloc"), 1)
    assert_eq(occurrences(buffers, "memref.copy"), 0)
    assert_eq(occurrences(buffers, "bufferization.clone"), 0)

// An array a lambda captures lives in a cell, as a counted object; a parallel body writes that
// object's buffer in place once nothing else holds it.
private val CAPTURED_IN_PARALLEL = "def bump(v: inout [integer], by: integer) =\n  for k in 1..length(v)\n    v[k] += by\n\ndef main() =\n  var m = fill((3, 4), 1)\n  def show() = print(m)\n  parallel for j in 1..4\n    bump(m[:, j], j)\n  show()\n"

@test("a captured array written by a parallel body is written in place, copied only while a val shares it")
par_captured_in_place()
    val b = bench()
    val buffers = lowered_until(b, emitted(CAPTURED_IN_PARALLEL).unwrap(), "buffer-deallocation-pipeline")
    val outs = outputs(b, "captured", CAPTURED_IN_PARALLEL)

    finish(b)

    for o in outs
        assert_eq(o.text, "[[2, 3, 4, 5], [2, 3, 4, 5], [2, 3, 4, 5]]\n")

    // The fill copied into the cell's object when `m` is bound, and the copy made only where
    // something else still holds that object, which nothing does here; none for the region.
    assert_eq(occurrences(buffers, "memref.copy"), 2)
    assert_eq(occurrences(buffers, "memref.alloc"), 1)
