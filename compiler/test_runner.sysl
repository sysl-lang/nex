// `nex test` (DESIGN §11.2): every `@test def` of the project built into one program, which is run
// once per test.
//
// **A test is run in a process of its own**, the program given the test's number: each test starts
// from the module-level bindings' initial values, and a trap ends only the test that trapped, which
// is reported and the next run. A test passes when its process ends with status 0. Under `--np N`
// each test is an N-rank MPI job, run by the launcher the driver finds. What a passing
// test prints is not shown; a failing one is reported by its trap's message. Interpreted, each test is
// a run of its own the same way, with nothing built.

import nex.sh.sysl.nex.*
import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, remove_dir_all}
import sysl.process.{Output, Status, capture}
import sysl.text.split

// What a run of the tests found: one line per failure and the summary line, and how many failed.
struct TestRun
    lines: Buf[string]
    passed: int
    failed: int

// The tests of the project whose root module is `file` whose names contain `filter`, built and run;
// or why they could not be built.
run_tests(file: string, prelude: Option[string], filter: string, tc: Toolchain, fpe_trap: bool, np: int = 0) -> Result[TestRun, string]
    val l = load(file, LoadOptions(prelude, true))?
    val t = l.program

    val mlir = emit_program(t, fpe_trap) match
        Ok(m) -> m
        Err(ds) -> return Err(l.project.render(ds))

    val work = make_temp_dir("nex-test").map_err((e) -> s"nex: cannot make a temporary directory: $e")?
    val exe = s"$work/tests"

    lower_module(mlir, exe, work, tc) match
        Ok(_) -> ()
        Err(m) ->
            _ = remove_dir_all(work)
            return Err(m)

    // Under `--np`, each test's process is the launcher's argument.
    var line: Buf[string] = buf()

    if np > 0
        line = mpi_launcher(np) match
            Ok(l) -> l
            Err(m) ->
                _ = remove_dir_all(work)
                return Err(m)

    line.push(exe)

    val r = tally(t, filter, (k) -> capture(line[0], with_test(line.view()[1..], k).view(), stderr = true) match
        Ok(out) -> if out.status.ok() then None else Some(failure(out))
        Err(e) -> Some(s"the test program could not be run: $e")
    )

    _ = remove_dir_all(work)
    Ok(r)

// The same tests interpreted (`interp.sysl` of the library), each from the module-level bindings'
// initial values; or why they cannot be.
run_tests_interpreted(file: string, prelude: Option[string], filter: string, fpe_trap: bool) -> Result[TestRun, string]
    val l = load(file, LoadOptions(prelude, true))?
    val t = l.program
    val refused = interpretable(t)

    if refused.len() > 0 then return Err(l.project.render(refused))

    Ok(tally(t, filter, (k) -> interpret(t, [], (s, text) -> (), fpe_trap, Some(k)) match
        Ok(Exit(0)) -> None
        Ok(Exit(code)) -> Some(s"stopped with status $code")
        Ok(Trap(message)) -> Some(message)
        Err(ds) -> Some(l.project.render(ds))
    ))

// Each test whose name holds `filter` run by `one`, which answers why it failed or `None`: a line per
// failure and the summary.
private tally(t: TProgram, filter: string, one: &Fn(usize) -> Option[string]) -> TestRun
    var r = TestRun(buf(), 0, 0)
    var skipped = 0

    for k in 0..<t.tests.len()
        val name = t.tests[k]

        if !name.contains(filter)
            skipped += 1
            continue

        one(k) match
            None -> r.passed += 1
            Some(why) ->
                r.failed += 1
                r.lines.push(s"FAIL ${name}: $why")

    var summary = s"${r.passed} passed, ${r.failed} failed"

    if skipped > 0 then summary += s", ${skipped} filtered out"

    r.lines.push(summary)
    r

// The arguments that run test `k`: `args`, then its number.
private with_test(args: []const string, k: usize) -> Buf[string]
    var out: Buf[string] = buf()

    for a in args
        out.push(a)

    out.push(s"$k")
    out

// Why a test's process did not end with status 0: its trap's message, the rank in front where an
// MPI job's rank trapped, or how it ended.
private failure(out: Output) -> string
    for line in split(out.err.unwrap_or(""), "\n")
        if line.starts_with("trap: ") then return line[6..]

        if line.starts_with("rank ") && line.contains(": trap: ")
            val at = line.index_of(": trap: ").unwrap()

            return line[0..<at + 2] + line[at + 8..]

    out.status match
        Exited(code) -> s"stopped with status $code"
        Signalled(sig) -> s"ended by signal $sig"
        other -> s"$other"
