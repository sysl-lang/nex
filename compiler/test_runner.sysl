// `nex test` (DESIGN §11.2): every `@test def` of the project built into one program, which is run
// once per test.
//
// **A test is run in a process of its own**, the program given the test's number: each test starts
// from the module-level bindings' initial values, and a trap ends only the test that trapped, which
// is reported and the next run. A test passes when its process ends with status 0. What a passing
// test prints is not shown; a failing one is reported by its trap's message.

import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, remove_dir_all}
import sysl.process.{Output, Status, capture}
import sysl.text.split

// What a run of the tests found: one line per failure and the summary line, and how many failed.
struct TestRun
    lines: Buf[string]
    passed: int
    failed: int

// The tests of the project whose root module is `file` whose names contain `filter`, built and run;
// or why they could not be built.
run_tests(file: string, prelude: Option[string], filter: string, tc: Toolchain, fpe_trap: bool) -> Result[TestRun, string]
    val project = load_project(file, LoadOptions(prelude, true))?
    val t = elaborate_project(project)?

    val mlir = emit_program(t, fpe_trap) match
        Ok(m) -> m
        Err(ds) -> return Err(project.render(ds))

    val work = make_temp_dir("nex-test").map_err((e) -> s"nex: cannot make a temporary directory: $e")?
    val exe = s"$work/tests"

    lower_module(mlir, exe, work, tc) match
        Ok(_) -> ()
        Err(m) ->
            _ = remove_dir_all(work)
            return Err(m)

    var r = TestRun(buf(), 0, 0)
    var skipped = 0

    for k in 0..<t.tests.len()
        val name = t.tests[k]

        if !name.contains(filter)
            skipped += 1
            continue

        capture(exe, [s"$k"], stderr = true) match
            Ok(out) ->
                if out.status.ok()
                    r.passed += 1
                else
                    r.failed += 1
                    r.lines.push(s"FAIL ${name}: ${failure(out)}")
            Err(e) ->
                r.failed += 1
                r.lines.push(s"FAIL ${name}: the test program could not be run: $e")

    _ = remove_dir_all(work)

    var summary = s"${r.passed} passed, ${r.failed} failed"

    if skipped > 0 then summary += s", ${skipped} filtered out"

    r.lines.push(summary)
    Ok(r)

// Why a test's process did not end with status 0: its trap's message, or how it ended.
private failure(out: Output) -> string
    for line in split(out.err.unwrap_or(""), "\n")
        if line.starts_with("trap: ") then return line[6..]

    out.status match
        Exited(code) -> s"stopped with status $code"
        Signalled(sig) -> s"ended by signal $sig"
        other -> s"$other"
