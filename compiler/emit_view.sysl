// Emission of what DESIGN §5 and §6 add to arrays: slices of slices as places, `origin` views and
// `reverse` along an axis known only at run time.
//
// **A slice of a place is a place** (DESIGN §5.3). Writing `a[2..4][1] = 99` opens each slice from
// the root outward — an `extract_slice` of what the place holds now, remembered as an `Opened` — makes
// the write on the innermost, and closes them again from the inside out, each an `insert_slice` into
// the value it was taken from, the root rebound to the result. One-shot bufferization turns the
// pairs into subviews of the root's buffer, so the write is in place. An `inout` argument that is a
// slice is opened and closed the same way around the call.
//
// **An `origin` view is its source's elements and, per axis, a shift**: the first index less one,
// an `i64` value of the function that took it. Indexing subtracts it from every explicit index and
// bound before the usual check, and `end` adds it back; read as a value the view is its source, so
// nothing about it is allocated or copied (DESIGN §6.4).

import nex.sh.sysl.nex.*
import nex_runtime.sh.sysl.nex_runtime.{NOT_AN_AXIS, SHAPE_MISMATCH}
import sysl.buf.{Buf, buf}
import sh.sysl.parsing.Span

// One slice opened along a place: the place `src` it was taken from and the value `cur` that held,
// the slice place `slot` itself, its window on `src` by axis, nex order, and the value it reads.
struct Opened
    src: TExpr
    slot: TExpr
    cur: string
    subs: Buf[TSub]
    offs: Buf[string]
    sizes: Buf[string]
    strides: Buf[string]
    view: string

// The place a place lent to a call is a slice or an element of, through every index: `a` of
// `a[2..][k]`, `s.v` of `s.v[k]`; the place itself where it is neither.
lent_root_of(e: TExpr) -> TExpr = *e.kind match
    TArray(op) -> *op match
        TIndex(src, _) -> if is_arr(src.ty) && !is_items(src.ty) then lent_root_of(src) else e
        _ -> e
    _ -> e

// `xs` last first.
backwards(xs: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()
    var k = xs.len()

    while k > 0
        k -= 1
        out.push(xs[k])

    out

// The root of a place lent to a call. A root held in storage — a captured local's cell, a
// module-level `var`, a field — is made the only holder of its array before the call and lent as
// that array's own buffer, so the callee's writes land in it as they are made and a trap that ends
// the call leaves them there (DESIGN §8.4): `m` is the buffer as a memref, `h` the object holding
// it and `ptr` the place's address. A root in SSA form has `m` empty; its function's frame is
// gone once a trap has left it, so nothing can see what a trap would lose.
struct LentRoot
    m: string
    h: string
    ptr: string

// An array local a `parallel for`'s code writes in place, and the descriptor of its buffer.
struct ParBuf
    id: usize
    d: string

// An `inout` array argument: its place, the slices opened to reach it and its root.
struct Held
    place: TExpr
    frames: Buf[Opened]
    root: LentRoot

// An element of an array of numbers lent to a call as an `inout` scalar: the array place `src` it
// is taken from, the slices opened on the way to `src`, its index list and checked indices (tensor
// order), and the slot holding its value while the call runs (DESIGN §8.2).
struct ElementLent
    src: TExpr
    frames: Buf[Opened]
    subs: Buf[TSub]
    idx: Buf[string]
    slot: string
    t: Ty

// A local bound to an `origin` view, and its shifts by axis.
struct OriginLocal
    id: usize
    shifts: Buf[string]

impl Emitter
    // An integer expression's value as an `i64`.
    index64(*self, x: TExpr) -> string = self.widen64(self.ex(x), bits_of(x.ty), is_signed(x.ty))

    // Index `w` on axis `k` (from 0) of a view with `shifts`, counted from 1 again.
    shifted(*self, w: string, shifts: Buf[string], k: usize) -> string =
        if k < shifts.len() then self.def(s"arith.subi $w, ${shifts[k]} : i64") else w

    // A 1-based index `w` on axis `k` as the view with `shifts` counts it.
    unshifted(*self, w: string, shifts: Buf[string], k: usize) -> string =
        if k < shifts.len() then self.def(s"arith.addi $w, ${shifts[k]} : i64") else w

    // An index list on `tv` (array type `t`, `origin` shifts `shifts`) begins: `end` reads it.
    open_ends(*self, tv: string, t: Ty, shifts: Buf[string])
        self.ends.push(tv)
        self.end_tys.push(t)
        self.end_shifts.push(shifts)

    close_ends(*self)
        self.ends.pop()
        self.end_tys.pop()
        self.end_shifts.pop()

    // -- `origin` ---------------------------------------------------------------------------------

    // The shifts of the array `e`, just emitted: an `origin` node's or an `origin` local's; none for
    // any other array.
    shifts_of(*self, e: TExpr) -> Buf[string]
        *e.kind match
            TLocal(id) ->
                if self.shift_words(id) > 0 && self.boxed[id] then return self.cell_shifts(id)

                var k = self.origins.len()

                while k > 0
                    k -= 1
                    if self.origins[k].id == id then return self.origins[k].shifts
            TArray(op) -> *op match
                TOrigin(_, _) -> return self.last_shifts
                _ -> ()
            _ -> ()

        buf()

    // `origin(a, f1, ..., fk)`: the source's elements; the shifts are kept for the index lists.
    origin(*self, source: TExpr, firsts: Buf[TExpr]) -> string
        val v = self.ex(source)
        var shifts: Buf[string] = buf()

        for f in firsts
            shifts.push(self.def(s"arith.subi ${self.index64(f)}, %one : i64"))

        self.last_shifts = shifts
        v

    // Local `id` has just been bound to `init`: an `origin` local keeps its shifts. One a lambda
    // captures keeps them in its cell after the array, where the lambda reads them too.
    note_origin(*self, span: Span, id: usize, init: TExpr)
        if self.shift_words(id) == 0 then return

        val shifts = self.shifts_of(init)

        if !self.boxed[id]
            self.origins.push(OriginLocal(id, shifts))
            return

        // An axis given no first index starts at 1: a shift of 0.
        for k in 0..<self.shift_words(id)
            val s = if k < shifts.len() then shifts[k] else self.def("arith.constant 0 : i64")

            self.op(s"llvm.store $s, ${self.shift_ptr(id, k)} : i64, !llvm.ptr")

    // The words after the array in local `id`'s cell that hold its shifts: one per axis of an
    // `origin` local, none for any other.
    shift_words(*self, id: usize) -> usize = self.prog.locals[id].kind match
        LOrigin -> rank_of(self.prog.locals[id].ty)
        _ -> 0

    // The address of the shift of axis `k` (from 0) in captured `origin` local `id`'s cell.
    shift_ptr(*self, id: usize, k: usize) -> string =
        self.def(s"llvm.getelementptr ${self.local_ptr(Span(0, 0), id)}[${self.words(self.prog.locals[id].ty) + k}] : (!llvm.ptr) -> !llvm.ptr, i64")

    // A captured `origin` local's shifts, read from its cell.
    cell_shifts(*self, id: usize) -> Buf[string]
        var out: Buf[string] = buf()

        for k in 0..<self.shift_words(id)
            out.push(self.def(s"llvm.load ${self.shift_ptr(id, k)} : !llvm.ptr -> i64"))

        out

    // -- slices of places -------------------------------------------------------------------------

    // The value `v` a `var` array local `id` starts from. An array literal folds to a constant, and
    // a constant's storage cannot be written: the first write through a window of one, an `inout`
    // argument above all, would copy the window and then the whole constant. Copied into a buffer of
    // the variable's own here, every later write is in place.
    var_start(*self, span: Span, id: usize, init: TExpr, v: string) -> string
        self.prog.locals[id].kind match
            LVar -> ()
            _ -> return v

        *init.kind match
            TArray(op) -> *op match
                TArrayLit(_) -> ()
                _ -> return v
            _ -> return v

        // `alloc_tensor`, not `linalg.copy`: canonicalization erases a copy into a fresh tensor.
        self.def(s"bufferization.alloc_tensor() copy($v) : ${self.tensor_ty(span, init.ty)}")

    // The array the place `e` holds now; each slice opened on the way to it pushed onto `frames`.
    open_place(*self, e: TExpr, frames: *Buf[Opened]) -> string
        *e.kind match
            TArray(op) -> *op match
                TIndex(src, subs) ->
                    val cur = self.open_place(src, frames)
                    val (offs, sizes, strides) = self.window(e.span, cur, src.ty, subs, buf())
                    val v = self.sliced(e.span, cur, src.ty, self.slice_text(subs, offs, sizes, strides), e.ty)

                    frames.push(Opened(src, e, cur, subs, offs, sizes, strides, v))
                    return v
                _ -> ()
            _ -> ()

        self.place_value(e)

    // Every root held in storage that one of `args` lends the call made the only holder of its
    // array, before any is opened: a pin taken by the statement — the loop over the array the call
    // is in, a read of it earlier in the expression — counts as a holder, since what it reads must
    // not change, but the pins the call's own arguments take do not.
    lend_roots(*self, args: Buf[TExpr])
        for a in args
            *a.kind match
                TBorrow(place) ->
                    val root = lent_root_of(place)

                    if is_arr(root.ty) && !is_items(root.ty) && !self.in_ssa_place(root) then self.sole_holder(root.span, self.place_ptr(root), root.ty)
                _ -> ()

    // Whether the array place `e` is a local held in SSA form.
    in_ssa_place(*self, e: TExpr) -> bool = *e.kind match
        TLocal(id) -> self.in_ssa(id)
        _ -> false

    // `open_place` for a place lent to a call, whose root `root` describes; `lend_roots` has made a
    // root held in storage the only holder of its array.
    open_lent(*self, e: TExpr, frames: *Buf[Opened], root: *LentRoot) -> string
        *e.kind match
            TArray(op) -> *op match
                TIndex(src, subs) ->
                    val cur = self.open_lent(src, frames, root)
                    val (offs, sizes, strides) = self.window(e.span, cur, src.ty, subs, buf())
                    val v = self.sliced(e.span, cur, src.ty, self.slice_text(subs, offs, sizes, strides), e.ty)

                    frames.push(Opened(src, e, cur, subs, offs, sizes, strides, v))
                    return v
                _ -> ()
            TLocal(id) -> if self.in_ssa(id) then return self.read_array(e.span, id)
            _ -> ()

        val ptr = self.place_ptr(e)
        val h = self.def(s"llvm.load $ptr : !llvm.ptr -> !llvm.ptr")

        self.pin(h, e.ty, 1)
        self.hold_temp(h, e.ty)

        val d = self.desc_ty(rank_of(e.ty))
        val m = self.def(s"builtin.unrealized_conversion_cast ${self.def(s"llvm.load $h : !llvm.ptr -> $d")} : $d to ${self.memref_ty(e.span, e.ty)}")

        *root = LentRoot(m, h, ptr)
        self.def(s"bufferization.to_tensor $m restrict writable : ${self.memref_ty(e.span, e.ty)} to ${self.tensor_ty(e.span, e.ty)}")

    // The array stored at `ptr` copied into a new object of its own unless the place is its only
    // holder and nothing pins it, so that writing its buffer changes nothing else.
    sole_holder(*self, span: Span, ptr: string, t: Ty)
        if self.dirty
            self.op(s"scf.if ${self.flowing()} {")
            self.dirty = false
            self.sole_holder(span, ptr, t)
            self.dirty = true
            self.op("}")
            return

        self.external("nex_count", "!llvm.ptr", "i64")

        val h = self.def(s"llvm.load $ptr : !llvm.ptr -> !llvm.ptr")
        val n = self.def(s"func.call @nex_count($h) : (!llvm.ptr) -> i64")

        self.op(s"scf.if ${self.def(s"arith.cmpi ne, $n, %one : i64")} {")

        val d = self.desc_ty(rank_of(t))
        val m = self.def(s"builtin.unrealized_conversion_cast ${self.def(s"llvm.load $h : !llvm.ptr -> $d")} : $d to ${self.memref_ty(span, t)}")
        val v = self.def(s"bufferization.to_tensor $m restrict : ${self.memref_ty(span, t)} to ${self.tensor_ty(span, t)}")

        self.op(s"llvm.store ${self.boxed_array(span, v, t)}, $ptr : !llvm.ptr, !llvm.ptr")
        self.release_ref(h)
        self.op("}")

    // The array `v` an `inout` call handed back for the whole place `e` lent from storage as `root`:
    // written into the lent buffer, which is where the callee wrote it unless it rebound the
    // parameter, or stored as a new object where it has another shape.
    whole_back(*self, span: Span, e: TExpr, v: string, root: LentRoot)
        val held = self.def(s"bufferization.to_tensor ${root.m} restrict : ${self.memref_ty(span, e.ty)} to ${self.tensor_ty(span, e.ty)}")
        var same = self.def("arith.constant true")

        for a in 1..rank_of(e.ty)
            same = self.def(s"arith.andi $same, ${self.def(s"arith.cmpi eq, ${self.dim(span, v, e.ty, a)}, ${self.dim(span, held, e.ty, a)} : index")} : i1")

        self.op(s"scf.if $same {")
        self.op(s"bufferization.materialize_in_destination $v in restrict writable ${root.m} : (${self.tensor_ty(span, e.ty)}, ${self.memref_ty(span, e.ty)}) -> ()")
        self.op("} else {")
        self.store_array(span, root.ptr, v, e.ty)
        self.op("}")

    // The `inout` array parameter whose argument the place `e` is, in SSA form: its local.
    inout_param(*self, e: TExpr) -> Option[usize] = *e.kind match
        TLocal(id) ->
            if !self.in_ssa(id) || self.par_kernel then return None

            self.prog.locals[id].kind match
                LParam(m) -> if m == Inout then Some(id) else None
                _ -> None
        _ -> None

    // `inout` array parameter `id` given the array `x` of its type `t`: written over the elements
    // its argument's buffer holds, where the caller sees them as they are made, so that a trap
    // later in the callee leaves them in place (DESIGN §8.4). Only a value of another shape, which
    // the buffer cannot take, rebinds the parameter; `same_shape` where `x` is known to fit.
    param_assign(*self, span: Span, id: usize, x: string, t: Ty, same_shape: bool)
        val cur = self.read_array(span, id)

        if same_shape
            self.arr.set(id, self.written_over(span, cur, x, t))
            return

        val tt = self.tensor_ty(span, t)
        var same = self.def("arith.constant true")

        for a in 1..rank_of(t)
            same = self.def(s"arith.andi $same, ${self.def(s"arith.cmpi eq, ${self.dim(span, x, t, a)}, ${self.dim(span, cur, t, a)} : index")} : i1")

        val r = self.fresh()

        self.op(s"$r = scf.if $same -> ($tt) {")
        self.op(s"scf.yield ${self.written_over(span, cur, x, t)} : $tt")
        self.op("} else {")
        self.op(s"scf.yield ${self.copied(span, x, t)} : $tt")
        self.op("}")
        self.arr.set(id, r)

    // The elements of `x` copied over those of `cur`, both arrays of type `t` and one shape. The value
    // is computed whole first, so a trap while computing it leaves `cur` as it was.
    written_over(*self, span: Span, cur: string, x: string, t: Ty) -> string =
        self.def(s"bufferization.materialize_in_destination $x in $cur : (${self.tensor_ty(span, t)}, ${self.tensor_ty(span, t)}) -> ${self.tensor_ty(span, t)}")

    // The place `e`, opened through `frames`, rebound to the array `v`. A value `handed_back` by an
    // `inout` call may have any shape: a whole place takes it, and a slice traps unless it kept the
    // shape. A place lent from storage as `root` is written into its lent buffer.
    close_place(*self, span: Span, e: TExpr, v: string, frames: Buf[Opened], handed_back: bool, root: LentRoot = LentRoot("", "", ""))
        if frames.len() == 0
            if root.m != "" then self.whole_back(span, e, v, root) else self.set_place(e, v, !handed_back)
            return

        val f = frames[frames.len() - 1]
        val st = self.view_ty(f.slot.ty)
        var subs: Buf[TSub] = buf()
        var offs: Buf[string] = buf()
        var sizes: Buf[string] = buf()
        var strides: Buf[string] = buf()

        for a in 1..rank_of(f.slot.ty)
            val n = self.dim(span, f.view, f.slot.ty, a)

            if handed_back then self.trap_if(self.def(s"arith.cmpi ne, ${self.dim(span, v, f.slot.ty, a)}, $n : index"), SHAPE_MISMATCH)

            subs.push(TSubAll)
            offs.push(self.index_const(0))
            sizes.push(n)
            strides.push(self.index_const(1))

        self.insert_through(span, frames, subs, offs, sizes, strides, self.cast(span, v, f.slot.ty, st), self.tensor_ty(span, st), root.m)

    // `x` written into the window `subs` (offsets, extents and strides by axis, nex order) of the
    // slice place `frames` opened, as one `insert` or `insert_slice` into the root place's array: the
    // windows compose, so the write is the root's own and bufferizes in place. `xt` is the type of
    // `x`, `""` for an element. A root lent from storage as the buffer `into` is written there.
    insert_through(*self, span: Span, frames: Buf[Opened], subs: Buf[TSub], offs: Buf[string], sizes: Buf[string], strides: Buf[string], x: string, xt: string,
                   into: string = "")
        val (s, o, z, t) = self.composed(frames, frames.len(), subs, offs, sizes, strides)
        val root = frames[0]
        val tt = self.tensor_ty(span, root.src.ty)
        val v = if xt == "" then self.def(s"tensor.insert $x into ${root.cur}[${joined(backwards(o))}] : $tt")
                else self.def(s"tensor.insert_slice $x into ${root.cur}${self.slice_text(s, o, z, t)} : $xt into $tt")

        if into == ""
            self.set_place(root.src, v, true)
        else
            self.op(s"bufferization.materialize_in_destination $v in restrict writable $into : ($tt, ${self.memref_ty(span, root.src.ty)}) -> ()")

    // -- elements lent to a call ------------------------------------------------------------------

    // The address an `inout` scalar argument `place` crosses at. A place with storage of its own is
    // its address; an element of an array of numbers (`a[i]`, `m[i, j]`, `a[2..][k]`, `s.v[k]`) is a
    // value in a tensor, so its indices are evaluated and checked once, here, before the call. An
    // element of an array held in storage crosses as its address in the array's buffer, as does one
    // of an array a `parallel for`'s code writes in place, so that what the callee writes before a
    // trap stays written (DESIGN §8.4). Any other element's value is copied to a slot whose address
    // crosses. Either way but the first, `elements` gains it: `element_back` writes what the address
    // holds into the element once the call has returned.
    lent_ptr(*self, place: TExpr, elements: *Buf[ElementLent]) -> string
        *place.kind match
            TArray(op) -> *op match
                TIndex(src, subs) ->
                    if is_arr(src.ty) && !is_items(src.ty) && !is_arr(place.ty)
                        var frames: Buf[Opened] = buf()
                        var root = LentRoot("", "", "")
                        val cur = self.open_lent(src, &frames, &root)
                        val idx = self.indices(place.span, cur, src.ty, subs, self.shifts_of(src))
                        val top = if frames.len() > 0 then frames[0].src else src

                        if root.m != "" then return self.element_address(place.span, frames, subs, idx, self.def(s"llvm.load ${root.h} : !llvm.ptr -> ${self.desc_ty(rank_of(top.ty))}"), top.ty, place.ty)

                        val written = self.par_buffer(top)

                        if written != ""
                            val at = self.element_address(place.span, frames, subs, idx, written, top.ty, place.ty)

                            elements.push(ElementLent(src, frames, subs, idx, at, place.ty))
                            return at

                        val slot = self.alloca(self.mem_ty(place.span, place.ty))

                        self.store(place.span, slot, self.def(s"tensor.extract $cur[${joined(idx)}] : ${self.tensor_ty(place.span, src.ty)}"), place.ty)
                        elements.push(ElementLent(src, frames, subs, idx, slot, place.ty))
                        return slot
                _ -> ()
            _ -> ()

        self.place_ptr(place)

    // The descriptor of the buffer a `parallel for`'s code writes the array local `e` in, `""` where
    // `e` is no such local.
    par_buffer(*self, e: TExpr) -> string
        *e.kind match
            TLocal(id) ->
                for b in self.par_bufs
                    if b.id == id then return b.d
            _ -> ()

        ""

    // The address of the element at the checked indices `idx` (tensor order) of the window `frames`
    // opened on a root of array type `rt` whose buffer the descriptor `d` describes: the element's
    // own storage, where the callee writes it directly (DESIGN §8.2). `subs` is the element's index
    // list and `t` its type.
    element_address(*self, span: Span, frames: Buf[Opened], subs: Buf[TSub], idx: Buf[string], d: string, rt: Ty, t: Ty) -> string
        var at = idx

        if frames.len() > 0
            var ones: Buf[string] = buf()

            for _ in idx
                ones.push(self.index_const(1))

            val (_, o, _, _) = self.composed(frames, frames.len(), subs, backwards(idx), ones, ones)

            at = backwards(o)

        val r = rank_of(rt)
        val dt = self.desc_ty(r)
        var lin = self.def(s"llvm.extractvalue $d[2] : $dt")

        for k in 0..<r
            val stride = self.def(s"llvm.extractvalue $d[4, $k] : $dt")

            lin = self.def(s"arith.addi $lin, ${self.def(s"arith.muli ${self.to_i64(at[k])}, $stride : i64")} : i64")

        self.def(s"llvm.getelementptr ${self.def(s"llvm.extractvalue $d[1] : $dt")}[$lin] : (!llvm.ptr, i64) -> !llvm.ptr, ${self.mem_ty(span, t)}")

    // The element `l` lent to a call written back from its slot into the array its place holds now,
    // which another `inout` argument of the same call may have rebound.
    element_back(*self, span: Span, l: ElementLent)
        val x = self.load(span, l.slot, l.t)

        if l.frames.len() == 0
            val now = self.place_value(l.src)

            self.set_place(l.src, self.def(s"tensor.insert $x into $now[${joined(l.idx)}] : ${self.tensor_ty(span, l.src.ty)}"), true)
            return

        var frames = l.frames
        val root = frames[0]
        var ones: Buf[string] = buf()

        frames.set(0, Opened(root.src, root.slot, self.place_value(root.src), root.subs, root.offs, root.sizes, root.strides, root.view))

        for _ in l.idx
            ones.push(self.index_const(1))

        self.insert_through(span, frames, l.subs, backwards(l.idx), ones, ones, x, "")

    // The window `subs` (offsets, extents and strides by axis, nex order) of the slice place the first
    // `upto` of `frames` opened, as a window of the root place's array: the windows compose.
    composed(*self, frames: Buf[Opened], upto: usize, subs: Buf[TSub], offs: Buf[string], sizes: Buf[string], strides: Buf[string]) -> (Buf[TSub], Buf[string], Buf[string], Buf[string])
        var s = subs
        var o = offs
        var z = sizes
        var t = strides
        var k = upto

        while k > 0
            k -= 1

            val f = frames[k]
            var ns: Buf[TSub] = buf()
            var no: Buf[string] = buf()
            var nz: Buf[string] = buf()
            var nt: Buf[string] = buf()
            var j: usize = 0

            for a in 0..<f.subs.len()
                f.subs[a] match
                    TSubAt(_) ->
                        ns.push(f.subs[a])
                        no.push(f.offs[a])
                        nz.push(f.sizes[a])
                        nt.push(f.strides[a])
                    _ ->
                        ns.push(s[j])
                        no.push(self.def(s"arith.addi ${f.offs[a]}, ${self.def(s"arith.muli ${o[j]}, ${f.strides[a]} : index")} : index"))
                        nz.push(z[j])
                        nt.push(self.def(s"arith.muli ${f.strides[a]}, ${t[j]} : index"))
                        j += 1

            s = ns
            o = no
            z = nz
            t = nt

        (s, o, z, t)
    end composed

    // -- `reverse(a, k)` --------------------------------------------------------------------------

    // `reverse(a, k)` with `k` known only at run time: every axis whole, axis `k` walked from its
    // end with stride −1; a `k` that is not an axis traps.
    reversed_at(*self, span: Span, args: Buf[TExpr], t: Ty) -> string
        val v = self.ex(args[0])
        val at = args[0].ty
        val k = self.index64(args[1])
        val r = rank_of(at)
        val zero = self.def("arith.constant 0 : i64")
        val down = self.def("arith.constant -1 : i64")
        var offs: Buf[string] = buf()
        var sizes: Buf[string] = buf()
        var strides: Buf[string] = buf()
        var subs: Buf[TSub] = buf()

        self.trap_if(self.def(s"arith.cmpi uge, ${self.def(s"arith.subi $k, %one : i64")}, ${self.def(s"arith.constant $r : i64")} : i64"), NOT_AN_AXIS)

        for a in 1..r
            val hit = self.def(s"arith.cmpi eq, $k, ${self.def(s"arith.constant $a : i64")} : i64")
            val n = self.dim(span, v, at, a)
            val last = self.def(s"arith.maxsi ${self.def(s"arith.subi ${self.to_i64(n)}, %one : i64")}, $zero : i64")

            offs.push(self.def(s"arith.index_cast ${self.def(s"arith.select $hit, $last, $zero : i64")} : i64 to index"))
            sizes.push(n)
            strides.push(self.def(s"arith.index_cast ${self.def(s"arith.select $hit, $down, %one : i64")} : i64 to index"))
            subs.push(TSubAll)

        if is_items(at) then return self.items_gathered(span, v, at, subs, offs, sizes, strides)

        self.sliced(span, v, at, self.slice_text(subs, offs, sizes, strides), t)
end Emitter
