@tests

// The engines a nex program runs on, and the one way a test runs a program on them. Every program
// test — a corpus category, the `testdata/v2/` and `testdata/leaks/` programs, a program written into
// a test, a project of several modules, `nex test` on its fixtures — runs its program on each engine
// of `ENGINES` through `runs`, `ran`, `check_programs` or `nex_test_on`, so a program checked on one
// engine is checked on every one and the two cannot drift.
//
// **The interpreter never calls C** (PLAN.md), so a program declaring an `extern` runs on the
// compiled engine alone. Which programs those are is `COMPILED_ONLY`, and the list is exact: a program
// there that calls no C fails, a program calling C that is not there fails, and so does an entry
// naming no program at all.
//
// What only a compiled program has — its MLIR, its LLVM IR, its link line, Guard Malloc and `leaks`
// on its executable — is checked on the executable the compiled engine leaves at `<work>/<case>`.
//
// **The interpreter is built in stages** (PLAN.md M13), so `NOT_INTERPRETED` names what it refuses
// yet, each with the stage that brings it, and is exact the same way: a program the interpreter
// refuses that is not there fails, an entry naming a `testdata/` program the interpreter runs fails,
// a test whose every program it runs fails as the test finishes, and so does an entry naming nothing.
// A test listed there whose programs the interpreter partly runs runs those on both engines.

import nex.sh.sysl.nex.{Ending, LoadOptions, Stream, TProgram, interpret, interpretable, load, load_source}
import nex_runtime.sh.sysl.nex_runtime.uncaught_text
import sh.sysl.parsing.{Diagnostic, source_of}
import sysl.buf.{Buf, buf}
import sysl.fs.{entries, exists, read_text}
import sysl.path.{join_all, normalize, parent}
import sysl.process.{Output, Status, Var, capture}
import sysl.text.{StrBuilder, from_utf8, split, str_builder}

// Where a program runs: compiled through MLIR to a native program, or interpreted from its typed IR.
enum Engine
    Compiled
    Interpreted

// The engines every program test runs on.
val ENGINES = [Engine.Compiled, Engine.Interpreted]

engine_name(e: Engine) -> string = e match
    Compiled -> "compiled"
    Interpreted -> "interpreted"

// The programs that run on the compiled engine alone, and why: a `testdata/` program by its file
// stem, a program written into a test by the test's function name.
val COMPILED_ONLY = [
    ("065-ffi-libm-and-scalars", "calls libm through `extern`"),
    ("066-ffi-arrays-strides-and-leading-dimension", "calls the C test library through `extern`"),
    ("067-ffi-complex-by-value", "calls the C test library through `extern`"),
    ("068-ffi-c-struct-by-reference", "calls the C test library through `extern`"),
    ("069-ffi-callbacks", "calls the C test library through `extern`"),
    ("070-ffi-fortran-bind-c", "calls the Fortran test library through `extern`"),
    ("071-ffi-fortran-subroutines", "calls the Fortran test library through `@fortran`"),
    ("072-ffi-fortran-character-arguments", "calls the Fortran test library through `@fortran`"),
    ("073-ffi-fortran-callbacks", "calls the Fortran test library through `@fortran`"),
    ("076-ffi-linear-algebra-units", "calls libm through `extern` beside the prelude's linear algebra"),
    ("085-ffi-descriptors", "calls the C test library through `extern`"),
    ("087-ffi-inout-elements", "calls the C test library through `extern`"),
    ("extern_abi_matches_clang", "runs the C programs of testdata/v2"),
    ("mod_run_extern", "imports a module whose `extern` is libm's"),
    ("mod_run_extern_described", "imports a module whose `extern`s are the C test library's"),
    ("run_callback_trap_keeps_inout_writes", "calls the C test library through `extern`"),
    ("run_callback_traps_uncaught", "calls the C test library through `extern`"),
    ("run_callbacks_leak_nothing", "runs 069, which calls the C test library"),
    ("run_callbacks_skipped_and_parallel", "calls the C test library through `extern`"),
    ("run_extern_roots", "calls the C test library through `extern`"),
    ("run_extern_shared_root", "calls the C test library through `extern`"),
    ("run_extern_skipped", "calls the C test library through `extern`"),
    ("run_extern_units", "calls libm through `extern`"),
    ("run_fortran_leak_nothing", "runs the Fortran programs of testdata/v2"),
    ("run_fortran_places_and_callbacks", "calls the Fortran test library through `@fortran`"),
    ("run_fortran_runtime_linked", "calls the Fortran test library through `@fortran`"),
]

// A path under the repository's root, found from where this file lies, so that a test reads the same
// file whatever directory the suite was started from.
repo(rel: string) -> string = normalize(join_all([parent(__FILE__).unwrap(), "..", rel]))

// Whether a program's text calls C: it declares an `extern`, `@fortran` ones among them.
calls_c(text: string) -> bool = text.contains("extern def")

private listed(case: string) -> bool
    for (c, _) in COMPILED_ONLY
        if c == case then return true

    false

// Whether `case` runs on the compiled engine alone, which its text must agree with.
compiled_only(case: string, text: string) -> bool
    val only = listed(case)

    if calls_c(text) && !only then fail_with(s"`$case` calls C, so it runs on the compiled engine alone: add it to COMPILED_ONLY with the reason")
    if only && !calls_c(text) then fail_with(s"`$case` is in COMPILED_ONLY, but its program calls no C")

    only

// One run of a program: where it ran, and what it wrote and how it ended, or why it did not run.
struct Run
    on: string
    out: Result[Output, string]

// `text` run on every engine of `ENGINES` — or, where `entry` is given, the project whose root module
// it is, `text` then being every file of it. The compiled engine builds `<work>/<case>` once and runs it
// at each of `threads` (`""` leaving `OMP_NUM_THREADS` alone); an engine running in one thread runs it
// once. A program that does not build is a run whose output is the diagnostics.
runs(b: Bench, case: string, text: string, entry: string = "", args: []const string = [], fpe_trap: bool = false, links: []const string = [],
     prelude: Option[string] = None, threads: []const string = [""]) -> Buf[Run]
    val only = compiled_only(case, text)
    var out: Buf[Run] = buf()

    for e in ENGINES
        e match
            Compiled ->
                for r in compiled_runs(b, case, text, entry, args, fpe_trap, links, prelude, threads)
                    out.push(r)
            Interpreted ->
                if !only
                    interpreted_run(b, case, text, entry, args, fpe_trap, prelude) match
                        Some(r) -> out.push(r)
                        None -> ()

    out

// `text`, or the project whose root module is `entry`, interpreted: what it wrote and how it ended as
// a compiled program's would read — a trap nothing caught written to standard error and the status
// an abort gives. `None` where the interpreter refuses a program `NOT_INTERPRETED` lists.
private interpreted_run(b: Bench, case: string, text: string, entry: string, args: []const string, fpe_trap: bool, prelude: Option[string]) -> Option[Run]
    if entry == ""
        val src = source_of("t.nex", text)

        return load_source(src) match
            Ok(p) -> interpreted_outcome(b, case, p, args, fpe_trap, (ds) -> lines(ds, src))
            Err(ds) -> Some(Run("interpreted", Err(lines(ds, src))))

    load(entry, LoadOptions(prelude, false)) match
        Ok(l) -> interpreted_outcome(b, case, l.program, args, fpe_trap, (ds) -> l.project.render(ds))
        Err(m) -> Some(Run("interpreted", Err(m)))

// What the interpreter's run wrote, as it wrote it.
private struct Gathered
    text: StrBuilder
    err: StrBuilder

private interpreted_outcome(b: Bench, case: string, p: TProgram, args: []const string, fpe_trap: bool, render: &Fn(Buf[Diagnostic]) -> string) -> Option[Run]
    val g: &Gathered = Gathered(str_builder(), str_builder())

    interpret(p, args, (s, t) -> if s == Stream.StdOut then g.text.push(t) else g.err.push(t), fpe_trap) match
        Ok(ending) ->
            b.seen.note(case, false)

            val status = ending match
                Exit(code) -> Status.Exited(code & 255)
                Trap(message) ->
                    g.err.push(uncaught_text(message))
                    Status.Signalled(6)

            Some(Run("interpreted", Ok(Output(status, g.text.finish(), Some(g.err.finish())))))
        Err(ds) ->
            if not_interpreted(case)
                b.seen.note(case, true)
                return None

            Some(Run("interpreted", Err(s"${render(ds)}\nNOT_INTERPRETED? $case")))

// Whether `NOT_INTERPRETED` (`tests_not_interpreted.sysl`) lists `case`.
private not_interpreted(case: string) -> bool
    for (c, _) in NOT_INTERPRETED
        if c == case then return true

    false

// Which cases of a test reached the interpreter, and whether it refused any program of each.
struct Seen
    cases: Buf[string]
    refused: Buf[bool]

    note(*self, case: string, refused: bool)
        for k in 0..<self.cases.len()
            if self.cases[k] == case
                if refused then self.refused.set(k, true)
                return

        self.cases.push(case)
        self.refused.push(refused)

// A test `NOT_INTERPRETED` lists must have had a program the interpreter refused.
still_refused(b: Bench)
    for k in 0..<b.seen.cases.len()
        val c = b.seen.cases[k]

        if not_interpreted(c) && !b.seen.refused[k] then fail_with(s"`$c` is in NOT_INTERPRETED, but the interpreter runs every program of it: take it out")

private compiled_runs(b: Bench, case: string, text: string, entry: string, args: []const string, fpe_trap: bool, links: []const string,
                      prelude: Option[string], threads: []const string) -> Buf[Run]
    var out: Buf[Run] = buf()
    val built = if entry == "" then emitted(text, fpe_trap) else mlir_of(entry, fpe_trap, LoadOptions(prelude, false))

    val m = built match
        Ok(m) -> m
        Err(e) ->
            out.push(Run("compiled", Err(e)))
            return out

    val exe = executable(b, case)

    lower_module(m, exe, b.work, b.tc, links) match
        Ok(_) -> ()
        Err(e) ->
            out.push(Run("compiled", Err(e)))
            return out

    for t in threads
        var env: Buf[Var] = buf()

        if t != "" then env.push(Var("OMP_NUM_THREADS", t))
        out.push(Run(if t == "" then "compiled" else s"compiled, $t threads", Ok(capture(exe, args, env = env.view(), stderr = true).unwrap())))

    out

// The executable the compiled engine left for `case`, for what only a compiled program is asked.
executable(b: Bench, case: string = __FUNCTION__) -> string = s"${b.work}/$case"

// `text` run on every engine, which must agree on what it wrote and how it ended; that output. A
// program that does not build fails the test.
ran(b: Bench, text: string, args: []const string = [], fpe_trap: bool = false, links: []const string = [], case: string = __FUNCTION__) -> Output
    agreed(runs(b, case, text, args = args, fpe_trap = fpe_trap, links = links))

// The output every one of `rs` gave, which must be one.
agreed(rs: Buf[Run]) -> Output
    var first: Option[Output] = None

    for r in rs
        val out = r.out match
            Ok(o) -> o
            Err(e) -> fail_with(s"${r.on}: $e")

        first match
            None -> first = Some(out)
            Some(f) -> if f.text != out.text || f.err != out.err || f.status != out.status then fail_with(s"${r.on} disagrees: ${out.status}\n${out.text}${out.err.unwrap_or("")}")

    first.unwrap()

// What a set of `testdata/` programs did: how many printed their `.out` on every engine, the ones that
// failed and how, and the ones whose every diagnostic says they wait on a part of the compiler not
// built yet.
struct Checked
    passed: int
    failed: Buf[string]
    waiting: Buf[string]

// Every program of `names` in `testdata/<dir>/` run on every engine, at each of `threads`, and
// compared with its `.out`.
check_programs(b: Bench, dir: string, names: []const string, links: []const string = [], threads: []const string = [""]) -> Checked
    var r = Checked(0, buf(), buf())

    for name in names
        val text = read_text(repo(s"testdata/$dir/$name.nex")).unwrap()
        val expected = read_text(repo(s"testdata/$dir/$name.out")).unwrap()
        var ok = true

        for run in runs(b, name, text, links = links, threads = threads)
            run.out match
                Ok(out) ->
                    if !out.status.ok() || out.text != expected
                        r.failed.push(s"$name (${run.on}): ${out.status}\n${out.text}${out.err.unwrap_or("")}")
                        ok = false
                Err(e) ->
                    if only_later(e) then r.waiting.push(name) else r.failed.push(s"$name (${run.on}): $e")
                    ok = false

        if ok then r.passed += 1

    r

// Whether every diagnostic says its construct waits on a later part of the compiler.
private only_later(diagnostics: string) -> bool
    for line in split(diagnostics, "\n")
        if !line.contains("is not compiled yet") && !line.contains("is not elaborated yet") then return false

    true

// `nex test` on `e`, of the project whose root module is `entry`, running the tests whose names hold
// `filter`.
nex_test_on(e: Engine, b: Bench, entry: string, filter: string) -> Result[TestRun, string] = e match
    Compiled -> run_tests(entry, None, filter, b.tc, false)
    Interpreted -> run_tests_interpreted(entry, None, filter, false)

// `nex test` on every engine, each of which must run it: what each reported. The interpreter's run is
// left out where it refuses a project of a test `NOT_INTERPRETED` lists.
nex_tests(b: Bench, entry: string, filter: string, case: string = __FUNCTION__) -> Buf[TestRun]
    var out: Buf[TestRun] = buf()

    for e in ENGINES
        nex_test_on(e, b, entry, filter) match
            Ok(r) ->
                if e == Engine.Interpreted then b.seen.note(case, false)
                out.push(r)
            Err(m) ->
                if e == Engine.Interpreted && not_interpreted(case) && m.contains("is not interpreted yet") then b.seen.note(case, true)
                else fail_with(s"${engine_name(e)}: $m")

    out

// The stems of the `.nex` programs of `testdata/<dir>/`.
private stems(dir: string) -> Buf[string]
    var out: Buf[string] = buf()

    for f in entries(repo(s"testdata/$dir")).unwrap()
        if f.ends_with(".nex") then out.push(f[0..<f.len - 4])

    out

@test("COMPILED_ONLY holds exactly the testdata programs that call C, and each other entry is a test of this project")
compiled_only_is_exact()
    var calling: Buf[string] = buf()

    for dir in ["corpus", "v2", "leaks"]
        for name in stems(dir)
            val text = read_text(repo(s"testdata/$dir/$name.nex")).unwrap()

            if calls_c(text) then calling.push(name)
            assert_eq(listed(name), calls_c(text))

    var sources = ""

    for f in entries(repo("compiler")).unwrap()
        if f.starts_with("tests_") && f.ends_with(".sysl") then sources += read_text(repo(s"compiler/$f")).unwrap()

    for (c, why) in COMPILED_ONLY
        assert(why != "", c)

        var found = sources.contains(s"\n$c()\n")

        for name in calling
            if name == c then found = true

        assert(found, s"`$c` in COMPILED_ONLY names no testdata program calling C and no test")

    assert_eq(calling.len(), 12)

@test("NOT_INTERPRETED names testdata programs the interpreter refuses and tests of this project, each with its stage")
not_interpreted_is_exact()
    var sources = ""

    for f in entries(repo("compiler")).unwrap()
        if f.starts_with("tests_") && f.ends_with(".sysl") && f != "tests_not_interpreted.sysl" then sources += read_text(repo(s"compiler/$f")).unwrap()

    // Every entry the interpreter runs, so one run names them all.
    var running = ""

    for (c, stage) in NOT_INTERPRETED
        assert(stage == "I2" || stage == "I3" || stage == "I3-LA" || stage == "I4" || stage == "I5", s"`$c`: `$stage` is no stage of the interpreter")
        assert(!listed(c), s"`$c` is in COMPILED_ONLY too, which already keeps it from the interpreter")

        var found = sources.contains(s"\n$c()\n") || sources.contains(s"\"$c\"")

        for dir in ["corpus", "v2", "leaks"]
            val file = repo(s"testdata/$dir/$c.nex")

            if exists(file)
                found = true

                load_source(source_of(file, read_text(file).unwrap())) match
                    Ok(p) -> if interpretable(p).len() == 0 then running += s" `$c`"
                    Err(_) -> ()

        assert(found, s"`$c` in NOT_INTERPRETED names no testdata program and no test")

    assert(running == "", s"in NOT_INTERPRETED, but the interpreter runs them: take them out:$running")
