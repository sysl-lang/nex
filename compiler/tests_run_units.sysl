@tests

// Programs with units of measure, run (DESIGN §13): the corpus's units programs, a conversion's
// overflow under `--fpe-trap`, and what units leave for a later part of the compiler.

import nex.sh.sysl.nex.*
import sysl.text.join

@test("every units-of-measure corpus program prints its .out")
run_units_corpus()
    val r = corpus_run(["units of measure"])

    assert(r.failed.len() == 0, join(r.failed.view(), "\n"))
    assert_eq(r.waiting.len(), 0)
    assert_eq(r.passed, 6)

@test("a conversion is a multiplication like any other: IEEE without --fpe-trap, an overflow trap with it")
run_conversion_overflow()
    val b = bench()
    val program = "def main() =\n  val d = 1.0e306<km>\n  print(to<mm>(d))\n"
    val quiet = ran(b, program)
    val trapped = ran(b, program, fpe_trap = true)

    finish(b)
    assert_eq(quiet.text, "inf mm\n")
    assert_eq(trapped.err.unwrap_or(""), "trap: floating-point overflow\n")
    assert(!trapped.status.ok())

@test("an extern takes the stripped number and its result gets a unit by multiplying")
run_extern_units()
    val b = bench()
    val out = ran(b, "@link(\"m\")\nextern def cbrt(x: real): real\n\ndef main() =\n  val v = 8.0<m^3>\n  print(cbrt(strip(v)) * 1.0<m>)\n")

    finish(b)
    assert_eq(out.text, "2.0 m\n")
