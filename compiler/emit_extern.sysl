// Emission of a call of an `extern def`: a C function, declared by its C symbol and called with the
// arguments C's ABI on this target wants (DESIGN §10.2, §10.3).
//
// **A scalar crosses as itself**, with the extension clang gives it: an 8- or 16-bit integer or a
// `bool`, as argument or result, is marked `signext` or `zeroext`, since Apple's arm64 ABI has the
// caller widen it. **A complex crosses by value as clang passes `_Complex`**: an argument is an array
// of its two parts, `[2 x double]`, which arm64 passes as a homogeneous floating-point aggregate in
// two consecutive FP registers, and a result comes back as the struct `{double, double}`.
//
// **Everything else crosses by pointer.** An `inout` scalar or struct is the address of its place; a
// `@c` struct in read mode is the address of a copy; a `string` is its own NUL-terminated bytes.
//
// **An array crosses as the address of its first element in its buffer.** A read-mode array is its
// value's buffer, read only. **An `inout` window is a subview of its root's buffer**, so C writes
// where the window lies and its leading dimension is the root's. A call with one is made through a
// wrapper function, as a call through a function value is (`through_value`): it takes each root, the
// outermost array of the place, as a tensor, makes its buffer writable, takes the subview through
// every slice opened on the way to the window, calls C, and hands the root back written in place.
// Bufferization sees an ordinary call writing an `inout` argument, so where the root is a constant
// or something else still reads it, the whole root is copied first — every stride kept, and the
// value semantics with it.
//
// **A parameter not marked `@strided` needs the layout §10.3 gives C**: unit stride along nex's
// first axis at rank 1 and 2, a dense column-major block from rank 3. The buffer's strides are read
// at run time, and an array laid out otherwise is gathered into a dense block by the runtime
// (`nex_c_gather`) under an `scf.if` that canonicalization folds where the strides are known; after
// the call the block is scattered back over an `inout` window (`nex_c_scatter`) or freed. A
// `@strided` parameter is never copied.
//
// **A `@fortran` extern takes every argument by address** (DESIGN §10.6): a read-mode scalar is the
// address of a temporary holding it, a `bool` as gfortran's 4-byte `logical` (an `inout` one copied
// back after the call), and each string's length in bytes follows the declared arguments as an `i64`.
// Arrays cross as they do to C. A `logical` result is 4 bytes, true where it is not zero.
//
// The libraries and frameworks the externs `@link` are written as `// nex.link` lines before the
// module, which the driver reads (`driver.sysl`).

import nex.sh.sysl.nex.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder
import sh.sysl.parsing.Span

// What `declared` holds where the module calls BLAS or LAPACK.
private val BLAS_MARK = "nex.blas"

// An array argument as C receives it: its buffer `m` (array type `t`), the address C gets, and where
// it may have been copied, the condition that it was not (`""` where it never is) and the slot
// holding its descriptor.
struct CArray
    m: string
    t: Ty
    ptr: string
    ok: string
    desc: string
    writes: bool

// The root of an `inout` array argument: its place, the array it holds before the call and its array
// type.
struct CRoot
    place: TExpr
    value: string
    t: Ty

// What a wrapper does with its C arguments and its windows' buffers: calls the C function `symbol`,
// or runs `name`, an `inout` form of the LAPACK prelude on elements of `et` (`emit_lapack.sysl`).
enum WrapJob
    CallC(symbol: string)
    Lapack(name: string, et: Ty)

// An `inout` array argument: its root, by number, each slice opened from the root to the window, and
// whether its parameter is `@strided`.
struct CWindow
    root: usize
    frames: Buf[Opened]
    strided: bool

impl Emitter
    find_extern(*self, name: string) -> Option[TExtern]
        for d in self.prog.decls
            d match
                ExternDecl(x) -> if x.name == name then return Some(x)
                _ -> ()

        None

    // The `// nex.link` lines for every extern's `@link`, each once, and `// nex.fortran` where an
    // extern is `@fortran`, for which the driver links gfortran's runtime.
    link_lines(*self) -> string
        var seen: Buf[string] = buf()
        var fortran = false

        for d in self.prog.decls
            d match
                ExternDecl(x) ->
                    if x.fortran then fortran = true

                    for l in x.links
                        if !contains_text(seen, s"-l$l") then seen.push(s"-l$l")

                    for f in x.frameworks
                        if !contains_text(seen, s"-framework $f") then seen.push(s"-framework $f")
                _ -> ()

        var out = ""

        for s in seen
            out += s"// nex.link $s\n"

        if fortran then out += "// nex.fortran\n"
        if contains_text(self.declared, BLAS_MARK) then out += "// nex.blas\n"

        out

    // The module calls BLAS or LAPACK, which the driver links (`driver.sysl`).
    use_blas(*self)
        if !contains_text(self.declared, BLAS_MARK) then self.declared.push(BLAS_MARK)

    // The call of the extern `x` with `args`, its value of type `ret` answered.
    extern_call(*self, span: Span, x: TExtern, args: Buf[TExpr], ret: Ty) -> string
        var vals: Buf[string] = buf()
        var arrays: Buf[CArray] = buf()
        var roots: Buf[CRoot] = buf()
        var windows: Buf[CWindow] = buf()
        // By parameter: the user data a callback's `@data` partner passes.
        var datas: Buf[string] = buf()
        var callbacks = false
        var next = 0
        // For a Fortran procedure: each string's length in bytes, and each `inout` `bool`'s place and
        // the `logical` temporary it crosses in, in pairs.
        var lengths: Buf[string] = buf()
        var logicals: Buf[string] = buf()

        for j in 0..<x.params.len()
            datas.push("")

            // A `@data` parameter has no argument; it passes its callback's user data, set below.
            if x.partner[j].is_some()
                vals.push("")
                continue

            val a = args[next]

            next += 1

            if is_callback_ty(x.params[j])
                val cb = self.c_callback(a, x.params[j], has_data(x.partner, j), x.fortran)

                vals.push(cb.code)
                datas.set(j, cb.data)
                callbacks = true
                continue

            *a.kind match
                TBorrow(place) ->
                    if is_arr(place.ty)
                        windows.push(self.open_window(place, x.strided[j], &roots))
                        vals.push("")
                    elif x.fortran && is_logical_ty(place.ty)
                        // A `logical` is 4 bytes to Fortran: the place's value crosses in a temporary
                        // and is stored back after the call.
                        val p = self.place_ptr(place)
                        val slot = self.fortran_temp(a.span, self.def(s"llvm.load $p : !llvm.ptr -> i1"), place.ty)

                        logicals.push(p)
                        logicals.push(slot)
                        vals.push(slot)
                    else
                        vals.push(self.place_ptr(place))
                _ ->
                    val v = self.ex(a)

                    if x.fortran && is_string(x.params[j]) then lengths.push(self.call("nex_str_bytes", v, "!llvm.ptr", "i64"))

                    vals.push(base_of(x.params[j]) match
                        Array(_, _) ->
                            val m = self.def(s"bufferization.to_buffer $v read_only : ${self.tensor_ty(a.span, a.ty)} to ${self.boundary_ty(a.span, a.ty)}")
                            val c = self.c_pointer(a.span, m, a.ty, x.strided[j], false)

                            arrays.push(c)
                            c.ptr
                        Nominal(_, _) ->
                            val ty = self.ty(a.span, a.ty)
                            val slot = self.alloca(ty)

                            self.op(s"llvm.store $v, $slot : $ty, !llvm.ptr")
                            slot
                        Str -> v
                        _ -> if x.fortran then self.fortran_temp(a.span, v, x.params[j])
                        else base_of(x.params[j]) match
                            Complex(b) -> self.c_complex(v, b)
                            _ -> v)

        for j in 0..<x.params.len()
            x.partner[j] match
                Some(f) -> vals.set(j, datas[f])
                None -> ()

        for n in lengths
            vals.push(n)

        val tys = self.declare_c(span, x)
        val rt = self.ext_result_ty(span, ret, x.fortran)

        // A callback's trap is raised once C has returned (`runtime/trap.sysl`).
        if callbacks then self.call("nex_cb_begin", "", "", "")

        val value = if windows.len() == 0
            self.c_value(self.effect(s"func.call @\"${x.symbol}\"(${joined(vals)}) : (${joined(tys)}) -> ${result_text(rt)}", rt), rt, ret)
        else
            self.c_wrapped(span, self.c_wrapper(span, WrapJob.CallC(x.symbol), vals, tys, rt, roots, windows), rt, ret, roots)

        self.give_back(arrays)

        for k in 0..<logicals.len() / 2
            val w = self.def(s"llvm.load ${logicals[2 * k + 1]} : !llvm.ptr -> i32")

            self.op(s"llvm.store ${self.def(s"arith.cmpi ne, $w, ${self.def("arith.constant 0 : i32")} : i32")}, ${logicals[2 * k]} : i1, !llvm.ptr")

        if callbacks then self.call("nex_cb_end", "", "", "")

        value
    end extern_call

    // The C function `x` declared by its symbol, once; the C types of its parameters. A Fortran
    // procedure takes an address for each, then a `size_t` for each string's length.
    declare_c(*self, span: Span, x: TExtern) -> Buf[string]
        var tys: Buf[string] = buf()
        var decl: Buf[string] = buf()

        for j in 0..<x.params.len()
            if x.fortran
                tys.push("!llvm.ptr")
                decl.push("!llvm.ptr")
                continue

            val t = self.c_param_ty(span, x.params[j], x.modes[j])

            tys.push(t)
            decl.push(t + c_ext(x.params[j], x.modes[j]))

        if x.fortran
            for t in x.params
                if is_string(t)
                    tys.push("i64")
                    decl.push("i64")

        val rt = self.ext_result_ty(span, x.ret, x.fortran)

        self.declare(s"c.${x.symbol}", s"func.func private @\"${x.symbol}\"(${joined(decl)})${if rt == "" then "" else s" -> ($rt${result_ext(x.ret, x.fortran)})"}")
        tys

    // The MLIR type of a result of type `t` as C, or a Fortran procedure where `fortran`, gives it: a
    // Fortran `logical` is gfortran's default kind, 4 bytes.
    ext_result_ty(*self, span: Span, t: Ty, fortran: bool) -> string
        if fortran && is_logical_ty(t) then return "i32"

        self.c_result_ty(span, t)

    // The value `v` of a scalar argument of type `t` to a Fortran procedure, stored in a temporary
    // whose address crosses: a complex as its parts, a `bool` as a default `logical`.
    private fortran_temp(*self, span: Span, v: string, t: Ty) -> string
        val (w, ty) = base_of(t) match
            Complex(b) -> (self.c_complex(v, b), s"!llvm.array<2 x f$b>")
            Bool -> (self.def(s"arith.extui $v : i1 to i32"), "i32")
            _ -> (v, self.ty(span, t))
        val slot = self.alloca(ty)

        self.op(s"llvm.store $w, $slot : $ty, !llvm.ptr")
        slot

    // The `inout` array place `place` opened: its root, numbered in `roots`, which gains it unless an
    // earlier argument of the call holds the same one, and the slices opened from it to the window.
    open_window(*self, place: TExpr, strided: bool, roots: *Buf[CRoot]) -> CWindow
        var frames: Buf[Opened] = buf()
        val v = self.open_place(place, &frames)
        val root = if frames.len() > 0 then frames[0].src else place

        for k in 0..<roots.len()
            if same_root(roots[k].place, root) then return CWindow(k, frames, strided)

        roots.push(CRoot(root, if frames.len() > 0 then frames[0].cur else v, root.ty))
        CWindow(roots.len() - 1, frames, strided)

    // The function through which `job` writes its `inout` arrays, and the operands and their types of
    // a call of it: the C arguments `vals` of types `tys` made by the caller (`""` for each `inout`
    // array), each root of `roots` as a tensor, and every operand of the windows' slices. Its value
    // is of C type `rt`.
    c_wrapper(*self, span: Span, job: WrapJob, vals: Buf[string], tys: Buf[string], rt: string, roots: Buf[CRoot], windows: Buf[CWindow]) -> string
        var head: Buf[string] = buf()
        var ops: Buf[string] = buf()
        var optys: Buf[string] = buf()
        var inner: Buf[string] = buf()

        for j in 0..<vals.len()
            if vals[j] == ""
                inner.push("")
                continue

            inner.push(wrapper_param(&head, &ops, &optys, vals[j], tys[j]))

        var params: Buf[string] = buf()

        for r in roots
            params.push(wrapper_param(&head, &ops, &optys, r.value, self.tensor_ty(span, r.t)))

        // Each window's slice operands, renamed to the wrapper's parameters.
        var offs: Buf[Buf[Buf[string]]] = buf()
        var sizes: Buf[Buf[Buf[string]]] = buf()
        var strides: Buf[Buf[Buf[string]]] = buf()

        for w in windows
            var o: Buf[Buf[string]] = buf()
            var s: Buf[Buf[string]] = buf()
            var t: Buf[Buf[string]] = buf()

            for f in w.frames
                o.push(wrapper_params(&head, &ops, &optys, f.offs))
                s.push(wrapper_params(&head, &ops, &optys, f.sizes))
                t.push(wrapper_params(&head, &ops, &optys, f.strides))

            offs.push(o)
            sizes.push(s)
            strides.push(t)

        val outer_entry = self.entry
        val outer_body = self.body
        val outer_dirty = self.dirty

        self.entry = str_builder()
        self.entry.push("    %one = arith.constant 1 : i64\n")
        self.body = str_builder()
        self.dirty = false

        var ms: Buf[string] = buf()

        for k in 0..<roots.len()
            ms.push(self.def(s"bufferization.to_buffer ${params[k]} : ${self.tensor_ty(span, roots[k].t)} to ${self.boundary_ty(span, roots[k].t)}"))

        // Each window's buffer, a subview of its root's.
        var wms: Buf[string] = buf()
        var wts: Buf[Ty] = buf()

        for next in 0..<windows.len()
            val w = windows[next]
            var m = ms[w.root]
            var mt = roots[w.root].t

            for i in 0..<w.frames.len()
                val nt = self.view_ty(w.frames[i].slot.ty)

                m = self.def(s"memref.subview $m${self.slice_text(w.frames[i].subs, offs[next][i], sizes[next][i], strides[next][i])} : ${self.boundary_ty(span, mt)} to ${self.boundary_ty(span, nt)}")
                mt = nt

            wms.push(m)
            wts.push(mt)

        var copies: Buf[CArray] = buf()

        val result = job match
            CallC(symbol) ->
                var next = 0

                for j in 0..<inner.len()
                    if inner[j] != "" then continue

                    val c = self.c_pointer(span, wms[next], wts[next], windows[next].strided, true)

                    copies.push(c)
                    inner.set(j, c.ptr)
                    next += 1

                val call = s"func.call @\"$symbol\"(${joined(inner)}) : (${joined(tys)}) -> ${result_text(rt)}"

                if rt == "" then
                    self.op(call)
                    ""
                else self.def(call)
            Lapack(name, et) -> self.lapack_in_place(span, name, et, inner, wms, wts, &copies)

        var outs: Buf[string] = buf()
        var out_tys: Buf[string] = buf()

        if rt != ""
            outs.push(result)
            out_tys.push(rt)

        self.give_back(copies)

        for k in 0..<roots.len()
            val tt = self.tensor_ty(span, roots[k].t)
            val now = self.def(s"bufferization.to_tensor ${ms[k]} restrict : ${self.boundary_ty(span, roots[k].t)} to $tt")

            outs.push(self.def(s"bufferization.materialize_in_destination $now in ${params[k]} : ($tt, $tt) -> $tt"))
            out_tys.push(tt)

        self.op(s"func.return ${joined(outs)} : ${joined(out_tys)}")

        val name = s"x.${self.wrappers.len()}"

        self.wrappers.push(name)
        self.funcs.push(s"  func.func private @\"$name\"(${joined(head)}) -> (${joined(out_tys)}) {\n${self.entry.finish()}${self.body.finish()}  }\n\n")
        self.entry = outer_entry
        self.body = outer_body
        self.dirty = outer_dirty

        s"@\"$name\"(${joined(ops)}) : (${joined(optys)})"
    end c_wrapper

    // The wrapper call `call` made, each root of `roots` rebound to what it hands back, and its value
    // of C type `rt` read as a value of `ret`. Where an `exit`, `cycle` or `return` may already have
    // run in the statement, it runs only where none did.
    c_wrapped(*self, span: Span, call: string, rt: string, ret: Ty, roots: Buf[CRoot]) -> string
        if self.dirty
            val ok = self.flowing()

            self.dirty = false

            var f = self.fork()

            f = self.fork_else(f, self.c_wrapped(span, call, rt, ret, roots), ret)
            self.dirty = true
            return self.join(f, ok, "", ret)

        var tys: Buf[string] = buf()

        if rt != "" then tys.push(rt)

        for r in roots
            tys.push(self.tensor_ty(span, r.t))

        val v = self.fresh()
        val n = tys.len()
        val first: usize = if rt == "" then 0 else 1

        self.op(s"${result_def(v, n)}func.call $call -> ${if n == 1 then tys[0] else s"(${joined(tys)})"}")

        for k in 0..<roots.len()
            self.set_place(roots[k].place, result_name(v, first + k, n), true)

        if rt == "" then "" else self.c_value(result_name(v, 0, n), rt, ret)

    // Each copy of `copies` scattered back over its window or freed, whether or not the call ran: the
    // window holds what it did.
    give_back(*self, copies: Buf[CArray])
        for c in copies
            if c.ok == "" then continue

            self.op(s"scf.if ${self.def(s"arith.xori ${c.ok}, ${self.def("arith.constant true")} : i1")} {")

            if c.writes then self.always("nex_c_scatter", s"${self.elem_const(c.t)}, ${self.def(s"arith.constant ${rank_of(c.t)} : i64")}, ${c.desc}, ${c.ptr}", "i64, i64, !llvm.ptr, !llvm.ptr", "")
            else self.always("nex_c_free", c.ptr, "!llvm.ptr", "")

            self.op("}")

    // A C result `r` of type `rt` as a value of `ret`: a complex from the struct of its parts, a
    // Fortran `logical` true where it is not zero.
    c_value(*self, r: string, rt: string, ret: Ty) -> string = base_of(ret) match
        Complex(b) ->
            val re = self.def(s"llvm.extractvalue $r[0] : $rt")
            val im = self.def(s"llvm.extractvalue $r[1] : $rt")

            self.def(s"complex.create $re, $im : complex<f$b>")
        Bool -> if rt == "i32" then self.def(s"arith.cmpi ne, $r, ${self.def("arith.constant 0 : i32")} : i32") else r
        _ -> r

    // The array buffer `m` of type `t` as C receives it. Unless the parameter is `strided`, a buffer
    // C cannot address as §10.3 says is gathered into a dense copy first; one C `writes` is scattered
    // back after.
    private c_pointer(*self, span: Span, m: string, t: Ty, strided: bool, writes: bool) -> CArray
        val direct = self.first_element(span, m, t)

        if strided then return CArray(m, t, direct, "", "", writes)

        val ok = self.c_layout(m, t)
        val r = rank_of(t)
        val dt = self.desc_ty(r)
        val desc = self.alloca(dt)
        val p = self.fresh()

        self.op(s"$p = scf.if $ok -> (!llvm.ptr) {")
        self.op(s"scf.yield $direct : !llvm.ptr")
        self.op("} else {")
        self.op(s"llvm.store ${self.def(s"builtin.unrealized_conversion_cast $m : ${self.boundary_ty(span, t)} to $dt")}, $desc : $dt, !llvm.ptr")
        self.op(s"scf.yield ${self.always("nex_c_gather",s"${self.elem_const(t)}, ${self.def(s"arith.constant $r : i64")}, $desc", "i64, i64, !llvm.ptr", "!llvm.ptr")} : !llvm.ptr")
        self.op("}")

        CArray(m, t, p, ok, desc, writes)

    // A call of the runtime's `name` that runs whether or not an `exit`, `cycle` or `return` has run
    // in the statement: a copy is made and given back either way.
    always(*self, name: string, args: string, params: string, result: string) -> string
        self.external(name, params, result)

        val text = s"func.call @$name($args) : ($params) -> ${result_text(result)}"

        if result == ""
            self.op(text)
            return ""

        self.def(text)

    // The bytes of an element of the array type `t`, as an `i64` constant.
    elem_const(*self, t: Ty) -> string = self.def(s"arith.constant ${self.elem_bytes(elem_of(t))} : i64")

    // The address of the first element of the buffer `m` of the array type `t`.
    first_element(*self, span: Span, m: string, t: Ty) -> string
        val b = self.boundary_ty(span, t)
        val md = self.metadata(m, t)
        val base = self.def(s"arith.index_cast ${self.def(s"memref.extract_aligned_pointer_as_index $m : $b -> index")} : index to i64")
        val off = self.def(s"arith.index_cast $md#1 : index to i64")
        val p = self.def(s"llvm.inttoptr $base : i64 to !llvm.ptr")

        self.def(s"llvm.getelementptr $p[$off] : (!llvm.ptr, i64) -> !llvm.ptr, ${self.mem_ty(span, elem_of(t))}")

    // `memref.extract_strided_metadata` of the buffer `m` of an array of type `t`: `#1` is the
    // offset, then the sizes and the strides, buffer order (nex's last axis first).
    metadata(*self, m: string, t: Ty) -> string
        val r = rank_of(t)
        val v = self.fresh()
        var tys = s"memref<${self.elem_ty(Span(0, 0), elem_of(t))}>, index"

        for _ in 0..<2 * r
            tys += ", index"

        self.op(s"$v:${2 + 2 * r} = memref.extract_strided_metadata $m : ${self.boundary_ty(Span(0, 0), t)} -> $tys")
        v

    // Whether the buffer `m` of an array of type `t` is laid out as C may address it without a copy:
    // nex's first axis at unit stride, and from rank 3 every axis dense after it.
    private c_layout(*self, m: string, t: Ty) -> string
        val r = rank_of(t)
        val md = self.metadata(m, t)
        var ok = self.def(s"arith.cmpi eq, $md#${2 + 2 * r - 1}, ${self.index_const(1)} : index")

        if r >= 3
            var k = r - 1

            while k > 0
                k -= 1

                val want = self.def(s"arith.muli $md#${2 + r + k + 1}, $md#${2 + k + 1} : index")

                ok = self.def(s"arith.andi $ok, ${self.def(s"arith.cmpi eq, $md#${2 + r + k}, $want : index")} : i1")

        ok

    // The MLIR type of a parameter of type `t` in mode `mode` as C takes it.
    c_param_ty(*self, span: Span, t: Ty, mode: Mode) -> string
        if mode == Inout then return "!llvm.ptr"

        base_of(t) match
            Complex(b) -> s"!llvm.array<2 x f$b>"
            Array(_, _) -> "!llvm.ptr"
            Nominal(_, _) -> "!llvm.ptr"
            Str -> "!llvm.ptr"
            Fn(_) -> "!llvm.ptr"
            CPtr -> "!llvm.ptr"
            _ -> self.ty(span, t)

    // The MLIR type of a result of type `t` as C gives it, `""` for none.
    c_result_ty(*self, span: Span, t: Ty) -> string = base_of(t) match
        Complex(b) -> s"!llvm.struct<(f$b, f$b)>"
        _ -> self.ty(span, t)

    // The complex `v` with parts of `b` bits as the array of its parts C takes.
    c_complex(*self, v: string, b: int) -> string
        val at = s"!llvm.array<2 x f$b>"
        val re = self.def(s"complex.re $v : complex<f$b>")
        val im = self.def(s"complex.im $v : complex<f$b>")
        val u = self.def(s"llvm.mlir.undef : $at")

        self.def(s"llvm.insertvalue $im, ${self.def(s"llvm.insertvalue $re, $u[0] : $at")}[1] : $at")
end Emitter

// A parameter of a wrapper, `%pN` of type `ty`, which the call passes `value` for.
private wrapper_param(head: *Buf[string], ops: *Buf[string], tys: *Buf[string], value: string, ty: string) -> string
    val p = s"%p${head.len()}"

    head.push(s"$p: $ty")
    ops.push(value)
    tys.push(ty)
    p

// An `index` parameter of a wrapper for each of `values`.
private wrapper_params(head: *Buf[string], ops: *Buf[string], tys: *Buf[string], values: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for v in values
        out.push(wrapper_param(head, ops, tys, v, "index"))

    out

// Whether two root places are one: the same local or the same module-level binding.
private same_root(a: TExpr, b: TExpr) -> bool = *a.kind match
    TLocal(x) -> *b.kind match
        TLocal(y) -> x == y
        _ -> false
    TGlobalRef(x) -> *b.kind match
        TGlobalRef(y) -> x == y
        _ -> false
    _ -> false

// The extension clang gives a C argument or result of type `t`: 8- and 16-bit integers and `bool`
// are widened by the caller on arm64.
c_ext(t: Ty, mode: Mode) -> string
    if mode == Inout then return ""

    base_of(t) match
        Int(b, signed) -> if b < 32 then (if signed then " {llvm.signext}" else " {llvm.zeroext}") else ""
        Bool -> " {llvm.zeroext}"
        _ -> ""

// The extension of a result of type `t`: none for a Fortran `logical`, which is 32 bits.
result_ext(t: Ty, fortran: bool) -> string = if fortran && is_logical_ty(t) then "" else c_ext(t, Mode.Read)

is_string(t: Ty) -> bool = base_of(t) match
    Str -> true
    _ -> false

private contains_text(xs: Buf[string], x: string) -> bool
    for y in xs
        if y == x then return true

    false
