@tests

// The element-by-element operations that are not arithmetic operators, run on both engines, which
// must agree to the bit: `^` of every kind of base and exponent, the numeric conversions, the
// elemental prelude, a user's elemental function and `map`, the locations, the complex and integer
// reductions, and `@` below BLAS's size, including a product whose answer shows whether a step was
// fused.

private val PROGRAM = raw"""
@elemental
def damp(x: real, k: real): real = x * k + 1.0

def main() =
  val a = [0.5, 1.5, 2.25, 3.0, -1.25]
  val f: [real32] = [0.1, 1.7, 2.3, -0.4]
  val h: [real16] = [0.1, 1.7, 2.3]
  val n4: [int32] = [3, -2, 7, 0]
  val b: [int8] = [2, 5, 11]
  val u: [uint8] = [3, 4, 15]
  val z: [complex[real64]] = [1 + 2i, -0.5 + 0.25i, 3 - 1i]
  val w: [complex[real32]] = [1 + 2i, -0.5 + 0.25i, 3 - 1i]
  print(a ^ 2.0)
  print(a ^ 3)
  print(a ^ a)
  print(2.0 ^ a)
  print(f ^ f)
  print(f ^ 2)
  print(h ^ 2.5)
  print(n4 ^ 2)
  print(n4 ^ n4)
  print(u ^ 2)
  print(b ^ -1)
  print(z ^ 2)
  print(z ^ z)
  print(w ^ 3)
  assert_traps(() -> print(b ^ 3), "int8 overflow")
  assert_traps(() -> print(u ^ 3), "uint8 overflow")
  assert_traps(() -> print(n4 ^ -1), "division by zero")
  print(real32(a))
  print(real16(a))
  print(real(f))
  print(int32(a))
  print(int64(n4))
  print(int8(n4))
  print(real(n4))
  print(real32(n4))
  print(complex[real64](a))
  print(complex[real32](z))
  print(complex[real64](w))
  assert_traps(() -> print(uint8(n4)), "out of range")
  assert_traps(() -> print(int8(a * 100.0)), "out of range")
  print(sqrt(a * a))
  print(exp(a))
  print(log(abs(a)))
  print(sin(a))
  print(cos(f))
  print(tan(h))
  print(tan(z))
  print(tan(w))
  print((tan(0 + 0i), tan(1.5 - 0.5i), tan(0.5 + 800i), tan(0.5 - 800i), tan(2i), tan(0.3 + 40i)))
  val zw: complex[real32] = 0.7 - 30i
  print(tan(zw))
  print(abs(n4))
  print(abs(a))
  print(abs(z))
  print(abs(w))
  print(sign(n4))
  print(sign(a))
  print(floor(a))
  print(round(a))
  print(ceil(f))
  print(trunc(a))
  print(min(a, 1.0))
  print(max(a, a * -1.0))
  print(max(n4, 1))
  print(min(2, n4))
  print(atan2(a, 2.0))
  print(hypot(a, a))
  print(sqrt(z))
  print(exp(w))
  print(conj(z))
  print(arg(z))
  print(log(z))
  print(abs(b))
  val m8: [int8] = [-128, 3]
  assert_traps(() -> print(abs(m8)), "int8 overflow")
  print(damp(a, 0.5))
  print(damp(a[.. by -2], 2.0))
  print(map(a, v -> v * 3.0))
  print(map(n4, v -> v + 1))
  val mm = reshape([1.0, 4.0, 2.0, 4.0, 0.5, 9.0], (2, 3))
  print(map(mm, v -> v / 2.0))
  print(sqrt(mm))
  print(mm ^ 2)
  print(minloc(a))
  print(maxloc(a))
  print(minloc(n4))
  print(maxloc([3, 7, 7, 1]))
  print(minloc([2.0, 1.0, 1.0]))
  print(maxloc(mm))
  print(minloc(mm, dim = 1))
  print(maxloc(mm, dim = 2))
  print(product(z))
  print(product(w))
  print(dot(z, z))
  print(dot(w, w))
  print(dot(n4, n4))
  print(dot(u, u))
  val big: [int8] = [100, 100]
  assert_traps(() -> print(dot(big, big)), "int8 overflow")
  val p = [1.0, 1.0 + 2.0 ^ -27]
  val q = [-1.0, 1.0 + 2.0 ^ -27]
  print(p @ q)
  val pm = reshape([1.0, 1.0 + 2.0 ^ -27, 3.0, 4.0], (2, 2))
  val qm = reshape([-1.0, 1.0 + 2.0 ^ -27, 0.5, 2.0], (2, 2))
  print(pm @ qm)
  print(pm @ p)
  print(p @ pm)
  print(transpose(pm) @ qm)
  val i8m = int8(reshape([100, 2, 3, 4], (2, 2)))
  print(i8m @ i8m)
  val fm = real32(reshape([0.1, 0.2, 0.3, 0.7], (2, 2)))
  print(fm @ fm)
  val zm: [complex[real64]; :, :] = reshape([1 + 1i, 2 - 1i, 0.5 + 0i, 1i], (2, 2))
  print(zm @ zm)
  print(zm @ z[1..2])
"""

private val EXPECTED = raw"""
