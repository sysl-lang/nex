"""

@test("^, the conversions, the elemental prelude, user elemental functions, map, the locations, complex and integer reductions and the inline @ agree on both engines to the bit")
run_kernels_agree()
    val b = bench()
    val out = ran(b, PROGRAM)

    finish(b)
    assert(out.status.ok(), out.err.unwrap_or(""))
    assert_eq(out.text, EXPECTED)
