// The `nex` command. `tokens` prints what the lexer reads, `parse` the tree the parser builds,
// `elaborate` the typed IR, or every diagnostic the elaborator gives; `emit` the MLIR module.
// `build` (or `compile`) makes a native program, beside the source or at `-o`, and `run` makes one in
// a temporary directory, runs it with the
// arguments after `--` and exits with its status; `run --interp` and `test --interp` interpret it
// instead (`interp.sysl` of the library), with no toolchain. `test` runs the project's `@test` functions, those
// whose names contain the substring after the file where one is given (`test_runner.sysl`).
// `nex --version` (or `nex version`) prints the version. `--fpe-trap` makes real division by zero, invalid operations and overflow trap (DESIGN §2.5);
// `--prelude-path <dir>` names the source prelude's directory (`modules.sysl`); `-L dir` and
// `-l lib` add a library search directory and a library to the link (DESIGN §10.1). `run --np N`
// and `test --np N` run the program, or each test, as an N-rank MPI job under the launcher the
// driver finds (`mpi_launcher`, DESIGN §9.6.7). Options may stand anywhere before `--`.

import nex.sh.sysl.nex.*
import nex_runtime.sh.sysl.nex_runtime.uncaught_text
import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, read_bytes, remove_dir_all}
import sysl.process.run
import sysl.text.parse_int
import sh.sysl.parsing.source

private val usage = "usage: nex <tokens | parse | elaborate | emit | build | run | test | version> [--fpe-trap] [--interp] [--np ranks] [--prelude-path dir] [-L dir] [-l lib] <file.nex> [-o out | -- args | substring]"

main(args: []string)
    if args.len == 2 && (args[1] == "--version" || args[1] == "version")
        print(s"nex $NEX_VERSION")
        return

    if args.len < 3
        print(usage)
        exit(2)

    val command = args[1]
    var fpe_trap = false
    var interp = false
    // `--np N`: how many ranks the program runs as, under an MPI launcher; 0 for none.
    var np = 0
    var prelude_flag: Option[string] = None
    var file = ""
    // The substring `test` selects by.
    var filter = ""
    var out = ""
    var links: Buf[string] = buf()
    var program_args: Buf[string] = buf()
    var k = 2

    while k < args.len
        val a = args[k]

        if a == "--"
            for b in args[k + 1..]
                program_args.push(b)
            break
        elif a == "--fpe-trap"
            fpe_trap = true
        elif a == "--interp" && (command == "run" || command == "test")
            interp = true
        elif a == "-o" || a == "-L" || a == "-l" || a == "--prelude-path" || (a == "--np" && (command == "run" || command == "test"))
            if k + 1 >= args.len then fail(s"nex: `$a` needs a value\n$usage")

            k += 1

            if a == "-o" then out = args[k]
            elif a == "--prelude-path" then prelude_flag = Some(args[k])
            elif a == "--np" then np = ranks_of(args[k])
            else links.push(a + args[k])
        elif a.starts_with("-L") || a.starts_with("-l")
            links.push(a)
        elif file == ""
            file = a
        elif command == "test" && filter == ""
            filter = a
        else
            fail(s"nex: unexpected `$a`\n$usage")

        k += 1

    if file == ""
        print(usage)
        exit(2)

    val prelude = find_prelude(prelude_flag) match
        Ok(p) -> p
        Err(m) -> fail(m)

    val opts = LoadOptions(prelude, false)

    if np > 0 && interp then fail("nex: --np runs the compiled program as an MPI job, and --interp runs it in this process; give one")

    if command == "emit"
        mlir_of(file, fpe_trap, opts) match
            Ok(text) -> prints(text)
            Err(m) -> fail(m)
        return

    if command == "test"
        val ran = if interp then run_tests_interpreted(file, prelude, filter, fpe_trap)
                  else find_toolchain(args[0]) match
                      Ok(tc) -> run_tests(file, prelude, filter, tc, fpe_trap, np)
                      Err(m) -> fail(m)

        val r = ran match
            Ok(r) -> r
            Err(m) -> fail(m)

        for line in r.lines
            print(line)

        exit(if r.failed > 0 then 1 else 0)

    val build = command == "build" || command == "compile"

    if command == "run" && interp then interpret_file(file, opts, program_args.view(), fpe_trap)

    if build || command == "run"
        val tc = find_toolchain(args[0]) match
            Ok(t) -> t
            Err(m) -> fail(m)

        if build
            compile_file_here(file, if out == "" then default_output(file) else out, tc, fpe_trap, opts, links.view())
            return

        val (work, exe) = compile_temp(file, tc, fpe_trap, opts, links.view()) match
            Ok(p) -> p
            Err(m) -> fail(m)

        // Under `--np`, the program is the launcher's argument.
        var line: Buf[string] = buf()

        if np > 0
            line = mpi_launcher(np) match
                Ok(l) -> l
                Err(m) ->
                    _ = remove_dir_all(work)
                    fail(m)

        line.push(exe)

        for a in program_args
            line.push(a)

        val status = run(line[0], line.view()[1..])

        _ = remove_dir_all(work)

        status match
            Ok(Exited(code)) -> exit(code)
            Ok(Signalled(sig)) -> exit(128 + sig)
            Ok(other) -> fail(s"nex: ${other}")
            Err(e) -> fail(s"nex: cannot run the program: $e")

    if command != "tokens" && command != "parse" && command != "elaborate"
        print(s"nex: '${command}' is not a command\n$usage")
        exit(2)

    if command == "elaborate"
        load(file, opts) match
            Ok(l) -> print(show_tprogram(l.program))
            Err(m) -> fail(m)
        return

    val bytes = read_bytes(file) match
        Ok(b) -> b
        Err(e) -> fail(s"nex: cannot read ${file}: ${e}")

    val doc = source(file, bytes)
    val src = program_text(doc) match
        Ok(s) -> s
        Err(d) -> fail(d.render(doc))

    if command == "tokens"
        lex(src) match
            Ok(toks) -> prints(show_tokens(src, toks))
            Err(d) -> fail(d.render(src))
        return

    val p = parse_program(src) match
        Ok(p) -> p
        Err(d) -> fail(d.render(src))

    print(show_program(p))
end main

// `program.nex` compiles to `program`.
private default_output(file: string) -> string =
    if file.ends_with(".nex") then file[0..<file.len - 4] elif file.ends_with(".lnex") then file[0..<file.len - 5] else file + ".out"

private compile_file_here(file: string, out: string, tc: Toolchain, fpe_trap: bool, opts: LoadOptions, links: []const string)
    val work = make_temp_dir("nex") match
        Ok(w) -> w
        Err(e) -> fail(s"nex: cannot make a temporary directory: $e")

    val done = compile_file(file, out, work, tc, fpe_trap, opts, links)

    _ = remove_dir_all(work)

    done match
        Ok(_) -> ()
        Err(m) -> fail(m)

// `nex run --interp`: the program interpreted in this process, no toolchain needed, ending as the
// compiled one would — with its `stop` status, or after a trap nothing caught with its message on
// standard error and the status of an abort.
private interpret_file(file: string, opts: LoadOptions, program_args: []const string, fpe_trap: bool) -> never
    val l = load(file, opts) match
        Ok(l) -> l
        Err(m) -> fail(m)

    interpret(l.program, program_args, (s, text) -> if s == StdOut then prints(text) else eprints(text), fpe_trap) match
        Ok(Exit(status)) ->
            flush()
            exit(status)
        Ok(Trap(message)) ->
            flush()
            eprints(uncaught_text(message))
            exit(134)
        Err(ds) -> fail(l.project.render(ds))

// `--np`'s value: a count of ranks, at least 1.
private ranks_of(text: string) -> int
    val n = parse_int(text) match
        Ok(n) -> n
        Err(_) -> fail(s"nex: --np takes a number of ranks, not `$text`")

    if n < 1 then fail(s"nex: --np takes a number of ranks, at least 1, not $n")

    n

private fail(text: string) -> never
    eprints(text)
    eprints("\n")
    exit(1)
