@tests

// Files (DESIGN §17.6) where a program's ending is the subject, on both engines: `main` answering the
// `Err` of a missing file, `!` trapping with its sentence, and the files still open as a program
// ends — by returning, by `stop` or by a trap nothing catches — closed, what they held written. The
// programs of `testdata/v2/120` to `125` and `testdata/leaks/files` cover the rest.

import nex_runtime.sh.sysl.nex_runtime.fail_flushes_under
import nex_runtime.sh.sysl.nex_runtime.fail_reads_under
import sysl.fs.{make_dir, read_text, remove_dir_all, write_text}
import sysl.process.{Output, Status}

@test("main returning Result[void, IoError] on a missing file exits 1 with the sentence; ! traps with it")
run_files_main_err()
    val b = bench()
    val missing = s"${b.work}/no-such-dir/in.dat"
    val err = ran(b, s"def load(p: string): Result[string, IoError] =\n  val f = open(p, Read)?\n  read_text(p)\ndef main(): Result[void, IoError] =\n  print(\"before\")\n  print(load(\"$missing\")?)\n  print(\"after\")\n  Ok(())\n", case = "run_files_main_err")
    val trap = ran(b, s"def main() =\n  print(\"before\")\n  print(read_text(\"$missing\")!)\n", case = "run_files_trap")
    val ok = ran(b, s"def main(): Result[void, IoError] =\n  if not exists(\"$missing\") then return Ok(())\n  print(read_text(\"$missing\")?)\n  Ok(())\n", case = "run_files_main_ok")

    finish(b)
    assert_eq(err.text, "before\n")
    assert_eq(err.err.unwrap_or(""), s"error: $missing: no such file\n")
    assert(err.status == Status.Exited(1), s"${err.status}")
    assert_eq(trap.text, "before\n")
    assert_eq(trap.err.unwrap_or(""), s"trap: $missing: no such file\n")
    assert(trap.status == Status.Signalled(6), s"${trap.status}")
    assert_eq(ok.text, "")
    assert(ok.status == Status.Exited(0), s"${ok.status}")

@test("a file still open as the program ends — a module-level binding, by returning or by stop — is closed, what it held written")
run_files_closed_at_exit()
    val b = bench()
    val dir = s"${b.work}/at-exit"

    make_dir(dir).unwrap()

    val returned = ran(b, s"val log = open(\"$dir/returned.txt\", Write)!\ndef main() =\n  write_line(log, \"kept\")!\n  write(log, \"to the end\")!\n  print(\"done\")\n", case = "run_files_exit_return")
    val returned_text = read_text(s"$dir/returned.txt").unwrap()
    val stopped = ran(b, s"val log = open(\"$dir/stopped.txt\", Write)!\ndef main() =\n  write_line(log, \"before stop\")!\n  stop 3\n", case = "run_files_exit_stop")
    val stopped_text = read_text(s"$dir/stopped.txt").unwrap()
    val local = ran(b, s"def main() =\n  val f = open(\"$dir/local.txt\", Write)!\n  write(f, \"local\")!\n  stop 0\n", case = "run_files_exit_local")
    val local_text = read_text(s"$dir/local.txt").unwrap()

    remove_dir_all(dir).unwrap()
    finish(b)
    assert_eq(returned.text, "done\n")
    assert_eq(returned_text, "kept\nto the end")
    assert(stopped.status == Status.Exited(3), s"${stopped.status}")
    assert_eq(stopped_text, "before stop\n")
    assert(local.status == Status.Exited(0), s"${local.status}")
    assert_eq(local_text, "local")

@test("a file still open as a trap nothing catches ends the program — a module-level binding, a local — is closed, what it held written")
run_files_closed_at_trap()
    val b = bench()
    val dir = s"${b.work}/at-trap"

    make_dir(dir).unwrap()

    var text = s"val log = open(\"$dir/module.txt\", Write)!\n"

    text += s"def main() =\n  val f = open(\"$dir/local.txt\", Write)!\n  write_line(log, \"before the trap\")!\n  write(f, \"local\")!\n"
    text += s"  print(\"trapping\")\n  print(read_text(\"$dir/missing.txt\")!)\n"

    val out = ran(b, text, case = "run_files_exit_trap")
    val module_text = read_text(s"$dir/module.txt").unwrap()
    val local_text = read_text(s"$dir/local.txt").unwrap()

    remove_dir_all(dir).unwrap()
    finish(b)
    assert_eq(out.text, "trapping\n")
    assert_eq(out.err.unwrap_or(""), s"trap: $dir/missing.txt: no such file\n")
    assert(out.status == Status.Signalled(6), s"${out.status}")
    assert_eq(module_text, "before the trap\n")
    assert_eq(local_text, "local")

@test("a close that fails as a trap ends the program warns before the trap's message, and the trap's status stands")
run_files_dropped_close_at_trap()
    val b = bench()
    val dir = s"${b.work}/dropped-trap"

    make_dir(dir).unwrap()

    val full = s"$dir/full-"
    val text = s"val log = open(\"${full}log.txt\", Write)!\ndef main() =\n  write_line(log, \"lost\")!\n  print(\"trapping\")\n  print(read_text(\"$dir/missing.txt\")!)\n"
    val out = ran_failing(b, full, text, "run_files_dropped_close_at_trap")

    remove_dir_all(dir).unwrap()
    finish(b)
    assert_eq(out.text, "trapping\n")
    assert_eq(out.err.unwrap_or(""), s"warning: ${full}log.txt: no space left on the device\ntrap: $dir/missing.txt: no such file\n")
    assert(out.status == Status.Signalled(6), s"${out.status}")

// `text` run on both engines with every hand-over to the system of a file under `prefix` failing as a
// full disk would: the interpreter's through the runtime's fault, set on this thread for the run; the
// compiled program's through a constructor, linked in, that sets it as the program starts.
private ran_failing(b: Bench, prefix: string, text: string, case: string) -> Output
    val hook = s"${b.work}/$case-fault.c"

    write_text(hook, s"void nex_test_fail_flushes(const char *prefix);\n__attribute__((constructor)) static void fault(void) { nex_test_fail_flushes(\"$prefix\"); }\n").unwrap()
    fail_flushes_under(prefix)

    val out = ran(b, text, links = [hook], case = case)

    fail_flushes_under("")
    out

@test("a read that fails answers Failed with the system's reason, from read_line and read_table(file), while a whole-file read is untouched, on both engines")
run_files_read_failure_reason()
    val b = bench()
    val dir = s"${b.work}/read-fails"

    make_dir(dir).unwrap()

    val bad = s"$dir/bad-"

    write_text(s"${bad}in.txt", "1 2\n3 4\n").unwrap()

    var text = "def shown(r: Result[string, IoError]) = r match\n  Ok(_) -> print(\"ok\")\n  Err(e) ->\n    print(message(e))\n"
    text += "def line_of(f: File): Result[string, IoError] =\n  read_line(f)? match\n    Some(s) -> Ok(s)\n    None -> Ok(\"end\")\n"
    text += s"def main() =\n  val f = open(\"${bad}in.txt\", Read)!\n  shown(line_of(f))\n"
    text += s"  val g = open(\"${bad}in.txt\", Read)!\n  val t: Result[[real64; :, :], IoError] = read_table(g)\n  t match\n    Ok(_) -> print(\"ok\")\n    Err(e) -> print(message(e))\n"
    text += s"  read_text(\"${bad}in.txt\") match\n    Ok(s) -> print(s)\n    Err(e) -> print(message(e))\n"

    val hook = s"${b.work}/run_files_read_failure_reason-fault.c"

    write_text(hook, s"void nex_test_fail_reads(const char *prefix);\n__attribute__((constructor)) static void fault(void) { nex_test_fail_reads(\"$bad\"); }\n").unwrap()
    fail_reads_under(bad)

    val out = ran(b, text, links = [hook], case = "run_files_read_failure_reason")

    fail_reads_under("")

    remove_dir_all(dir).unwrap()
    finish(b)

    val why = s"${bad}in.txt: is a directory\n"

    assert_eq(out.text, why + why + "1 2\n3 4\n\n")
    assert(out.status == Status.Exited(0), s"${out.status}")

@test("a close that fails as the last reference goes warns on stderr and the program goes on: a scope's end, an overwritten binding, the program's end")
run_files_dropped_close_warns()
    val b = bench()
    val dir = s"${b.work}/dropped"

    make_dir(dir).unwrap()

    val full = s"$dir/full-"
    var text = s"val log = open(\"${full}module.txt\", Write)!\n"

    text += s"def scoped() =\n  val f = open(\"${full}scope.txt\", Write)!\n  write(f, \"lost\")!\n"
    text += "def main() =\n  write_line(log, \"lost\")!\n  scoped()\n  print(\"after the scope\")\n"
    text += s"  var g = open(\"${full}first.txt\", Write)!\n  write(g, \"lost\")!\n  g = open(\"$dir/second.txt\", Write)!\n  write(g, \"kept\")!\n"
    text += "  print(\"after the overwrite\")\n"

    val out = ran_failing(b, full, text, "run_files_dropped_close_warns")
    val second = read_text(s"$dir/second.txt").unwrap()

    remove_dir_all(dir).unwrap()
    finish(b)
    assert_eq(out.text, "after the scope\nafter the overwrite\n")
    assert_eq(out.err.unwrap_or(""), s"warning: ${full}scope.txt: no space left on the device\nwarning: ${full}first.txt: no space left on the device\nwarning: ${full}module.txt: no space left on the device\n")
    assert(out.status == Status.Exited(0), s"${out.status}")
    assert_eq(second, "kept")

@test("a close that fails as stop ends the program warns, and stop's status stands")
run_files_dropped_close_at_stop()
    val b = bench()
    val dir = s"${b.work}/dropped-stop"

    make_dir(dir).unwrap()

    val full = s"$dir/full-"
    val text = s"val log = open(\"${full}log.txt\", Write)!\ndef main() =\n  write_line(log, \"lost\")!\n  print(\"stopping\")\n  stop 3\n"
    val out = ran_failing(b, full, text, "run_files_dropped_close_at_stop")

    remove_dir_all(dir).unwrap()
    finish(b)
    assert_eq(out.text, "stopping\n")
    assert_eq(out.err.unwrap_or(""), s"warning: ${full}log.txt: no space left on the device\n")
    assert(out.status == Status.Exited(3), s"${out.status}")

@test("an explicit close or flush of a file whose flush fails answers Err(Failed(…)), and no warning follows")
run_files_explicit_close_fails()
    val b = bench()
    val dir = s"${b.work}/explicit"

    make_dir(dir).unwrap()

    val full = s"$dir/full-"
    var text = "def kind(e: IoError): string = e match\n  Failed(_, _) -> \"Failed\"\n  _ -> \"other\"\n"

    text += "def shown(r: Result[void, IoError]) = r match\n  Ok(_) -> print(\"ok\")\n  Err(e) ->\n    print(kind(e))\n    print(message(e))\n"
    text += s"def main() =\n  val f = open(\"${full}flushed.txt\", Write)!\n  write(f, \"x\")!\n  shown(flush(f))\n"
    text += s"  val h = open(\"${full}closed.txt\", Write)!\n  write(h, \"x\")!\n  shown(close(h))\n  shown(close(h))\n  print(\"end\")\n"

    val out = ran_failing(b, full, text, "run_files_explicit_close_fails")

    remove_dir_all(dir).unwrap()
    finish(b)
    assert_eq(out.text, s"Failed\n${full}flushed.txt: no space left on the device\nFailed\n${full}closed.txt: no space left on the device\nok\nend\n")
    assert_eq(out.err.unwrap_or(""), "")
    assert(out.status == Status.Exited(0), s"${out.status}")
