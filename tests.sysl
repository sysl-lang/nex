@tests

// The corpus is the oracle every milestone is measured against, so the first thing checked is that
// it is all here: the index lists every program, and each one has its source and its output.

import sysl.buf.{Buf, buf}
import sysl.fs.read_text
import sysl.text.{from_utf8, split}

private val INDEX = from_utf8(embed("testdata/corpus/index.tsv")).unwrap()

// The rows after the header, each a corpus file stem and its metadata.
private rows() -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(INDEX, "\n")
        if line.len > 0 && !line.starts_with("file\t") then out.push(line)

    out

@test("the corpus index lists all 425 programs of the reference corpus")
corpus_count()
    assert_eq(rows().len(), 425)

@test("every program in the index has a source and an expected output")
corpus_files()
    for row in rows()
        val name = split(row, "\t")[0]

        assert(read_text(s"testdata/corpus/${name}.nex").is_ok(), name)
        assert(read_text(s"testdata/corpus/${name}.out").is_ok(), name)
