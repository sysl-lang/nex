@tests

// The toolchain the compiler will drive, driven from sysl: each hand-written MLIR proof in
// `experiments/mlir/` goes through `mlir-opt` with the pipeline in `pipeline.txt`, `mlir-translate`
// and `clang`, linked against the runtime in `runtime/` (a sysl archive `sysl build-c` writes), and the
// program it makes must print its corpus output byte for byte.
// The same tests pin the library calls the driver is built from: a child's stdin from a path and from
// a pipe this program wrote, a temporary directory, and a large text gathered in a `StrBuilder`.
//
// LLVM is found at `NEX_LLVM_HOME`, else Homebrew's; without `mlir-opt` there every test skips.

import sysl.env.get_or
import sysl.fs.{exists, make_temp_dir, read_text, remove_dir_all, write_text}
import sysl.buf.{Buf, buf}
import sysl.process.{Status, Stdio, capture, pipe}
import sysl.testing.{compiler, skip}
import sysl.text.{fields, split, str_builder}
import sysl.time.monotonic

private llvm_bin() -> string
    val dir = s"${get_or("NEX_LLVM_HOME", "/opt/homebrew/opt/llvm")}/bin"

    if !exists(s"$dir/mlir-opt") then skip(s"no mlir-opt in $dir")
    dir

// A tool run that must succeed, its stdout answered.
private tool(program: string, args: []const string, stdin: Stdio = Inherit) -> string
    val out = capture(program, args, stderr = true, stdin = stdin).unwrap()

    assert(out.status.ok(), s"$program: ${out.status}\n${out.err.unwrap_or("")}")
    out.text

// The runtime, built by the compiler running these tests as the archive a C link line takes.
private runtime_archive(work: string) -> string
    val archive = s"$work/libnex_rt.a"

    tool(compiler(), ["build-c", "runtime", "-o", archive])
    archive

// Lower one proof to a native program in `work`, linked against the runtime alone, and answer its path.
private lower(bin: string, work: string, proof: string) -> string
    val pipeline = read_text("experiments/mlir/pipeline.txt").unwrap().trim()
    val lowered = s"$work/$proof.llvm.mlir"

    tool(s"$bin/mlir-opt", [s"experiments/mlir/$proof.mlir", s"--pass-pipeline=$pipeline", "-o", lowered])

    // `mlir-translate` reads the lowered module on its stdin and writes LLVM IR to its stdout.
    write_text(s"$work/$proof.ll", tool(s"$bin/mlir-translate", ["--mlir-to-llvmir"],
                                        stdin = Stdio.FromPath(lowered))).unwrap()
    tool(s"$bin/clang", ["-Wno-override-module", "-O2", s"$work/$proof.ll", runtime_archive(work),
                         "-lm", "-o", s"$work/$proof"])
    s"$work/$proof"

private check_proof(proof: string, oracle: string)
    val bin = llvm_bin()
    val work = make_temp_dir("nex-toolchain").unwrap()
    val got = tool(lower(bin, work, proof), [])

    remove_dir_all(work).unwrap()
    assert_eq(got, read_text(oracle).unwrap())

@test("Newton's square root lowers through the pipeline and prints its corpus output")
proof_newton()
    check_proof("316-newton-sqrt", "testdata/corpus/316-06-numerical-methods-newton-s-method-for-sqrt.out")

@test("three elementwise operators fuse into one loop and print the point distances of the corpus")
proof_point_distance()
    check_proof("313-point-distance", "testdata/corpus/313-02-arrays-element-wise-fusion-point-distance.out")

@test("complex elementwise arithmetic emitted over re and im prints its corpus output")
proof_complex()
    check_proof("145-complex-elementwise", "testdata/corpus/145-elementwise-complex-via-componentwise-lowering.out")

@test("the runtime spells reals as the reference interpreter does, at 22 boundary values")
proof_real_spelling()
    check_proof("real-spelling", "experiments/mlir/real-spelling.out")

@test("every width nex has lowers: real16, real32, complex[real32], int8 overflow detection, int32 widening")
proof_precision()
    check_proof("precision", "experiments/mlir/precision.out")

@test("a trap inside MLIR-generated frames is caught and resumed by the runtime, and aborts uncaught")
proof_trap_catch()
    val bin = llvm_bin()
    val work = make_temp_dir("nex-toolchain").unwrap()
    val out = capture(lower(bin, work, "trap-catch"), [], stderr = true).unwrap()

    remove_dir_all(work).unwrap()
    assert_eq(out.text, read_text("experiments/mlir/trap-catch.out").unwrap())
    assert_eq(out.err.unwrap_or(""), "trap: complex division by zero\n")
    assert(out.status == Status.Signalled(6), s"${out.status}")

// One `main` and one allocator: the archive defines neither, so the program's `main` is the one MLIR
// generated and the runtime's heap is the libc `malloc` and `free` lowered memrefs call.
@test("the runtime archive defines no main and no allocator of its own, and takes libc's malloc")
runtime_one_main_one_allocator()
    val bin = llvm_bin()
    val work = make_temp_dir("nex-toolchain").unwrap()
    val symbols = tool(s"$bin/llvm-nm", ["-g", runtime_archive(work)])

    remove_dir_all(work).unwrap()

    var defined: Buf[string] = buf()
    var undefined: Buf[string] = buf()

    for line in split(symbols, "\n")
        val words = fields(line)

        if words.len == 2 && words[0] == "U" then undefined.push(words[1])
        else if words.len == 3 && words[1] != "U" then defined.push(words[2])

    for name in ["main", "malloc", "free", "calloc", "realloc"]
        assert(!names(defined, name), s"the archive defines $name")

    assert(names(undefined, "malloc"), "the runtime allocates through libc's malloc")
    assert(names(defined, "_mlir_ciface_nex_print_array_real"), symbols)
    assert(names(defined, "nex_catch_trap"), symbols)
    assert(names(defined, "nex_trap"), symbols)

// A C symbol as `nm` lists it: with the leading underscore Mach-O adds, or without, as ELF has it.
private names(symbols: Buf[string], name: string) -> bool
    for s in symbols
        if s == name || s == "_" + name then return true

    false

@test("the module named at a FromPath stdin is the one mlir-opt reads")
stdin_from_path()
    val bin = llvm_bin()
    val work = make_temp_dir("nex-toolchain").unwrap()
    val src = s"$work/a.mlir"

    write_text(src, "func.func @from_path(%x: f64) -> f64 {\n  return %x : f64\n}\n").unwrap()

    val text = tool(s"$bin/mlir-opt", ["-", "--canonicalize"], stdin = Stdio.FromPath(src))

    remove_dir_all(work).unwrap()
    assert(text.contains("func.func @from_path"), text)

@test("a pipe this program writes and closes feeds mlir-opt through FromFile")
stdin_from_pipe()
    val bin = llvm_bin()
    val (r, w) = pipe().unwrap()
    var wr = w
    var rd = r

    wr.write("func.func @from_pipe() {\n  return\n}\n".bytes)
    wr.close().unwrap()

    val text = tool(s"$bin/mlir-opt", ["-"], stdin = Stdio.FromFile(rd))

    rd.close().unwrap()
    assert(text.contains("func.func @from_pipe"), text)

@test("a missing input is mlir-opt's failure, reported through the status and stderr")
mlir_opt_failure()
    val bin = llvm_bin()
    val out = capture(s"$bin/mlir-opt", ["no-such-file.mlir"], stderr = true).unwrap()

    assert(!out.status.ok())
    assert(out.err.unwrap_or("").contains("no-such-file.mlir"), out.err.unwrap_or(""))

@test("a FromPath naming no file is refused before anything is started")
stdin_from_missing_path()
    assert(capture("/bin/cat", [], stdin = Stdio.FromPath("no-such-file.mlir")).is_err())

@test("a 46 MB module gathered a line at a time in a StrBuilder is built and written in seconds")
large_text()
    val work = make_temp_dir("nex-toolchain").unwrap()
    val start = monotonic()
    var b = str_builder()

    for i in 0..<1000000
        b.push("    %v")
        b.push_int(i)
        b.push(" = arith.addf %a, %b : f64 // ")
        b.push_real(1.5)
        b.push("\n")

    val text = b.finish()
    val built = monotonic()

    write_text(s"$work/big.mlir", text).unwrap()

    val written = monotonic()
    val back = read_text(s"$work/big.mlir").unwrap()

    remove_dir_all(work).unwrap()
    print(s"built ${text.len} bytes in ${(built - start).us / 1000} ms, wrote in ${(written - built).us / 1000} ms")
    assert_eq(back.len, text.len)
    assert(text.len > 45000000)
    assert(text.ends_with("    %v999999 = arith.addf %a, %b : f64 // 1.5\n"))
    assert((written - start).us < 10000000)
