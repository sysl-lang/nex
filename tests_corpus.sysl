@tests

// Every program of the reference corpus lexes and parses. The corpus was written for the reference
// implementation, so a program the parser refuses is a program the language accepts and this one
// does not.

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.read_text
import sysl.text.{from_utf8, split}

private val INDEX = from_utf8(embed("testdata/corpus/index.tsv")).unwrap()

private names() -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(INDEX, "\n")
        if line.len > 0 && !line.starts_with("file\t") then out.push(split(line, "\t")[0])

    out

@test("all 433 corpus programs lex")
corpus_lexes()
    var count = 0

    for name in names()
        val src = source_of(name, read_text(s"testdata/corpus/${name}.nex").unwrap())

        lex(src) match
            Ok(_) -> count += 1
            Err(d) -> assert(false, s"${name}: ${d.message} @${src.locate(d.span.start)}")

    assert_eq(count, 433)

// The categories whose programs are scalar: they use no struct, enum, generic or unit. Some of them
// still reach for an array, which the elaborator does not handle yet.
private val SCALAR_CATEGORIES = ["top-level bindings + print", "scalar arithmetic", "comparison + logical", "chained comparison", "chained comparisons", "control flow", "blocks + scoping", "top-level initialization", "compound assignment", "functions", "string interpolation", "const fn calls", "inout by-ref"]

private scalar_names() -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(INDEX, "\n")
        if line.len == 0 || line.starts_with("file\t") then continue

        val cols = split(line, "\t")

        for c in SCALAR_CATEGORIES
            if cols[1] == c then out.push(cols[0])

    out

@test("every scalar corpus program elaborates, or waits only on arrays")
corpus_scalar_programs_elaborate()
    var clean = 0
    var waiting = 0

    for name in scalar_names()
        val src = source_of(name, read_text(s"testdata/corpus/${name}.nex").unwrap())
        val p = parse_program(src).unwrap()

        elaborate(p) match
            Ok(_) -> clean += 1
            Err(ds) ->
                for d in ds
                    assert(d.message.ends_with("is not elaborated yet"), s"${name}: ${d.message} @${src.locate(d.span.start)}")

                waiting += 1

    assert_eq(clean, 115)
    assert_eq(waiting, 38)

// The categories of structs, tuples, enums and escaping closures, and of these the programs that
// still wait on arrays: every other one elaborates clean.
private val AGGREGATE_CATEGORIES = ["structs", "tuple destructuring", "paren-less tuple construction", "sum types (enums)", "closure escape (§4.11)"]

private val AGGREGATES_WAITING = [
    "210-field-write-through-an-array-element-receiver-mutates-the-sl",
    "270-return-a-paren-less-tuple-via-the-return-keyword",
]

@test("every struct, tuple, enum and closure-escape corpus program elaborates, or waits only on arrays")
corpus_aggregate_programs_elaborate()
    var clean = 0

    for line in split(INDEX, "\n")
        if line.len == 0 || line.starts_with("file\t") then continue

        val cols = split(line, "\t")
        var wanted = false

        for c in AGGREGATE_CATEGORIES
            if cols[1] == c then wanted = true

        if !wanted then continue

        val name = cols[0]
        var waits = false

        for w in AGGREGATES_WAITING
            if w == name then waits = true

        val src = source_of(name, read_text(s"testdata/corpus/${name}.nex").unwrap())

        elaborate(parse_program(src).unwrap()) match
            Ok(_) ->
                assert(!waits, s"${name} elaborates now; take it off the waiting list")
                clean += 1
            Err(ds) ->
                assert(waits, s"${name}: ${ds[0].message} @${src.locate(ds[0].span.start)}")

                for d in ds
                    assert(d.message.ends_with("is not elaborated yet"), s"${name}: ${d.message} @${src.locate(d.span.start)}")

    assert_eq(clean, 36)
end corpus_aggregate_programs_elaborate

@test("all 433 corpus programs parse")
corpus_parses()
    var count = 0

    for name in names()
        val src = source_of(name, read_text(s"testdata/corpus/${name}.nex").unwrap())

        parse_program(src) match
            Ok(_) -> count += 1
            Err(d) -> assert(false, s"${name}: ${d.message} @${src.locate(d.span.start)}")

    assert_eq(count, 433)
