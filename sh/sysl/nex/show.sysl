module sh.sysl.nex

// The printed forms of what the lexer and the parser produce: what `nex tokens` and `nex parse`
// print, and what the tests compare against.
//
// **A tree prints as an S-expression**, one form per node with its operator first: `(+ 1 (* 2 x))`,
// `(call f a b)`, `(def square ((x real)) real (* x x))`. A name, a number and a string print as
// themselves; a part left out prints as `_`. Types print in nex's own syntax, since they are short
// and have no precedence to show.

import sysl.buf.{Buf, buf}
import sysl.fmt.shortest
import sysl.text.{from_utf8_unchecked, join}
import sh.sysl.parsing.{Source, Spanned, write_quoted}

// -- tokens -----------------------------------------------------------------------------------------

// One token in a compact form: `K(def)` for a keyword or an operator, `ID(x)`, `N(42)`, `S(text)`,
// and `NL`, `INDENT`, `DEDENT` for the layout. An interpolated literal prints as its body after `s:`
// or `f:`.
show_token(src: Source, t: Tok) -> string = t match
    Num(text) -> s"N(${text})"
    Str(value) -> s"S(${escaped(value)})"
    Interp(pieces, format) -> s"S(${escaped(interp_body(src, pieces, format))})"
    Ident(name) -> s"ID(${name})"
    Keyword(text) -> s"K(${text})"
    UnitOpen -> "U<"
    UnitClose -> "U>"
    Newline -> "NL"
    Indent -> "INDENT"
    Dedent -> "DEDENT"
    Eof -> "EOF"

// The tokens of a file, without the end marker.
token_names(src: Source, toks: Buf[Spanned[Tok]]) -> Buf[string]
    var out: Buf[string] = buf()

    for t in toks
        t.value match
            Eof -> ()
            v -> out.push(show_token(src, v))

    out

show_tokens(src: Source, toks: Buf[Spanned[Tok]]) -> string = join(token_names(src, toks).view(), "\n") + "\n"

private interp_body(src: Source, pieces: Buf[Piece], format: bool) -> string
    var out = if format then "f:" else "s:"

    for p in pieces
        val piece = p match
            Chunk(text) -> text
            NameHole(at, spec) -> "$" + from_utf8_unchecked(src.text(at)) + spec
            ExprHole(at, spec) -> "${" + from_utf8_unchecked(src.text(at)) + "}" + spec

        out = out + piece

    out

// Control characters and the backslash written as escapes, so a token stays on one line.
private escaped(text: string) -> string
    var b: Buf[u8] = buf()

    for c in text.bytes
        if c == u8('\n') then
            b.extend("\\n".bytes)
        elif c == u8('\t') then
            b.extend("\\t".bytes)
        elif c == u8('\r') then
            b.extend("\\r".bytes)
        elif c == u8('\\') then
            b.extend("\\\\".bytes)
        else
            b.push(c)

    from_utf8_unchecked(b.view()).copy()

// -- the tree ---------------------------------------------------------------------------------------

private quoted(text: string) -> string = write_quoted(text, u8('"'))

// `(head item item ...)`.
private form(head: string, items: Buf[string]) -> string =
    if items.len() == 0 then "(" + head + ")" else "(" + head + " " + join(items.view(), " ") + ")"

private exprs_into(out: *Buf[string], es: Buf[Expr])
    for e in es
        out.push(show_expr(e))

// A loop's label as it was written, `name:`; nothing where the loop has none.
private label_into(out: *Buf[string], label: Option[string])
    label match
        Some(n) -> out.push(n + ":")
        None -> ()

private opt_expr(e: Option[Expr]) -> string = e match
    Some(x) -> show_expr(x)
    None -> "_"

// A real always with a point or an exponent, so it never reads as an integer.
private show_real(x: real) -> string
    val text = shortest(x)

    for c in text.bytes
        if c == u8('.') || c == u8('e') || c == u8('n') then return text

    text + ".0"

show_program(p: Program) -> string
    var out: Buf[string] = buf()

    for d in p.decls
        out.push(show_decl(d))

    join(out.view(), "\n")

private show_attr(a: Attribute) -> string
    if a.args.len() == 0 then return "@" + a.name

    var args: Buf[string] = buf()

    for arg in a.args
        args.push(arg match
            Str(v) -> quoted(v)
            Name(n) -> n
            Named(n, v) -> n + " = " + quoted(v))

    "@" + a.name + "(" + join(args.view(), ", ") + ")"

private attrs_prefix(attrs: Buf[Attribute]) -> string
    var head = ""

    for a in attrs
        head = head + show_attr(a) + " "

    head

// `(x real)`, `(v inout [real])`, `(@strided x [real])`, `(data @data(f) c_ptr)`, `(n integer 1)`
// with a default.
private show_params(params: Buf[Param]) -> string
    var ps: Buf[string] = buf()

    for p in params
        var text = attrs_prefix(p.attrs) + p.name + " "

        if p.mode == Inout then text = text + "inout "

        text = text + attrs_prefix(p.type_attrs) + show_type(p.typ)

        p.default match
            Some(e) -> text = text + " " + show_expr(e)
            None -> ()

        ps.push("(" + text + ")")

    "(" + join(ps.view(), " ") + ")"

private show_ret(ret: Option[Type]) -> string = ret match
    Some(t) -> show_type(t)
    None -> "_"

private generic(name: string, tps: Buf[TypeParam]) -> string
    if tps.len() == 0 then return name

    var out: Buf[string] = buf()

    for tp in tps
        out.push(tp.constraint match
            Some(c) -> tp.name + ": " + c
            None -> tp.name)

    name + "[" + join(out.view(), ", ") + "]"

private show_field(f: Field) -> string = f.default match
    Some(e) -> "(" + f.name + " " + show_type(f.typ) + " " + show_expr(e) + ")"
    None -> "(" + f.name + " " + show_type(f.typ) + ")"

show_decl(d: Decl) -> string
    var items: Buf[string] = buf()
    var head = attrs_prefix(d.attrs)

    if d.private_ then head = head + "private "

    *d.kind match
        Bind(kind, pat, typ, init) ->
            val word = kind match
                Val -> "val"
                Var -> "var"
                Const -> "const"

            head = head + word
            items.push(show_pattern(pat))

            typ match
                Some(t) ->
                    items.push(":")
                    items.push(show_type(t))
                None -> ()

            items.push(show_expr(init))
        Fun(name, tps, params, ret, body) ->
            head = head + "def"
            items.push(generic(name, tps))
            items.push(show_params(params))
            items.push(show_ret(ret))
            items.push(opt_expr(body))
        Extern(name, params, ret) ->
            head = head + "extern def"
            items.push(name)
            items.push(show_params(params))
            items.push(show_ret(ret))
        Struct(name, tps, fields) ->
            head = head + "struct"
            items.push(generic(name, tps))

            for f in fields
                items.push(show_field(f))
        Enum(name, tps, variants) ->
            head = head + "enum"
            items.push(generic(name, tps))

            for v in variants
                if v.fields.len() == 0
                    items.push(v.name)
                else
                    var fs: Buf[string] = buf()

                    fs.push(v.name)

                    for f in v.fields
                        fs.push(show_field(f))

                    items.push("(" + join(fs.view(), " ") + ")")
        Module(path) ->
            head = head + "module"
            items.push(join(path.view(), "."))
        Import(path, selectors, wildcard) ->
            head = head + "import"
            items.push(join(path.view(), "."))

            if wildcard then items.push("*")

            for sel in selectors
                items.push(sel.alias match
                    Some(a) -> "(" + sel.name + " as " + a + ")"
                    None -> sel.name)
        UnitDecl(name, factor, body) ->
            head = head + "unit"
            items.push(name)

            factor match
                Some(f) -> items.push(f)
                None -> ()

            body match
                Some(b) -> items.push(show_unit(b))
                None -> ()

    form(head, items)
end show_decl

show_pattern(p: Pattern) -> string = *p.kind match
    Name(n) -> n
    Wildcard -> "_"
    Tuple(elems) ->
        var out: Buf[string] = buf()

        for e in elems
            out.push(show_pattern(e))

        form("tuple", out)
    Variant(name, args) ->
        var out: Buf[string] = buf()

        for a in args
            out.push(show_pattern(a))

        form(name, out)

show_type(t: Type) -> string = *t.kind match
    Named(n) -> n
    Applied(n, args) -> n + "[" + types(args) + "]"
    Array(elem, axes) ->
        // `[T; :]` is the type `[T]` names, and prints the short way.
        var out: Buf[string] = buf()

        for a in axes
            out.push(a match
                AnyExtent -> ":"
                FixedExtent(n) -> n.to_string()
                NamedExtent(n) -> n)

        if out.len() == 1 && out[0] == ":" then return "[" + show_type(elem) + "]"

        "[" + show_type(elem) + "; " + join(out.view(), ", ") + "]"
    Tuple(elems) -> "(" + types(elems) + ")"
    Func(params, modes, ret) ->
        var out: Buf[string] = buf()

        for i in 0..<params.len()
            out.push((if modes[i] == Inout then "inout " else "") + show_type(params[i]))

        val ps = if params.len() == 1 then out[0] else "(" + join(out.view(), ", ") + ")"

        "(" + ps + " -> " + show_type(ret) + ")"
    Measured(base, u) -> show_type(base) + "<" + show_unit(u) + ">"

// A unit expression in its canonical spelling: factors side by side, `/` without blanks, an
// exponent after `^` (`^(1/2)` where it is a fraction), and parentheses only where the tree differs
// from what the spelling without them would read as: `kg m/s^2`, `J/(kg K)`, `(m/s)^2`.
show_unit(u: UnitExpr) -> string = *u.kind match
    One -> "1"
    Base(n) -> n
    Mul(l, r) -> unit_operand(l, false) + " " + unit_operand(r, true)
    Div(l, r) -> show_unit(l) + "/" + unit_divisor(r)
    Pow(b, num, den) ->
        val base = *b.kind match
            One -> show_unit(b)
            Base(_) -> show_unit(b)
            _ -> "(" + show_unit(b) + ")"

        base + "^" + (if den == 1 then num.to_string() else "(" + num.to_string() + "/" + den.to_string() + ")")

// A factor of a product: a quotient is parenthesised, and so is a product on the right, since a
// product associates to the left.
private unit_operand(u: UnitExpr, right: bool) -> string = *u.kind match
    Div(_, _) -> "(" + show_unit(u) + ")"
    Mul(_, _) -> if right then "(" + show_unit(u) + ")" else show_unit(u)
    _ -> show_unit(u)

// The right of a `/`: a quotient is parenthesised, since `/` associates to the left.
private unit_divisor(u: UnitExpr) -> string = *u.kind match
    Div(_, _) -> "(" + show_unit(u) + ")"
    _ -> show_unit(u)

private types(ts: Buf[Type]) -> string
    var out: Buf[string] = buf()

    for t in ts
        out.push(show_type(t))

    join(out.view(), ", ")

show_expr(e: Expr) -> string
    var items: Buf[string] = buf()

    *e.kind match
        IntLit(v) -> return v.to_string()
        RealLit(v) -> return show_real(v)
        BoolLit(v) -> return v.to_string()
        StrLit(v) -> return quoted(v)
        UnitLit -> return "()"
        Name(n) -> return n
        AxisAll -> return ":"
        End -> return "end"
        Interp(parts, format) ->
            for p in parts
                items.push(p match
                    Text(text) -> quoted(text)
                    Value(x, spec) -> if spec.len == 0 then show_expr(x) else "(spec " + show_expr(x) + " " + quoted(spec) + ")")

            return form(if format then "f" else "s", items)
        BinOp(op, l, r) ->
            items.push(show_expr(l))
            items.push(show_expr(r))
            return form(op, items)
        Chain(operands, ops) ->
            for i in 0..<operands.len()
                if i > 0 then items.push(ops[i - 1])

                items.push(show_expr(operands[i]))

            return form("chain", items)
        Unary(op, x) ->
            items.push(show_expr(x))
            return form(op, items)
        Juxtapose(c, b) ->
            items.push(show_expr(c))
            items.push(show_expr(b))
            return form("juxt", items)
        Measured(v, u) -> return show_expr(v) + "<" + show_unit(u) + ">"
        Range(lo, hi, inclusive, stride) ->
            items.push(opt_expr(lo))
            items.push(opt_expr(hi))

            stride match
                Some(k) ->
                    items.push("by")
                    items.push(show_expr(k))
                None -> ()

            return form(if inclusive then ".." else "..<", items)
        Array(elems) ->
            exprs_into(&items, elems)
            return form("array", items)
        Tuple(elems) ->
            exprs_into(&items, elems)
            return form("tuple", items)
        Call(callee, args) ->
            items.push(show_expr(callee))
            exprs_into(&items, args)
            return form("call", items)
        NamedArg(n, v) ->
            items.push(n)
            items.push(show_expr(v))
            return form("named", items)
        Index(target, indices) ->
            items.push(show_expr(target))
            exprs_into(&items, indices)
            return form("index", items)
        Field(r, n) ->
            items.push(show_expr(r))
            items.push(n)
            return form(".", items)
        TupleField(r, i) ->
            items.push(show_expr(r))
            items.push(i.to_string())
            return form(".", items)
        MethodCall(r, n, args) ->
            items.push(show_expr(r))
            items.push(n)
            exprs_into(&items, args)
            return form("method", items)
        Lambda(params, body) ->
            var ps: Buf[string] = buf()

            for p in params
                ps.push(p.typ match
                    Some(t) -> "(" + p.name + " " + show_type(t) + ")"
                    None -> p.name)

            items.push("(" + join(ps.view(), " ") + ")")
            items.push(show_expr(body))
            return form("fn", items)
        If(c, t, el) ->
            items.push(show_expr(c))
            items.push(show_expr(t))

            el match
                Some(x) -> items.push(show_expr(x))
                None -> ()

            return form("if", items)
        For(label, p, it, body) ->
            label_into(&items, label)
            items.push(show_pattern(p))
            items.push(show_expr(it))
            items.push(show_expr(body))
            return form("for", items)
        While(label, c, body) ->
            label_into(&items, label)
            items.push(show_expr(c))
            items.push(show_expr(body))
            return form("while", items)
        Exit(label) ->
            label match
                Some(n) -> items.push(n)
                None -> ()

            return form("exit", items)
        Cycle(label) ->
            label match
                Some(n) -> items.push(n)
                None -> ()

            return form("cycle", items)
        Stop(code) ->
            code match
                Some(x) -> items.push(show_expr(x))
                None -> ()

            return form("stop", items)
        ParallelFor(clauses, reductions, body) ->
            for c in clauses
                items.push("(" + c.name + " " + show_expr(c.range) + ")")

            if reductions.len() > 0
                var rs: Buf[string] = buf()

                for r in reductions
                    rs.push("(" + r.name + " " + r.op + ")")

                items.push("(reduce " + join(rs.view(), " ") + ")")

            items.push(show_expr(body))
            return form("parallel-for", items)
        Parallel(x) ->
            items.push(show_expr(x))
            return form("parallel", items)
        Return(v) ->
            v match
                Some(x) -> items.push(show_expr(x))
                None -> ()

            return form("return", items)
        Match(scrutinee, cases) ->
            items.push(show_expr(scrutinee))

            for c in cases
                items.push("(" + show_pattern(c.pat) + " " + show_expr(c.body) + ")")

            return form("match", items)
        Assign(op, t, v) ->
            items.push(show_expr(t))
            items.push(show_expr(v))
            return form(op, items)
        Block(its, result) ->
            for it in its
                items.push(it match
                    Item(d) -> show_decl(d)
                    Stmt(x) -> show_expr(x))

            items.push(show_expr(result))
            return form("block", items)
end show_expr
