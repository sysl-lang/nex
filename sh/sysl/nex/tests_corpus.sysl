@tests

// Every program of the reference corpus lexes and parses. The corpus was written for the reference
// implementation, so a program the parser refuses is a program the language accepts and this one
// does not.

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.read_text
import sysl.text.{from_utf8, split}

private val INDEX = from_utf8(embed("testdata/corpus/index.tsv")).unwrap()

private names() -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(INDEX, "\n")
        if line.len > 0 && !line.starts_with("file\t") then out.push(split(line, "\t")[0])

    out

@test("all 433 corpus programs lex")
corpus_lexes()
    var count = 0

    for name in names()
        val src = source_of(name, read_text(s"testdata/corpus/${name}.nex").unwrap())

        lex(src) match
            Ok(_) -> count += 1
            Err(d) -> assert(false, s"${name}: ${d.message} @${src.locate(d.span.start)}")

    assert_eq(count, 433)

// The categories whose programs are scalar: they use no struct, enum, generic or unit. Some of them
// still reach for an array, which the elaborator does not handle yet.
private val SCALAR_CATEGORIES = ["top-level bindings + print", "scalar arithmetic", "comparison + logical", "chained comparison", "chained comparisons", "control flow", "blocks + scoping", "top-level initialization", "compound assignment", "functions", "string interpolation", "const fn calls", "inout by-ref"]

private scalar_names() -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(INDEX, "\n")
        if line.len == 0 || line.starts_with("file\t") then continue

        val cols = split(line, "\t")

        for c in SCALAR_CATEGORIES
            if cols[1] == c then out.push(cols[0])

    out

@test("every scalar corpus program elaborates, or waits only on arrays")
corpus_scalar_programs_elaborate()
    var clean = 0
    var waiting = 0

    for name in scalar_names()
        val src = source_of(name, read_text(s"testdata/corpus/${name}.nex").unwrap())
        val p = parse_program(src).unwrap()

        elaborate(p) match
            Ok(_) -> clean += 1
            Err(ds) ->
                for d in ds
                    assert(d.message.ends_with("is not elaborated yet"), s"${name}: ${d.message} @${src.locate(d.span.start)}")

                waiting += 1

    assert_eq(clean, 153)
    assert_eq(waiting, 0)

// The categories whose programs are arrays and the array prelude.
private val ARRAY_CATEGORIES = ["arrays", "prelude", "[byte] buffer"]

@test("every corpus program of arrays, the array prelude and byte buffers elaborates")
corpus_array_programs_elaborate()
    var clean = 0

    for line in split(INDEX, "\n")
        if line.len == 0 || line.starts_with("file\t") then continue

        val cols = split(line, "\t")

        for c in ARRAY_CATEGORIES
            if cols[1] != c then continue

            val src = source_of(cols[0], read_text(s"testdata/corpus/${cols[0]}.nex").unwrap())

            elaborate(parse_program(src).unwrap()) match
                Ok(_) -> clean += 1
                Err(ds) -> assert(false, s"${cols[0]}: ${ds[0].message} @${src.locate(ds[0].span.start)}")

    assert_eq(clean, 139)

// The categories of structs, tuples, enums and escaping closures.
private val AGGREGATE_CATEGORIES = ["structs", "tuple destructuring", "paren-less tuple construction", "sum types (enums)", "closure escape (§4.11)"]

@test("every struct, tuple, enum and closure-escape corpus program elaborates")
corpus_aggregate_programs_elaborate()
    var clean = 0

    for line in split(INDEX, "\n")
        if line.len == 0 || line.starts_with("file\t") then continue

        val cols = split(line, "\t")
        var wanted = false

        for c in AGGREGATE_CATEGORIES
            if cols[1] == c then wanted = true

        if !wanted then continue

        val name = cols[0]
        val src = source_of(name, read_text(s"testdata/corpus/${name}.nex").unwrap())

        elaborate(parse_program(src).unwrap()) match
            Ok(_) -> clean += 1
            Err(ds) -> assert(false, s"${name}: ${ds[0].message} @${src.locate(ds[0].span.start)}")

    assert_eq(clean, 38)
end corpus_aggregate_programs_elaborate

// The categories of views and of the copies `var` arrays need.
private val VIEW_CATEGORIES = ["view-style slicing", "rank-2 view-style slicing", "rank-2 sub-rectangle view-style slicing", "rank-1 strided view-style slicing", "auto-clone (§8.3)"]

@test("every view and auto-clone corpus program elaborates")
corpus_view_programs_elaborate()
    var clean = 0

    for line in split(INDEX, "\n")
        if line.len == 0 || line.starts_with("file\t") then continue

        val cols = split(line, "\t")

        for c in VIEW_CATEGORIES
            if cols[1] != c then continue

            val src = source_of(cols[0], read_text(s"testdata/corpus/${cols[0]}.nex").unwrap())

            elaborate(parse_program(src).unwrap()) match
                Ok(_) -> clean += 1
                Err(ds) -> assert(false, s"${cols[0]}: ${ds[0].message} @${src.locate(ds[0].span.start)}")

    assert_eq(clean, 49)

// The categories of generic functions, structs and enums.
private val GENERIC_CATEGORIES = ["user generics", "user generic structs", "user generic enums"]

@test("every generic function, struct and enum corpus program elaborates")
corpus_generic_programs_elaborate()
    var clean = 0

    for line in split(INDEX, "\n")
        if line.len == 0 || line.starts_with("file\t") then continue

        val cols = split(line, "\t")
        var wanted = false

        for c in GENERIC_CATEGORIES
            if cols[1] == c then wanted = true

        if !wanted then continue

        val src = source_of(cols[0], read_text(s"testdata/corpus/${cols[0]}.nex").unwrap())

        elaborate(parse_program(src).unwrap()) match
            Ok(_) -> clean += 1
            Err(ds) -> assert(false, s"${cols[0]}: ${ds[0].message} @${src.locate(ds[0].span.start)}")

    assert_eq(clean, 36)
end corpus_generic_programs_elaborate

@test("every units-of-measure corpus program elaborates")
corpus_units_programs_elaborate()
    var clean = 0

    for line in split(INDEX, "\n")
        if line.len == 0 || line.starts_with("file\t") then continue

        val cols = split(line, "\t")

        if cols[1] != "units of measure" then continue

        val src = source_of(cols[0], read_text(s"testdata/corpus/${cols[0]}.nex").unwrap())

        elaborate(parse_program(src).unwrap()) match
            Ok(_) -> clean += 1
            Err(ds) -> assert(false, s"${cols[0]}: ${ds[0].message} @${src.locate(ds[0].span.start)}")

    assert_eq(clean, 6)

@test("all 433 corpus programs parse")
corpus_parses()
    var count = 0

    for name in names()
        val src = source_of(name, read_text(s"testdata/corpus/${name}.nex").unwrap())

        parse_program(src) match
            Ok(_) -> count += 1
            Err(d) -> assert(false, s"${name}: ${d.message} @${src.locate(d.span.start)}")

    assert_eq(count, 433)
