module sh.sysl.nex

// Fusion of an element-wise expression (DESIGN §7.1, §9.5): the operators, elemental calls,
// conversions, widenings and rescalings of a whole element-wise expression become one scalar
// computation over the arrays and values at its leaves, so each element is computed whole before the
// next. Both engines compute a `parallel` element-wise expression and a `parallel` reduction's
// operand from this one form, so a trap is the same one on each. Without `parallel` the compiled
// engine fuses an expression only where it is `quiet`, and the interpreter computes operation by
// operation; the two agree because nothing a quiet expression does tells them apart.

import sysl.buf.{Buf, buf}

// Whether `e` is an array computed element by element from operands of its own shape or broadcast
// values, so that a `parallel` expression computes it inside its consumer's loop. `and` and `or`
// stay apart: their scalar forms skip the right side, and an operand array is computed whole.
fusible(e: TExpr) -> bool
    if !is_arr(e.ty) then return false

    *e.kind match
        TPromote(v) -> !ty_eq(elem_of(v.ty), elem_of(e.ty))
        TRescale(_, _) -> true
        TArray(op) -> *op match
            TElementwise(o, _, _) -> o != "and" && o != "or"
            TElementwiseUnary(_, _) -> true
            TElemental(_, _) -> true
            TElementalConvert(_, _) -> true
            TElementalCall(_, _) -> true
            _ -> false
        _ -> false

// The element of `e`, an element-wise operation, as a scalar over `leaves`: an operand that is
// itself one is fused in, anything else is a leaf, an array read at the element or a value
// broadcast, pushed onto `leaves` in source order and read as `TChainOperand` of its position.
fused_scalar(e: TExpr, leaves: *Buf[TExpr]) -> TExpr
    if !fusible(e)
        leaves.push(e)
        return chain_leaf(e, leaves.len() - 1)

    val kind = *e.kind match
        TPromote(v) -> TKind.TPromote(fused_scalar(v, leaves))
        TRescale(v, factor) -> TKind.TRescale(fused_scalar(v, leaves), factor)
        TArray(op) -> *op match
            TElementwise(o, l, r) ->
                val a = fused_scalar(l, leaves)

                TKind.TBinary(o, a, fused_scalar(r, leaves))
            TElementwiseUnary(o, v) -> TKind.TUnary(o, fused_scalar(v, leaves))
            TElemental(name, args) -> TKind.TBuiltin(name, fused_args(args, leaves))
            TElementalConvert(v, traps) -> TKind.TConvert(fused_scalar(v, leaves), traps)
            TElementalCall(callee, args) -> TKind.TCall(callee, fused_args(args, leaves))
            _ -> TKind.TChainOperand(0)
        _ -> TKind.TChainOperand(0)

    texpr(e.span, elem_of(e.ty), kind)

private fused_args(args: Buf[TExpr], leaves: *Buf[TExpr]) -> Buf[TExpr]
    var out: Buf[TExpr] = buf()

    for a in args
        out.push(fused_scalar(a, leaves))

    out

// The operands of `e`, a fusible operation, in source order: the order `fused_scalar` meets its
// leaves in.
fused_operands(e: TExpr) -> Buf[TExpr]
    var out: Buf[TExpr] = buf()

    *e.kind match
        TPromote(v) -> out.push(v)
        TRescale(v, _) -> out.push(v)
        TArray(op) -> *op match
            TElementwise(_, l, r) ->
                out.push(l)
                out.push(r)
            TElementwiseUnary(_, v) -> out.push(v)
            TElemental(_, args) -> return args
            TElementalConvert(v, _) -> out.push(v)
            TElementalCall(_, args) -> return args
            _ -> ()
        _ -> ()

    out

// Whether `s`, a scalar made by `fused_scalar`, can neither trap nor print, so that computing it
// element by element, each element whole, is indistinguishable from computing it operation by
// operation over whole arrays. Real and complex arithmetic is quiet without `--fpe-trap` (`fpe`), but
// complex division, which traps on a zero divisor; a comparison is quiet over any numbers; integer
// arithmetic traps on overflow, a conversion that checks its range traps, and an `@elemental`
// function may trap or print, so none of them is. `merge` is as quiet as its three operands. A bit
// function (spec §12.2.2) cannot overflow: `iand`, `ior`, `ieor` and the counting functions are quiet,
// and a shift or a bit-position function is where each count is a literal, among `leaves`, that the
// word takes.
quiet(s: TExpr, fpe: bool, leaves: Buf[TExpr]) -> bool = *s.kind match
    TChainOperand(_) -> true
    TPromote(v) -> quiet(v, fpe, leaves) && (is_floating(s.ty) && !fpe || is_int(base_of(s.ty)) && is_int(base_of(v.ty)))
    TRescale(v, _) -> !fpe && is_floating(s.ty) && quiet(v, fpe, leaves)
    TUnary(o, v) -> quiet(v, fpe, leaves) && (o == "not" || o == "-" && !fpe && is_floating(v.ty))
    TBinary(o, a, b) ->
        if !quiet(a, fpe, leaves) || !quiet(b, fpe, leaves) then return false

        if o == "==" || o == "!=" || o == "<" || o == "<=" || o == ">" || o == ">=" then return true
        if fpe then return false

        // A real raised to any power.
        if o == "^" then return is_real(base_of(a.ty)) && (is_floating(b.ty) || is_int(base_of(b.ty)))
        if !is_floating(a.ty) || !is_floating(b.ty) then return false

        o == "+" || o == "-" || o == "*" || o == "/" && is_real(base_of(b.ty)) && is_real(base_of(a.ty))
    TBuiltin(name, args) ->
        // `merge` only picks one of two values it was given, which cannot trap.
        if name == "merge" || is_bit_function(name)
            for a in args
                if !quiet(a, fpe, leaves) then return false

            if name == "merge" || is_bit_logic(name) || is_bit_count(name) then return true

            return counts_fit(name, args, leaves)

        if fpe || !is_floating(s.ty) then return false

        for a in args
            if !is_floating(a.ty) || !quiet(a, fpe, leaves) then return false

        true
    TConvert(v, traps) -> !traps && !fpe && is_floating(s.ty) && is_floating(v.ty) && quiet(v, fpe, leaves)
    _ -> false

// Whether the counts of shift or bit-position function `name` (its arguments after the word) are
// literals that its word takes, so that it cannot trap.
private counts_fit(name: string, args: Buf[TExpr], leaves: Buf[TExpr]) -> bool
    val bits = bits_of(base_of(args[0].ty))
    val n = written_count(args[1], leaves) match
        Some(v) -> v
        None -> return false

    if is_bit_shift(name) then return shift_in_range(name, n, bits)

    val len = if args.len() == 3 then (written_count(args[2], leaves) match
        Some(v) -> v
        None -> return false) else i128(1)

    position_in_range(name, n, len, bits)

// The integer `e` is, where it is a literal: written in the scalar, or a leaf that is one.
private written_count(e: TExpr, leaves: Buf[TExpr]) -> Option[i128] = *e.kind match
    TChainOperand(k) -> if k < leaves.len() then (*leaves[k].kind match
        TChainOperand(_) -> None
        _ -> written_count(leaves[k], leaves)) else None
    TLiteral(IntVal(v), _) -> Some(v)
    TPromote(v) -> written_count(v, leaves)
    TUnary(o, v) -> if o == "-" then (written_count(v, leaves) match
        Some(x) -> Some(-x)
        None -> None) else None
    _ -> None

// Whether `t` is a real or a complex number, measured or not.
private is_floating(t: Ty) -> bool = is_real(base_of(t)) || is_complex(base_of(t))

// An operand of a scalar body: the `k`th value of the innermost chain frame, of `e`'s element type.
chain_leaf(e: TExpr, k: usize) -> TExpr = texpr(e.span, elem_of(e.ty), TChainOperand(k))

// Whether `t` is an array of numbers or booleans: a tensor.
is_arr(t: Ty) -> bool = t match
    Array(e, _) -> is_number_ty(*e)
    _ -> false

// Whether `t` is a number or a boolean, an element a tensor holds.
is_number_ty(t: Ty) -> bool = t match
    Int(_, _) -> true
    Real(_) -> true
    Complex(_) -> true
    Bool -> true
    Measured(b, _) -> is_number_ty(*b)
    _ -> false
