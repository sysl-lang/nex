@tests

// The exclusivity check of DESIGN §8.3: each rule with a call it refuses, and each disjoint form
// with a call it accepts.

private val SW = "def sw(x: inout integer, y: inout integer) =\n  val t = x\n  x = y\n  y = t\n"
private val F = "def f(x: inout [real], y: inout [real]) = ()\n"
private val G = "def g(x: inout [real; :, :], y: inout [real; :, :]) = ()\n"
private val AXPY = "def axpy(s: real, x: [real], y: inout [real]) = y = y + s * x\n"

private in_main(decls: string, body: string) -> string = refused(decls + "def main() =\n" + body)

// -- rule 1: two inout arguments on one variable --------------------------------------------------

@test("two inout arguments on one variable are refused unless the source shows them apart")
ino_same_root()
    assert_eq(in_main(SW, "  var a = 1\n  sw(a, a)\n"),
        "error: `a` and `a` are both passed `inout` and overlap; an `inout` argument must be the only access to its place while the call runs @7:9")
    assert_eq(in_main(SW, "  var a = [1, 2, 3]\n  val i = 1\n  val j = 2\n  sw(a[i], a[j])\n"),
        "error: `a[i]` and `a[j]` may overlap; borrow `a[1..e]` and `a[e+1..]` at one split point `e` @9:12")
    assert_eq(in_main(F, "  var a: [real] = zeros(8)\n  val k = 4\n  val j = 5\n  f(a[1..k], a[j..8])\n"),
        "error: `a[1..k]` and `a[j..8]` may overlap; borrow `a[1..e]` and `a[e+1..]` at one split point `e` @6:14")
    assert_eq(in_main("def h(x: inout [real], y: inout real) = ()\n", "  var a: [real] = zeros(8)\n  h(a, a[1])\n"),
        "error: `a` and `a[1]` are both passed `inout` and overlap; an `inout` argument must be the only access to its place while the call runs @4:8")
    assert_eq(in_main("struct P\n  x: integer\n  y: integer\n" + SW, "  var p = P(1, 2)\n  sw(p.x, p.x)\n"),
        "error: `p.x` and `p.x` are both passed `inout` and overlap; an `inout` argument must be the only access to its place while the call runs @10:11")
    assert_eq(in_main(G, "  var m: [real; :, :] = zeros((3, 3))\n  val e = 1\n  g(m[:, ..e], m[:, e..])\n"),
        "error: `m[:, ..e]` and `m[:, e..]` may overlap; borrow `m[:, ..e]` and `m[:, e+1..]` at one split point `e` @5:16")

@test("two inout arguments are accepted on different fields, constant windows and indices, and a split at one e")
ino_disjoint_forms()
    assert_eq(in_main("struct P\n  x: integer\n  y: integer\n" + SW, "  var p = P(1, 2)\n  sw(p.x, p.y)\n"), "ok")
    assert_eq(in_main(F, "  var a: [real] = zeros(8)\n  f(a[1..4], a[5..8])\n  f(a[5..], a[..<5])\n  f(a[..4], a[5..end])\n"), "ok")
    assert_eq(in_main(SW, "  var a = [1, 2, 3]\n  sw(a[1], a[2])\n  sw(a[3], a[1])\n"), "ok")
    assert_eq(in_main(F, "  var m: [real; :, :] = zeros((3, 3))\n  f(m[:, 1], m[:, 2])\n  f(m[1, :], m[3, :])\n"), "ok")
    assert_eq(in_main(G, "  var m: [real; :, :] = zeros((3, 3))\n  g(m[1..1, :], m[2..3, :])\n"), "ok")
    assert_eq(in_main(F, "  var a: [real] = zeros(8)\n  val e = 3\n  val n = 8\n  f(a[1..e], a[e+1..n])\n  f(a[..<e], a[e..])\n  f(a[e+1..], a[..e])\n"), "ok")
    assert_eq(in_main(G, "  var m: [real; :, :] = zeros((3, 3))\n  val e = 1\n  g(m[:, ..e], m[:, e+1..])\n"), "ok")
    assert_eq(in_main(SW, "  var a = [1, 2, 3]\n  var i = 1\n  sw(a[i], a[i+1])\n"), "ok")
    assert_eq(in_main(F, "  var a: [real] = zeros(8)\n  val e = 3\n  f(a[..e-1], a[e..])\n"), "ok")
    assert_eq(in_main("struct P\n  x: integer\n  y: integer\n" + SW, "  var a = [P(1, 2), P(3, 4)]\n  val k = 1\n  sw(a[k].x, a[k].y)\n"), "ok")
    assert_eq(in_main("struct P\n  x: integer\n  y: integer\n" + SW, "  var a = [P(1, 2), P(3, 4)]\n  val k = 1\n  sw(a[k].x, a[k].x)\n"),
        "error: `a[k].x` and `a[k].x` are both passed `inout` and overlap; an `inout` argument must be the only access to its place while the call runs @11:14")

@test("a split point is one expression on both sides, and nothing the call evaluates may change it")
ino_split_point()
    assert_eq(in_main(F, "  var a: [real] = zeros(8)\n  val e = 3\n  val d = 3\n  f(a[1..e], a[d+1..])\n"),
        "error: `a[1..e]` and `a[d+1..]` may overlap; borrow `a[1..e]` and `a[e+1..]` at one split point `e` @6:14")
    assert_eq(in_main(F, "  var a: [real] = zeros(8)\n  val e = 3\n  f(a[1..e+1], a[e+1..])\n"),
        "error: `a[1..e+1]` and `a[e+1..]` may overlap; borrow `a[1..e]` and `a[e+1..]` at one split point `e` @5:16")
    assert_eq(in_main("var e = 3\ndef step(): integer =\n  e += 1\n  e\ndef f(x: inout [real], k: integer, y: inout [real]) = ()\n",
        "  var a: [real] = zeros(8)\n  f(a[1..e], step(), a[e+1..])\n"),
        "error: `a[1..e]` and `a[e+1..]` may overlap; borrow `a[1..e]` and `a[e+1..]` at one split point `e` @8:22")
    assert_eq(in_main(F, "  var a: [real] = zeros(8)\n  f(a[1..8 by 2], a[2..8 by 2])\n"),
        "error: `a[1..8 by 2]` and `a[2..8 by 2]` may overlap; borrow `a[1..e]` and `a[e+1..]` at one split point `e` @4:19")
    assert_eq(in_main(F, "  var a: [real] = zeros(8)\n  f(a[1..4 by 2], a[5..8])\n"), "ok")

// -- rule 2: an inout argument beside one that reads ----------------------------------------------

@test("an inout argument beside a read-mode argument that shares its storage is refused")
ino_read_beside()
    assert_eq(in_main(F + AXPY, "  var a: [real] = zeros(8)\n  axpy(2.0, a, a)\n"),
        "error: `a` is read while the call runs, and overlaps `a`, which the call borrows `inout`; an `inout` argument must be the only access to its place @5:13")
    assert_eq(in_main(AXPY, "  var a: [real] = zeros(8)\n  axpy(2.0, a[1..3], a)\n"),
        "error: `a[1..3]` is read while the call runs, and overlaps `a`, which the call borrows `inout`; an `inout` argument must be the only access to its place @4:13")
    assert_eq(in_main(AXPY, "  var a: [real] = zeros(8)\n  axpy(2.0, a[1..5], a[5..8])\n"),
        "error: `a[1..5]` is read while the call runs and may overlap `a[5..8]`, which the call borrows `inout`; borrow `a[1..e]` and `a[e+1..]` at one split point `e` @4:13")
    assert_eq(in_main(AXPY, "  var a: [real] = zeros(8)\n  val v = a[1..5]\n  axpy(2.0, v, a[5..8])\n"),
        "error: `v` is read while the call runs and may overlap `a[5..8]`, which the call borrows `inout`; borrow `a[1..e]` and `a[e+1..]` at one split point `e` @5:13")

@test("an inout window beside a read-mode window is accepted in the three disjoint forms, and a scalar read never conflicts")
ino_read_disjoint()
    assert_eq(in_main(AXPY, "  var a: [real] = zeros(8)\n  axpy(2.0, a[1..4], a[5..8])\n  val e = 4\n  axpy(2.0, a[..e], a[e+1..])\n  axpy(2.0, a[e..], a[..<e])\n"), "ok")
    assert_eq(in_main("def col(s: real, x: [real], y: inout [real]) = ()\n", "  var m: [real; :, :] = zeros((3, 3))\n  col(2.0, m[:, 1], m[:, 2])\n"), "ok")
    assert_eq(in_main("def scale(v: inout [real], s: real) = v = v * s\n", "  var a: [real] = zeros(8)\n  scale(a, a[1])\n  scale(a, sum(a))\n"), "ok")
    assert_eq(in_main("def resize(v: inout [real], n: integer) = ()\n", "  var a: [real] = zeros(8)\n  resize(a, length(a))\n"), "ok")
    assert_eq(in_main(AXPY, "  var a: [real] = zeros(8)\n  val v = a[1..4]\n  axpy(2.0, v, a[5..8])\n"), "ok")

@test("a function passed beside an inout argument may not reach the borrowed variable")
ino_function_beside()
    val decl = "def app(x: inout integer, k: () -> integer) = x = k()\n"

    assert_eq(in_main(decl, "  var n = 1\n  app(n, () -> n + 1)\n"),
        "error: the function passed here reaches `n`, which `n` borrows `inout` for the call; an `inout` argument must be the only access to its place while the call runs @4:10")
    assert_eq(in_main("var g = 1\ndef peek(): integer = g\n" + decl, "  app(g, peek)\n"),
        "error: the function passed here reaches `g`, which `g` borrows `inout` for the call; an `inout` argument must be the only access to its place while the call runs @5:10")
    assert_eq(in_main(decl, "  var n = 1\n  val m = 2\n  app(n, () -> m + 1)\n"), "ok")

// -- rule 3: access by another route -----------------------------------------------------------------

@test("a module var passed inout to a function that reaches it by name is refused, transitively")
ino_other_route()
    assert_eq(in_main("var g = 1\ndef bump(x: inout integer) = x = g + 1\n", "  bump(g)\n"),
        "error: `g` is passed `inout` to `bump`, which also reads or writes the module variable `g` by name while the call runs; an `inout` argument must be the only access to its place @4:8")
    assert_eq(in_main("var g = 1\ndef peek(): integer = g\ndef bump(x: inout integer) = x = peek() + 1\n", "  bump(g)\n"),
        "error: `g` is passed `inout` to `bump`, which also reads or writes the module variable `g` by name while the call runs; an `inout` argument must be the only access to its place @5:8")
    assert_eq(in_main("var g: [real] = zeros(4)\ndef clear() = g = zeros(4)\ndef scale(v: inout [real]) =\n  clear()\n  v = v * 2.0\n", "  scale(g[1..2])\n"),
        "error: `g[1..2]` is passed `inout` to `scale`, which also reads or writes the module variable `g` by name while the call runs; an `inout` argument must be the only access to its place @7:9")
    assert_eq(in_main("var g = 1\nvar h = 1\ndef bump(x: inout integer) = x = h + 1\n", "  bump(g)\n"), "ok")

@test("a local passed inout to a local function that captures it is refused")
ino_captured_route()
    assert_eq(in_main("", "  var n = 1\n  def inc(x: inout integer) = x = n + 1\n  inc(n)\n"),
        "error: `n` is passed `inout` to a lambda that captures `n` itself; an `inout` argument must be the only access to its place while the call runs @4:7")
    assert_eq(in_main("", "  var n = 1\n  var k = 1\n  def inc(x: inout integer) = x = k + 1\n  inc(n)\n"), "ok")

// -- rule 4: escaping captures --------------------------------------------------------------------

@test("an inout parameter may be captured by a lambda passed straight as an argument, never by one that escapes")
ino_escaping_capture()
    assert(in_main("def f(v: inout integer): () -> integer = () -> v\n", "  ()\n").starts_with("error: this lambda captures the `inout` parameter `v`"))
    assert_eq(in_main("def twice(k: () -> integer): integer = k() + k()\ndef f(v: inout integer) = v = twice(() -> v)\n", "  ()\n"), "ok")
