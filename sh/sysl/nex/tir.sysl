module sh.sysl.nex

// The typed IR: the program after elaboration, every name resolved and every type known.
//
// **Every expression carries its type, and nothing about it is left implicit.** A widening along
// the lattice of DESIGN §2.2 is a `TPromote` node whose type is the wider one; a literal or a prelude
// constant that took its type from its context (DESIGN §2.3) says so with `adopted`; a conversion
// function is a `TConvert` that says whether it can trap (DESIGN §2.4); a compound assignment carries
// its operator and a right-hand side already in the target's type. So a later phase reads off what
// to do and never decides it again.
//
// **A name is resolved to its binding.** A local — a parameter, a `val`, `var`, a loop variable, a
// lambda's parameter — is a number into `TProgram.locals`, which holds its name, its type and how it
// was bound; two bindings that share a spelling have two numbers. A module-level binding and a
// function are their names, which the top level keeps unique. A loop is a number too, which is what
// an `exit` or a `cycle` names once its label is resolved.
//
// **A lambda is a number into `TProgram.lambdas`**, with its parameters, its result type, the locals
// it captures from the functions around it and its body. A local `def` is a lambda bound to a local.
// Keeping them in a table is what lets a lambda whose parameter types come from its first call be
// elaborated at that call, after the binding that holds it was built.
//
// **A unit of measure is in the types and nowhere else** (DESIGN §13.8). A `Measured` type says what
// unit a value is in; mixing scales is a `TRescale` with its exact factor, and attaching, renaming or
// removing a unit a `TUnitAs` that changes no number. Printing a value with a unit is already an
// interpolation that spells the unit as text. So emission erases every type with `erase` and reads the
// `TRescale` factors, and nothing else about units reaches it.
//
// **A struct or an enum is declared once, in `TProgram.decls`, and named by its type everywhere
// else**: a field and a variant carry their position in that declaration beside their name, so a
// later phase lays them out without looking a name up.

import sysl.buf.{Buf, buf}
import sh.sysl.parsing.Span

enum Lit
    // Wide enough for every value of `int64` and of `uint64`.
    IntVal(v: i128)
    RealVal(v: real)
    BoolVal(v: bool)
    StrVal(v: string)
    // `()`: the one value of `void`.
    VoidVal

struct TExpr
    span: Span
    ty: Ty
    kind: &TKind

// One comparison of a chain: the operator, and its two sides written over `TChainOperand` leaves,
// promoted to the type the comparison is made in.
struct Link
    op: string
    lhs: TExpr
    rhs: TExpr

// A piece of an interpolated literal: text, or a value with its `f"..."` specifier (`""` for none).
enum TPart
    TText(text: string)
    TValue(value: TExpr, spec: string)

enum TKind
    TLiteral(value: Lit, adopted: bool)
    // A prelude constant, `pi`, `e`, `inf`, `nan` or the imaginary unit `i`, typed like a literal.
    TConstant(name: string, adopted: bool)
    TLocal(id: usize)
    TGlobalRef(name: string)
    // A top-level `def` used as a value or called.
    TFnRef(name: string)
    // The implicit widening of `value` to this node's type.
    TPromote(value: TExpr)
    // A conversion function applied to `value`; `traps` where the value can be out of the target's
    // range (a narrower integer, a change of signedness, a real to an integer).
    TConvert(value: TExpr, traps: bool)
    // `value` in a unit of the same dimension and another scale: one multiplication by `factor`, the
    // exact ratio of the two scales, which emission rounds once to the value's width (DESIGN §13.8).
    // On an array value it multiplies every element.
    TRescale(value: TExpr, factor: Ratio)
    // `value` with a unit attached (`x<m>`), renamed to an equal unit (`to<N>(m)`), or removed
    // (`strip(x)`): the number is unchanged, and the node's type says which. On an array value it
    // is the same storage under another element type.
    TUnitAs(value: TExpr)
    // `complex[realN](re, im)`: both parts already of the part type.
    TMakeComplex(re: TExpr, im: TExpr)
    // `z.re` or `z.im`.
    TComplexPart(value: TExpr, imag: bool)
    // An arithmetic or comparison operator on two operands already of one type; the node's type is
    // the result's.
    TBinary(op: string, lhs: TExpr, rhs: TExpr)
    // `and` or `or`, which evaluate the right only where the left does not decide.
    TLogical(op: string, lhs: TExpr, rhs: TExpr)
    // `-x` or `not x`.
    TUnary(op: string, operand: TExpr)
    // `a < b <= c`: each operand evaluated once, left to right, stopping at the first false link.
    TChain(operands: Buf[TExpr], links: Buf[Link])
    // The `k`th operand of the chain around it, inside one of its links.
    TChainOperand(k: usize)
    // A call of a function value: a `TFnRef`, a local holding a function or a lambda. The arguments
    // are in parameter order with every default filled in, each already of its parameter's type.
    TCall(callee: TExpr, args: Buf[TExpr])
    // A prelude function, `print`, `sqrt`, `max`, by name.
    TBuiltin(name: string, args: Buf[TExpr])
    // The caller's place passed to an `inout` parameter.
    TBorrow(place: TExpr)
    TLambdaRef(id: usize)
    TInterp(parts: Buf[TPart], format: bool)
    TIf(cond: TExpr, then_branch: TExpr, else_branch: Option[TExpr])
    TWhile(loop_id: usize, cond: TExpr, body: TExpr)
    // `for v in lo..hi by step`: an integer loop over a range, `inclusive` of `hi` or stopping before
    // it; `var_id` is the loop variable's local.
    TFor(loop_id: usize, var_id: usize, lo: TExpr, hi: TExpr, inclusive: bool, step: Option[TExpr], body: TExpr)
    TBlock(items: Buf[TExpr], result: TExpr)
    // `val`/`var` inside a body: the local it binds, and its initial value in the local's type.
    TLet(id: usize, init: TExpr)
    // `target = value` or a compound `target += value`, whose `op` is the operator (`=` for a plain
    // store); `value` is already in the target's type.
    TAssign(op: string, target: TExpr, value: TExpr)
    // `a, b = b, a`: `value`, a tuple, is evaluated whole, and then each of its elements is stored
    // into its target, left to right.
    TAssignTuple(target: TTarget, value: TExpr)
    TReturn(value: Option[TExpr])
    TExit(loop_id: usize)
    TCycle(loop_id: usize)
    TStop(code: Option[TExpr])
    // `(a, b)` or `a, b`: each element already of its element type.
    TTuple(elems: Buf[TExpr])
    // `t.1`: the element at position `k` from 0, which the language writes counting from 1.
    TTupleField(value: TExpr, k: usize)
    // `Point(x, y)`: a struct built from a value for each field, in declaration order, each already
    // of its field's type.
    TNew(args: Buf[TExpr])
    // `p.x`: the field `name`, at position `k` from 0 in its struct's declaration.
    TField(value: TExpr, name: string, k: usize)
    // `Converged(x)` or `Diverged`: the variant `name` of the node's enum type, `tag` its position
    // from 0 in the declaration, with a value for each of its fields.
    TVariant(name: string, tag: usize, args: Buf[TExpr])
    // `s match ...`: the arms in the order written, the first that matches taken.
    TMatch(scrutinee: TExpr, arms: Buf[TArm])
    // `val a, (b, _) = t` inside a body: the tuple taken apart into the locals `pat` names.
    TDestructure(kind: BindKind, pat: TBind, init: TExpr)
    // An array node: `tir_array.sysl`.
    TArray(op: &TArr)
    // A parallel node: `tir_parallel.sysl`.
    TParallel(op: &TPar)
    // What could not be elaborated, after its diagnostic.
    TInvalid
end TKind

// What a `match` arm matches. Every arm of a `match` the elaborator accepts is reachable, and
// together they cover every variant.
enum TPat
    // The variant `name` with its `tag`, and the local each of its fields is bound to (`None` for
    // `_`).
    PVariant(name: string, tag: usize, fields: Buf[Option[usize]])
    // Any value: `_`, or a name bound to the whole value.
    PAny(bind: Option[usize])

struct TArm
    pat: TPat
    body: TExpr

// The left of a destructuring binding: what each element of the tuple is bound to.
enum TBind
    BLocal(id: usize)
    // A module-level binding, by name.
    BGlobal(name: string)
    // `_`: the element is computed and dropped.
    BSkip
    BTuple(elems: Buf[TBind])

// The left of a tuple assignment: where each element of the tuple is stored.
enum TTarget
    // A local, a module-level `var`, a field or an element, as a plain assignment's target is.
    TPlace(place: TExpr)
    // `_`: the element is computed and dropped.
    TDrop
    TTargets(elems: Buf[TTarget])

// How a local came to be.
enum LocalKind
    LVal
    LVar
    // A parameter, read-only or an `inout` borrow.
    LParam(mode: Mode)
    // A loop variable, read-only.
    LLoop
    // A `val` holding an `origin` view: read-only, and indexed from the first indices its
    // initializer's `TOrigin` gives (DESIGN §6.4).
    LOrigin

struct LocalInfo
    name: string
    ty: Ty
    kind: LocalKind

struct TLambda
    // The name of a local `def`; `""` for a lambda.
    name: string
    params: Buf[usize]
    ret: Ty
    // The locals of enclosing functions the body reads or writes, in the order first used.
    captures: Buf[usize]
    body: TExpr
    // Whether the lambda may outlive the call it was made in: false only for one written straight
    // as an argument, which the callee borrows for the call (DESIGN §8.3).
    escapes: bool
    // The captured views a lambda that escapes copies to dense arrays when it is made (DESIGN §6.2
    // rule 3).
    copies: Buf[usize]

// A loop, by the label it was given (`""` for none).
struct TLoop
    label: string

struct TGlobal
    span: Span
    name: string
    kind: BindKind
    ty: Ty
    init: TExpr

struct TFun
    span: Span
    name: string
    params: Buf[usize]
    // Each parameter's default, already of the parameter's type.
    defaults: Buf[Option[TExpr]]
    ret: Ty
    body: TExpr

// `extern def name(params): ret`: a C function, its parameter types and modes and its result.
// `symbol` is the C name (`@symbol`, else `name`, or for `@fortran` gfortran's `name_`); `links` the libraries its `@link`s name and
// `frameworks` the frameworks; `pure` whether it is declared `@pure`. By parameter: whether it is
// `@strided`, and the function parameter a `@data(f)` one partners.
struct TExtern
    span: Span
    name: string
    params: Buf[Ty]
    modes: Buf[Mode]
    ret: Ty
    symbol: string
    links: Buf[string]
    frameworks: Buf[string]
    pure: bool
    strided: Buf[bool]
    partner: Buf[Option[usize]]
    // Declared `@fortran`: every argument by reference, a string's length trailing (DESIGN §10.6).
    fortran: bool
    // Declared `@host`: a function the embedding program gives, not C (DESIGN §16.3).
    host: bool

// `val a, b = 1, 2` at module level: one initializer, its tuple taken apart into the module-level
// bindings `pat` names.
struct TGlobalTuple
    span: Span
    kind: BindKind
    pat: TBind
    ty: Ty
    init: TExpr

// A field of a struct or of an enum's variant, its type resolved.
struct FieldInfo
    name: string
    ty: Ty

// A struct, or with `host` a type the embedding program owns (DESIGN §16.3), which has no fields.
struct TStruct
    span: Span
    name: string
    fields: Buf[FieldInfo]
    host: bool

struct VariantInfo
    name: string
    fields: Buf[FieldInfo]

// An enum and its variants, a variant's tag being its position here.
struct TEnum
    span: Span
    name: string
    variants: Buf[VariantInfo]

enum TDecl
    StructDecl(s: TStruct)
    EnumDecl(e: TEnum)
    GlobalDecl(g: TGlobal)
    TupleGlobalDecl(g: TGlobalTuple)
    FunDecl(f: TFun)
    ExternDecl(x: TExtern)

struct TProgram
    // The structs and enums, then the other declarations, each in the order the source declares
    // them.
    decls: Buf[TDecl]
    locals: Buf[LocalInfo]
    lambdas: Buf[TLambda]
    loops: Buf[TLoop]
    // The `@test` functions, in source order, and whether this is `nex test`'s build, whose entry
    // runs the test its first argument numbers instead of `main`.
    tests: Buf[string]
    test_build: bool

texpr(span: Span, ty: Ty, kind: TKind) -> TExpr = TExpr(span, ty, kind)
