module sh.sysl.nex
@tests

// The typed IR of arrays and the diagnostics the elaborator gives for them (DESIGN §3–§7), each
// rule with the program it accepts and the one it refuses.

private val MAIN = "def main() = ()\n"

// -- literals and types -----------------------------------------------------------------------------

@test("a literal of rank 1, 2 or 3 is brackets nested that deep, its elements in one type")
array_literal_ranks()
    assert_eq(elaborated("def main() =\n  val t = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]\n  print(t[2, 1, 2])\n"),
        "(def main () void (block (val t#0:[int64; :, :, :] (array:[int64; :, :, :] (array:[int64; :, :] (array:[int64] 1 2) (array:[int64] 3 4)) (array:[int64; :, :] (array:[int64] 5 6) (array:[int64] 7 8)))) (print (index:int64 t#0 2 1 2))))")
    assert_eq(elaborated("def main() = print([1, 2.5])\n"), "(def main () void (print (array:[real64] (adopt:real64 1) 2.5)))")
    assert_eq(elaborated("def f(x: real32) = [x, 1]\n" + MAIN), "(def f ((x#0 real32)) [real32] (array:[real32] x#0 (adopt:real32 1)))\n(def main () void ())")
    assert_eq(elaborated("def f(n: integer) = [n, 2.5]\n" + MAIN), "(def f ((n#0 int64)) [real64] (array:[real64] (promote:real64 n#0) 2.5))\n(def main () void ())")

@test("a literal takes a static shape from its annotation, every visible extent checked")
array_literal_static_shape()
    assert_eq(elaborated("def main() =\n  val s: [real; 2, 3] = [[1, 2, 3], [4, 5, 6]]\n"),
        "(def main () void (block (val s#0:[real64; 2, 3] (array:[real64; 2, 3] (array:[real64] (adopt:real64 1) (adopt:real64 2) (adopt:real64 3)) (array:[real64] (adopt:real64 4) (adopt:real64 5) (adopt:real64 6)))) ()))")
    assert_eq(refused("def main() =\n  val a: [real; 3] = [1.0, 2.0]\n"), "error: this literal has 2 items along axis 1, and its type has 3 @2:22")
    assert_eq(refused("def main() =\n  val m: [real; :, 2] = [[1.0, 2.0, 3.0]]\n"), "error: this literal has 3 items along axis 2, and its type has 2 @2:25")

@test("a jagged literal, an empty one with no type and mixed elements are refused")
array_literal_refusals()
    assert_eq(refused("def main() =\n  val m = [[1, 2, 3], [4, 5]]\n"), "error: this row has 2 items, and the first has 3: an array is not jagged @2:23")
    assert_eq(refused("def main() = print([])\n"), "error: an empty array literal has no element type; write its type: `val a: [real] = []` @1:20")
    assert_eq(elaborated("def main() =\n  val e: [real] = []\n"), "(def main () void (block (val e#0:[real64] (array:[real64])) ()))")
    assert_eq(refused("def main() = print([1, \"a\"])\n"), "error: an element of this array must be string, but this is int64 @1:21")
    assert_eq(refused("def f(n: integer) = [n, \"a\"]\n" + MAIN), "error: the elements of this array differ: int64 and string @1:25")
    assert_eq(refused("def f(v: [real], x: real) = [v, x]\n" + MAIN), "error: the items of this array differ in rank: 1 and 0 @1:33")

@test("a static shape converts to the dynamic one; a dynamic shape to a static one is checked at run time")
array_shape_conversions()
    assert_eq(elaborated("def f(d: [real], s: [real; 3]) =\n  val a: [real; 3] = d\n  val b: [real] = s\n" + MAIN),
        "(def f ((d#0 [real64]) (s#1 [real64; 3])) void (block (val a#2:[real64; 3] (shape-check:[real64; 3] d#0)) (val b#3:[real64] (promote:[real64] s#1)) ()))\n(def main () void ())")
    assert_eq(refused("def f(s: [real; 3]) =\n  val c: [real; 4] = s\n" + MAIN), "error: `c` must be [real; 4], but this is [real; 3]: axis 1 is 3 here, and 4 is required @2:22")
    assert_eq(refused("def f(s: [real; :, :]) =\n  val c: [real] = s\n" + MAIN), "error: `c` must be [real], but this is [real; :, :]: its rank is 2, not 1 @2:19")
    assert_eq(refused("def f(s: [real]) =\n  val c: real = s\n" + MAIN), "error: `c` must be real, but this is [real] @2:17")

@test("an array widens element by element where it is stored, and never narrows")
array_store_widens_not_narrows()
    assert_eq(elaborated("def f(a: [real32]) =\n  val b: [real] = a\n" + MAIN),
        "(def f ((a#0 [real32])) void (block (val b#1:[real64] (promote:[real64] a#0)) ()))\n(def main () void ())")
    assert_eq(refused("def f(x: real64) =\n  var a: [real32] = [1.0, 2.0]\n  a = x * a\n" + MAIN),
        "error: the value must be [real32], but this is [real64]: that would narrow it; convert it explicitly, `real32(...)` @3:7")

// -- ranges -----------------------------------------------------------------------------------------

@test("a range as a value is a rank-1 integer array, and a for may walk any array")
array_ranges_and_for()
    assert_eq(elaborated("def main() =\n  for x in 1..<4 by 2\n    print(x)\n  for y in [1.5, 2.5]\n    print(y)\n  val r = 0..<5\n"),
        "(def main () void (block (for L0 x#0:int64 (1 ..< 4 by 2) (print x#0)) (for L1 y#1:real64 (in (array:[real64] 1.5 2.5)) (print y#1)) (val r#2:[int64] (range:[int64] 0 ..< 5)) ()))")
    assert_eq(elaborated("def main() =\n  val r: [int32] = 1..3\n"), "(def main () void (block (val r#0:[int32] (range:[int32] (adopt:int32 1) .. (adopt:int32 3))) ()))")
    assert_eq(refused("def main() = print(1.0..2.0)\n"), "error: a range counts in integers; this one is real64 (`linspace` spaces reals) @1:20")
    assert_eq(refused("def f(x: real) =\n  for y in x do print(y)\n" + MAIN), "error: a `for` walks a range or an array; this is real @2:12")

@test("a for over an array of tuples takes each element apart, written with or without parentheses")
array_for_destructuring()
    val each = "(for L0 _#1:(int64, int64) (in (enumerate:[(int64, int64)] xs#0)) (block (val (i#2:int64 x#3:int64) _#1) (print (s i#2 \": \" x#3))))"

    assert_eq(elaborated("def main() =\n  val xs = [10, 20]\n  for i, x in enumerate(xs)\n    print(s\"$i: $x\")\n"), s"(def main () void (block (val xs#0:[int64] (array:[int64] 10 20)) ${each}))")
    assert_eq(elaborated("def main() =\n  val xs = [10, 20]\n  for (i, x) in enumerate(xs)\n    print(s\"$i: $x\")\n"), s"(def main () void (block (val xs#0:[int64] (array:[int64] 10 20)) ${each}))")
    assert_eq(elaborated("def f(xs: [integer], ys: [real]) =\n  for i, (a, _) in enumerate(zip(xs, ys))\n    print(a + i)\n" + MAIN),
        "(def f ((xs#0 [int64]) (ys#1 [real64])) void (for L0 _#2:(int64, (int64, real64)) (in (enumerate:[(int64, (int64, real64))] (zip:[(int64, real64)] xs#0 ys#1))) (block (val (i#3:int64 (a#4:int64 _)) _#2) (print (+:int64 a#4 i#3)))))\n(def main () void ())")

@test("a for pattern must match its element, cannot test a variant, and binds read-only names")
array_for_destructuring_refused()
    assert_eq(refused("def f(xs: [integer]) =\n  for i, x in xs\n    print(i)\n" + MAIN), "error: a destructuring pattern takes a tuple apart, and this is int64 @2:7")
    assert_eq(refused("def f(xs: [integer]) =\n  for i, x, y in enumerate(xs)\n    print(i)\n" + MAIN), "error: this pattern takes 3 elements apart, and the value has 2: (int64, int64) @2:7")
    assert_eq(refused("def main() =\n  for i, j in 0..3\n    print(i)\n"), "error: a counted `for` names one integer; there is no tuple to take apart @2:7")
    assert_eq(refused("def f(xs: [integer]) =\n  for i, x in enumerate(xs)\n    i = 2\n" + MAIN), "error: `i` cannot be assigned: a loop variable is read-only @3:5")
    assert_eq(refused("def f(xs: [integer]) =\n  for i, x in enumerate(xs)\n    print(i)\n  print(x)\n" + MAIN), "error: unknown name `x`; did you mean `xs`? @4:9")
    assert_eq(refused("def f(xs: [integer]) =\n  for Some(x) in xs\n    print(x)\n" + MAIN), "error: a binding cannot test which variant a value is; take `Some` apart with `match` @2:7")

@test("zip pairs the elements of two arrays")
array_zip()
    assert_eq(elaborated("def f(xs: [integer], ys: [real32; 2, 2]) = zip(xs, ys)\n" + MAIN), "(def f ((xs#0 [int64]) (ys#1 [real32; 2, 2])) [(int64, real32)] (zip:[(int64, real32)] xs#0 ys#1))\n(def main () void ())")
    assert_eq(refused("def f(xs: [integer]) = zip(xs)\n" + MAIN), "error: `zip` takes two arrays @1:24")
    assert_eq(refused("def f(xs: [integer]) = zip(xs, 3)\n" + MAIN), "error: `zip` takes an array; this is int64 @1:32")

// -- indexing ---------------------------------------------------------------------------------------

@test("an index list collapses integer axes, keeps the others and writes out the trailing ones")
array_index_lists()
    assert_eq(elaborated("def f(m: [real; 3, :]) =\n  print(m[2])\n  print(m[:, 1])\n  print(m[1..2, 2..<4 by 2])\n  print(m[1][2])\n" + MAIN),
        "(def f ((m#0 [real64; 3, :])) void (block (print (view:[real64] m#0 2 :)) (print (view:[real64; 3] m#0 : 1)) (print (view:[real64; :, :] m#0 (1 .. 2) (2 ..< 4 by 2))) (print (index:real64 (view:[real64] m#0 1 :) 2))))\n(def main () void ())")
    assert_eq(refused("def f(a: [real]) = a[1, 2]\n" + MAIN), "error: this array has rank 1, and 2 subscripts are given @1:20")
    assert_eq(refused("def f(x: real) = x[1]\n" + MAIN), "error: this is real and cannot be indexed @1:18")
    assert_eq(refused("def f(a: [real]) = a[1.5]\n" + MAIN), "error: an index must be int64, but this is real64: that would narrow it; convert it explicitly, `int64(...)` @1:22")

@test("end is the extent of the axis its subscript indexes, and a negative stride walks down")
array_end_and_negative_strides()
    assert_eq(elaborated("def main() =\n  val a = [10, 20, 30]\n  print(a[.. by -1])\n  print(a[end..1 by -1])\n  print(a[2..<end])\n"),
        "(def main () void (block (val a#0:[int64] (array:[int64] 10 20 30)) (print (view:[int64] a#0 (_ .. _ by -1))) (print (view:[int64] a#0 ((end 1) .. 1 by -1))) (print (view:[int64] a#0 (2 ..< (end 1))))))")
    assert_eq(elaborated("def f(m: [real; :, :], b: [integer]) = m[end, b[end]]\n" + MAIN),
        "(def f ((m#0 [real64; :, :]) (b#1 [int64])) real64 (index:real64 m#0 (end 1) (index:int64 b#1 (end 1))))\n(def main () void ())")
    assert_eq(elaborated("def f(m: [real; :, :]) = m[1, end - 1]\n" + MAIN),
        "(def f ((m#0 [real64; :, :])) real64 (index:real64 m#0 1 (-:int64 (end 2) 1)))\n(def main () void ())")

// -- assignment -------------------------------------------------------------------------------------

@test("an element, a slice and a compound slice are assignment targets; a scalar fills a slice")
array_assignment()
    assert_eq(elaborated("def main() =\n  var m = [[1.0, 2.0], [3.0, 4.0]]\n  m[1, :] = 0\n  m[:, 2] += 1\n  m[2, 2] = 7\n  m[2, :] = [5.0, 6.0]\n"),
        "(def main () void (block (var m#0:[real64; :, :] (array:[real64; :, :] (array:[real64] 1.0 2.0) (array:[real64] 3.0 4.0))) (= (index:[real64] m#0 1 :) (broadcast:[real64] (adopt:real64 0))) (+= (index:[real64] m#0 : 2) (adopt:real64 1)) (= (index:real64 m#0 2 2) (adopt:real64 7)) (= (index:[real64] m#0 2 :) (array:[real64] 5.0 6.0))))")
    assert_eq(refused("def main() =\n  val a = [1, 2]\n  a[1] = 5\n"), "error: `a` cannot be assigned: it is a `val` @3:3")
    assert_eq(refused("def main() =\n  var a = [1, 2]\n  a[1..2] = [[1, 2]]\n"), "error: the value must be [int64], but this is [int64; :, :]: its rank is 2, not 1 @3:13")
    assert_eq(refused("def f(x: real64) =\n  var a: [real32] = [1.0]\n  a[1..1] += x\n" + MAIN), "error: `+=` computes [real64], which the target ([real32]) cannot hold without narrowing @3:3")

// -- element-wise operators -------------------------------------------------------------------------

@test("a typed real64 scalar promotes a real32 array, and a literal adapts to it")
array_scalar_promotes()
    assert_eq(elaborated("def f(x: real64, a: [real32]) = x * a\ndef g(a: [real32]) = 2.0 * a\n" + MAIN),
        "(def f ((x#0 real64) (a#1 [real32])) [real64] (.*:[real64] x#0 (promote:[real64] a#1)))\n(def g ((a#2 [real32])) [real32] (.*:[real32] (adopt:real32 2.0) a#2))\n(def main () void ())")
    assert_eq(elaborated("def f(a: [integer], b: [real]) = a + b\n" + MAIN),
        "(def f ((a#0 [int64]) (b#1 [real64])) [real64] (.+:[real64] (promote:[real64] a#0) b#1))\n(def main () void ())")

@test("an element-wise operation keeps static extents, and compares element by element")
array_elementwise_shapes()
    assert_eq(elaborated("def f(a: [real; 3], b: [real]) = a - b\n" + MAIN), "(def f ((a#0 [real64; 3]) (b#1 [real64])) [real64; 3] (.-:[real64; 3] a#0 b#1))\n(def main () void ())")
    assert_eq(elaborated("def f(a: [integer]) = a < 5\n" + MAIN), "(def f ((a#0 [int64])) [bool] (.<:[bool] a#0 5))\n(def main () void ())")
    assert_eq(elaborated("def f(a: [real]) = -a ^ 2\n" + MAIN), "(def f ((a#0 [real64])) [real64] (.-:[real64] (.^:[real64] a#0 2)))\n(def main () void ())")
    assert_eq(elaborated("def f(a: [uint8], b: [uint8]) = a == b\ndef g(a: [uint8], b: [uint8]) = all(a == b)\ndef h(a: [real; 2], b: [real]) = a != b\n" + MAIN),
        "(def f ((a#0 [uint8]) (b#1 [uint8])) [bool] (.==:[bool] a#0 b#1))\n(def g ((a#2 [uint8]) (b#3 [uint8])) bool (all:bool (.==:[bool] a#2 b#3)))\n(def h ((a#4 [real64; 2]) (b#5 [real64])) [bool; 2] (.!=:[bool; 2] a#4 b#5))\n(def main () void ())")

@test("element-wise operands of different rank or static shape, or of no number, are refused")
array_elementwise_refusals()
    assert_eq(refused("def f(v: [real], m: [real; :, :]) = v + m\n" + MAIN), "error: `+` combines arrays of one rank; these have rank 1 and rank 2 @1:37")
    assert_eq(refused("def f(a: [real; 3], b: [real; 4]) = a + b\n" + MAIN), "error: `+` combines arrays of one shape; axis 1 is 3 in one and 4 in the other @1:37")
    assert_eq(refused("def f(s: [string]) = s + s\n" + MAIN), "error: element-wise `+` needs numbers; found [string] and [string] @1:22")
    assert_eq(refused("def f(a: [uint8; 2], b: [uint8; 3]) = a == b\n" + MAIN), "error: `==` combines arrays of one shape; axis 1 is 2 in one and 3 in the other @1:39")
    assert_eq(refused("def f(a: [uint8], b: [uint8]): bool = a == b\n" + MAIN), "error: the result must be bool, but this is [bool] @1:39")
    assert_eq(refused("def f(a: [real]) = 0 < a < 1\n" + MAIN), "error: a chained comparison compares scalars; this compares real64 with [real64] @1:20\nerror: a chained comparison compares scalars; this compares [real64] with real64 @1:24")

@test("not, and and or apply element by element to bools, and the branches of an if meet as arrays")
array_logical_and_branches()
    assert_eq(elaborated("def f(c: bool, a: [integer], b: [real; 3], p: [bool]) =\n  print(if c then a else b)\n  print(not p)\n  print(a > 1 and p)\n  print(p or true)\n" + MAIN),
        "(def f ((c#0 bool) (a#1 [int64]) (b#2 [real64; 3]) (p#3 [bool])) void (block (print (if:[real64] c#0 (promote:[real64] a#1) (promote:[real64] b#2))) (print (.not:[bool] p#3)) (print (.and:[bool] (.>:[bool] a#1 1) p#3)) (print (.or:[bool] p#3 true))))\n(def main () void ())")
    assert_eq(refused("def f(p: [integer]) = not p\n" + MAIN), "error: `not` needs bools; found [integer] @1:23")
    assert_eq(refused("def f(p: [integer]) = p and true\n" + MAIN), "error: an operand of `and` must be bool or [bool], but this is [integer] @1:23")
    assert_eq(refused("def f(c: bool, p: [integer], q: [integer; :, :]) = if c then p else q\n" + MAIN), "error: the branches of this `if` differ: [int64] and [int64; :, :] @1:52")

@test("a whole array takes a compound assignment, and a slice of a place is a place")
array_compound_and_nested_places()
    assert_eq(elaborated("def f(a: [integer]) =\n  var x = [1, 2, 3]\n  x[2..3][1] = 9\n  x += 1\n  x *= a\n" + MAIN),
        "(def f ((a#0 [int64])) void (block (var x#1:[int64] (array:[int64] 1 2 3)) (= (index:int64 (index:[int64] x#1 (2 .. 3)) 1) 9) (+= x#1 1) (*= x#1 a#0)))\n(def main () void ())")

// -- `@` --------------------------------------------------------------------------------------------

@test("@ takes ranks 1 and 2, carrying static extents into its result")
array_matmul()
    assert_eq(elaborated("def f(a: [real; 3, 4], b: [real; 4, :], v: [real], w: [integer]) =\n  print(a @ b)\n  print(v @ w)\n  print(a @ v)\n  print(v @ b)\n" + MAIN),
        "(def f ((a#0 [real64; 3, 4]) (b#1 [real64; 4, :]) (v#2 [real64]) (w#3 [int64])) void (block (print (@:[real64; 3, :] a#0 b#1)) (print (@:real64 v#2 (promote:[real64] w#3))) (print (@:[real64; 3] a#0 v#2)) (print (@:[real64] v#2 b#1))))\n(def main () void ())")

@test("a batched @, mismatched inner extents and a scalar operand are refused")
array_matmul_refusals()
    assert_eq(refused("def f(a: [real; :, :, :], b: [real; :, :]) = a @ b\n" + MAIN), "error: `@` takes ranks 1 and 2, and this has rank 3; a batch of products is a loop over the trailing axis: `C[:, :, k] = A[:, :, k] @ B[:, :, k]` @1:46")
    assert_eq(refused("def f(a: [real; 2, 3], b: [real; 2, 3]) = a @ b\n" + MAIN), "error: `@` needs the inner extents to agree; they are 3 and 2 @1:43")
    assert_eq(refused("def f(a: [real; 2, 3]) = 2.0 @ a\n" + MAIN), "error: `@` multiplies matrices and vectors; this is real64 @ [real; 2, 3] (scale with `*`) @1:26")

// -- elemental functions ----------------------------------------------------------------------------

@test("the prelude's scalar functions and the conversions apply element by element")
array_elemental_prelude()
    assert_eq(elaborated("def f(a: [integer], b: [real32], c: [real]) =\n  print(sqrt(a))\n  print(max(b, 0.0))\n  print(real32(c))\n  print(int8(a))\n" + MAIN),
        "(def f ((a#0 [int64]) (b#1 [real32]) (c#2 [real64])) void (block (print (.sqrt:[real64] (promote:[real64] a#0))) (print (.max:[real32] b#1 (adopt:real32 0.0))) (print (.convert:[real32] c#2)) (print (.convert-trap:[int8] a#0))))\n(def main () void ())")
    assert_eq(refused("def f(a: [real; 2], b: [real; 3]) = atan2(a, b)\n" + MAIN), "error: `atan2` combines arrays of one shape; axis 1 is 2 in one and 3 in the other @1:37")

@test("an @elemental function applies to every element; an unmarked one is refused on an array")
array_elemental_user()
    assert_eq(elaborated("@elemental def sq(x: real) = x * x\ndef main() =\n  print(sq([1.0, 2.0]))\n  print(sq(3.0))\n"),
        "(def sq ((x#0 real64)) real64 (*:real64 x#0 x#0))\n(def main () void (block (print (.call:[real64] sq (array:[real64] 1.0 2.0))) (print (call:real64 sq 3.0))))")
    assert_eq(refused("def sq(x: real) = x * x\ndef main() = print(sq([1.0, 2.0]))\n"), "error: `sq` takes real, and this is [real64]: mark it `@elemental` to apply it to every element, or write `map(a, sq)` @2:23")
    assert_eq(elaborated("@elemental def f(x: real, k: real) = x * k\ndef g(a: [real; 2]) = f(a, 2)\n" + MAIN),
        "(def f ((x#0 real64) (k#1 real64)) real64 (*:real64 x#0 k#1))\n(def g ((a#2 [real64; 2])) [real64; 2] (.call:[real64; 2] f a#2 (adopt:real64 2)))\n(def main () void ())")
    assert_eq(refused("@elemental def f(x: real, k: real) = x * k\ndef g(a: [real; 2], b: [real; 3]) = f(a, b)\n" + MAIN), "error: an elemental call combines arrays of one shape; axis 1 is 2 in one and 3 in the other @2:37")

@test("an @elemental function takes scalars, none inout, gives a value and has no effects but print and eprint")
array_elemental_rules()
    assert_eq(refused("var total = 0.0\n@elemental def bump(x: real) =\n  total = total + x\n  x\n" + MAIN), "error: an `@elemental` function may be run in any order, so it cannot write the module variable `total` @2:1")
    assert_eq(refused("@elemental def twice(x: inout real) = x\n" + MAIN), "error: an `@elemental` function takes no `inout` parameter, and `x` is one @1:1")
    assert_eq(refused("@elemental def p(x: real) = print(x)\n" + MAIN), "error: an `@elemental` function gives a value for each element, and `p` returns nothing @1:1")
    assert_eq(refused("@elemental def q(v: [real]) = 1.0\n" + MAIN), "error: an `@elemental` function takes scalars, and `v` is [real64] @1:1")
    assert_eq(refused("@elemental def e(x: real) =\n  eprint(x)\n  x\n" + MAIN), "ok")
    assert_eq(refused("@elemental def e(x: real) =\n  write_bytes(\"f\", to_bytes([1]))\n  x\n" + MAIN), "error: an `@elemental` function may be run in any order, so it cannot do I/O with `write_bytes` @1:1")

@test("merge meets its two values as + does, broadcasts a scalar and takes a bool or [bool] mask")
array_merge()
    assert_eq(elaborated("def f(a: [real32], b: [bool], m: [integer]) =\n  print(merge(a, 0.0, b))\n  print(merge(m, 2.5, true))\n  print(merge(1, 2, b))\n  print(merge(1, 2.0, false))\n" + MAIN),
        "(def f ((a#0 [real32]) (b#1 [bool]) (m#2 [int64])) void (block (print (.merge:[real32] a#0 (adopt:real32 0.0) b#1)) (print (.merge:[real64] (promote:[real64] m#2) 2.5 true)) (print (.merge:[int64] 1 2 b#1)) (print (merge:real64 (promote:real64 1) 2.0 false))))\n(def main () void ())")
    assert_eq(refused("def f(a: [real; 2], b: [real; 3], c: bool) = merge(a, b, c)\n" + MAIN), "error: `merge` combines arrays of one shape; axis 1 is 2 in one and 3 in the other @1:46")
    assert_eq(refused("def f(a: [real; 2], m: [bool; 3]) = merge(a, 0.0, m)\n" + MAIN), "error: `merge` combines arrays of one shape; axis 1 is 2 in one and 3 in the other @1:37")
    assert_eq(refused("def f(a: [real]) = merge(a, 0.0, a)\n" + MAIN), "error: `merge`'s mask must be bool or [bool], but this is [real] @1:34")
    assert_eq(refused("def f(a: [real]) = merge(a, 0.0)\n" + MAIN), "error: `merge` takes the value where true, the value where false and the mask @1:20")
    assert_eq(refused("def f(a: real<m>, b: real<s>) = merge(a, b, true)\n" + MAIN), "error: `merge` cannot combine m and s: length and time are different dimensions @1:33")
    assert_eq(refused("def f(a: string) = merge(a, \"b\", true)\n" + MAIN), "error: `merge` chooses between numbers or bools; these are string: choose between other values with `if c then a else b` @1:20")

@test("modulo takes integers or reals of one dimension, keeps the first's unit and applies element by element")
array_modulo()
    assert_eq(elaborated("def f(a: [integer], x: real32, d: real<m>) =\n  print(modulo(a, 3))\n  print(modulo(x, 2.0))\n  print(modulo(d, 30.0<cm>))\n" + MAIN),
        "(def f ((a#0 [int64]) (x#1 real32) (d#2 real64<m>)) void (block (print (.modulo:[int64] a#0 3)) (print (modulo:real32 x#1 (adopt:real32 2.0))) (print (s (strip:real64 (modulo:real64<m> d#2 (rescale:real64<m> 0.01 30.0<cm>))) \" m\"))))\n(def main () void ())")
    assert_eq(refused("def f(z: complex) = modulo(z, z)\n" + MAIN), "error: `modulo` takes integers or reals; these are complex[real64] @1:21")
    assert_eq(refused("def f(b: bool) = modulo(b, b)\n" + MAIN), "error: `modulo` takes integers or reals; these are bool @1:18")
    assert_eq(refused("def f(d: real<m>) = modulo(d, 2.0<s>)\n" + MAIN), "error: `modulo` cannot combine m and s: length and time are different dimensions @1:21")
    assert_eq(refused("def f(a: [real; 2], b: [real; 3]) = modulo(a, b)\n" + MAIN), "error: `modulo` combines arrays of one shape; axis 1 is 2 in one and 3 in the other @1:37")
    assert_eq(refused("def f(a: real) = modulo(a)\n" + MAIN), "error: `modulo` takes two values @1:18")

@test("findloc gives an index or a tuple of them, takes dim = and back =, and meets its value as == does")
array_findloc()
    assert_eq(elaborated("def f(v: [integer], m: [real; 2, 3], b: bool) =\n  print(findloc(v, 3))\n  print(findloc(m, 2))\n  print(findloc(m, 2.0, dim = 1, back = b))\n  print(findloc(v, 2.5, back = true))\n" + MAIN),
        "(def f ((v#0 [int64]) (m#1 [real64; 2, 3]) (b#2 bool)) void (block (print (findloc:int64 v#0 3 false)) (print (findloc:(int64, int64) m#1 (adopt:real64 2) false)) (print (findloc:[int64; 3] m#1 2.0 b#2 (dim 1))) (print (findloc:int64 (promote:[real64] v#0) 2.5 true))))\n(def main () void ())")
    assert_eq(refused("def f(v: [string]) = findloc(v, \"a\")\n" + MAIN), "error: `findloc` takes an array of numbers or bools; this is [string] @1:30")
    assert_eq(refused("def f(v: [real]) = findloc(v, [1.0])\n" + MAIN), "error: `findloc` finds one value, and this is [real64] @1:31")
    assert_eq(refused("def f(v: [real]) = findloc(v)\n" + MAIN), "error: `findloc` takes an array and the value to find, and optionally `dim =` and `back =` @1:20")
    assert_eq(refused("def f(v: [real]) = findloc(v, 1.0, last = true)\n" + MAIN), "error: `findloc` takes two named arguments, `dim =` and `back =` @1:36")
    assert_eq(refused("def f(v: [real]) = findloc(v, 1.0, back = 1)\n" + MAIN), "error: `back` must be bool, but this is int64 @1:43")
    assert_eq(refused("def f(m: [real; :, :]) = findloc(m, 1.0, dim = 3)\n" + MAIN), "error: there is no axis 3: this array has rank 2 @1:48")
    assert_eq(refused("def f(v: [real<m>]) = findloc(v, 1.0<s>)\n" + MAIN), "error: `findloc` cannot combine m and s: length and time are different dimensions @1:23")
    assert_eq(refused("def f(x: real) = findloc(x, 1.0)\n" + MAIN), "error: `findloc` takes an array; this is real @1:26")

// -- the prelude ------------------------------------------------------------------------------------

@test("a reduction gives a scalar, or along dim = an array of one rank less")
array_reductions()
    assert_eq(elaborated("def f(m: [real; 2, 3], b: [bool]) =\n  print(sum(m))\n  print(maxval(m, dim = 2))\n  print(maxloc(m))\n  print(count(b))\n  print(norm2([3, 4]))\n  print(dot([1.0], [2]))\n" + MAIN),
        "(def f ((m#0 [real64; 2, 3]) (b#1 [bool])) void (block (print (sum:real64 m#0)) (print (maxval:[real64; 2] m#0 (dim 2))) (print (maxloc:(int64, int64) m#0)) (print (count:int64 b#1)) (print (norm2:real64 (promote:[real64] (array:[int64] 3 4)))) (print (dot:real64 (array:[real64] 1.0) (promote:[real64] (array:[int64] 2))))))\n(def main () void ())")

@test("a dim = that names no axis, and a reduction of the wrong elements, are refused")
array_reduction_refusals()
    assert_eq(refused("def f(m: [real; :, :]) = sum(m, dim = 3)\n" + MAIN), "error: there is no axis 3: this array has rank 2 @1:39")
    assert_eq(refused("def f(m: [real; :, :]) = sum(m, dim = 0)\n" + MAIN), "error: there is no axis 0: this array has rank 2 @1:39")
    assert_eq(refused("def f(m: [real; :, :]) = sum(m, dim = 0xFFFF_FFFF_FFFF_FFFF)\n" + MAIN), "error: there is no axis 18446744073709551615: this array has rank 2 @1:39\nerror: 18446744073709551615 does not fit in int64 @1:39")
    assert_eq(refused("def f(m: [real]) = sum(m, 1)\n" + MAIN), "error: `sum` takes one array, and optionally `dim =` the axis to reduce along @1:20")
    assert_eq(refused("def f(m: [real]) = any(m)\n" + MAIN), "error: `any` takes an array of bools; this is [real] @1:24")
    assert_eq(refused("def f(m: [real]) = dot(m, m, dim = 1)\n" + MAIN), "error: `dot` takes no named arguments @1:30")

@test("the shape functions and constructors type their results by rank")
array_shape_functions()
    assert_eq(elaborated("def main() =\n  val z: [real32; :, :] = zeros((4, 4))\n  var b: [uint8] = zeros(4)\n  print(to_integers(b))\n  print(shape(z))\n  print(transpose(z))\n  print(extents(z))\n  print(reshape([1, 2, 3, 4], 2, 2))\n"),
        "(def main () void (block (val z#0:[real32; :, :] (zeros:[real32; :, :] 4 4)) (var b#1:[uint8] (zeros:[uint8] 4)) (print (promote:[int64] b#1)) (print (shape:(int64, int64) z#0)) (print (transpose:[real32; :, :] z#0)) (print (extents:[int64; 2] z#0)) (print (reshape:[int64; :, :] (array:[int64] 1 2 3 4) 2 2))))")
    assert_eq(refused("def f(v: [real]) = rows(v)\n" + MAIN), "error: `rows` takes a matrix (rank 2); this has rank 1 @1:25")
    assert_eq(refused("def f(m: [real; :, :]) = extent(m, 3)\n" + MAIN), "error: there is no axis 3: this array has rank 2 @1:36")
    assert_eq(refused("def f(m: [real; :, :]) = permute(m, (1, 1))\n" + MAIN), "error: axis 1 is given twice @1:41")
    assert_eq(refused("def f(x: real) = length(x)\n" + MAIN), "error: `length` takes an array; this is real @1:25")

@test("map, filter, reduce and flatMap give a lambda its parameter types from the array")
array_higher_order()
    assert_eq(elaborated("def main() =\n  val xs = [1, 2, 3]\n  print(map(xs, x -> x * 1.5))\n  print(filter(xs, x -> x > 1))\n  print(reduce(xs, 0, (acc, x) -> acc + x))\n  print(flatMap(xs, x -> [x, x]))\n"),
        "(def main () void (block (val xs#0:[int64] (array:[int64] 1 2 3)) (print (map:[real64] xs#0 (lambda 0))) (print (filter:[int64] xs#0 (lambda 1))) (print (reduce:int64 xs#0 0 (lambda 2))) (print (flatMap:[int64] xs#0 (lambda 3)))))\n(lambda 0 _ ((x#1 int64)) real64 (captures) passed (*:real64 (promote:real64 x#1) 1.5))\n(lambda 1 _ ((x#2 int64)) bool (captures) passed (>:bool x#2 1))\n(lambda 2 _ ((acc#3 int64) (x#4 int64)) int64 (captures) passed (+:int64 acc#3 x#4))\n(lambda 3 _ ((x#5 int64)) [int64] (captures) passed (array:[int64] x#5 x#5))")
    assert_eq(refused("def f(k: inout integer, a: [integer]) = map(a, x -> x + k)\n" + MAIN), "ok")
    assert_eq(refused("def f(a: [real]) = filter(a, x -> x + 1.0)\n" + MAIN), "error: the predicate given to `filter` returns bool, and this one returns real64 @1:30")
    assert_eq(refused("def f(a: [real]) = map(a, x -> print(x))\n" + MAIN), "error: the function given to `map` gives one element for each, and this one returns void @1:27")
    assert_eq(refused("def f(a: [real]) = map(a, (x, y) -> x)\n" + MAIN), "error: the function given to `map` takes 1 parameter; this one has 2 @1:27")
    assert_eq(refused("def g(s: string) = 1\ndef f(a: [real]) = map(a, g)\n" + MAIN), "error: the function given to `map` is called with (real64); this is (string) -> int64 @2:27")

@test("assert_approx compares two values of one rank, and assert_traps takes a function of nothing")
array_assertions()
    assert_eq(elaborated("def main() =\n  assert_approx([1, 2], [1, 2], 1.0e-12)\n  assert_traps(() -> print(1 div 0), \"division\")\n"),
        "(def main () void (block (assert_approx (promote:[real64] (array:[int64] 1 2)) (promote:[real64] (array:[int64] 1 2)) 1e-12) (assert_traps (lambda 0) \"division\")))\n(lambda 0 _ () void (captures) passed (print (div:int64 1 0)))")
    assert_eq(refused("def f(a: [real], m: [real; :, :]) = assert_approx(a, m, 0.1)\n" + MAIN), "error: `assert_approx` compares values of one rank; these are [real] and [real; :, :] @1:37")

@test("a void expression is refused where a value is needed, at that expression")
void_is_not_a_value()
    val g = "def g() = ()\nstruct P\n  x: real\n"
    assert_eq(elaborated("def main() =\n  val n = 3\n  val m = map(1..n, k -> real(k) / n)\n"),
        "(def main () void (block (val n#0:int64 3) (val m#2:[real64] (map:[real64] (range:[int64] 1 .. n#0) (lambda 0))) ()))\n(lambda 0 _ ((k#1 int64)) real64 (captures n#0) passed (/:real64 (promote:real64 k#1) (promote:real64 n#0)))")
    assert_eq(refused("def main() =\n  val n = 3\n  val x = [for k in 1..n do real(k) / n]\n"),
        "error: an array element holds a value, and a `for` has none: nex has no array comprehensions; write `map(1..n, k -> e)` @3:12")
    assert_eq(refused(g + "def main() = print([1.0, g()])\n"), "error: an array element holds a value, and this is void @4:26")
    assert_eq(refused(g + "def main() = print([[1.0], [g()]])\n"), "error: an array element holds a value, and this is void @4:29")
    assert_eq(refused(g + "def main() = print((g(), 1))\n"), "error: a tuple element holds a value, and this is void @4:21")
    assert_eq(refused(g + "def main() = print(P(g()))\n"), "error: the field `x` must be real64, but this is void @4:22")
    assert_eq(refused(g + "def main() =\n  val v = g()\n"), "error: `v` would hold nothing: this is void @5:11")
    assert_eq(refused(g + "def main() = print(sin(g()))\n"), "error: `sin` does not take void @4:20")
    assert_eq(refused(g + "def main() = print(1 + g())\n"), "error: `+` needs numbers; found int64 and void @4:20")

// -- shifting ----------------------------------------------------------------------------------------

@test("cshift and eoshift keep the array's type, every argument in place; spread adds an axis")
shift_typing()
    assert_eq(elaborated("def f(m: [real32; 2, 3], s: [int32]) =\n  print(cshift(m, 1))\n  print(cshift(m, s, dim = 2))\n  print(eoshift(m, -1, 0.5, 2))\n  print(eoshift(m, 1))\n" + MAIN), "(def f ((m#0 [real32; 2, 3]) (s#1 [int32])) void (block (print (cshift:[real32; 2, 3] m#0 1 1)) (print (cshift:[real32; 2, 3] m#0 (promote:[int64] s#1) 2)) (print (eoshift:[real32; 2, 3] m#0 -1 2 (adopt:real32 0.5))) (print (eoshift:[real32; 2, 3] m#0 1 1))))\n(def main () void ())")
    assert_eq(elaborated("def f(v: [real<m>], n: integer) =\n  print(eoshift(v, 1, boundary = 50.0<cm>))\n  print(spread(v, 1, n))\n  print(spread(2, 1, n))\n" + MAIN), "(def f ((v#0 [real64<m>]) (n#1 int64)) void (block (print (s (strip:[real64] (eoshift:[real64<m>] v#0 1 1 (rescale:real64<m> 0.01 50.0<cm>))) \" m\")) (print (s (strip:[real64; :, :] (spread:[real64<m>; :, :] v#0 1 n#1)) \" m\")) (print (spread:[int64] 2 1 n#1))))\n(def main () void ())")

@test("a shift's arguments are refused by name, kind, rank and element type")
shift_refusals()
    assert_eq(refused("def f(v: [real], k: integer) = spread(v, k, 2)\n" + MAIN), "error: `spread`'s axis fixes the rank of its result, so it is written as a number: `spread(a, 2, n)` @1:42")
    assert_eq(refused("def f(v: [real]) = spread(v, 3, 2)\n" + MAIN), "error: there is no axis 3 to spread along: the result has rank 2 @1:30")
    assert_eq(refused("def f(v: [real]) = cshift(v, 1, dim = 2)\n" + MAIN), "error: there is no axis 2: this array has rank 1 @1:39")
    assert_eq(refused("def f(v: [real]) = cshift(v, [1, 2])\n" + MAIN), "error: the shift of a vector is one integer; this is [int64] @1:30")
    assert_eq(refused("def f(m: [real; :, :], s: [integer], k: integer) = cshift(m, s, k)\n" + MAIN), "error: a shift per lane needs its axis written as a number, `dim = 2` @1:62")
    assert_eq(refused("def f(m: [real; :, :], s: [integer; :, :]) = cshift(m, s, 1)\n" + MAIN), "error: `cshift` shifts by an integer, or by an array of them of rank 1, one per lane; this is [integer; :, :] @1:56")
    assert_eq(refused("def f(m: [real; :, :], s: [real]) = eoshift(m, s, dim = 1)\n" + MAIN), "error: `eoshift` shifts by an integer, or by an array of them of rank 1, one per lane; this is [real] @1:48")
    assert_eq(refused("def f(v: [string]) = cshift(v, 1)\n" + MAIN), "error: `cshift` moves numbers and booleans; these are string @1:29")
    assert_eq(refused("def f(v: [real]) = eoshift(v, 1, fill = 0.0)\n" + MAIN), "error: `eoshift` takes the named arguments `shift =`, `boundary =` and `dim =` @1:34")
    assert_eq(refused("def f(v: [real]) = cshift(v)\n" + MAIN), "error: `cshift` takes an array, a shift and an optional axis, `cshift(a, 1)` or `cshift(a, 1, dim = 2)` @1:20")
    assert_eq(refused("def f(v: [real]) = cshift(v, 1, 2, dim = 1)\n" + MAIN), "error: `dim` is given twice @1:36")
    assert_eq(refused("def f(v: [real]) = cshift(v, 1, 1, 1)\n" + MAIN), "error: `cshift` takes an array, a shift and an optional axis, `cshift(a, 1)` or `cshift(a, 1, dim = 2)` @1:20")
    assert_eq(refused("def f(v: [real32], x: real) = eoshift(v, 1, x)\n" + MAIN), "error: the boundary must be real32, but this is real: that would narrow it; convert it explicitly, `real32(...)` @1:45")
    assert_eq(refused("def f(v: [real<m>]) = eoshift(v, 1, 2.0<s>)\n" + MAIN), "error: the boundary must be real64<m>, but this is real64<s>: time and length are different dimensions @1:37")
    assert_eq(refused("def f(v: [real]) = cshift(v, 1.5)\n" + MAIN), "error: the shift must be int64, but this is real64: that would narrow it; convert it explicitly, `int64(...)` @1:30")
    assert_eq(refused("def f(x: string) = spread(x, 1, 2)\n" + MAIN), "error: `spread` moves numbers and booleans; these are string @1:27")

// -- packing -----------------------------------------------------------------------------------------

@test("pack gives a vector of the array's element type, unpack the mask's shape; vector and field are converted")
pack_typing()
    assert_eq(elaborated("def f(m: [real32; 2, 3], b: [bool; 2, 3], v: [real32], w: [real]) =\n  print(pack(m, b))\n  print(pack(m, true, vector = v))\n  print(unpack(v, b, 0.5))\n  print(unpack(v, b, m))\n  print(pack(w, w > 0.0))\n" + MAIN), "(def f ((m#0 [real32; 2, 3]) (b#1 [bool; 2, 3]) (v#2 [real32]) (w#3 [real64])) void (block (print (pack:[real32] m#0 b#1)) (print (pack:[real32] m#0 true v#2)) (print (unpack:[real32; 2, 3] v#2 b#1 (adopt:real32 0.5))) (print (unpack:[real32; 2, 3] v#2 b#1 m#0)) (print (pack:[real64] w#3 (.>:[bool] w#3 0.0)))))\n(def main () void ())")
    assert_eq(elaborated("def f(v: [real<m>], b: [bool]) =\n  print(pack(v, b, vector = [1.0, 2.0]<cm>))\n  print(unpack(v, b, 50.0<cm>))\n" + MAIN), "(def f ((v#0 [real64<m>]) (b#1 [bool])) void (block (print (s (strip:[real64] (pack:[real64<m>] v#0 b#1 (rescale:[real64<m>] 0.01 (unit:[real64<cm>] (array:[real64] 1.0 2.0))))) \" m\")) (print (s (strip:[real64] (unpack:[real64<m>] v#0 b#1 (rescale:real64<m> 0.01 50.0<cm>))) \" m\"))))\n(def main () void ())")

@test("pack's and unpack's arguments are refused by shape, rank, kind, element type and unit")
pack_refusals()
    assert_eq(refused("def f(a: [real; 2, 3], b: [bool; 3, 2]) = pack(a, b)\n" + MAIN), "error: `pack` combines arrays of one shape; axis 1 is 2 in one and 3 in the other @1:43")
    assert_eq(refused("def f(a: [real], b: [bool; :, :]) = pack(a, b)\n" + MAIN), "error: `pack` combines arrays of one rank; these have rank 1 and rank 2 @1:37")
    assert_eq(refused("def f(a: [real], b: [integer]) = pack(a, b)\n" + MAIN), "error: `pack`'s mask is `bool` or a `bool` array of the array's shape; this is [integer] @1:42")
    assert_eq(refused("def f(a: [real; 3], b: [bool; 4], v: [real]) = unpack(v, b, a)\n" + MAIN), "error: `unpack`'s field must be [real64; 4], but this is [real; 3]: axis 1 is 3 here, and 4 is required @1:61")
    assert_eq(refused("def f(v: [real; :, :], b: [bool; :, :]) = unpack(v, b, 0.0)\n" + MAIN), "error: `unpack` takes its elements as a vector (rank 1); this is [real; :, :] @1:50")
    assert_eq(refused("def f(v: [real], b: bool) = unpack(v, b, 0.0)\n" + MAIN), "error: `unpack`'s mask is an array of `bool`; this is bool @1:39")
    assert_eq(refused("def f(a: [string], b: [bool]) = pack(a, b)\n" + MAIN), "error: `pack` moves numbers and booleans; these are string @1:38")
    assert_eq(refused("def f(a: [real32], b: [bool], v: [real]) = pack(a, b, v)\n" + MAIN), "error: `pack`'s vector must be [real32], but this is [real]: that would narrow it; convert it explicitly, `real32(...)` @1:55")
    assert_eq(refused("def f(a: [real], b: [bool], c: [bool]) = pack(a, b, c)\n" + MAIN), "error: `pack`'s vector must be [real64], but this is [bool] @1:53")
    assert_eq(refused("def f(a: [real<m>], b: [bool]) = unpack(a, b, 2.0<s>)\n" + MAIN), "error: `unpack`'s field must be real64<m>, but this is real64<s>: time and length are different dimensions @1:47")
    assert_eq(refused("def f(a: [real], b: [bool]) = pack(a, b, fill = a)\n" + MAIN), "error: `pack` takes the named arguments `mask =` and `vector =` @1:42")
    assert_eq(refused("def f(a: [real]) = pack(a)\n" + MAIN), "error: `pack` takes an array and a mask, and optionally a vector, `pack(a, a > 0)` or `pack(a, m, vector = v)` @1:20")
    assert_eq(refused("def f(a: [real], b: [bool]) = unpack(a, b)\n" + MAIN), "error: `unpack` takes a vector, a mask and a field, `unpack(v, m, 0.0)` @1:31")
    assert_eq(refused("def f(a: real, b: bool) = pack(a, b)\n" + MAIN), "error: `pack` takes an array; this is real @1:32")
