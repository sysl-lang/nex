module sh.sysl.nex
@tests

// `extern def` (DESIGN §10) in the elaborator: what it accepts and refuses in a declaration, its
// attributes, its callbacks and its `@c` structs. What the compiler makes of one is
// `compiler/tests_ffi.sysl`.

private val M = "def main() = ()\n"

// -- declarations -----------------------------------------------------------------------------------

@test("an extern's attributes are recorded: its C symbol, its link inputs, @pure and @strided")
extern_attributes()
    assert_eq(elaborated("@link(\"m\")\n@link(framework = \"Accelerate\")\n@symbol(\"cblas_ddot\")\n@pure\nextern def ddot(n: int32, @strided x: [real], incx: int32): real\n" + M),
        "(extern ddot (int32, [real64], int32) -> real64 @symbol(\"cblas_ddot\") @link(\"m\") @link(framework = \"Accelerate\") @pure @strided(2))\n(def main () void ())")
    assert_eq(elaborated("extern def f(a: int8, b: uint16, c: real16, d: complex[real32], e: bool, s: string, x: inout int32, m: inout [real; :, :, :])\n" + M),
        "(extern f (int8, uint16, real16, complex[real32], bool, string, inout int32, inout [real64; :, :, :]) -> void)\n(def main () void ())")

@test("an extern's attributes are refused where they say nothing it takes")
extern_attributes_refused()
    assert_eq(refused("@inline\nextern def f(x: real): real\n" + M), "error: `@inline` is not an attribute of an `extern def`, which takes `@link`, `@symbol`, `@pure` and `@fortran` @1:1")
    assert_eq(refused("@link\nextern def f(x: real): real\n" + M), "error: `@link` names a library, `@link(\"m\")`, or a framework, `@link(framework = \"Accelerate\")` @1:1")
    assert_eq(refused("@link(path = \"x\")\nextern def f(x: real): real\n" + M), "error: `@link` names a library, `@link(\"m\")`, or a framework, `@link(framework = \"Accelerate\")` @1:1")
    assert_eq(refused("@symbol(T)\nextern def f(x: real): real\n" + M), "error: `@symbol` names the C symbol, `@symbol(\"dgesv_\")` @1:1")
    assert_eq(refused("@symbol(\"a\")\n@symbol(\"b\")\nextern def f(x: real): real\n" + M), "error: `f` has one C symbol, and `@symbol` is given twice @1:1")
    assert_eq(refused("@pure(\"yes\")\nextern def f(x: real): real\n" + M), "error: `@pure` takes no arguments @1:1")
    assert_eq(refused("extern def cos(x: real): real\n@symbol(\"cos\")\nextern def cosine(x: real): real\n" + M), "error: `cosine` and `cos` both name the C symbol `cos` @2:1")
    assert_eq(refused("extern def f(@strided x: real): real\n" + M), "error: `@strided` passes an array's view as it lies, and `x` is not an array @1:26")
    assert_eq(refused("extern def f(@strided(\"2\") x: [real]): real\n" + M), "error: `@strided` takes no arguments @1:31")
    assert_eq(refused("extern def f(@dense x: [real]): real\n" + M), "error: `@dense` is not an attribute of an `extern` parameter, which takes `@strided` @1:24")
    assert_eq(refused("@fortran(\"gfortran\")\nextern def f(x: real): real\n" + M), "error: `@fortran` takes no arguments @1:1")

@test("an extern takes what crosses to C and returns a scalar or nothing; anything else is refused")
extern_types_refused()
    assert_eq(refused("extern def f(s: inout string)\n" + M), "error: a `string` crosses to C as a `const char *` it may not write, so `s` cannot be `inout` @1:23")
    assert_eq(refused("extern def f(s: [string])\n" + M), "error: an array crosses to C as a pointer to its elements, which must be numbers or `bool`, and [string] holds string @1:17")
    assert_eq(refused("struct P\n  x: real\nextern def f(p: P)\n" + M), "error: a struct crosses to C by pointer only where it is declared `@c`, which lays it out as C does, and `P` is not @3:17")
    assert_eq(refused("extern def f(t: (real, real))\n" + M), "error: (real64, real64) does not cross to C: an `extern` takes numbers, `bool`, `string`, arrays of numbers, `@c` structs and callbacks @1:17")
    assert_eq(refused("extern def f(): string\n" + M), "error: an `extern` returns a number, a `bool`, a complex or nothing, and string does not cross back from C @1:17")
    assert_eq(refused("extern def f(): [real]\n" + M), "error: an `extern` returns a number, a `bool`, a complex or nothing, and [real64] does not cross back from C @1:17")
    assert_eq(refused("@c\nstruct P\n  x: real\nextern def f(): P\n" + M), "error: an `extern` returns a number, a `bool`, a complex or nothing, and P does not cross back from C @4:17")

@test("c_ptr is C's void *, named only in an extern, and only as a callback's @data partner")
extern_c_ptr()
    assert_eq(elaborated("extern def integrate(f: (real, c_ptr) -> real, data: @data(f) c_ptr, a: real, b: real): real\n" + M),
        "(extern integrate ((real64, c_ptr) -> real64, c_ptr, real64, real64) -> real64 @data(2 -> 1))\n(def main () void ())")
    assert_eq(refused("extern def f(data: @data(g) c_ptr, g: (c_ptr) -> real)\n" + M), "ok")
    assert_eq(refused("def main() =\n  val p: c_ptr = 0\n"), "error: `c_ptr` is C's `void *`, and only an `extern` declaration names it @2:10")
    assert_eq(refused("extern def f(p: c_ptr)\n" + M), "error: a `c_ptr` is a callback's user data: declare `p: @data(f) c_ptr`, naming the callback parameter it goes with @1:17")
    assert_eq(refused("extern def f(f: (real) -> real, x: @data(f) real)\n" + M), "error: a `@data` parameter is C's `void *` for its callback's user data, so `x` is declared `c_ptr` @1:45")
    assert_eq(refused("extern def f(p: @data(g) c_ptr)\n" + M), "error: `@data(g)` names no parameter of this `extern` @1:26")
    assert_eq(refused("extern def f(n: int32, p: @data(n) c_ptr)\n" + M), "error: `@data(n)` names the callback its user data goes with, and `n` is int32, not a function @1:36")
    assert_eq(refused("extern def f(f: (real, c_ptr) -> real, p: inout @data(f) c_ptr)\n" + M), "error: a `c_ptr` is a callback's user data, passed by value, so `p` cannot be `inout` @1:58")
    assert_eq(refused("extern def f(p: @keep c_ptr)\n" + M), "error: `@keep` is not an attribute of an `extern` parameter's type, which takes `@data(f)` @1:23")
    assert_eq(refused("extern def f(f: (real, c_ptr) -> real, p: @data(f) c_ptr, q: @data(f) c_ptr)\n" + M), "error: `f` has one user data, and a second `@data(f)` names it @1:71")

// -- callbacks --------------------------------------------------------------------------------------

private val INTEGRATE = "extern def integrate(f: (real, c_ptr) -> real, data: @data(f) c_ptr, a: real, b: real): real\nextern def plain(f: (real) -> real, x: real): real\ndef sq(x: real) = x * x\n"

@test("a callback's type crosses by value: numbers, bool and complexes, never inout, and a c_ptr exactly where it has a @data partner")
callback_types()
    assert_eq(refused("extern def f(g: (int8, uint16, bool, complex[real32], real16) -> complex, h: (c_ptr, int64) -> void, d: @data(h) c_ptr)\n" + M), "ok")
    assert_eq(refused("extern def f(g: (inout real) -> real)\n" + M), "error: C passes a callback its arguments by value, so parameter 1 of `g` cannot be `inout` @1:17")
    assert_eq(refused("extern def f(g: (real, [real]) -> real)\n" + M), "error: C passes a callback numbers, `bool` and complexes by value, and parameter 2 of `g` is [real64] @1:17")
    assert_eq(refused("extern def f(g: (string) -> real)\n" + M), "error: C passes a callback numbers, `bool` and complexes by value, and parameter 1 of `g` is string @1:17")
    assert_eq(refused("extern def f(g: (real) -> [real])\n" + M), "error: a callback returns a number, a `bool`, a complex or nothing to C, and `g` returns [real64] @1:17")
    assert_eq(refused("extern def f(g: (real) -> real, d: @data(g) c_ptr)\n" + M), "error: `g` has a `@data` partner, so its type takes one `c_ptr`, where C hands the user data back @1:17")
    assert_eq(refused("extern def f(g: (c_ptr, c_ptr) -> real, d: @data(g) c_ptr)\n" + M), "error: `g` has a `@data` partner, so its type takes one `c_ptr`, where C hands the user data back @1:17")
    assert_eq(refused("extern def f(g: (real, c_ptr) -> real)\n" + M), "error: a `c_ptr` in a callback's type is the user data C hands back: declare a `@data(g) c_ptr` parameter beside `g` @1:17")

@test("a call passes a def or a non-capturing lambda as a bare callback, and any function with its user data, the @data argument omitted")
callback_calls()
    assert_eq(refused(INTEGRATE + "def main() =\n  val k = 2.0\n  val f: (real) -> real = sq\n  print(plain(sq, 1.0))\n  print(plain(x -> x + 1.0, 1.0))\n  print(integrate(sq, 0.0, 1.0))\n  print(integrate(x -> k * x, 0.0, 1.0))\n  print(integrate(f, 0.0, 1.0))\n"), "ok")
    assert_eq(elaborated(INTEGRATE + "def main() = print(integrate(x -> x, 0.0, 1.0))\n"),
        "(extern integrate ((real64, c_ptr) -> real64, c_ptr, real64, real64) -> real64 @data(2 -> 1))\n(extern plain ((real64) -> real64, real64) -> real64)\n(def sq ((x#0 real64)) real64 (*:real64 x#0 x#0))\n(def main () void (print (call:real64 integrate (lambda 0) 0.0 1.0)))\n(lambda 0 _ ((x#1 real64)) real64 (captures) passed x#1)")

@test("a bare callback refuses an environment, and a call names every argument but the @data ones")
callback_calls_refused()
    assert_eq(refused(INTEGRATE + "def main() =\n  val k = 2.0\n  print(plain(x -> k * x, 1.0))\n"), "error: this lambda captures `k`, and a callback with no `@data` partner is a bare C function pointer, with no environment to carry it @6:15")
    assert_eq(refused(INTEGRATE + "def main() =\n  val f: (real) -> real = sq\n  print(plain(f, 1.0))\n"), "error: a callback with no `@data` partner is a bare C function pointer, so it takes a function named directly or a lambda that captures nothing @6:15")
    assert_eq(refused(INTEGRATE + "def main() = print(integrate(sq, 0.0))\n"), "error: `integrate` takes 3 arguments, and 2 are given @4:20")
    assert_eq(refused(INTEGRATE + "def main() = print(integrate(sq, 0, 0.0, 1.0))\n"), "error: `integrate` takes 3 arguments, and 4 are given @4:20")
    assert_eq(refused(INTEGRATE + "def main() = print(plain((x: int32) -> 1.0, 1.0))\n"), "error: argument 1 must be (real64) -> real64, but this is (int32) -> real64 @4:26")
    assert_eq(refused(INTEGRATE + "def main() = print(integrate((x: real, d: real) -> x, 0.0, 1.0))\n"), "error: argument 1 must be (real64) -> real64, but this is (real64, real64) -> real64 @4:30")

@test("an extern is a function value where everything it takes and returns crosses by value")
extern_values()
    assert_eq(refused("extern def cbrt(x: real): real\nextern def nf_mix(a: int8, z: complex): complex\ndef main() =\n  val f = cbrt\n  val g = nf_mix\n  print(f(8.0))\n  print(g(1, 1i))\n"), "ok")
    assert_eq(refused("extern def r(x: [real]): real\ndef main() =\n  val f = r\n"), "error: `r` is an `extern` taking or returning more than numbers, `bool` and complexes by value, which only a call of it passes; call it, or wrap the call in a `def` @3:11")
    assert_eq(refused("extern def w(x: inout real)\ndef main() =\n  val f = w\n"), "error: `w` is an `extern` taking or returning more than numbers, `bool` and complexes by value, which only a call of it passes; call it, or wrap the call in a `def` @3:11")
    assert_eq(refused(INTEGRATE + "def main() =\n  val f = plain\n"), "error: `plain` is an `extern` taking or returning more than numbers, `bool` and complexes by value, which only a call of it passes; call it, or wrap the call in a `def` @5:11")

@test("a @c struct holds numbers, bool and @c structs; any other field, a generic one or another attribute is refused")
c_structs()
    assert_eq(refused("@c\nstruct In\n  a: int8\n  z: complex\n@c\nstruct Out\n  i: In\n  ok: bool\nextern def f(o: inout Out, i: In)\n" + M), "ok")
    assert_eq(refused("@c\nstruct P\n  name: string\n" + M), "error: a `@c` struct holds numbers, `bool` and `@c` structs, as C lays them out, and its field `name` is string @1:1")
    assert_eq(refused("struct In\n  a: int8\n@c\nstruct Out\n  i: In\n" + M), "error: a `@c` struct holds numbers, `bool` and `@c` structs, as C lays them out, and its field `i` is In @3:1")
    assert_eq(refused("@c\nstruct P\n  v: [real]\n" + M), "error: a `@c` struct holds numbers, `bool` and `@c` structs, as C lays them out, and its field `v` is [real64] @1:1")
    assert_eq(refused("@c\nstruct P[T]\n  x: T\n" + M), "error: a `@c` struct is laid out as C lays it out, so `P` cannot be generic @1:1")
    assert_eq(refused("@packed\nstruct P\n  x: real\n" + M), "error: `@packed` is not an attribute of a struct, which takes `@c` and `@host` @1:1")
    assert_eq(refused("@c(\"x\")\nstruct P\n  x: real\n" + M), "error: `@c` takes no arguments @1:1")

@test("a parallel body and an @elemental function call only @pure externs, directly or through a function")
extern_purity()
    val head = "@pure\nextern def p(x: real): real\nextern def q(x: real): real\ndef via(x: real) = q(x)\n"
    val body = "def main() =\n  var y: [real] = zeros(4)\n  parallel for i in 1..4\n    y[i] = "

    assert_eq(refused(head + body + "p(1.0 * i)\n"), "ok")
    assert_eq(refused(head + body + "q(1.0 * i)\n"), "error: `q` is an `extern` not declared `@pure`, and a parallel body calls only `@pure` externs @8:12")
    assert_eq(refused(head + body + "via(1.0 * i)\n"), "error: `via` calls `q`, an `extern` not declared `@pure`, and a parallel body calls only `@pure` externs @8:12")
    assert_eq(refused(head + "@elemental def e(x: real) = p(x)\ndef main() = print(e([1.0]))\n"), "ok")
    assert_eq(refused(head + "@elemental def e(x: real) = q(x)\ndef main() = print(e([1.0]))\n"), "error: an `@elemental` function may be run in any order, so it cannot call `q`, an `extern` not declared `@pure` @5:1")

// -- Fortran ----------------------------------------------------------------------------------------

@test("a @fortran extern's symbol is gfortran's: the name in lowercase with an underscore, @symbol overriding it")
fortran_symbols()
    assert_eq(elaborated("@fortran\nextern def DGTSV(n: int32, info: inout int32)\n" + M),
        "(extern DGTSV (int32, inout int32) -> void @symbol(\"dgtsv_\") @fortran)\n(def main () void ())")
    assert_eq(elaborated("@fortran @link(\"mesh\")\n@symbol(\"__mesh_MOD_read_mesh\")\nextern def read_mesh(file: string, nodes: inout [real; :, :], n: inout int32)\n" + M),
        "(extern read_mesh (string, inout [real64; :, :], inout int32) -> void @symbol(\"__mesh_MOD_read_mesh\") @link(\"mesh\") @fortran)\n(def main () void ())")
    assert_eq(elaborated("@fortran\nextern def ok(x: complex, b: bool, z: [complex], f: (real, bool) -> bool): bool\n" + M),
        "(extern ok (complex[real64], bool, [complex[real64]], (real64, bool) -> bool) -> bool @symbol(\"ok_\") @fortran)\n(def main () void ())")

@test("a @fortran extern refuses what a plain Fortran procedure has no dummy for, and two spellings of one name")
fortran_refused()
    assert_eq(refused("@fortran\nextern def faxpy(n: int32)\n@fortran\nextern def FAXPY(n: int32)\n" + M), "error: `FAXPY` and `faxpy` both name the C symbol `faxpy_` @3:1")
    assert_eq(refused("@fortran\nextern def f(g: (real) -> real, p: c_ptr)\n" + M), "error: a Fortran procedure hands its callbacks no user data, so a `@fortran` extern takes no `c_ptr`; a callback passed to it captures nothing @2:36")
    assert_eq(refused("@fortran\nextern def f(g: (real, c_ptr) -> real, p: @data(g) c_ptr)\n" + M), "error: a Fortran procedure hands its callbacks no user data, so `p` takes no `@data` @2:52\nerror: a Fortran procedure hands its callbacks no user data, so `g`'s type takes no `c_ptr` @2:17")
    assert_eq(refused("@c\nstruct P\n  x: real\n@fortran\nextern def f(p: inout P)\n" + M), "error: a derived type does not cross to a plain Fortran procedure, so `P` cannot; reach it through a `bind(c)` wrapper written in Fortran and declare that as a C `extern` @5:23")
    assert_eq(refused("@fortran\nextern def f(n: int32, b: [bool])\n" + M), "error: a Fortran `logical` array has gfortran's 4-byte elements, and a `[bool]` has 1-byte ones: declare `b` as `[int32]`, 0 for `.false.` and 1 for `.true.` @2:27")
    assert_eq(refused("@fortran\nextern def f(s: inout string)\n" + M), "error: a `string` crosses to Fortran as a `character(*)` it may not write, so `s` cannot be `inout` @2:23")
    assert_eq(refused("@fortran\nextern def f(g: (inout real) -> void)\n" + M), "error: Fortran passes a callback its arguments by reference, and nex reads each as a value, so parameter 1 of `g` cannot be `inout` @2:17")
    assert_eq(refused("@fortran\nextern def f(g: (real) -> string)\n" + M), "error: a callback returns a number, a `bool`, a complex or nothing to C, and `g` returns string @2:17")
    assert_eq(refused("@fortran\nextern def f(): [real]\n" + M), "error: an `extern` returns a number, a `bool`, a complex or nothing, and [real64] does not cross back from C @2:17")
    assert_eq(refused("@fortran\nextern def f(x: real): real\ndef main() =\n  val g = f\n  print(g(1.0))\n"), "error: `f` is a `@fortran` extern, which takes every argument by reference, so it is only called; wrap the call in a `def` to pass it as a value @4:11")
    assert_eq(refused("@fortran\nextern def f(x: real): real\nextern def apply(g: (real) -> real): real\ndef main() = print(apply(f))\n"), "error: `f` is a `@fortran` extern, which takes every argument by reference, so it is only called; wrap the call in a `def` to pass it as a value @4:26")
    assert_eq(refused("@fortran\nextern def each(g: (real) -> void)\ndef main() =\n  val k = 2.0\n  each(x -> print(k * x))\n"), "error: this lambda captures `k`, and a callback with no `@data` partner is a bare C function pointer, with no environment to carry it @5:8")
