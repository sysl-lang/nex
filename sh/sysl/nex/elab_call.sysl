module sh.sysl.nex

// Calls: of a `def`, of a function value, of a numeric type name (a conversion, DESIGN §2.4), and of
// the prelude's scalar functions.
//
// **A name is looked up before it is taken for a conversion or a prelude function**, so a program
// that binds `sqrt` or `real` calls its own, as DESIGN §12 has `i` shadowed by a binding.
//
// **A call of a `def` resolves its arguments against the parameter list**: positional ones first,
// then named ones in any order, then each parameter left out takes its default. A function value —
// a parameter of function type, a lambda bound to a local — has no names and no defaults, so its
// arguments are positional only.
//
// **The prelude functions are typed here by rule, not declared**: each is generic over the numeric
// families in a way DESIGN §2.6's constraints will express once the elaborator has generics.

import sysl.buf.{Buf, buf}
import sh.sysl.parsing.Span

// The prelude functions of one real argument whose result is a real of the argument's width (an
// integer argument is first widened to `real64`).
private val REAL_FUNCTIONS = ["sqrt", "cbrt", "exp", "log", "log2", "log10", "sin", "cos", "tan", "asin", "acos", "atan", "sinh", "cosh", "tanh", "asinh", "acosh", "atanh", "floor", "ceil", "round", "trunc"]

// Those of them that also take a complex and give one.
private val COMPLEX_FUNCTIONS = ["sqrt", "exp", "log", "sin", "cos", "tan"]

private val OTHER_BUILTINS = ["print", "eprint", "abs", "sign", "conj", "arg", "atan2", "hypot", "fma", "min", "max", "assert", "assert_eq", "to_real", "to_integer", "to_complex"]

// The prelude's array functions (DESIGN §4.2, §4.3, §7.4), which come with arrays, and the
// assertions over arrays and lambdas.
private val ARRAY_BUILTINS = ["sum", "product", "length", "size", "rank", "extent", "extents", "permute", "reverse", "map", "filter", "flatMap", "reduce", "enumerate", "zip", "minval", "maxval", "minloc", "maxloc", "any", "all", "count", "norm2", "dot", "zeros", "ones", "fill", "reshape", "flatten", "transpose", "shape", "rows", "cols", "diag", "identity", "linspace", "origin", "rebase", "read_bytes", "write_bytes", "to_integers", "to_bytes", "assert_approx", "assert_traps"]

private among(name: string, set: []const string) -> bool
    for s in set
        if s == name then return true

    false

// The inverse trigonometric functions of one argument, whose real result is an angle in radians
// (DESIGN §13.4); `atan2` gives one too.
private val INVERSE_TRIG = ["asin", "acos", "atan"]

// The real result `t` of prelude function `name`: an angle in radians where `name` is an inverse
// trigonometric function, and `t` itself otherwise.
private inverse_angle(name: string, t: Ty) -> Ty = if among(name, INVERSE_TRIG) then measured(t, base_unit(ANGLE)) else t

// Whether `name` is a prelude function.
is_builtin(name: string) -> bool = among(name, REAL_FUNCTIONS) || among(name, OTHER_BUILTINS)

is_array_builtin(name: string) -> bool = among(name, ARRAY_BUILTINS) || is_lapack(name)

impl Elab
    call(*self, span: Span, callee: Expr, args: Buf[Expr], want: Option[Ty]) -> TExpr
        *callee.kind match
            Name(n) ->
                self.lookup_local(n) match
                    Some(id) ->
                        self.pending_of(id) match
                            Some(k) -> return self.call_pending(span, callee.span, id, k, args)
                            None -> return self.call_value(span, self.local_ref(callee.span, id, None), args)
                    None -> ()

                if self.names_a_parameter(callee.span, n) then return self.invalid(span)

                val q = self.global(callee.span, n)

                if self.is_intrinsic(q) then return self.mpi_call(span, q, args)

                self.find_generic_fun(q) match
                    Some(g) -> return self.generic_call(span, callee.span, q, g, args)
                    None -> ()

                self.find_top(q) match
                    Some(TopFun(k)) -> return self.call_fun(span, callee.span, k, args)
                    Some(TopValue(_)) -> return self.call_value(span, self.name(callee.span, n, None), args)
                    Some(TopExtern(k)) -> return self.call_extern(span, callee.span, k, args)
                    None -> ()

                if n == "strip" then return self.strip_call(span, args)

                if n == "to"
                    self.fail(callee.span, "`to` names the unit it converts to: `to<mm>(x)`")
                    return self.invalid(span)

                self.construct(span, callee.span, q, args, want) match
                    Some(v) -> return v
                    None -> ()

                scalar_named(n) match
                    Some(t) -> return self.conversion(span, n, t, args)
                    None -> ()

                if is_builtin(n) then return self.builtin(span, n, args, want)
                if is_array_builtin(n) then return self.array_builtin(span, n, args, want)

                self.unknown_name(callee.span, n)
                self.invalid(span)
            Index(target, indices) ->
                // `complex[real32](z)`: the type name of a complex kind, called.
                *target.kind match
                    Name(n) ->
                        if n == "complex" && indices.len() == 1 && self.lookup_local(n).is_none() && self.find_top(self.global(target.span, n)).is_none()
                            val part = *indices[0].kind match
                                Name(p) -> scalar_named(p)
                                _ -> None

                            part match
                                Some(Real(b)) -> return self.conversion(span, s"complex[real${b}]", Complex(b), args)
                                _ ->
                                    self.fail(indices[0].span, "a complex type names a real part type: `complex[real32]`")
                                    return self.invalid(span)
                    _ -> ()

                self.call_value(span, self.infer(callee), args)
            Measured(target, unit) ->
                // `to<mm>(x)`, unless `to` is a binding of the program.
                *target.kind match
                    Name(n) ->
                        if n == "to" && self.lookup_local(n).is_none() && self.find_top(self.global(target.span, n)).is_none() then return self.to_call(span, unit, args)
                    _ -> ()

                self.call_value(span, self.infer(callee), args)
            _ -> self.call_value(span, self.infer(callee), args)
    end call

    // `x.f(args)` calls the field `f` where `x` is a struct with a field of that name, and is
    // `f(x, args)` otherwise.
    method_call(*self, span: Span, receiver: Expr, name: string, args: Buf[Expr], want: Option[Ty]) -> TExpr
        if self.has_field(receiver, name) then return self.call_value(span, self.field(receiver.span, receiver, name), args)

        var all: Buf[Expr] = buf()

        all.push(receiver)
        all.extend(args.view())
        self.call(span, Expr(span, ExprKind.Name(name)), all, want)

    // `z.re` and `z.im`, or a struct's field.
    field(*self, span: Span, receiver: Expr, name: string) -> TExpr = self.select_field(span, self.infer(receiver), name)

    // An argument passed to an `inout` parameter: a variable the callee borrows, exactly of the
    // parameter's type, since a borrow cannot convert (DESIGN §8).
    borrow(*self, arg: Expr, ty: Ty, named: string) -> TExpr
        *arg.kind match
            Name(_) -> ()
            Field(_, _) -> ()
            TupleField(_, _) -> ()
            // An element, or a slice borrowed as the window it names and written in place.
            Index(_, _) -> ()
            _ ->
                self.fail(arg.span, "an `inout` argument is a variable the callee can write to")
                return self.invalid(arg.span)

        val p = self.place(arg)

        // A `[*; ..]` parameter takes the place as it is, which its caller checks.
        if is_assumed(ty) then return texpr(arg.span, p.ty, TBorrow(p))

        if !ty_eq(p.ty, ty) && !is_wild(p.ty) && !is_error(ty)
            self.fail(arg.span, s"an `inout` argument must be exactly ${if named.len > 0 then named else show_ty(ty)}, since it is borrowed and not converted; this is ${self.shown(p)}")

        texpr(arg.span, ty, TBorrow(p))
    end borrow

    // One argument against its parameter's type and mode; `named` is that type as the parameter
    // wrote it, or `""`.
    argument(*self, arg: Expr, ty: Ty, named: string, mode: Mode, name: string) -> TExpr
        if mode == Inout then return self.borrow(arg, ty, named)

        self.pass_lambda(arg)
        self.coerce_named(self.elab(arg, Some(ty)), ty, named, name)

    // A call of a function value, with positional arguments only.
    call_value(*self, span: Span, f: TExpr, args: Buf[Expr]) -> TExpr
        val sig = f.ty match
            Fn(sig) -> *sig
            Error -> return self.invalid(span)
            _ ->
                self.fail(f.span, s"this is ${self.shown(f)} and cannot be called")
                return self.invalid(span)

        if args.len() != sig.params.len()
            self.fail(span, s"this function takes ${sig.params.len()} argument${if sig.params.len() == 1 then "" else "s"}, and ${args.len()} ${if args.len() == 1 then "is" else "are"} given")
            return self.invalid(span)

        var out: Buf[TExpr] = buf()

        for k in 0..<args.len()
            *args[k].kind match
                NamedArg(n, _) ->
                    self.fail(args[k].span, s"a function value has no parameter names, so `${n} = ...` cannot be passed; pass it by position")
                    out.push(self.invalid(args[k].span))
                _ -> out.push(self.argument(args[k], sig.params[k], "", sig.modes[k], s"argument ${k + 1}"))

        texpr(span, sig.ret, TCall(f, out))
    end call_value

    // The first call of a lambda waiting for its parameter types: the arguments give them.
    call_pending(*self, span: Span, at: Span, id: usize, k: usize, args: Buf[Expr]) -> TExpr
        if args.len() != self.pending[k].params.len()
            self.fail(span, s"`${self.locals[id].name}` takes ${self.pending[k].params.len()} arguments, and ${args.len()} are given")
            return self.invalid(span)

        var vals: Buf[TExpr] = buf()
        var tys: Buf[Ty] = buf()

        for a in args
            val v = self.infer(a)

            vals.push(v)
            tys.push(v.ty)

        val ty = self.resolve_pending(k, tys)
        val f = self.local_ref(at, id, None)

        var out: Buf[TExpr] = buf()

        ty match
            Fn(sig) ->
                for j in 0..<vals.len()
                    out.push(self.coerce(vals[j], sig.params[j], s"argument ${j + 1}"))

                texpr(span, sig.ret, TCall(f, out))
            _ -> self.invalid(span)
    end call_pending

    // A call of the `k`th `def`, with positional and named arguments and defaults.
    call_fun(*self, span: Span, at: Span, k: usize, args: Buf[Expr]) -> TExpr
        val complete = self.ensure_defaults(k, span)
        val sig = self.fsig[k]
        val name = self.funs[k].name
        var slots: Buf[Option[Expr]] = buf()
        var named = false

        for _ in sig.names
            slots.push(None)

        var next: usize = 0

        for a in args
            *a.kind match
                NamedArg(n, value) ->
                    named = true

                    var found = false

                    for j in 0..<sig.names.len()
                        if sig.names[j] == n
                            found = true

                            if slots[j].is_some() then self.fail(a.span, s"`${n}` is given twice") else slots.set(j, Some(value))

                    if !found then self.fail(a.span, s"`${name}` has no parameter `${n}`")
                _ ->
                    if named
                        self.fail(a.span, "a positional argument cannot follow a named one")
                    elif next >= slots.len()
                        self.fail(a.span, s"`${name}` takes ${sig.names.len()} argument${if sig.names.len() == 1 then "" else "s"}")
                    else
                        slots.set(next, Some(a))

                    next += 1

        var out: Buf[TExpr] = buf()
        var given: Buf[bool] = buf()
        val generic = self.funs[k].uparams.len() > 0
        var bound = UnitBindings(buf(), buf())

        for j in 0..<slots.len()
            given.push(slots[j].is_some())

            slots[j] match
                Some(a) ->
                    val what = s"argument `${sig.names[j]}`"
                    val named = self.spelled[sig.params[j]]

                    out.push(if generic then self.unit_argument(&bound, a, sig.tys[j], named, sig.modes[j], what) else self.fun_argument(k, a, sig.tys[j], named, sig.modes[j], what))
                None ->
                    sig.defaults[j] match
                        Some(d) -> out.push(d)
                        None ->
                            self.missing_argument(span, name, k, j, complete)
                            out.push(self.invalid(span))

        val ty = self.fun_type(k, at)
        val ret = ty match
            Fn(s) -> subst_ty(s.ret, bound)
            _ -> Error

        val (items, args) = self.defaulted_args(k, out, given)
        val call = if self.is_elemental(k) && any_array(args) then self.elemental_call(span, texpr(at, ty, TFnRef(name)), args, ret) else texpr(span, ret, TCall(texpr(at, ty, TFnRef(name)), args))

        after_items(span, items, call)
    end call_fun

    // A call of `name`, the `k`th `def`, leaving out its `j`th parameter, whose default is not known:
    // none was written, or the call is met while `name`'s defaults are still being elaborated, which
    // they reach in a cycle (`complete` false). A cycle closed in a default was reported there.
    missing_argument(*self, span: Span, name: string, k: usize, j: usize, complete: bool)
        val param = self.fsig[k].names[j]

        if complete || self.funs[k].params[j].default.is_none()
            self.fail(span, s"`${name}` needs its argument `${param}`")
        elif self.fx.owner == ""
            self.fail(span, s"this call leaves out `${param}`, whose default is being elaborated: the defaults of `${name}` reach this call, which reaches them again; give `${param}` here")

    // The arguments `out` of a call of the `k`th `def`, where each default (`given[j]` false) that
    // reads an earlier parameter reads that parameter's argument (DESIGN §11.3), and the items the
    // call follows. Every argument up to the last one such a default reads is bound to a local of its
    // own by an item, in parameter order, so that each is evaluated once and before the defaults
    // after it; an `inout` argument is not bound but read in its place, as an argument beside a
    // borrow reads it (§8.3). An `@elemental` function applied to an array does not fill a default
    // that reads that array, which would see the whole of it and not one element.
    defaulted_args(*self, k: usize, out: Buf[TExpr], given: Buf[bool]) -> (Buf[TExpr], Buf[TExpr])
        val sig = self.fsig[k]
        var items: Buf[TExpr] = buf()
        var upto: usize = 0
        var reading = false

        for j in 0..<out.len()
            if given[j] then continue

            val reads = reads_locals(out[j], sig.params)

            for i in 0..<j
                if reads[i]
                    if is_array(out[i].ty) && self.is_elemental(k)
                        self.fail(out[i].span, s"`${self.funs[k].name}` is applied to each element of this array, and the default of `${sig.names[j]}` reads `${sig.names[i]}`, which would be the whole array; give `${sig.names[j]}`")

                    if sig.modes[i] == Inout && self.has_call(out[i])
                        self.fail(out[i].span, s"the default of `${sig.names[j]}` reads `${sig.names[i]}`, so this `inout` argument would be evaluated twice; bind what its subscript calls to a `val` first")

                    if !reading || i > upto then upto = i

                    reading = true

        if !reading then return (items, out)

        var args: Buf[TExpr] = buf()
        var from: Buf[usize] = buf()
        var to: Buf[TExpr] = buf()

        for j in 0..<out.len()
            val v = if given[j] then out[j] else subst_locals(out[j], from, to)

            if j <= upto && sig.modes[j] != Inout
                val id = self.argument_local(sig.names[j], v)
                val read = texpr(v.span, v.ty, TLocal(id))

                items.push(texpr(v.span, Void, TLet(id, v)))
                args.push(read)
                to.push(read)
            else
                args.push(v)
                to.push(*v.kind match
                    TBorrow(place) -> place
                    _ -> v)

            from.push(sig.params[j])

        (items, args)
    end defaulted_args

    // A local holding the argument `v` of the parameter `name` for a call whose defaults read it,
    // a `val` as `val name = v` would declare it.
    private argument_local(*self, name: string, v: TExpr) -> usize
        val origin = self.is_origin(v)
        val id = self.new_local(name, v.ty, if origin then LOrigin else LVal)

        if !origin && is_array(v.ty) && self.views_storage(v) then self.vw.locals.push(id)

        id

    // Whether `e` calls a function, which evaluating it again would call again.
    private has_call(self, e: TExpr) -> bool
        *e.kind match
            TCall(_, _) -> return true
            _ -> ()

        for c in children(e)
            if self.has_call(c) then return true

        false

    // -- conversions ------------------------------------------------------------------------------

    // `real32(x)`, `int16(n)`, `complex[real32](re, im)`: a type name called (DESIGN §2.4).
    conversion(*self, span: Span, name: string, target: Ty, args: Buf[Expr]) -> TExpr
        if !is_numeric(target)
            self.fail(span, s"`${name}` is a type, not a conversion; only the numeric types convert")
            return self.invalid(span)

        if is_complex(target) && args.len() == 2 then return self.make_complex(span, target, args[0], args[1])

        if args.len() != 1
            self.fail(span, s"`${name}(...)` converts one value")
            return self.invalid(span)

        val class = self.literal_class(args[0])
        val v = if class != NOT_LITERAL && adoption(class, target).is_some() then self.elab(args[0], Some(target)) else self.infer(args[0])
        val from = v.ty

        if is_error(from) then return self.invalid(span)
        if is_array(from) then return self.elemental_conversion(span, name, target, v)
        if has_unit(from) then return self.measured_conversion(span, name, target, v)
        if ty_eq(from, target) then return v
        if promotes(from, target) then return texpr(span, target, TPromote(v))

        if !is_numeric(from)
            self.fail(args[0].span, s"`${name}(...)` converts a number, and this is ${show_ty(from)}")
            return self.invalid(span)

        if is_complex(from) && !is_complex(target)
            self.fail(args[0].span, s"a complex number does not convert to ${show_ty(target)}: take `.re` (or `abs`, `arg`) first")
            return self.invalid(span)

        // A narrower complex rounds each part, as a narrower real does, and never traps. A narrower integer, a change of signedness, or a real to an integer can be out of range.
        texpr(span, target, TConvert(v, is_int(target)))
    end conversion

    // -- the prelude ------------------------------------------------------------------------------

    // Arguments that are elaborated together into one common type, literals adopting it.
    unified(*self, span: Span, what: string, args: Buf[Expr]) -> Buf[TExpr]
        val reported = self.diags.len()
        var vals: Buf[Option[TExpr]] = buf()
        var shared: Option[Ty] = None

        for a in args
            if self.literal_class(a) != NOT_LITERAL
                vals.push(None)
            else
                val v = self.infer(a)

                shared = shared match
                    Some(t) -> self.common_of(span, what, t, elem_of(v.ty))
                    None -> Some(elem_of(v.ty))
                vals.push(Some(v))

        var out: Buf[TExpr] = buf()

        for k in 0..<args.len()
            out.push(vals[k] match
                Some(v) -> v
                None ->
                    val class = self.literal_class(args[k])

                    self.elab(args[k], shared match
                        Some(t) -> Some(adoption(class, t).unwrap_or(default_of(class)))
                        None -> None))

        // An array argument meets the others by its element type, and is widened element by element.
        var ty = elem_of(out[0].ty)

        for k in 1..<out.len()
            val ety = elem_of(out[k].ty)

            ty = common(ty, ety) match
                Some(t) -> t
                None ->
                    // A literal of no unit beside one that has a unit, which the pass above did not meet.
                    if (has_unit(ty) || has_unit(ety)) && !is_error(ty) && self.diags.len() == reported then self.unit_mismatch(span, what, out[0], out[k])
                    Error

        for k in 0..<out.len()
            out.set(k, promote(out[k], with_elem(out[k].ty, ty)))

        out
    end unified

    // `fma(a, b, c)`: `a * b + c` rounded once (DESIGN §7.3). It takes reals of one width, the width of
    // the widest, literals adopting it; `a` and `b` combine their units as `*` does and `c` must be a
    // measure of the product's dimension, converted to its unit as `+` converts its right operand.
    // An array argument makes it elemental, the scalars broadcasting.
    fused_multiply_add(*self, span: Span, args: Buf[Expr]) -> TExpr
        if args.len() != 3 then return self.arity(span, "fma", "three values")

        val reported = self.diags.len()
        var vals: Buf[Option[TExpr]] = buf()
        var shared: Option[Ty] = None

        for a in args
            if self.literal_class(a) != NOT_LITERAL
                vals.push(None)
            else
                val v = self.infer(a)

                if is_error(v.ty) then return self.invalid(span)

                shared = shared match
                    Some(t) -> self.common_of(span, "fma", t, base_of(elem_of(v.ty)))
                    None -> Some(base_of(elem_of(v.ty)))
                vals.push(Some(v))

        if self.diags.len() != reported then return self.invalid(span)

        var out: Buf[TExpr] = buf()

        for k in 0..<3
            out.push(vals[k] match
                Some(v) -> v
                None ->
                    val class = self.literal_class(args[k])

                    self.elab(args[k], shared match
                        Some(t) -> Some(adoption(class, t).unwrap_or(default_of(class)))
                        None -> None))

        var w = base_of(elem_of(out[0].ty))

        for k in 1..<3
            w = self.common_of(span, "fma", w, base_of(elem_of(out[k].ty))).unwrap_or(Error)

        if is_error(w) then return self.invalid(span)

        if is_complex(w)
            self.fail(span, s"`fma` takes reals: a complex product and sum have no single rounding, so write the two operations; these are ${show_ty(out[0].ty)}, ${show_ty(out[1].ty)} and ${show_ty(out[2].ty)}")
            return self.invalid(span)

        if !is_real(w)
            self.fail(span, s"`fma` takes reals, and an integer has no rounding to fuse; these are ${show_ty(out[0].ty)}, ${show_ty(out[1].ty)} and ${show_ty(out[2].ty)}")
            return self.invalid(span)

        val ua = elem_unit(out[0].ty)
        val ub = elem_unit(out[1].ty)
        val uc = elem_unit(out[2].ty)
        val (xa, xb) = self.product_units(ua, ub, false)
        val u = unit_mul(xa, xb)

        if self.exact(span, u).is_none() then return self.invalid(span)

        if !same_dims(u, uc)
            self.fail(span, s"`fma` adds `c` to the product `a * b`, which is ${spell(u)}, and `c` is ${show_ty(out[2].ty)}")
            return self.invalid(span)

        out.set(0, promote(out[0], with_elem(out[0].ty, measured(w, xa))))
        out.set(1, promote(out[1], with_elem(out[1].ty, measured(w, xb))))
        out.set(2, promote(out[2], with_elem(out[2].ty, measured(w, u))))

        val ret = measured(w, u)

        if any_array(out) then return self.elemental(span, "fma", out, ret)

        texpr(span, ret, TBuiltin("fma", out))
    end fused_multiply_add

    builtin(*self, span: Span, name: string, args: Buf[Expr], want: Option[Ty]) -> TExpr
        for a in args
            *a.kind match
                NamedArg(n, _) ->
                    self.fail(a.span, s"`${name}` takes no named arguments")
                    return self.invalid(span)
                _ -> ()

        if name == "print" || name == "eprint" then return self.print_call(span, name, args)
        if name == "to_real" then return self.conversion(span, name, REAL, args)
        if name == "to_integer" then return self.conversion(span, name, INTEGER, args)
        if name == "to_complex" then return self.conversion(span, name, COMPLEX, args)

        if name == "assert"
            if args.len() < 1 || args.len() > 2 then return self.arity(span, name, "a condition and an optional message")

            var out: Buf[TExpr] = buf()

            out.push(self.check(args[0], Bool, "the condition"))
            if args.len() == 2 then out.push(self.check(args[1], Ty.Str, "the message"))

            return texpr(span, Void, TBuiltin(name, out))

        if name == "assert_eq"
            if args.len() != 2 then return self.arity(span, name, "two values")

            return texpr(span, Void, TBuiltin(name, self.unified(span, name, args)))

        if name == "min" || name == "max"
            if args.len() < 2 then return self.arity(span, name, "two or more values")

            val out = self.unified(span, name, args)
            val ty = elem_of(out[0].ty)

            if !is_ordered(base_of(ty)) && !is_error(ty) then self.fail(span, s"`${name}` compares integers and reals; these are ${show_ty(ty)}")
            if any_array(out) then return self.elemental(span, name, out, ty)

            return texpr(span, ty, TBuiltin(name, out))

        if name == "fma" then return self.fused_multiply_add(span, args)

        if name == "atan2" || name == "hypot"
            if args.len() != 2 then return self.arity(span, name, "two values")

            var out = self.unified(span, name, args)
            val ety = elem_of(out[0].ty)
            val ty = if is_int(ety) then REAL else ety

            if !is_real(base_of(ty)) && !is_error(ty) then self.fail(span, s"`${name}` takes reals; these are ${show_ty(ty)}")

            for k in 0..<out.len()
                out.set(k, promote(out[k], with_elem(out[k].ty, ty)))

            // `atan2` gives an angle in radians, whatever its arguments' one unit (DESIGN §13.4).
            val result = if name == "atan2" then measured(base_of(ty), base_unit(ANGLE)) else ty

            if any_array(out) then return self.elemental(span, name, out, result)

            return texpr(span, result, TBuiltin(name, out))

        if args.len() != 1 then return self.arity(span, name, "one value")

        val v = self.infer(args[0])
        var out: Buf[TExpr] = buf()

        out.push(v)

        if is_error(v.ty) then return texpr(span, Error, TBuiltin(name, out))
        if has_unit(v.ty) then return self.measured_builtin(span, name, v)

        // On an array whose elements carry a unit, the scalar rule over one element types the result
        // and says what the argument becomes: a dimensionless one with a scale is brought to scale 1.
        if is_array(v.ty) && carries_unit(v.ty)
            val s = self.measured_builtin(span, name, texpr(v.span, elem_of(v.ty), TInvalid))

            if is_error(s.ty) then return self.invalid(span)

            *s.kind match
                TBuiltin(_, xs) -> out.set(0, promote(v, with_elem(v.ty, xs[0].ty)))
                _ -> ()

            return self.elemental(span, name, out, s.ty)

        if is_array(v.ty)
            val r = self.scalar_result(span, name, elem_of(v.ty))

            if is_real(base_of(r)) && is_int(elem_of(v.ty)) then out.set(0, promote(v, with_elem(v.ty, REAL)))

            return self.elemental(span, name, out, r)

        val result = self.scalar_result(span, name, v.ty)

        // An integer argument to a real function is widened to `real64` first.
        if is_real(base_of(result)) && is_int(v.ty) then out.set(0, promote(v, REAL))

        texpr(span, result, TBuiltin(name, out))
    end builtin

    // The result type of a one-argument prelude function on an argument of type `t`.
    scalar_result(*self, span: Span, name: string, t: Ty) -> Ty
        // The real part's type of a complex parameter is not a type the generic can name.
        if (name == "abs" || name == "arg") && is_param(t) && is_complex(t)
            self.fail(span, s"`${name}` of a complex number is its real part's type, which ${param_text(t)} does not name")
            return Error

        if name == "abs"
            if is_complex(t) then return Real(bits_of(t))
            if is_ordered(t) then return t
        elif name == "sign"
            if is_ordered(t) then return t
        elif name == "conj"
            if is_complex(t) then return t
        elif name == "arg"
            if is_complex(t) then return Real(bits_of(t))
        else
            if is_int(t) then return inverse_angle(name, REAL)
            if is_real(t) then return inverse_angle(name, t)
            if is_complex(t) && among(name, COMPLEX_FUNCTIONS) then return t

        self.fail(span, s"`${name}` does not take ${show_ty(t)}")
        Error
    end scalar_result

    print_call(*self, span: Span, name: string, args: Buf[Expr]) -> TExpr
        if args.len() > 1 then return self.arity(span, name, "one value; interpolate several: `s\"$a $b\"`")

        var out: Buf[TExpr] = buf()

        for a in args
            val v = self.infer(a)

            v.ty match
                Void -> self.fail(a.span, "this has no value to print: it is void")
                Fn(_) -> self.fail(a.span, s"a function cannot be printed")
                _ -> ()

            out.push(printable(v))

        texpr(span, Void, TBuiltin(name, out))

    arity(*self, span: Span, name: string, wants: string) -> TExpr
        self.fail(span, s"`${name}` takes ${wants}")
        self.invalid(span)
end Elab

// `call` after `items`, the locals a call's defaults read bound first; the call alone where there are
// none.
after_items(span: Span, items: Buf[TExpr], call: TExpr) -> TExpr = if items.len() == 0 then call else texpr(span, call.ty, TBlock(items, call))
