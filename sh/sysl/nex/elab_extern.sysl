module sh.sysl.nex

// `extern def`: a C function declared and called (DESIGN §10, §13.7).
//
// **An extern's signature is resolved before any body is elaborated**, since it has no body to infer
// a result from. **Its parameters and result never carry a unit**: a C function takes the number, so
// a caller passes `strip(x)` and gives the result a unit by multiplying.
//
// **What crosses is DESIGN §10.2's table**: integers, reals, complexes and `bool` by value (by
// pointer as `inout`), a `string` read-only, an array of numbers or `bool` as a pointer to its first
// element, a `@c` struct by pointer, a function as a callback with `c_ptr` as its `@data` partner. A
// result is a scalar, a complex or nothing. The attributes say the rest: `@link` and `@symbol` on the
// declaration, `@pure`, `@strided` on an array parameter.
//
// **A `@fortran` extern is a plain gfortran procedure** (DESIGN §10.6): its symbol is the name in
// lowercase with an underscore after it, and what crosses is what crosses to C less what Fortran has
// no dummy for — a `@c` struct, a `[bool]` (gfortran's `logical` is 4 bytes) and user data. It is only
// called, never a function value.

import sysl.buf.{Buf, buf}
import sysl.text.to_lower
import sh.sysl.parsing.Span

// An `extern def` as written.
struct ExternSrc
    decl: Decl
    name: string
    params: Buf[Param]
    ret: Option[Type]

impl Elab
    // The `k`th extern's parameter and result types and what its attributes say.
    resolve_extern(*self, k: usize)
        val x = self.externs[k]

        if has_attr(x.decl.attrs, "host") then return self.resolve_host(k)

        var tys: Buf[Ty] = buf()
        var modes: Buf[Mode] = buf()
        var names: Buf[string] = buf()
        var strided: Buf[bool] = buf()
        var partner: Buf[Option[usize]] = buf()
        val fortran = has_attr(x.decl.attrs, "fortran")

        self.in_extern = true

        for p in x.params
            if contains(names, p.name) then self.fail(x.decl.span, s"redeclaration of `${p.name}`")
            if p.default.is_some() then self.fail(p.typ.span, "an `extern` parameter has no default: an `extern` declares the C function as it is, and a default belongs to a `def` that wraps it")

            val ty = self.resolve_type(p.typ)

            if carries_unit(ty) then self.fail(p.typ.span, s"an `extern` parameter never carries a unit: C takes the number, so declare it ${show_ty(stripped(ty))} and pass `strip(x)`")
            elif fortran then self.check_fortran_crossing(p, ty)
            else self.check_crossing(p, ty)

            names.push(p.name)
            tys.push(ty)
            modes.push(p.mode)
            strided.push(self.strided_attr(p, ty))

        // A `@data(f)` partner names a parameter of function type, which may stand after it.
        for j in 0..<x.params.len()
            val f = if fortran then None else self.data_partner(x.params[j], tys[j], names, tys)

            f match
                Some(i) -> if has_data(partner, i) then self.fail(x.params[j].typ.span, s"`${names[i]}` has one user data, and a second `@data(${names[i]})` names it")
                None -> ()

            partner.push(f)

        for j in 0..<x.params.len()
            if is_callback(tys[j]) then self.check_callback(x.params[j], tys[j], has_data(partner, j), fortran)

        val ret = x.ret match
            Some(t) ->
                val r = self.resolve_type(t)

                if carries_unit(r) then self.fail(t.span, s"an `extern` result never carries a unit: declare it ${show_ty(stripped(r))} and give the result its unit by multiplying, `${x.name}(...) * 1.0<${spell(elem_unit(r))}>`")
                elif !c_scalar(r) && !is_error(r) then self.fail(t.span, s"an `extern` returns a number, a `bool`, a complex or nothing, and ${show_ty(r)} does not cross back from C")
                r
            None -> Void

        self.in_extern = false

        // A module's extern is the C function of its own name, without the module's path; a Fortran
        // procedure's is gfortran's: the name in lowercase with an underscore after it.
        var symbol = if fortran then to_lower(display_name(x.name)) + "_" else display_name(x.name)
        var links: Buf[string] = buf()
        var frameworks: Buf[string] = buf()
        var pure = false
        var named = false

        for a in x.decl.attrs
            if a.name == "link"
                if a.args.len() != 1 then self.fail(x.decl.span, LINK_FORM)
                else a.args[0] match
                    Str(lib) -> links.push(lib)
                    Named(n, v) -> if n == "framework" then frameworks.push(v) else self.fail(x.decl.span, LINK_FORM)
                    _ -> self.fail(x.decl.span, LINK_FORM)
            elif a.name == "symbol"
                if named then self.fail(x.decl.span, s"`${x.name}` has one C symbol, and `@symbol` is given twice")

                named = true

                if a.args.len() != 1 then self.fail(x.decl.span, SYMBOL_FORM)
                else a.args[0] match
                    Str(s) -> symbol = s
                    _ -> self.fail(x.decl.span, SYMBOL_FORM)
            elif a.name == "pure"
                if a.args.len() > 0 then self.fail(x.decl.span, "`@pure` takes no arguments")

                pure = true
            elif a.name == "fortran"
                if a.args.len() > 0 then self.fail(x.decl.span, "`@fortran` takes no arguments")
            else
                self.fail(x.decl.span, s"`@${a.name}` is not an attribute of an `extern def`, which takes `@link`, `@symbol`, `@pure` and `@fortran`")

        for j in 0..<k
            if !self.xout[j].host && self.xout[j].symbol == symbol then self.fail(x.decl.span, s"`${display_name(x.name)}` and `${display_name(self.xout[j].name)}` both name the C symbol `${symbol}`")

        self.xout.push(TExtern(x.decl.span, x.name, tys, modes, ret, symbol, links, frameworks, pure, strided, partner, fortran, false))
    end resolve_extern

    // A `@host extern def`: a function the embedding program gives (DESIGN §16.3). Its parameters and
    // result are values a host holds — any but a function — with their units, and it takes its
    // arguments by value.
    resolve_host(*self, k: usize)
        val x = self.externs[k]
        var tys: Buf[Ty] = buf()
        var modes: Buf[Mode] = buf()
        var names: Buf[string] = buf()
        var none: Buf[Option[usize]] = buf()
        var flat: Buf[bool] = buf()
        var pure = false

        for a in x.decl.attrs
            if a.name == "pure" then pure = true
            elif a.name != "host" then self.fail(x.decl.span, s"`@${a.name}` is not an attribute of a `@host extern def`, which takes `@pure`")
            elif a.args.len() > 0 then self.fail(x.decl.span, "`@host` takes no arguments")

        for p in x.params
            if contains(names, p.name) then self.fail(x.decl.span, s"redeclaration of `${p.name}`")
            if p.default.is_some() then self.fail(p.typ.span, "a `@host` function's parameter has no default: the host gives the function as it is, and a default belongs to a `def` that wraps it")
            if p.mode == Inout then self.fail(p.typ.span, s"a `@host` function takes its arguments by value, so `${p.name}` is not `inout`; return the new value instead")

            val ty = self.resolve_type(p.typ)

            if is_callback(ty) then self.fail(p.typ.span, s"a `@host` function's parameter is a value the host holds, and `${p.name}` is a function")

            names.push(p.name)
            tys.push(ty)
            modes.push(p.mode)
            none.push(None)
            flat.push(false)

        val ret = x.ret match
            Some(t) ->
                val r = self.resolve_type(t)

                if is_callback(r) then self.fail(t.span, "a `@host` function's result is a value the host holds, and a function is not one")
                r
            None -> Void

        self.xout.push(TExtern(x.decl.span, x.name, tys, modes, ret, display_name(x.name), buf(), buf(), pure, flat, none, false, true))
    end resolve_host

    // Whether a parameter of type `ty` crosses to C as DESIGN §10.2 says, and if not, why.
    private check_crossing(*self, p: Param, ty: Ty)
        if is_error(ty) || c_scalar(ty) then return

        base_of(ty) match
            Str -> if p.mode == Inout then self.fail(p.typ.span, s"a `string` crosses to C as a `const char *` it may not write, so `${p.name}` cannot be `inout`")
            Array(_, _) ->
                if !c_scalar(elem_of(ty)) then self.fail(p.typ.span, s"an array crosses to C as a pointer to its elements, which must be numbers or `bool`, and ${show_ty(ty)} holds ${show_ty(elem_of(ty))}")
            Nominal(name, _) ->
                if !self.is_c_struct(ty) then self.fail(p.typ.span, s"a struct crosses to C by pointer only where it is declared `@c`, which lays it out as C does, and `${name}` is not")
            Fn(_) -> if p.mode == Inout then self.fail(p.typ.span, s"a callback crosses to C as a function pointer, so `${p.name}` cannot be `inout`")
            CPtr -> if p.mode == Inout then self.fail(p.typ.span, s"a `c_ptr` is a callback's user data, passed by value, so `${p.name}` cannot be `inout`")
            _ -> self.fail(p.typ.span, s"${show_ty(ty)} does not cross to C: an `extern` takes numbers, `bool`, `string`, arrays of numbers, `@c` structs and callbacks")

    // Whether a parameter of type `ty` crosses to a plain Fortran procedure as DESIGN §10.6 says, every
    // argument by reference: what crosses to C, less what Fortran has no matching dummy for.
    private check_fortran_crossing(*self, p: Param, ty: Ty)
        if p.type_attrs.len() > 0
            self.fail(p.typ.span, s"a Fortran procedure hands its callbacks no user data, so `${p.name}` takes no `@data`")
            return

        if is_error(ty) || c_scalar(ty) then return

        base_of(ty) match
            Str -> if p.mode == Inout then self.fail(p.typ.span, s"a `string` crosses to Fortran as a `character(*)` it may not write, so `${p.name}` cannot be `inout`")
            Array(_, _) ->
                if is_logical_ty(elem_of(ty)) then self.fail(p.typ.span, s"a Fortran `logical` array has gfortran's 4-byte elements, and a `[bool]` has 1-byte ones: declare `${p.name}` as `[int32]`, 0 for `.false.` and 1 for `.true.`")
                else self.check_crossing(p, ty)
            Nominal(name, _) -> self.fail(p.typ.span, s"a derived type does not cross to a plain Fortran procedure, so `${name}` cannot; reach it through a `bind(c)` wrapper written in Fortran and declare that as a C `extern`")
            CPtr -> self.fail(p.typ.span, s"a Fortran procedure hands its callbacks no user data, so a `@fortran` extern takes no `c_ptr`; a callback passed to it captures nothing")
            _ -> self.check_crossing(p, ty)

    // A callback's own parameters and result cross by value, as a C extern's do; a Fortran
    // procedure's callback is passed each by reference and reads it as a value. Its type holds a
    // `c_ptr`, where C hands the user data back, exactly when it has a `@data` partner.
    private check_callback(*self, p: Param, ty: Ty, with_data: bool, fortran: bool)
        val sig = base_of(ty) match
            Fn(s) -> s
            _ -> return

        var ptrs = 0
        val caller = if fortran then "Fortran passes a callback its arguments by reference, and nex reads each as a value" else "C passes a callback its arguments by value"

        for k in 0..<sig.params.len()
            val t = sig.params[k]

            if is_c_ptr(t)
                if fortran then self.fail(p.typ.span, s"a Fortran procedure hands its callbacks no user data, so `${p.name}`'s type takes no `c_ptr`")
                ptrs += 1
            elif sig.modes[k] == Inout then self.fail(p.typ.span, s"$caller, so parameter ${k + 1} of `${p.name}` cannot be `inout`")
            elif !c_scalar(t) && !is_error(t) then self.fail(p.typ.span, s"C passes a callback numbers, `bool` and complexes by value, and parameter ${k + 1} of `${p.name}` is ${show_ty(t)}")

        if !c_scalar(sig.ret) && !is_void(sig.ret) && !is_error(sig.ret) then self.fail(p.typ.span, s"a callback returns a number, a `bool`, a complex or nothing to C, and `${p.name}` returns ${show_ty(sig.ret)}")

        if with_data && ptrs != 1 then self.fail(p.typ.span, s"`${p.name}` has a `@data` partner, so its type takes one `c_ptr`, where C hands the user data back")
        elif !with_data && ptrs > 0 && !fortran then self.fail(p.typ.span, s"a `c_ptr` in a callback's type is the user data C hands back: declare a `@data(${p.name}) c_ptr` parameter beside `${p.name}`")

    // Whether the parameter is marked `@strided`, which only an array parameter may be.
    private strided_attr(*self, p: Param, ty: Ty) -> bool
        var marked = false

        for a in p.attrs
            if a.name == "strided"
                if a.args.len() > 0 then self.fail(p.typ.span, "`@strided` takes no arguments")
                elif !is_array(ty) && !is_error(ty) then self.fail(p.typ.span, s"`@strided` passes an array's view as it lies, and `${p.name}` is not an array")

                marked = true
            else
                self.fail(p.typ.span, s"`@${a.name}` is not an attribute of an `extern` parameter, which takes `@strided`")

        marked

    // The function parameter a `c_ptr` parameter's `@data(f)` names, by number; a `c_ptr` has one,
    // and nothing else does.
    private data_partner(*self, p: Param, ty: Ty, names: Buf[string], tys: Buf[Ty]) -> Option[usize]
        var out: Option[usize] = None

        for a in p.type_attrs
            if a.name != "data"
                self.fail(p.typ.span, s"`@${a.name}` is not an attribute of an `extern` parameter's type, which takes `@data(f)`")
                continue

            val f = if a.args.len() == 1 then (a.args[0] match
                Name(n) -> n
                _ -> "") else ""

            if f == ""
                self.fail(p.typ.span, "`@data` names the callback parameter its user data goes with, `@data(f)`")
                continue

            for j in 0..<names.len()
                if names[j] == f then out = Some(j)

            out match
                Some(j) -> if !is_callback(tys[j]) then self.fail(p.typ.span, s"`@data(${f})` names the callback its user data goes with, and `${f}` is ${show_ty(tys[j])}, not a function")
                None -> self.fail(p.typ.span, s"`@data(${f})` names no parameter of this `extern`")

        val is_ptr = base_of(ty) match
            CPtr -> true
            _ -> false

        if is_ptr && out.is_none() && p.type_attrs.len() == 0 then self.fail(p.typ.span, s"a `c_ptr` is a callback's user data: declare `${p.name}: @data(f) c_ptr`, naming the callback parameter it goes with")
        elif !is_ptr && out.is_some()
            self.fail(p.typ.span, s"a `@data` parameter is C's `void *` for its callback's user data, so `${p.name}` is declared `c_ptr`")
            return None

        out

    // Whether `ty` is a struct declared `@c`.
    is_c_struct(self, ty: Ty) -> bool = base_of(ty) match
        Nominal(name, args) ->
            if args.len() > 0 then return false

            self.find_struct(name) match
                Some(k) -> has_attr(self.agg.structs[k].decl.attrs, "c")
                None -> false
        _ -> false

    // Every struct's attributes: `@c` is the one, and a `@c` struct's fields are what C lays out —
    // numbers, `bool` and other `@c` structs.
    check_c_structs(*self)
        for s in self.agg.structs
            for a in s.decl.attrs
                if a.name != "c" && a.name != "host" then self.fail(s.decl.span, s"`@${a.name}` is not an attribute of a struct, which takes `@c` and `@host`")
                elif a.args.len() > 0 then self.fail(s.decl.span, s"`@${a.name}` takes no arguments")

            val host = has_attr(s.decl.attrs, "host")

            if host && has_attr(s.decl.attrs, "c") then self.fail(s.decl.span, s"`${s.name}` is a host type, which the host lays out, so it is not `@c` too")
            elif host && s.generic then self.fail(s.decl.span, s"a host type is the host's own, so `${s.name}` is not generic")
            elif host && s.fields.len() > 0 then self.fail(s.decl.span, s"a host type has no fields: nex holds `${s.name}` and passes it back, and only the host looks inside")
            elif !host && s.fields.len() == 0 then self.fail(s.decl.span, s"a struct has fields; one with none is a type the host owns, declared `@host struct ${s.name}`")


            if !has_attr(s.decl.attrs, "c") then continue

            if s.generic
                self.fail(s.decl.span, s"a `@c` struct is laid out as C lays it out, so `${s.name}` cannot be generic")
                continue

            for f in s.fields
                if !c_scalar(f.ty) && !self.is_c_struct(f.ty) && !is_error(f.ty) then self.fail(s.decl.span, s"a `@c` struct holds numbers, `bool` and `@c` structs, as C lays them out, and its field `${f.name}` is ${show_ty(f.ty)}")

    extern_type(self, k: usize) -> Ty = fn_type(self.xout[k].params, self.xout[k].modes, self.xout[k].ret)

    // A call of the `k`th extern: positional arguments, each a plain number where it is one. A `@data`
    // parameter is omitted, the compiler passing it (DESIGN §10.2.1), so the call's arguments are the
    // other parameters', in order.
    call_extern(*self, span: Span, at: Span, k: usize, args: Buf[Expr]) -> TExpr
        val x = self.xout[k]
        var given: Buf[usize] = buf()

        for j in 0..<x.params.len()
            if x.partner[j].is_none() then given.push(j)

        if args.len() != given.len()
            self.fail(span, s"`${x.name}` takes ${given.len()} argument${if given.len() == 1 then "" else "s"}, and ${args.len()} ${if args.len() == 1 then "is" else "are"} given")
            return self.invalid(span)

        var out: Buf[TExpr] = buf()

        for i in 0..<args.len()
            val a = args[i]
            val j = given[i]
            val ty = x.params[j]

            *a.kind match
                NamedArg(_, _) ->
                    self.fail(a.span, s"an `extern` takes its arguments by position")
                    out.push(self.invalid(a.span))
                    continue
                _ -> ()

            if x.host
                out.push(self.coerce(self.elab(a, Some(ty)), ty, s"argument ${i + 1}"))
                continue

            if x.modes[j] == Inout
                out.push(self.borrow(a, ty, ""))
                continue

            if is_callback(ty)
                out.push(self.callback_arg(a, ty, has_data(x.partner, j), i))
                continue

            val v = self.elab(a, Some(ty))

            if carries_unit(v.ty)
                self.fail(a.span, s"`${x.name}` is an `extern`, whose parameters never carry a unit; pass the number: `${x.name}(strip(x))`")
                out.push(self.invalid(a.span))
            else
                out.push(self.coerce(v, ty, s"argument ${i + 1}"))

        // The callee is typed as the call sees it, without the `@data` parameters it omits.
        var params: Buf[Ty] = buf()
        var modes: Buf[Mode] = buf()

        for j in given
            params.push(x.params[j])
            modes.push(x.modes[j])

        texpr(span, x.ret, TCall(texpr(at, fn_type(params, modes, x.ret), TFnRef(x.name)), out))
    end call_extern

    // The argument `a`, the `i`th, for a callback parameter of type `ty`, borrowed for the call. With
    // a `@data` partner it is any function of the type without its `c_ptr`, its environment crossing
    // as the user data. Without one C gets a bare function pointer, with no environment to carry: a
    // function named directly, an extern among them, or a lambda that captures nothing.
    private callback_arg(*self, a: Expr, ty: Ty, with_data: bool, i: usize) -> TExpr
        val want = if with_data then without_c_ptr(ty) else ty

        self.pass_lambda(a)

        val v = self.coerce(self.elab(a, Some(want)), want, s"argument ${i + 1}")

        if with_data || is_error(v.ty) then return v

        val bare = *v.kind match
            TFnRef(_) -> true
            TLambdaRef(id) ->
                for c in self.captures
                    if c.lambda == id
                        self.fail(a.span, s"this lambda captures `${self.locals[c.local].name}`, and a callback with no `@data` partner is a bare C function pointer, with no environment to carry it")
                        return self.invalid(a.span)

                true
            _ -> false

        if bare then return v

        self.fail(a.span, "a callback with no `@data` partner is a bare C function pointer, so it takes a function named directly or a lambda that captures nothing")
        self.invalid(a.span)

    // The `k`th extern as a function value, which a call through it reaches by its own C signature:
    // only one whose parameters and result all cross by value.
    extern_value(*self, span: Span, k: usize, name: string) -> TExpr
        val x = self.xout[k]

        if x.host
            self.fail(span, s"`${display_name(x.name)}` is a `@host` function, which is only called; wrap the call in a `def` to pass it as a value")
            return self.invalid(span)

        if x.fortran
            self.fail(span, s"`${display_name(x.name)}` is a `@fortran` extern, which takes every argument by reference, so it is only called; wrap the call in a `def` to pass it as a value")
            return self.invalid(span)

        var ok = c_scalar(x.ret) || is_void(x.ret)

        for j in 0..<x.params.len()
            if x.modes[j] == Inout || !c_scalar(x.params[j]) then ok = false

        if !ok
            self.fail(span, s"`${display_name(x.name)}` is an `extern` taking or returning more than numbers, `bool` and complexes by value, which only a call of it passes; call it, or wrap the call in a `def`")
            return self.invalid(span)

        texpr(span, self.extern_type(k), TFnRef(name))
end Elab

private val LINK_FORM = "`@link` names a library, `@link(\"m\")`, or a framework, `@link(framework = \"Accelerate\")`"
private val SYMBOL_FORM = "`@symbol` names the C symbol, `@symbol(\"dgesv_\")`"

// Whether a value of `ty` crosses to C as itself: an integer of 8 to 64 bits, a `real16`, `real32` or
// `real64`, a complex of `real32` or `real64` parts, or a `bool`.
c_scalar(ty: Ty) -> bool = ty match
    Int(b, _) -> b == 8 || b == 16 || b == 32 || b == 64
    Real(b) -> b == 16 || b == 32 || b == 64
    Complex(b) -> b == 32 || b == 64
    Bool -> true
    _ -> false

private is_callback(ty: Ty) -> bool = base_of(ty) match
    Fn(_) -> true
    _ -> false

private is_c_ptr(ty: Ty) -> bool = base_of(ty) match
    CPtr -> true
    _ -> false

// Whether `t` is a `bool`, which crosses to Fortran as a 4-byte `logical`.
is_logical_ty(t: Ty) -> bool = base_of(t) match
    Bool -> true
    _ -> false

// Whether some parameter is the `@data` partner of parameter `j`.
has_data(partner: Buf[Option[usize]], j: usize) -> bool
    for p in partner
        p match
            Some(f) -> if f == j then return true
            None -> ()

    false

// A callback type without its `c_ptr`: the function a nex caller passes for it.
without_c_ptr(ty: Ty) -> Ty
    val sig = base_of(ty) match
        Fn(s) -> s
        _ -> return ty

    var params: Buf[Ty] = buf()
    var modes: Buf[Mode] = buf()

    for k in 0..<sig.params.len()
        if is_c_ptr(sig.params[k]) then continue

        params.push(sig.params[k])
        modes.push(sig.modes[k])

    fn_type(params, modes, sig.ret)

private[nex] has_attr(attrs: Buf[Attribute], name: string) -> bool
    for a in attrs
        if a.name == name then return true

    false
