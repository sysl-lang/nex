module sh.sysl.nex
@tests

// Modules (DESIGN §11.5) and the test build of `nex test` (DESIGN §11.2): projects of several files
// written to a scratch directory, loaded and elaborated. The cases of the reference's module loader,
// sysroot, prelude integration and test runner tests are here in nex's own terms; the projects whose
// output is the point, and `nex test` itself, run in `compiler/tests_run_modules.sysl`.

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, read_text, remove_dir_all, write_text}
import sysl.text.{join, replace_all}

// A project written to a fresh directory, each file at its path; its entry is `main.nex`.
private project(files: []const (string, string)) -> string
    val dir = make_temp_dir("nex-modules").unwrap()

    for (rel, text) in files
        val path = s"${dir}/${rel}"

        make_dir_all(parent_dir(path)).unwrap()
        write_text(path, text).unwrap()

    dir

// The typed IR of a project, or every diagnostic the loader and the elaborator give, one to a line
// with its file, relative to the project, and position; the project is removed.
private elab_project(dir: string, test_build: bool = false, prelude: Option[string] = None) -> string
    val out = elab_at(dir, test_build, prelude)

    remove_dir_all(dir).unwrap()
    replace_all(out, s"${dir}/", "")

private elab_at(dir: string, test_build: bool, prelude: Option[string]) -> string
    val p = load_project(s"${dir}/main.nex", LoadOptions(prelude, test_build)) match
        Ok(p) -> p
        Err(m) -> return m

    var ds = p.diags

    if ds.len() == 0
        elaborate_modules(p.program, p.mods) match
            Ok(t) -> return show_tprogram(t)
            Err(e) -> ds = e

    var out: Buf[string] = buf()

    for d in ds
        out.push(s"error: ${d.message} @${p.locate(d.span.start)}")

    join(out.view(), "\n")

// `ok` where the project elaborates, its diagnostics where it does not.
private project_refused(files: []const (string, string), test_build: bool = false) -> string
    val out = elab_project(project(files), test_build)

    if out.starts_with("error: ") then out else "ok"

// -- loading and resolving ---------------------------------------------------------------------------

@test("two externs of one module naming one C symbol are refused")
mod_extern()
    assert_eq(project_refused([("main.nex", "import cmath.{cbrt}\nextern def cbrt2(x: real): real\n@symbol(\"cbrt\")\nextern def mine(x: real): real\ndef main() = print(cbrt(27.0))\n"), ("cmath/libm.nex", "module cmath\nextern def cbrt(x: real): real\n")]),
        "error: `mine` and `cbrt` both name the C symbol `cbrt` @main.nex:3:1")

@test("a program of one file is the root module, its names its own")
mod_single_file()
    assert_eq(elab_project(project([("main.nex", "def main() = print(42)\n")])), "(def main () void (print 42))")

@test("an import reads the module's directory, and the module's names are internal to it")
mod_sibling_directory()
    assert_eq(elab_project(project([("main.nex", "import helpers.{square}\ndef main() = print(square(7))\n"), ("helpers/ops.nex", "module helpers\ndef square(x: integer) = x * x\n")])),
        "(def helpers.square ((x#0 int64)) int64 (*:int64 x#0 x#0))\n(def main () void (print (call:int64 helpers.square 7)))")

@test("every file of a module's directory is the module, and a private name is the whole module's")
mod_files_merge()
    assert_eq(project_refused([("main.nex", "import helpers.{square, twice}\ndef main() = print(twice(square(3)))\n"),
        ("helpers/sq.nex", "module helpers\ndef square(x: integer) = x * x\n"),
        ("helpers/twice.nex", "module helpers\ndef twice(x: integer) = double(x)\nprivate def double(x: integer) = x + x\n")]), "ok")
    assert_eq(project_refused([("main.nex", "import helpers.{f}\ndef main() = print(f(1))\n"),
        ("helpers/a.nex", "module helpers\ndef f(x: integer) = g(x)\n"),
        ("helpers/b.nex", "module helpers\nprivate def g(x: integer) = x\n")]), "ok")

@test("a unit any module declares is written against a literal in every module, as units are the program's")
mod_unit_shorthand()
    assert_eq(elab_project(project([("main.nex", "import fruit.{basket}\ndef main() = print(basket() + 2apple)\n"), ("fruit/f.nex", "module fruit\nunit apple\ndef basket() = 3apple\n")])),
        elab_project(project([("main.nex", "import fruit.{basket}\ndef main() = print(basket() + 2<apple>)\n"), ("fruit/f.nex", "module fruit\nunit apple\ndef basket() = 3<apple>\n")])))
    assert_eq(project_refused([("main.nex", "import fruit.{basket}\nunit apple\ndef main() = print(basket())\n"), ("fruit/f.nex", "module fruit\ndef basket() = 3apple\n")]), "ok")
    assert_eq(project_refused([("main.nex", "import fruit.{basket}\ndef main() = print(basket())\n"), ("fruit/f.nex", "module fruit\ndef basket() = 3apple\n")]),
        "error: unknown name `apple` @fruit/f.nex:2:17")

@test("a module declaration is optional, and one that names another module is refused")
mod_declaration()
    assert_eq(project_refused([("main.nex", "import helpers.{f}\ndef main() = print(f(1))\n"), ("helpers/ops.nex", "def f(x: integer) = x\n")]), "ok")
    assert_eq(project_refused([("main.nex", "import helpers.{f}\ndef main() = print(f(1))\n"), ("helpers/ops.nex", "module wrong_name\ndef f(x: integer) = x\n")]),
        "error: `module wrong_name` does not match the directory, which is the module `helpers` @helpers/ops.nex:1:1")
    assert_eq(project_refused([("main.nex", "module app\ndef main() = ()\n")]),
        "error: the program's own file is the root module and declares none; `module app` belongs to a file in the directory `app` @main.nex:1:1")
    assert_eq(project_refused([("main.nex", "import helpers.{f}\ndef main() = print(f(1))\n"), ("helpers/ops.nex", "def f(x: integer) = x\nmodule helpers\n")]),
        "error: a `module` declaration is the first line of its file @helpers/ops.nex:2:1")

@test("an import stands at the top of its file and names what it takes")
mod_import_placement()
    assert_eq(project_refused([("main.nex", "def main() = print(f(1))\nimport helpers.{f}\n"), ("helpers/ops.nex", "def f(x: integer) = x\n")]),
        "error: an `import` stands at the top of its file, before every other declaration @main.nex:2:1")
    assert_eq(project_refused([("main.nex", "import helpers.{}\ndef main() = ()\n"), ("helpers/ops.nex", "def f(x: integer) = x\n")]),
        "error: expected a name to import, found '}' @main.nex:1:17")

// The module `geom` of the qualified-access tests: a struct, a generic struct, an enum, a public
// `var`, a function, and private names.
private geom_file() -> (string, string) = ("geom/geom.nex", read_text(repo("testdata/modules/geom.nex")).unwrap())

// A project of `main` and the module `geom`.
private with_geom(main: string) -> string = project_refused([("main.nex", main), geom_file()])

@test("a bare `import m` reaches every kind of public name as `m.x`")
mod_qualified()
    assert_eq(with_geom("import geom\ndef main() = print(geom.dist2(geom.origin, geom.Point(3.0, 4.0)))\n"), "ok")
    assert_eq(with_geom("import geom\ndef main() =\n  val p: geom.Point = geom.Point(1.0, 2.0)\n  val pr: geom.Pair[integer, real] = geom.Pair(1, 2.0)\n  print(p.x + pr.snd)\n"), "ok")
    assert_eq(with_geom("import geom\ndef area(s: geom.Shape): real = s match\n  Circle(r) -> r * r\n  Empty -> 0.0\ndef main() = print(area(geom.Circle(2.0)) + area(geom.Empty))\n"), "ok")
    assert_eq(with_geom("import geom\ndef main() =\n  geom.count = 3\n  geom.count += 1\n  print(geom.count)\n"), "ok")
    assert_eq(with_geom("import geom\ndef main() =\n  val f = geom.twice\n  print(f(2))\n"), "ok")
    assert_eq(with_geom("import geom\nimport geom.{twice}\nimport geom.*\ndef main() = print(geom.twice(twice(1)) + count)\n"), "ok")
    assert_eq(elab_project(project([("main.nex", "import geom\ndef main() = print(geom.twice(4))\n"), geom_file()])).contains("(def main () void (print (call:int64 geom.twice 4)))"), true)

@test("`import a.b` reaches `a.b.x`; `import a` does not")
mod_qualified_dotted()
    val files = [("a/a.nex", "val top = 1\n"), ("a/b/b.nex", "def f(x: integer) = x + 1\nval v = 2\n")]

    assert_eq(project_refused([("main.nex", "import a.b\ndef main() = print(a.b.f(a.b.v))\n"), files[0], files[1]]), "ok")
    assert_eq(project_refused([("main.nex", "import a\ndef main() = print(a.b.v + a.top)\n"), files[0], files[1]]),
        "error: the module `a` has no public member `b` @main.nex:2:20")
    assert_eq(project_refused([("main.nex", "import a.b\ndef main() = print(b.v)\n"), files[0], files[1]]),
        "error: unknown name `b` @main.nex:2:20")

@test("a local shadows a module, and `m.x` is then the local's field")
mod_qualified_shadow()
    val lib = ("lib/c.nex", "val x = 99\n")

    assert_eq(elab_project(project([("main.nex", "import lib\nstruct Box\n  x: integer\ndef main() =\n  val lib = Box(7)\n  print(lib.x)\n"), lib])),
        "(struct Box (x int64))\n(val lib.x int64 99)\n(def main () void (block (val lib#0:Box (new:Box 7)) (print (.x:int64 lib#0))))")
    assert_eq(project_refused([("main.nex", "import lib\nstruct Box\n  x: integer\ndef get(lib: Box) = lib.x\ndef main() = print(get(Box(1)) + lib.x)\n"), lib]), "ok")
    assert_eq(project_refused([("main.nex", "import lib\nstruct Box\n  y: integer\ndef get(lib: Box) = lib.x\ndef main() = print(get(Box(1)))\n"), lib]),
        "error: `Box` has no field `x`; did you mean `y`? @main.nex:4:21")

@test("a default is resolved in its declaring module, private names included, wherever it is called")
mod_default_in_its_module()
    val lib = ("lib/lib.nex", "private val secret = 41\nprivate def bump(n: integer): integer = n + 1\ndef f(n: integer = bump(secret)) = print(n)\nstruct P\n  n: integer = secret\n")

    assert_eq(elab_project(project([("main.nex", "import lib\ndef main() =\n  lib.f()\n  print(lib.P().n)\n"), lib])),
        "(struct lib.P (n int64))\n(val lib.secret int64 41)\n(def lib.bump ((n#0 int64)) int64 (+:int64 n#0 1))\n(def lib.f ((n#1 int64 (call:int64 lib.bump lib.secret))) void (print n#1))\n(def main () void (block (call lib.f (call:int64 lib.bump lib.secret)) (print (.n:int64 (new:lib.P lib.secret)))))")
    assert_eq(project_refused([("main.nex", "import lib\nval secret = 1\ndef main() = print(secret)\n"), lib]), "ok")

@test("a private or missing member is not reached through `m.x`")
mod_qualified_private()
    assert_eq(with_geom("import geom\ndef main() = print(geom.secret())\n"), "error: the module `geom` has no public member `secret` @main.nex:2:20")
    assert_eq(with_geom("import geom\ndef main() = print(geom.nope)\n"), "error: the module `geom` has no public member `nope` @main.nex:2:20")
    assert_eq(with_geom("import geom\ndef f(h: geom.Hidden) = 0\ndef main() = ()\n"), "error: the module `geom` has no public member `Hidden` @main.nex:2:10")
    assert_eq(with_geom("import geom\ndef main() =\n  geom.nope = 1\n"), "error: the module `geom` has no public member `nope` @main.nex:3:3")
    assert_eq(with_geom("import geom.{count}\ndef main() = print(geom.count)\n"), "error: unknown name `geom` @main.nex:2:20")

@test("a bare import's first word may not be the module's own name nor one another import binds")
mod_qualified_clash()
    assert_eq(with_geom("import geom\ndef geom() = 1\ndef main() = print(geom())\n"), "error: the imported module `geom` clashes with this module's own `geom` @main.nex:1:1")
    assert_eq(project_refused([("main.nex", "import other.{geom}\nimport geom\ndef main() = ()\n"), ("other/o.nex", "val geom = 1\n"), geom_file()]),
        "error: `geom` is imported twice, as `other.geom` and as the module `geom` @main.nex:2:1")
    assert_eq(project_refused([("main.nex", "import geom\nimport other.{geom}\ndef main() = ()\n"), ("other/o.nex", "val geom = 1\n"), geom_file()]),
        "error: `geom` is imported twice, as the module `geom` and as `other.geom` @main.nex:2:1")

@test("`as` renames what an import binds, and the original name is then not bound")
mod_alias()
    assert_eq(project_refused([("main.nex", "import helpers.{square as sq}\ndef main() = print(sq(8))\n"), ("helpers/ops.nex", "def square(x: integer) = x * x\n")]), "ok")
    assert_eq(project_refused([("main.nex", "import helpers.{square as sq}\ndef main() = print(square(8))\n"), ("helpers/ops.nex", "def square(x: integer) = x * x\n")]),
        "error: unknown name `square` @main.nex:2:20")

@test("imports chain through modules, and a nested module's directory is its path")
mod_chain()
    assert_eq(project_refused([("main.nex", "import b.{step2}\ndef main() = print(step2(5))\n"),
        ("a/a.nex", "module a\ndef step1(x: integer) = x + 10\n"),
        ("b/b.nex", "module b\nimport a.{step1}\ndef step2(x: integer) = step1(x) * 2\n")]), "ok")
    assert_eq(project_refused([("main.nex", "import linalg.dense.{add}\ndef main() = print(add(1, 2))\n"),
        ("linalg/dense/ops.nex", "module linalg.dense\ndef add(a: integer, b: integer) = a + b\n")]), "ok")

@test("a module sees only what it declares and imports, not the program's own names")
mod_no_leak()
    assert_eq(project_refused([("main.nex", "import helpers.{f}\ndef gauge(x: integer) = x\ndef main() = print(f(1))\n"), ("helpers/ops.nex", "def f(x: integer) = gauge(x)\n")]),
        "error: unknown name `gauge` @helpers/ops.nex:1:21")
    assert_eq(project_refused([("main.nex", "import helpers.{f}\ndef main() = print(f(1) + gauge(2))\n"),
        ("helpers/ops.nex", "def f(x: integer) = x\ndef gauge(x: integer) = x\n")]),
        "error: unknown name `gauge` @main.nex:2:27")
    assert_eq(project_refused([("main.nex", "import helpers.{square}\ndef main() = print(squre(2))\n"), ("helpers/ops.nex", "def square(x: integer) = x * x\n")]),
        "error: unknown name `squre`; did you mean `square`? @main.nex:2:20")

@test("two modules may declare one name, each using its own")
mod_same_name_twice()
    assert_eq(project_refused([("main.nex", "import a.{fa}\nimport b.{fb}\ndef helper() = 0\ndef main() = print(fa() + fb() + helper())\n"),
        ("a/a.nex", "def helper() = 1\ndef fa() = helper()\n"),
        ("b/b.nex", "def helper() = 2\ndef fb() = helper()\n")]), "ok")

@test("an import of a module that does not exist, or of a name it does not have, is reported")
mod_missing()
    assert_eq(project_refused([("main.nex", "import does_not_exist.{x}\ndef main() = print(0)\n")]),
        "error: no module `does_not_exist`: there is no directory `does_not_exist` @main.nex:1:1")
    assert_eq(project_refused([("main.nex", "import helpers.{nope}\ndef main() = print(0)\n"), ("helpers/ops.nex", "def square(x: integer) = x * x\n")]),
        "error: the module `helpers` has no public member `nope` @main.nex:1:1")
    assert_eq(project_refused([("main.nex", "import helpers.{nope, Shape}\ndef area(s: Shape) = 0\ndef main() = print(nope(1))\n"), ("helpers/ops.nex", "def square(x: integer) = x * x\n")]),
        "error: the module `helpers` has no public member `nope` @main.nex:1:1\nerror: the module `helpers` has no public member `Shape` @main.nex:1:1")
    assert_eq(project_refused([("main.nex", "import empty.{x}\ndef main() = print(0)\n"), ("empty/readme.txt", "nothing\n")]),
        "error: the module `empty` has no `.nex` files in `empty` @main.nex:1:1")

@test("an import cycle is reported at the import that closes it")
mod_cycle()
    assert_eq(project_refused([("main.nex", "import a.{f}\ndef main() = print(f())\n"),
        ("a/a.nex", "import b.{g}\ndef f() = g()\n"),
        ("b/b.nex", "import a.{f}\ndef g() = 1\n")]),
        "error: an import cycle: `a` imports `b` imports `a` @b/b.nex:1:1")
    assert_eq(project_refused([("main.nex", "import a.{f}\ndef main() = print(f())\n"), ("a/a.nex", "import a.{f}\ndef f() = 1\n")]),
        "error: an import cycle: `a` imports `a` @a/a.nex:1:1")

// -- visibility -------------------------------------------------------------------------------------

@test("a struct and its constructor are imported by its name; a private one is not visible")
mod_struct_visibility()
    assert_eq(project_refused([("main.nex", "import geom.{Point}\ndef main() = print(Point(3.0, 4.0).x)\n"), ("geom/types.nex", "struct Point\n  x: real\n  y: real\n")]), "ok")
    assert_eq(project_refused([("main.nex", "import geom.{Hidden}\ndef main() = print(0)\n"), ("geom/types.nex", "private struct Hidden\n  x: real\n")]),
        "error: the module `geom` has no public member `Hidden` @main.nex:1:1")
    assert_eq(project_refused([("main.nex", "import geom.{origin}\ndef main() = print(origin().x)\n"),
        ("geom/types.nex", "private struct Hidden\n  x: real\ndef origin() = Hidden(0.0)\n")]), "ok")

@test("a public val and const are visible to an importer, a private one is not")
mod_binding_visibility()
    assert_eq(project_refused([("main.nex", "import lib.{answer, LIMIT}\ndef main() = print(answer + LIMIT)\n"), ("lib/c.nex", "val answer = 42\nconst LIMIT = 8\n")]), "ok")
    assert_eq(project_refused([("main.nex", "import lib.{secret}\ndef main() = print(secret)\n"), ("lib/c.nex", "private val secret = 42\n")]),
        "error: the module `lib` has no public member `secret` @main.nex:1:1")
    assert_eq(project_refused([("main.nex", "import lib.{MAGIC}\ndef main() = print(MAGIC)\n"), ("lib/c.nex", "private const MAGIC = 99\n")]),
        "error: the module `lib` has no public member `MAGIC` @main.nex:1:1")

@test("a module-level var of another module is read and assigned through its import")
mod_var_across()
    assert_eq(project_refused([("main.nex", "import lib.{count, bump}\ndef main() =\n  bump()\n  count = count + 1\n  print(count)\n"),
        ("lib/c.nex", "var count = 0\ndef bump() =\n  count += 1\n")]), "ok")

@test("`import m.*` binds every public name of the module, and none of its private ones")
mod_wildcard()
    assert_eq(project_refused([("main.nex", "import helpers.*\ndef main() = print(square(twice(3)))\n"), ("helpers/ops.nex", "def square(x: integer) = x * x\ndef twice(x: integer) = x + x\n")]), "ok")
    assert_eq(project_refused([("main.nex", "import lib.*\ndef main() = print(visible + hidden)\n"), ("lib/c.nex", "val visible = 11\nprivate val hidden = 99\n")]),
        "error: unknown name `hidden` @main.nex:2:30")
    assert_eq(project_refused([("main.nex", "import lib.*\ndef main() = print(Some(1))\n"), ("lib/c.nex", "enum Opt =\n  Some(v: integer)\n  Empty\n")]), "ok")

@test("an imported name may not clash with the module's own, nor two imports bind one name")
mod_import_clash()
    assert_eq(project_refused([("main.nex", "import lib.*\nval x = 1\ndef main() = print(x)\n"), ("lib/c.nex", "val x = 99\n")]),
        "error: the imported `x` clashes with this module's own `x` @main.nex:1:1")
    assert_eq(project_refused([("main.nex", "import lib.{x}\nval x = 1\ndef main() = print(x)\n"), ("lib/c.nex", "val x = 99\n")]),
        "error: the imported `x` clashes with this module's own `x` @main.nex:1:1")
    assert_eq(project_refused([("main.nex", "import a.{x}\nimport b.{x}\ndef main() = print(x)\n"), ("a/c.nex", "val x = 1\n"), ("b/c.nex", "val x = 2\n")]),
        "error: `x` is imported twice, as `a.x` and as `b.x` @main.nex:2:1")
    assert_eq(project_refused([("main.nex", "import a.{x}\nimport a.{x}\ndef main() = print(x)\n"), ("a/c.nex", "val x = 1\n")]), "ok")

// -- the source prelude ------------------------------------------------------------------------------

// A prelude directory holding `files`, beside the project.
private prelude_dir(files: []const (string, string)) -> string = project(files)

@test("the source prelude's names are seen in every module without an import")
mod_prelude_auto_import()
    val pre = prelude_dir([("scalar.nex", "module prelude\ndef triple(x: integer) = x * 3\ndef quadruple(x: integer) = double(double(x))\nprivate def double(x: integer) = x + x\n")])

    assert_eq(elab_project(project([("main.nex", "import lib.{f}\ndef main() = print(triple(7) + quadruple(f()))\n"), ("lib/c.nex", "def f() = triple(1)\n")]), prelude = Some(pre)).starts_with("error"), false)
    assert_eq(elab_project(project([("main.nex", "def main() = print(double(2))\n")]), prelude = Some(pre)),
        "error: unknown name `double` @main.nex:1:20")

    remove_dir_all(pre).unwrap()

@test("a module's own declaration and its imports shadow the source prelude's")
mod_prelude_shadowed()
    val pre = prelude_dir([("scalar.nex", "def triple(x: integer) = x * 3\n")])

    assert_eq(elab_project(project([("main.nex", "def triple(x: integer) = x\ndef main() = print(triple(7))\n")]), prelude = Some(pre)),
        "(def prelude.triple ((x#0 int64)) int64 (*:int64 x#0 3))\n(def triple ((x#1 int64)) int64 x#1)\n(def main () void (print (call:int64 triple 7)))")

    remove_dir_all(pre).unwrap()

@test("an empty source prelude changes nothing, and the prelude imports nothing")
mod_prelude_empty()
    val empty = prelude_dir([("scalar.nex", "module prelude\n")])

    assert_eq(elab_project(project([("main.nex", "def main() = print(42)\n")]), prelude = Some(empty)), "(def main () void (print 42))")

    val importing = prelude_dir([("scalar.nex", "import lib.{x}\n")])

    assert_eq(elab_project(project([("main.nex", "def main() = print(42)\n")]), prelude = Some(importing)).starts_with("error: the prelude imports nothing"), true)

    remove_dir_all(empty).unwrap()
    remove_dir_all(importing).unwrap()

private found(r: Result[Option[string], string]) -> string = r match
    Ok(Some(d)) -> d
    Ok(None) -> "none"
    Err(m) -> m

@test("--prelude-path must name a directory")
mod_find_prelude()
    val dir = make_temp_dir("nex-prelude").unwrap()

    assert_eq(found(find_prelude(Some(dir))), dir)
    assert_eq(found(find_prelude(Some("/this/path/does/not/exist"))), "nex: --prelude-path names no directory: /this/path/does/not/exist")

    remove_dir_all(dir).unwrap()

// -- tests and test modules --------------------------------------------------------------------------

@test("a `@test def` exists only in the test build, where `main` is not required")
mod_test_functions()
    val files = [("main.nex", "def f() = 1\n@test\ndef test_f() = assert_eq(f(), 1)\ndef main() = print(f())\n")]

    assert_eq(elab_project(project(files)), "(def f () int64 1)\n(def main () void (print (call:int64 f)))")
    assert_eq(elab_project(project(files), test_build = true).contains("(def test_f () void"), true)
    assert_eq(project_refused([("main.nex", "@test\ndef test_a() = assert(true)\n")], test_build = true), "ok")
    assert_eq(project_refused([("main.nex", "@test\ndef test_a() = assert(true)\n")]),
        "error: a program needs a `def main()` or a `def main(args: [string])` @main.nex:1:1")

@test("a test takes no parameters and returns nothing")
mod_test_shape()
    assert_eq(project_refused([("main.nex", "@test\ndef test_with_arg(x: integer) = ()\n")], test_build = true),
        "error: a test takes no parameters: `@test def test_with_arg()` @main.nex:1:1")
    assert_eq(project_refused([("main.nex", "@test\ndef test_value() = 42\n")], test_build = true),
        "error: a test returns nothing, but this one returns int64 @main.nex:1:1")

@test("a `@test module` is built only by `nex test`, and no other module may import it")
mod_test_module()
    val files = [("main.nex", "import test_fixtures.{helper}\ndef main() = print(helper())\n"), ("test_fixtures/fix.nex", "@test module test_fixtures\ndef helper() = 42\n")]

    assert_eq(project_refused(files),
        "error: `test_fixtures` is a test module (`@test module`), which only `nex test` builds @main.nex:1:1")
    assert_eq(project_refused(files, test_build = true), "ok")
    assert_eq(project_refused([("main.nex", "def main() = ()\n"), ("t/t.nex", "@test module t\n@test\ndef test_x() = assert(true)\n")], test_build = true), "ok")
