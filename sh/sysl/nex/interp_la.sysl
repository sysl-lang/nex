module sh.sysl.nex

// `@` and the prelude's linear algebra as the interpreter computes them (DESIGN §10.4, §10.5), each
// as `compiler/emit_blas.sysl` and `compiler/emit_lapack.sysl` compute it, so the two engines answer
// bit for bit alike.
//
// **A product of `real32`, `real64` or complex elements goes to BLAS where the compiled one does**:
// where an operand is written `transpose(X)` or `conj(transpose(X))`, which is `X` with BLAS's `T` or
// `C` flag and no transposed copy, and where the product reaches the size DESIGN §10.4 sets. Both go
// through the runtime's `la_product` and `la_dot`, the functions compiled code reaches through its
// `nex_la_*` entries. Below the size, and for every other element type, `@` is computed as the
// compiled program's inline `linalg` operation computes it: each result element from zero, adding
// the products along the inner axis in order, each product and each sum rounded on its own.
//
// **The linear-algebra prelude is the runtime's `la_*` functions**: a value form traps with the words
// its `Err` carries, and an `inout` form writes its factors where its arrays lie and answers LAPACK's
// `info`.
//
// **An array crosses as compiled code hands it over** (DESIGN §10.3): the interpreter's storage holds
// the machine numbers (`interp_store.sysl`), so where an array's first axis is at unit stride and its
// columns do not overlap, the runtime is handed a view of that storage itself, its columns as far
// apart as they lie, and an `inout` form writes its factors there; any other array is copied dense
// and, for an `inout` form, written back. Two operands lying in one storage are two views of one
// buffer, so the library sees one buffer where the compiled program passes one: Accelerate answers
// `transpose(A) @ A` differently in the last bits when both operands are the same address.

import nex_runtime.sh.sysl.nex_runtime.{SHAPE_MISMATCH, la_chol, la_chol_inplace, la_det, la_dot, la_eig, la_eigh, la_eigvals, la_inv, la_lstsq, la_lu, la_lu_inplace,
                                        la_product, la_qr, la_qr_inplace, la_solve, la_solve_inplace, la_svd, la_svdvals}
import sh.sysl.blas.{MatrixView, Op}
import sh.sysl.lapack.Scalar
import sysl.buf.{Buf, buf}
import sysl.math.Float
// The standard complex number, under a name that leaves `Complex` to nex's type.
import sysl.math.complex.Complex as Cx
import sh.sysl.parsing.Span

// The size from which a product goes to BLAS (DESIGN §10.4): m·k·n for matrix by matrix, the
// matrix's m·k for a matrix and a vector, k for two vectors.
private val GEMM_AT: ulong = 262144
private val GEMV_AT: ulong = 16384
private val DOT_AT: ulong = 4096

// The runtime's element kind for the element type `t`: 0 `real32`, 1 `real64`, 2 `complex[real32]`,
// 3 `complex[real64]`; -1 for a type BLAS has no routines for.
private la_kind(t: Ty) -> int = base_of(t) match
    Real(b) -> if b == 32 then 0 elif b == 64 then 1 else -1
    Complex(b) -> if b == 32 then 2 elif b == 64 then 3 else -1
    _ -> -1

// An operand of `@` as BLAS reads it: `transpose(X)` is `X` with the `T` flag, `conj(transpose(X))`
// with `C`, anything else itself.
private la_operand(x: TExpr) -> (TExpr, Op) = *x.kind match
    TBuiltin(name, args) -> if name == "transpose" then (args[0], Op.Trans) else (x, Op.NoTrans)
    TArray(op) -> *op match
        TElemental(name, args) ->
            if name != "conj" || args.len() != 1 then return (x, Op.NoTrans)

            *args[0].kind match
                TBuiltin(n, inner) -> if n == "transpose" then (inner[0], Op.ConjTrans) else (x, Op.NoTrans)
                _ -> (x, Op.NoTrans)
        _ -> (x, Op.NoTrans)
    _ -> (x, Op.NoTrans)

// Whether `x @ y` reaches BLAS's size: the extents it is measured by multiplied, against the
// threshold for how many there are.
private reaches_blas(x: &Arr, y: &Arr) -> bool
    var size: ulong = 1
    var n = 0

    if x.ext.len() == 2
        size *%= ulong.wrap(x.ext[0])
        n += 1

    size *%= ulong.wrap(x.ext[x.ext.len() - 1])
    n += 1

    if y.ext.len() == 2
        size *%= ulong.wrap(y.ext[1])
        n += 1

    size >= (if n == 3 then GEMM_AT elif n == 2 then GEMV_AT else DOT_AT)

// The inline product on an element type: its sum of nothing, and one step `acc + a·b`, the product and the sum each
// rounded once at the width (a complex product as nex writes it), or an integer's wrapped at its
// width, as `arith.muli` and `arith.addi` do.
private trait InlineStep
    naught() ->Self
    step(acc: Self, a: Self, b: Self) -> Self

impl InlineStep for i8
    naught() ->i8 = 0
    step(acc: i8, a: i8, b: i8) -> i8 = acc +% a *% b

impl InlineStep for i16
    naught() ->i16 = 0
    step(acc: i16, a: i16, b: i16) -> i16 = acc +% a *% b

impl InlineStep for i32
    naught() ->i32 = 0
    step(acc: i32, a: i32, b: i32) -> i32 = acc +% a *% b

impl InlineStep for long
    naught() ->long = 0
    step(acc: long, a: long, b: long) -> long = acc +% a *% b

impl InlineStep for u8
    naught() ->u8 = 0
    step(acc: u8, a: u8, b: u8) -> u8 = acc +% a *% b

impl InlineStep for u16
    naught() ->u16 = 0
    step(acc: u16, a: u16, b: u16) -> u16 = acc +% a *% b

impl InlineStep for u32
    naught() ->u32 = 0
    step(acc: u32, a: u32, b: u32) -> u32 = acc +% a *% b

impl InlineStep for u64
    naught() ->u64 = 0
    step(acc: u64, a: u64, b: u64) -> u64 = acc +% a *% b

// A `real16` product and sum are computed in `real64`, where the product is exact, and rounded.
impl InlineStep for f16
    naught() ->f16 = 0.0
    step(acc: f16, a: f16, b: f16) -> f16
        val p = f16(real(a) * real(b))

        f16(real(acc) + real(p))

impl InlineStep for f32
    naught() ->f32 = 0.0
    step(acc: f32, a: f32, b: f32) -> f32
        val p = a * b

        acc + p

impl InlineStep for real
    naught() ->real = 0.0
    step(acc: real, a: real, b: real) -> real
        val p = a * b

        acc + p

impl[F: Float] InlineStep for Cx[F]
    naught() ->Cx[F] = Cx(F(0.0), F(0.0))

    step(acc: Cx[F], a: Cx[F], b: Cx[F]) -> Cx[F]
        val bits = if const sizeof(F) == 4 then 32 else 64
        val p = complex_mul(real(a.re), real(a.im), real(b.re), real(b.im), bits).unwrap()

        Cx(F(real(acc.re) + re_of(p)), F(real(acc.im) + im_of(p)))

// `x @ y` as the compiled program's inline `linalg` operation computes it, over machine numbers of
// element type `t`; `None` where `t` is not a number.
private inline_kernel(t: Ty) -> Option[&Fn(&Arr, &Arr) -> Answer]
    val f: &Fn(&Arr, &Arr) -> Answer = t match
        Int(8, true) -> (x, y) -> inline_product[i8](x, y)
        Int(16, true) -> (x, y) -> inline_product[i16](x, y)
        Int(32, true) -> (x, y) -> inline_product[i32](x, y)
        Int(64, true) -> (x, y) -> inline_product[long](x, y)
        Int(8, false) -> (x, y) -> inline_product[u8](x, y)
        Int(16, false) -> (x, y) -> inline_product[u16](x, y)
        Int(32, false) -> (x, y) -> inline_product[u32](x, y)
        Int(64, false) -> (x, y) -> inline_product[u64](x, y)
        Real(16) -> (x, y) -> inline_product[f16](x, y)
        Real(32) -> (x, y) -> inline_product[f32](x, y)
        Real(64) -> (x, y) -> inline_product[real](x, y)
        Complex(32) -> (x, y) -> inline_product[Cx[f32]](x, y)
        Complex(64) -> (x, y) -> inline_product[Cx[real]](x, y)
        _ -> return None

    Some(f)

// `x @ y` as the compiled program's inline `linalg` operation computes it. Its storage is nex's with
// the axes reversed, so `linalg.matmul` and `linalg.vecmat`/`matvec` take `y` first: each product is
// `y`'s element times `x`'s, added to the element so far, from zero, along the inner axis in order.
// `linalg.dot` of two vectors takes them in order.
private inline_product[T: Elem + InlineStep](x: &Arr, y: &Arr) -> Answer
    val ra = x.ext.len()
    val rb = y.ext.len()
    val k = x.ext[ra - 1]

    if k != y.ext[0] then return trapped(SHAPE_MISMATCH)

    val xs = T.held(x.store.d)
    val ys = T.held(y.store.d)
    val xk = x.str[ra - 1]
    val yk = y.str[0]

    if ra == 1 && rb == 1
        var acc = T.naught()

        for l in 0..<k
            acc = T.step(acc, xs[usize(x.offset + l * xk)], ys[usize(y.offset + l * yk)])

        return Ok(acc.boxed())

    val m = if ra == 2 then x.ext[0] else 1
    val n = if rb == 2 then y.ext[1] else 1
    val xi = if ra == 2 then x.str[0] else 0
    val yj = if rb == 2 then y.str[1] else 0
    var out: Buf[T] = buf()

    out.reserve(usize(m * n))

    for j in 0..<n
        for i in 0..<m
            var acc = T.naught()
            var p = x.offset + i * xi
            var q = y.offset + j * yj

            for _ in 0..<k
                acc = T.step(acc, ys[usize(q)], xs[usize(p)])
                p += xk
                q += yk

            out.push(acc)

    var ext: Buf[long] = buf()

    if ra == 2 then ext.push(m)
    if rb == 2 then ext.push(n)
    Ok(dense_data(T.holding(out), ext))

// `op(x) @ op(y)` through BLAS, in the element type of kind `kind`; `vector` where the result is one.
private blas_product(kind: int, x: &Arr, fx: Op, y: &Arr, fy: Op, vector: bool) -> Answer = kind match
    0 -> product_in[f32](x, fx, y, fy, vector)
    1 -> product_in[real](x, fx, y, fy, vector)
    2 -> product_in[Cx[f32]](x, fx, y, fy, vector)
    _ -> product_in[Cx[real]](x, fx, y, fy, vector)

private product_in[T: Scalar + Elem](x: &Arr, fx: Op, y: &Arr, fy: Op, vector: bool) -> Answer
    val xv = x.ext.len() == 1
    val yv = y.ext.len() == 1
    val a = crossing[T](x)
    val b = crossing[T](y)

    if xv && yv
        return la_dot(a.col(0), b.col(0)) match
            Ok(d) -> Ok(value_of(d))
            Err(m) -> trapped(m)

    matrix_answer(la_product(a, xv, fx, b, yv, fy), vector)

// -- crossing --------------------------------------------------------------------------------------

// Whether compiled code hands `a`, of rank 1 or 2, to the runtime where it lies: its first axis at
// unit stride and, for a matrix, its columns not overlapping. Any other array is gathered dense.
private lies_in_place(a: &Arr) -> bool
    if count_of(a) == 0 || a.str[0] != 1 then return false

    a.ext.len() == 1 || a.str[1] >= a.ext[0]

// `a`, of rank 1 or 2, as compiled code hands it to the runtime: a view of its own storage where it
// lies, read with its own leading dimension; otherwise a dense copy. Two arrays lying in one storage
// are two views of one buffer, the same place where they are the same array.
private[nex] crossing[T: Scalar + Elem](a: &Arr) -> MatrixView[T]
    if !lies_in_place(a) then return gathered(a)

    viewed(T.held(a.store.d).view(), a, a.offset)

// The array `a`, lying in `xs` from position `at` with its own column stride.
private viewed[T](xs: []T, a: &Arr, at: long) -> MatrixView[T]
    val rows = usize(a.ext[0])
    val cols = if a.ext.len() == 2 then usize(a.ext[1]) else 1
    val ld = if a.ext.len() == 2 then usize(a.str[1]) elif rows > 1 then rows else 1

    MatrixView.strided(xs[usize(at)..<xs.len], rows, cols, ld).unwrap()

// `a` copied dense, column after column, its leading dimension its row count.
private gathered[T: Scalar + Elem](a: &Arr) -> MatrixView[T]
    val rows = a.ext[0]
    val cols = if a.ext.len() == 2 then a.ext[1] else 1
    val step = if a.ext.len() == 2 then a.str[1] else 0
    val src = T.held(a.store.d)
    var xs: []T = [T.zero(); usize(rows * cols)]

    for j in 0..<cols
        for i in 0..<rows do xs[usize(i + j * rows)] = src[usize(a.offset + i * a.str[0] + j * step)]

    MatrixView.of(xs, usize(rows), usize(cols)).unwrap()

// Whether the vector `a` lies in its storage one element after another, where it is handed over.
private runs_in_place(a: &Arr) -> bool = a.ext[0] > 0 && a.str[0] == 1

// The elements of the vector `a`, in order: its own storage where it runs in place, else a copy.
private slice_in[T: Elem](a: &Arr, zero: T) -> []T
    val src = T.held(a.store.d)

    if runs_in_place(a) then return src.view()[usize(a.offset)..<usize(a.offset + a.ext[0])]

    var xs: []T = [zero; usize(a.ext[0])]

    for i in 0..<a.ext[0] do xs[usize(i)] = src[usize(a.offset + i * a.str[0])]

    xs

private value_of[T: Scalar](x: T) -> Value =
    if T.is_complex() then VComplex(T.real_part(x).to_real(), T.imag_part(x).to_real()) else VReal(T.real_part(x).to_real())

// The matrix `m` as an array, column after column: of rank 1 where `vector` holds, its one column.
private matrix_value[T: Elem](m: MatrixView[T], vector: bool) -> Value
    var out: Buf[T] = buf()

    out.reserve(m.rows * m.cols)

    for j in 0..<m.cols
        for i in 0..<m.rows do out.push(m.at(i, j))

    var ext: Buf[long] = buf()

    ext.push(long(m.rows))
    if !vector then ext.push(long(m.cols))
    dense_data(T.holding(out), ext)

private list_value[T: Elem](xs: []T) -> Value
    var out: Buf[T] = buf()

    out.extend(xs)
    vector_data(T.holding(out))

// Reals of an element type's real width — `real32` or `real64` — as an array.
private reals_value[R](xs: []R) -> Value
    if const sizeof(R) == 4
        var out: Buf[f32] = buf()

        for x in xs do out.push(f32(x))

        vector_data(DR32(out))
    else
        var out: Buf[real] = buf()

        for x in xs do out.push(real(x))

        vector_data(DR64(out))

private matrix_answer[T: Scalar + Elem](r: Result[MatrixView[T], string], vector: bool) -> Answer = r match
    Ok(m) -> Ok(matrix_value(m, vector))
    Err(e) -> trapped(e)

// `m`, the copy `crossing` made of `a`, written back over `a`'s elements where they lie; nothing
// where `a` was handed over in place, which the runtime wrote itself.
private put_matrix[T: Scalar + Elem](a: &Arr, m: MatrixView[T])
    if lies_in_place(a) then return

    val dst = T.held(a.store.d)
    val cols = if a.ext.len() == 2 then a.ext[1] else 1
    val step = if a.ext.len() == 2 then a.str[1] else 0

    for j in 0..<cols
        for i in 0..<a.ext[0] do dst.set(usize(a.offset + i * a.str[0] + j * step), m.at(usize(i), usize(j)))

// `xs`, the copy `slice_in` made of the vector `a`, written back over it; nothing where it ran in
// place.
private put_slice[T: Elem](a: &Arr, xs: []T)
    if runs_in_place(a) then return

    val dst = T.held(a.store.d)

    for i in 0..<a.ext[0] do dst.set(usize(a.offset + i * a.str[0]), xs[usize(i)])

private tuple(xs: []const Value) -> Value
    var out: Buf[Value] = buf()

    for x in xs do out.push(x)

    VAgg(0, out)

// -- the prelude --------------------------------------------------------------------------------------

// The value form `name` on `a` (and the right-hand side `b` of `solve` and `lstsq`, `chol`'s `upper`),
// in the element type of kind `kind`.
private la_value(kind: int, name: string, a: &Arr, b: &Arr, upper: bool) -> Answer = kind match
    0 -> value_in[f32](name, a, b, upper)
    1 -> value_in[real](name, a, b, upper)
    2 -> value_in[Cx[f32]](name, a, b, upper)
    _ -> value_in[Cx[real]](name, a, b, upper)

private value_in[T: Scalar + Elem](name: string, a: &Arr, b: &Arr, upper: bool) -> Answer
    val m = crossing[T](a)
    val r = if name == "solve" || name == "lstsq" then crossing[T](b) else m

    if name == "solve" then return matrix_answer(la_solve(m, r), b.ext.len() == 1)
    if name == "lstsq" then return matrix_answer(la_lstsq(m, r), b.ext.len() == 1)
    if name == "inv" then return matrix_answer(la_inv(m), false)
    if name == "chol" then return matrix_answer(la_chol(m, upper), false)

    if name == "det" then return la_det(m) match
        Ok(d) -> Ok(value_of(d))
        Err(e) -> trapped(e)

    if name == "lu" then return la_lu(m) match
        Ok((l, u, p)) -> Ok(tuple([matrix_value(l, false), matrix_value(u, false), list_value(p)]))
        Err(e) -> trapped(e)

    if name == "qr" then return la_qr(m) match
        Ok((q, r)) -> Ok(tuple([matrix_value(q, false), matrix_value(r, false)]))
        Err(e) -> trapped(e)

    if name == "eigvals" then return la_eigvals(m) match
        Ok(w) -> Ok(list_value(w))
        Err(e) -> trapped(e)

    if name == "eig" then return la_eig(m) match
        Ok((w, v)) -> Ok(tuple([list_value(w), matrix_value(v, false)]))
        Err(e) -> trapped(e)

    if name == "eigh" then return la_eigh(m) match
        Ok((w, v)) -> Ok(tuple([reals_value(w), matrix_value(v, false)]))
        Err(e) -> trapped(e)

    if name == "svd" then return la_svd(m) match
        Ok((u, s, v)) -> Ok(tuple([matrix_value(u, false), reals_value(s), matrix_value(v, false)]))
        Err(e) -> trapped(e)

    la_svdvals(m) match
        Ok(s) -> Ok(reals_value(s))
        Err(e) -> trapped(e)

// The `inout` form `name` on the arrays `xs` where they lie — the matrix, then `ipiv` or `tau`, then
// the right-hand sides — and `chol_inplace`'s `upper`, in the element type of kind `kind`.
private la_in_place(kind: int, name: string, xs: Buf[&Arr], upper: bool) -> Answer = kind match
    0 -> in_place_in[f32](name, xs, upper)
    1 -> in_place_in[real](name, xs, upper)
    2 -> in_place_in[Cx[f32]](name, xs, upper)
    _ -> in_place_in[Cx[real]](name, xs, upper)

private in_place_in[T: Scalar + Elem](name: string, xs: Buf[&Arr], upper: bool) -> Answer
    val m = crossing[T](xs[0])
    var info: Result[i32, string] = Ok(0)

    if name == "chol_inplace"
        info = la_chol_inplace(m, upper)
    elif name == "qr_inplace"
        val tau = slice_in(xs[1], T.zero())

        info = la_qr_inplace(m, tau)
        put_slice(xs[1], tau)
    else
        val ipiv = slice_in(xs[1], i32(0))

        if name == "lu_inplace"
            info = la_lu_inplace(m, ipiv)
        else
            val b = crossing[T](xs[2])

            info = la_solve_inplace(m, ipiv, b)
            put_matrix(xs[2], b)

        put_slice(xs[1], ipiv)

    put_matrix(xs[0], m)

    info match
        Ok(i) -> Ok(VInt(long(i)))
        Err(e) -> trapped(e)

impl Interp
    // `l @ r` (DESIGN §7.2, §10.4), of type `t`: through BLAS where the compiled product goes there,
    // else inline.
    matmul(*self, span: Span, l: TExpr, r: TExpr, t: Ty) -> Code
        val et = elem_or(t)
        val inline = inline_kernel(et) match
            Some(f) -> f
            None -> return self.later(span, s"`@` of ${show_ty(et)}")
        val kind = la_kind(et)
        val vector = rank_of(t) == 1

        if kind < 0
            val codes = self.operands(pair_exprs(l, r))

            return (c) ->
                val f = codes[0]
                val g = codes[1]

                val a = arr_of(f(c)?)

                inline(a, arr_of(g(c)?))

        val (x, fx) = la_operand(l)
        val (y, fy) = la_operand(r)
        val flagged = fx != Op.NoTrans || fy != Op.NoTrans
        val codes = self.operands(pair_exprs(x, y))

        (c) ->
            val f = codes[0]
            val g = codes[1]
            val a = arr_of(f(c)?)
            val b = arr_of(g(c)?)

            if flagged || reaches_blas(a, b) then blas_product(kind, a, fx, b, fy, vector) else inline(a, b)

    // A call of the linear-algebra prelude (DESIGN §10.5).
    linear_algebra(*self, name: string, args: Buf[TExpr]) -> Code
        val kind = la_kind(elem_or(args[0].ty))

        if name.ends_with("_inplace")
            var codes: Buf[Code] = buf()
            var borrowed: Buf[bool] = buf()

            for a in args
                codes.push(self.argument(a))
                borrowed.push(*a.kind match
                    TBorrow(_) -> true
                    _ -> false)

            return (c) ->
                var vals: Buf[Value] = buf()

                for f in codes
                    vals.push(f(c)?)

                var xs: Buf[&Arr] = buf()
                var upper = false

                for k in 0..<vals.len()
                    if borrowed[k] then xs.push(owned(vals[k])) else upper = bool_of(vals[k])

                la_in_place(kind, name, xs, upper)

        val codes = self.operands(args)
        val two = name == "solve" || name == "lstsq"
        val chol = name == "chol"

        (c) ->
            val f = codes[0]
            val a = arr_of(f(c)?)
            var b = a
            var upper = false

            if two || chol
                val g = codes[1]
                val v = g(c)?

                if two then b = arr_of(v) else upper = bool_of(v)

            la_value(kind, name, a, b, upper)
end Interp

private pair_exprs(a: TExpr, b: TExpr) -> Buf[TExpr]
    var out: Buf[TExpr] = buf()

    out.push(a)
    out.push(b)
    out
