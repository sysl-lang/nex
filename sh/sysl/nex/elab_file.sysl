module sh.sysl.nex

// Files (DESIGN §17.6): `open`, `read_line`, `write`, `write_line`, `flush`, `close`, the whole-file
// functions, `exists`, `remove`, and the values `stdin`, `stdout` and `stderr`.
//
// **Each is one call of the runtime** (`runtime/files.sysl`), which both engines answer with the same
// sysl, **inside the typed IR a `match` would give**. The call leaves its thread's outcome behind it,
// and the IR reads that back to build the `Result`. So `read_text(p)` is
//
//     val path = p
//     val text = file_read_text(path)
//     val status = file_status()
//     if status == FILE_OK then Ok(text)
//     elif status == FILE_MISUSE then trap(file_fail_message())
//     elif status == FILE_NOT_FOUND then Err(NotFound(file_fail_path()))
//     elif status == FILE_DENIED then Err(Denied(file_fail_path()))
//     elif status == FILE_MALFORMED then Err(Malformed(file_fail_path(), file_fail_line(), file_fail_column(), file_fail_message()))
//     else Err(Failed(file_fail_path(), file_fail_message()))
//
// `read_line` answers `Ok(None)` where the outcome is the end of the input. `read_bytes` and
// `write_bytes` hand the array's storage across whole: the runtime holds what it read until a second
// call fills the new array with it, and writes an array's storage in the one call.

import nex_runtime.sh.sysl.nex_runtime.{FILE_DENIED, FILE_END, FILE_MALFORMED, FILE_MISUSE, FILE_NOT_FOUND, FILE_OK}
import sysl.buf.{Buf, buf}
import sh.sysl.parsing.Span

private val FILE_FUNCTIONS = ["open", "read_line", "write", "write_line", "flush", "close", "read_text", "read_lines", "write_text", "append_text", "write_lines",
                              "read_bytes", "write_bytes", "exists", "remove"]

private val STANDARD_FILES = ["stdin", "stdout", "stderr"]

is_file_function(name: string) -> bool
    for n in FILE_FUNCTIONS
        if n == name then return true

    false

// The runtime calls the elaborator makes for files.
is_file_builtin(name: string) -> bool = name.starts_with("file_")

// The file function a runtime call is the I/O of, by its nex name; `""` for a call that reads or
// writes no file (an outcome read back, read bytes handed to their array, a standard file named).
file_io_name(builtin: string) -> string
    if !is_file_builtin(builtin) then return ""
    if builtin == "file_write_buffer" then return "write_bytes"

    val n = builtin[5..]

    if n == "exists" || is_file_function(n) then n else ""

private val MODE = "prelude.Mode"
private val RESULT_ENUM = "prelude.Result"
private val OPTION_ENUM = "prelude.Option"

private val UINT8 = Int(8, false)

private no_args() -> Buf[TExpr] = buf()

private just(e: TExpr) -> Buf[TExpr]
    var out: Buf[TExpr] = buf()

    out.push(e)
    out

private pair(a: TExpr, b: TExpr) -> Buf[TExpr]
    var out = just(a)

    out.push(b)
    out

private tys(a: Ty, b: Ty) -> Buf[Ty]
    var out: Buf[Ty] = buf()

    out.push(a)
    out.push(b)
    out

private lit(span: Span, v: i128) -> TExpr = texpr(span, INTEGER, TLiteral(IntVal(v), false))

private at(span: Span, ty: Ty, id: usize) -> TExpr = texpr(span, ty, TLocal(id))

private is(span: Span, status: usize, code: int) -> TExpr = texpr(span, Bool, TBinary("==", at(span, INTEGER, status), lit(span, i128(code))))

private call(span: Span, ty: Ty, name: string, args: Buf[TExpr]) -> TExpr = texpr(span, ty, TBuiltin(name, args))

private unit(span: Span) -> TExpr = texpr(span, Void, TLiteral(VoidVal, false))

impl Elab
    // Whether `name` here is the prelude's `stdin`, `stdout` or `stderr` rather than a binding of the
    // program.
    is_standard_file(self, span: Span, name: string) -> bool
        if self.lookup_local(name).is_some() || self.find_top(self.global(span, name)).is_some() then return false

        for n in STANDARD_FILES
            if n == name then return true

        false

    // `stdin`, `stdout` or `stderr`.
    standard_file(self, span: Span, name: string) -> TExpr
        val k = if name == "stdin" then 0 elif name == "stdout" then 1 else 2

        call(span, Ty.File, "file_std", just(lit(span, i128(k))))

    // A call of a file function; its `Result` may not be dropped where it is a statement.
    file_call(*self, span: Span, name: string, args: Buf[Expr], want: Option[Ty]) -> TExpr
        for a in args
            *a.kind match
                NamedArg(_, _) ->
                    self.fail(a.span, s"`${name}` takes no named arguments")
                    return self.invalid(span)
                _ -> ()

        val v = self.file_typed(span, name, args)

        val statement = want match
            Some(Void) -> true
            _ -> false

        if statement && name != "exists" && !is_error(v.ty) then self.fail(span, s"the `Result` of `${name}` is dropped: handle it with `!`, `?` or `match`, or discard it with `val _ = …`")

        v

    private file_typed(*self, span: Span, name: string, args: Buf[Expr]) -> TExpr
        val wants = if name == "open" then "a path and a `Mode`, `Read`, `Write` or `Append`"
                    elif name == "read_line" || name == "flush" || name == "close" then "a `File`"
                    elif name == "write" || name == "write_line" then "a `File` and a string"
                    elif name == "write_text" || name == "append_text" then "a path and a string"
                    elif name == "write_lines" then "a path and the lines, `[string]`"
                    elif name == "write_bytes" then "a path and the bytes, `[uint8]`"
                    else "a path"
        val count: usize = if name == "open" || name == "write" || name == "write_line" || name.starts_with("write_") || name == "append_text" then 2 else 1

        if args.len() != count then return self.arity(span, name, wants)

        val on_file = name == "read_line" || name == "write" || name == "write_line" || name == "flush" || name == "close"
        val first = if on_file then self.check(args[0], Ty.File, s"the file `${name}` takes") else self.check(args[0], Ty.Str, "the path")

        if name == "exists" then return call(span, Bool, "file_exists", just(first))

        var items: Buf[TExpr] = buf()
        val subject = self.new_local(if on_file then "file" else "path", first.ty, LVal)

        items.push(texpr(span, Void, TLet(subject, first)))

        var operands = just(at(span, first.ty, subject))

        if count == 2
            val second = if name == "open" then self.check(args[1], Nominal(MODE, buf()), "the mode")
                         elif name == "write_lines" then self.check(args[1], Ty.Array(Ty.Str, dynamic_axes(1)), "the lines")
                         elif name == "write_bytes" then self.check(args[1], Ty.Array(UINT8, dynamic_axes(1)), "the bytes")
                         else self.check(args[1], Ty.Str, "the text")
            val held = self.new_local("operand", second.ty, LVal)

            items.push(texpr(span, Void, TLet(held, self.stored(at(span, second.ty, held), second))))
            operands.push(if name == "open" then mode_tag(span, at(span, second.ty, held)) else at(span, second.ty, held))

        if name == "read_bytes" then return self.bytes_read(span, items, operands)

        // The value the call answers on success, and the call.
        val ty = if name == "open" then Ty.File elif name == "read_line" || name == "read_text" then Ty.Str elif name == "read_lines" then Ty.Array(Ty.Str, dynamic_axes(1)) else Void
        val entry = if name == "write_bytes" then "file_write_buffer" else s"file_${name}"
        val made = call(span, ty, entry, operands)
        var value = unit(span)

        if is_void(ty)
            items.push(made)
        else
            val v = self.new_local("value", ty, LVal)

            items.push(texpr(span, Void, TLet(v, made)))
            value = at(span, ty, v)

        val ok_ty = if name == "read_line" then self.prelude_instance(span, OPTION_ENUM, just_ty(Ty.Str)) else ty
        val result = self.prelude_instance(span, RESULT_ENUM, tys(ok_ty, io_error_ty()))
        val status = self.status_of(span, &items)
        val ok_value = if name == "read_line" then texpr(span, ok_ty, TVariant("prelude.Some", 0, just(value))) else value
        var otherwise = self.failure(span, result, status)

        if name == "read_line" then otherwise = texpr(span, result, TIf(is(span, status, FILE_END), ok(span, result, texpr(span, ok_ty, TVariant("prelude.None", 1, buf()))), Some(otherwise)))

        texpr(span, result, TBlock(items, texpr(span, result, TIf(is(span, status, FILE_OK), ok(span, result, ok_value), Some(otherwise)))))
    end file_typed

    // The outcome of the call just made, bound to a local by a statement added to `items`.
    private status_of(*self, span: Span, items: *Buf[TExpr]) -> usize
        val status = self.new_local("status", INTEGER, LVal)

        items.push(texpr(span, Void, TLet(status, call(span, INTEGER, "file_status", no_args()))))
        status

    // What an outcome other than success is: the trap of a misuse, or the `Err` of its `IoError`.
    private failure(*self, span: Span, result: Ty, status: usize) -> TExpr
        val err = io_error_ty()
        val path = call(span, Ty.Str, "file_fail_path", no_args())
        val message = call(span, Ty.Str, "file_fail_message", no_args())
        var fields = pair(path, call(span, INTEGER, "file_fail_line", no_args()))

        fields.push(call(span, INTEGER, "file_fail_column", no_args()))
        fields.push(message)

        val failed = error(span, result, texpr(span, err, TVariant("prelude.Failed", 3, pair(path, message))))
        val bad = error(span, result, texpr(span, err, TVariant("prelude.Malformed", 2, fields)))
        val denied = error(span, result, texpr(span, err, TVariant("prelude.Denied", 1, just(path))))
        val missing = error(span, result, texpr(span, err, TVariant("prelude.NotFound", 0, just(path))))
        val trap = texpr(span, Never, TBuiltin("trap", just(message)))
        val e3 = texpr(span, result, TIf(is(span, status, FILE_MALFORMED), bad, Some(failed)))
        val e2 = texpr(span, result, TIf(is(span, status, FILE_DENIED), denied, Some(e3)))
        val e1 = texpr(span, result, TIf(is(span, status, FILE_NOT_FOUND), missing, Some(e2)))

        texpr(span, result, TIf(is(span, status, FILE_MISUSE), trap, Some(e1)))

    // `read_bytes(path)`: the file's bytes held by the runtime, then handed whole to a new `[uint8]`.
    //
    //     val count = file_read_bytes(path)
    //     val status = file_status()
    //     if status == FILE_OK then Ok(file_bytes_taken(count)) else …
    //
    // `write_bytes(path, data)` is one call, `file_write_buffer(path, data)`, which hands the array's
    // storage to the runtime whole.
    private bytes_read(*self, span: Span, items: Buf[TExpr], operands: Buf[TExpr]) -> TExpr
        var out = items
        val bytes_ty = Ty.Array(UINT8, dynamic_axes(1))
        val result = self.prelude_instance(span, RESULT_ENUM, tys(bytes_ty, io_error_ty()))
        val count = self.new_local("count", INTEGER, LVal)

        out.push(texpr(span, Void, TLet(count, call(span, INTEGER, "file_read_bytes", operands))))

        val status = self.status_of(span, &out)
        val taken = ok(span, result, call(span, bytes_ty, "file_bytes_taken", just(at(span, INTEGER, count))))

        texpr(span, result, TBlock(out, texpr(span, result, TIf(is(span, status, FILE_OK), taken, Some(self.failure(span, result, status))))))
end Elab

private just_ty(t: Ty) -> Buf[Ty]
    var out: Buf[Ty] = buf()

    out.push(t)
    out

private ok(span: Span, result: Ty, v: TExpr) -> TExpr = texpr(span, result, TVariant("prelude.Ok", 0, just(v)))

private error(span: Span, result: Ty, e: TExpr) -> TExpr = texpr(span, result, TVariant("prelude.Err", 1, just(e)))

// The prelude `Mode` `m` as the runtime's number for it: its tag.
private mode_tag(span: Span, m: TExpr) -> TExpr
    var arms: Buf[TArm] = buf()

    arms.push(TArm(PVariant("Read", 0, buf()), lit(span, 0)))
    arms.push(TArm(PVariant("Write", 1, buf()), lit(span, 1)))
    arms.push(TArm(PVariant("Append", 2, buf()), lit(span, 2)))
    texpr(span, INTEGER, TMatch(m, arms))
