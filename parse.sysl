// The nex parser: tokens to the tree in `ast.sysl`, by recursive descent.
//
// Each function reads one construct of spec chapters 4 to 9 and is named for it. Precedence is the
// table of §4.3, loosest first: `,` (a tuple), `->` (a lambda), `or`, `and`, `not`, comparison, `..`,
// `+ -`, `* / div % @`, juxtaposition, unary `-`, `^`, then calls, indexing, `.` and a
// unit annotation `<unit>`, all postfix and chained left to right.
// A postfix `match` may follow any expression short of a tuple. A loop label, `name:`, is told
// from a name by the `for` or `while` two tokens on.
//
// **Two places look ahead before they commit**, and both are where the language puts the deciding
// token after the part that is ambiguous: a parenthesised lambda head (`(x, y) -> ...` against the
// tuple `(x, y)`) is told by the `->` after it, and a statement is an assignment when an assignment
// operator follows what it began with. The rest decides on the token in front of it.

import sysl.buf.{Buf, buf}
import sysl.text.{from_utf8_unchecked, parse_real}
import sh.sysl.parsing.{Diagnostic, Source, Span, Spanned, Tokens, error, tokens_of}

// A whole file: its declarations.
parse_program(src: Source) -> Result[Program, Diagnostic]
    var p = parser(src, lex(src)?)

    p.program()

// One file of a project, its text between `from` and `to` in the project's text `src`.
parse_file(src: Source, from: usize, to: usize) -> Result[Program, Diagnostic]
    var p = parser(src, lex_file(src, from, to)?)

    p.program()

// One expression standing alone, as a `${...}` hole holds and as tests write them.
parse_expression(src: Source) -> Result[Expr, Diagnostic]
    var p = parser(src, lex(src)?)

    p.standalone()

private parser(src: Source, toks: Buf[Spanned[Tok]]) -> Parser = Parser(src, tokens_of(toks), false)

private is_kw(t: Tok, text: string) -> bool = t match
    Keyword(k) -> k == text
    _ -> false

private is_newline(t: Tok) -> bool = t match
    Newline -> true
    _ -> false

private is_indent(t: Tok) -> bool = t match
    Indent -> true
    _ -> false

private is_dedent(t: Tok) -> bool = t match
    Dedent -> true
    _ -> false

private is_ident(t: Tok) -> bool = t match
    Ident(_) -> true
    _ -> false

private is_eof(t: Tok) -> bool = t match
    Eof -> true
    _ -> false

// How a token is named in a complaint about finding it.
private described(t: Tok) -> string = t match
    Num(text) -> s"'${text}'"
    Str(_) -> "a string"
    Interp(_, _) -> "an interpolated string"
    Ident(name) -> s"'${name}'"
    Keyword(text) -> s"'${text}'"
    UnitOpen -> "'<'"
    UnitClose -> "'>'"
    Newline -> "the end of the line"
    Indent -> "an indented block"
    Dedent -> "the end of the block"
    Eof -> "the end of the input"

private ex(span: Span, kind: ExprKind) -> Expr = Expr(span, kind)

private is_unit_open(t: Tok) -> bool = t match
    UnitOpen -> true
    _ -> false

private is_unit_close(t: Tok) -> bool = t match
    UnitClose -> true
    _ -> false

// Whether `t` can begin a factor of a unit expression: a name, `in`, `1`, or a parenthesis.
private starts_unit(t: Tok) -> bool = t match
    Ident(_) -> true
    Num(_) -> true
    Keyword(k) -> k == "in" || k == "("
    _ -> false

// The words that may close a block after `end`, beside the construct's own name.
private val end_words = ["if", "for", "while", "do", "def", "struct", "enum", "module", "match"]

private val compare_ops = ["==", "!=", "<", "<=", ">", ">="]

private val mul_ops = ["*", "/", "div", "%", "@"]

private val assign_ops = ["=", "+=", "-=", "*=", "/=", "%="]

private one_of(t: Tok, set: []const string) -> string
    for op in set
        if is_kw(t, op) then return op

    ""

struct Parser
    src: Source
    toks: Tokens[Tok]

    // Whether the innermost `[` around the cursor opened an index list rather than an array
    // literal, which is where `end` is an index (DESIGN §5.2). A parenthesis does not change it, so
    // in `a[f(end)]` the `end` is `a`'s.
    in_subscript: bool

    // -- the cursor -------------------------------------------------------------------------------

    // The token `n` ahead of the cursor; past the end, the end.
    tok(self, n: usize) -> Tok = self.toks.peek_at(n) match
        Some(t) -> t.value
        None -> Eof

    at(self, text: string) -> bool = is_kw(self.tok(0), text)

    // Whether the contextual word `word` (`by`, `reduce`) is at the cursor.
    at_word(self, word: string) -> bool = self.tok(0) match
        Ident(name) -> name == word
        _ -> false

    // Whether the cursor is on the first token of a line: what an end marker always is.
    at_line_head(self) -> bool = self.toks.looked_back() match
        Some(t) -> is_newline(t.value) || is_indent(t.value) || is_dedent(t.value)
        None -> true

    accept(*self, text: string) -> bool
        if !self.at(text) then return false

        self.toks.advance()
        true

    bump(*self)
        self.toks.advance()

    fail[T](self, want: string) -> Result[T, Diagnostic] =
        Err(error(self.toks.here(), s"expected ${want}, found ${described(self.tok(0))}"))

    expect(*self, text: string) -> Result[unit, Diagnostic]
        if self.accept(text) then return Ok(())

        self.fail(s"'${text}'")

    ident(*self, what: string) -> Result[string, Diagnostic]
        self.tok(0) match
            Ident(name) ->
                self.bump()
                Ok(name)
            _ -> self.fail(what)

    // Whether a run of newlines and then `text` is ahead.
    at_after_newlines(self, text: string) -> bool
        var n: usize = 0

        while is_newline(self.tok(n))
            n += 1

        is_kw(self.tok(n), text)

    skip_newlines(*self)
        while is_newline(self.tok(0))
            self.bump()

    // Newlines and `;`, which separate statements interchangeably.
    skip_separators(*self) -> bool
        var any = false

        while is_newline(self.tok(0)) || self.at(";")
            self.bump()
            any = true

        any

    // Whether a block opens here: the newline ending a header, then an indent.
    at_block(self) -> bool = is_newline(self.tok(0)) && is_indent(self.tok(1))

    // `end`, optionally naming what it closes, after the newline that follows a block's dedent. It
    // closes nothing the layout has not already closed; which name it gives is not checked.
    end_marker(*self)
        if !self.at_after_newlines("end") then return

        self.skip_newlines()
        self.bump()

        self.tok(0) match
            Ident(_) -> self.bump()
            t ->
                if one_of(t, end_words).len > 0 then self.bump()
    end end_marker

    // -- declarations -----------------------------------------------------------------------------

    program(*self) -> Result[Program, Diagnostic]
        var decls: Buf[Decl] = buf()

        self.skip_separators()

        while !is_eof(self.tok(0))
            decls.push(self.decl()?)

            if is_eof(self.tok(0)) then break
            if !self.skip_separators() then return self.fail("the end of the declaration")

        Ok(Program(decls))
    end program

    standalone(*self) -> Result[Expr, Diagnostic]
        val e = self.expr_tuple()?

        self.skip_newlines()

        if !is_eof(self.tok(0)) then return self.fail("the end of the expression")

        Ok(e)

    // Whether a declaration starts here.
    at_decl(self) -> bool
        val t = self.tok(0)

        for word in ["@", "private", "val", "var", "const", "def", "extern", "struct", "enum", "module", "import", "unit"]
            if is_kw(t, word) then return true

        false

    decl(*self) -> Result[Decl, Diagnostic]
        val m = self.toks.mark()
        var attrs: Buf[Attribute] = buf()

        while self.accept("@")
            attrs.push(self.attribute()?)
            self.skip_newlines()

        val private_ = self.accept("private")
        val kind = self.decl_kind()?

        Ok(Decl(self.toks.span_from(m), attrs, private_, kind))
    end decl

    attribute(*self) -> Result[Attribute, Diagnostic]
        val name = self.ident("an attribute name")?
        var args: Buf[AttrArg] = buf()

        if self.accept("(")
            if !self.at(")")
                loop
                    args.push(self.attribute_arg()?)

                    if !self.accept(",") then break
            end if

            self.expect(")")?
        end if

        Ok(Attribute(name, args))
    end attribute

    // A string, a name, or `name = "string"`.
    attribute_arg(*self) -> Result[AttrArg, Diagnostic]
        val t = self.tok(0)

        t match
            Str(v) ->
                self.bump()
                return Ok(AttrArg.Str(v))
            Ident(n) ->
                self.bump()

                if !self.accept("=") then return Ok(AttrArg.Name(n))

                self.tok(0) match
                    Str(v) ->
                        self.bump()
                        return Ok(AttrArg.Named(n, v))
                    _ -> return self.fail("a string")
            _ -> self.fail("a string or a name")
    end attribute_arg

    decl_kind(*self) -> Result[DeclKind, Diagnostic]
        if self.accept("val") then return self.binding(Val)
        if self.accept("var") then return self.binding(Var)
        if self.accept("const") then return self.binding(Const)
        if self.accept("def") then return self.function()

        if self.accept("extern")
            self.expect("def")?
            return self.extern_function()

        if self.accept("struct") then return self.structure()
        if self.accept("enum") then return self.enumeration()

        if self.accept("module")
            return Ok(Module(self.dotted()?))

        if self.accept("import") then return self.import_decl()

        if self.accept("unit") then return self.unit_decl()

        self.fail("a declaration")
    end decl_kind

    // After `unit`: a name, then nothing (a base unit), or `=` and a unit expression, which a
    // number before it scales: `unit in = 0.0254 m`.
    unit_decl(*self) -> Result[DeclKind, Diagnostic]
        val name = if self.accept("in") then "in" else self.ident("a unit name")?

        if !self.accept("=") then return Ok(UnitDecl(name, None, None))

        var factor: Option[string] = None

        self.tok(0) match
            Num(text) ->
                if starts_unit(self.tok(1))
                    self.bump()
                    factor = Some(text)
            _ -> ()

        Ok(UnitDecl(name, factor, Some(self.unit_expr()?)))
    end unit_decl

    // -- units --------------------------------------------------------------------------------------

    // `<unit>` after a number, a name or a type name, its `<` at the cursor.
    annotation(*self) -> Result[UnitExpr, Diagnostic]
        val m = self.toks.mark()

        self.bump()

        if is_unit_close(self.tok(0))
            self.bump()
            return Err(error(self.toks.span_from(m), "a unit annotation is empty: it names a unit, and `<1>` is the dimensionless one"))

        val u = self.unit_expr()?

        if !is_unit_close(self.tok(0)) then return self.fail("'>' to close the unit annotation")

        self.bump()
        Ok(u)
    end annotation

    // Products separated by `/`, to the left.
    unit_expr(*self) -> Result[UnitExpr, Diagnostic]
        val m = self.toks.mark()
        var u = self.unit_product()?

        while self.accept("/")
            val rhs = self.unit_product()?

            u = UnitExpr(self.toks.span_from(m), Div(u, rhs))

        Ok(u)

    // Powers written side by side, to the left.
    unit_product(*self) -> Result[UnitExpr, Diagnostic]
        val m = self.toks.mark()
        var u = self.unit_power()?

        while starts_unit(self.tok(0))
            val rhs = self.unit_power()?

            u = UnitExpr(self.toks.span_from(m), Mul(u, rhs))

        Ok(u)

    // A factor and an optional exponent: a whole number, `s^2`, `s^-1`, or a fraction in
    // parentheses, `m^(1/2)`.
    unit_power(*self) -> Result[UnitExpr, Diagnostic]
        val m = self.toks.mark()
        val base = self.unit_factor()?

        if !self.accept("^") then return Ok(base)

        if !self.accept("(")
            val n = self.unit_integer(true)?

            return Ok(UnitExpr(self.toks.span_from(m), Pow(base, n, 1)))

        val num = self.unit_integer(true)?
        var den: i64 = 1

        if self.accept("/")
            den = self.unit_integer(false)?

            if den == 0 then return Err(error(self.toks.previous(), "a unit exponent's denominator may not be zero"))

        self.expect(")")?
        Ok(UnitExpr(self.toks.span_from(m), Pow(base, num, den)))
    end unit_power

    // A whole number in an exponent, with a `-` before it where `signed`.
    unit_integer(*self, signed: bool) -> Result[i64, Diagnostic]
        val negative = signed && self.accept("-")

        val text = self.tok(0) match
            Num(t) -> t
            _ -> return self.fail("a whole-number exponent")

        digits_value(text, 10) match
            Some(v) ->
                if v > 0x7FFF_FFFF_FFFF_FFFFu64 then return Err(error(self.toks.here(), "this exponent does not fit in an integer"))

                self.bump()
                Ok(if negative then -i64(v) else i64(v))
            None ->
                Err(error(self.toks.here(), "a unit exponent is a whole number, or a fraction in parentheses: `m^(3/2)`"))
    end unit_integer

    // A unit's name, `1`, or a parenthesised unit expression.
    unit_factor(*self) -> Result[UnitExpr, Diagnostic]
        val m = self.toks.mark()

        self.tok(0) match
            Ident(name) ->
                self.bump()
                return Ok(UnitExpr(self.toks.span_from(m), Base(name)))
            Num(text) ->
                if text != "1"
                    return Err(error(self.toks.here(), "the only number in a unit expression is `1`, the dimensionless unit; a scale factor belongs in a `unit` declaration"))

                self.bump()
                return Ok(UnitExpr(self.toks.span_from(m), One))
            _ -> ()

        if self.accept("in") then return Ok(UnitExpr(self.toks.span_from(m), Base("in")))

        if self.accept("(")
            val inner = self.unit_expr()?

            self.expect(")")?
            return Ok(inner)

        self.fail("a unit")
    end unit_factor

    binding(*self, kind: BindKind) -> Result[DeclKind, Diagnostic]
        val pat = self.pattern_list("a name to bind")?
        val typ = if self.accept(":") then Some(self.type_expr()?) else None

        self.expect("=")?

        val init = if self.at_block() then self.block()? else self.expr_tuple()?

        Ok(Bind(kind, pat, typ, init))
    end binding

    function(*self) -> Result[DeclKind, Diagnostic]
        val name = self.ident("a function name")?
        val type_params = self.type_params()?
        val params = self.params()?
        val ret = if self.accept(":") then Some(self.type_expr()?) else None
        var body: Option[Expr] = None

        if self.accept("=")
            body = Some(if self.at_block() then self.block()? else self.statement(true)?)
            self.end_marker()

        Ok(Fun(name, type_params, params, ret, body))
    end function

    // The rest of an `extern def`: a C function's signature, which has no body to give.
    extern_function(*self) -> Result[DeclKind, Diagnostic]
        val name = self.ident("a function name")?
        val params = self.params()?
        val ret = if self.accept(":") then Some(self.type_expr()?) else None

        if self.at("=")
            return Err(error(self.toks.here(), "an `extern def` has no body: it declares a C function, which is defined in C"))

        Ok(Extern(name, params, ret))
    end extern_function

    // A parenthesised parameter list.
    params(*self) -> Result[Buf[Param], Diagnostic]
        var out: Buf[Param] = buf()

        self.expect("(")?

        if !self.at(")")
            loop
                out.push(self.param()?)

                if !self.accept(",") then break

        self.expect(")")?
        Ok(out)
    end params

    param(*self) -> Result[Param, Diagnostic]
        var attrs: Buf[Attribute] = buf()

        while self.accept("@")
            attrs.push(self.attribute()?)

        val name = self.ident("a parameter name")?

        self.expect(":")?

        if self.at("mut")
            return Err(error(self.toks.here(), "`mut` is not a parameter mode: a parameter the callee writes is `inout`"))

        val mode = if self.accept("inout") then Inout else Read
        var type_attrs: Buf[Attribute] = buf()

        while self.accept("@")
            type_attrs.push(self.attribute()?)

        val typ = self.type_expr()?
        val default = if self.accept("=") then Some(self.expr()?) else None

        Ok(Param(attrs, name, type_attrs, typ, mode, default))
    end param

    // `[T, U: Numeric]` after a generic declaration's name, or nothing.
    type_params(*self) -> Result[Buf[TypeParam], Diagnostic]
        var out: Buf[TypeParam] = buf()

        if !self.accept("[") then return Ok(out)

        loop
            val name = self.ident("a type parameter")?
            val constraint = if self.accept(":") then Some(self.ident("a constraint")?) else None

            out.push(TypeParam(name, constraint))

            if !self.accept(",") then break

        self.expect("]")?
        Ok(out)
    end type_params

    field(*self) -> Result[Field, Diagnostic]
        val name = self.ident("a field name")?

        self.expect(":")?
        Ok(Field(name, self.type_expr()?))

    // The lines of an indented block, each read by `item`, with the newline before the block and
    // the dedent after it taken. An item ends at a newline or a `;`; anything else after it is an
    // error rather than the start of the next item.
    lines[T](*self, what: string, item: (*Parser) -> Result[T, Diagnostic]) -> Result[Buf[T], Diagnostic]
        var out: Buf[T] = buf()

        if !self.at_block() then return self.fail(what)

        self.bump()
        self.bump()

        loop
            out.push(item(self)?)

            val separated = self.skip_separators()

            if is_dedent(self.tok(0)) then break
            if !separated then return self.fail("the end of the line")

        self.bump()
        Ok(out)
    end lines

    structure(*self) -> Result[DeclKind, Diagnostic]
        val name = self.ident("a struct name")?
        val type_params = self.type_params()?
        val fields = self.lines("the struct's fields on indented lines", (p) -> p.field())?

        self.end_marker()
        Ok(Struct(name, type_params, fields))
    end structure

    enumeration(*self) -> Result[DeclKind, Diagnostic]
        val name = self.ident("an enum name")?
        val type_params = self.type_params()?

        self.expect("=")?

        val variants = self.lines("the enum's variants on indented lines", (p) -> p.variant())?

        self.end_marker()
        Ok(Enum(name, type_params, variants))
    end enumeration

    variant(*self) -> Result[Variant, Diagnostic]
        val name = self.ident("a variant name")?
        var fields: Buf[Field] = buf()

        if self.accept("(")
            loop
                fields.push(self.field()?)

                if !self.accept(",") then break

            self.expect(")")?
        end if

        Ok(Variant(name, fields))
    end variant

    dotted(*self) -> Result[Buf[string], Diagnostic]
        var path: Buf[string] = buf()

        path.push(self.ident("a module name")?)

        while self.at(".") && is_ident(self.tok(1))
            self.bump()
            path.push(self.ident("a module name")?)

        Ok(path)
    end dotted

    import_decl(*self) -> Result[DeclKind, Diagnostic]
        val path = self.dotted()?
        var selectors: Buf[Selector] = buf()

        if self.accept(".*") then return Ok(Import(path, selectors, true))

        if self.accept(".")
            self.expect("{")?

            loop
                val name = self.ident("a name to import")?
                val alias = if self.accept("as") then Some(self.ident("a name to import it as")?) else None

                selectors.push(Selector(name, alias))

                if !self.accept(",") then break

            self.expect("}")?
        end if

        Ok(Import(path, selectors, false))
    end import_decl

    // -- blocks and statements --------------------------------------------------------------------

    // An indented block. Its value is its last line's: a block of one expression is that expression,
    // and a block ending in a declaration is `()`.
    block(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        val items = self.lines("an indented block", (p) -> p.block_item())?
        val span = self.toks.span_from(m)
        var head: Buf[BlockItem] = buf()

        for i in 0..<items.len() - 1
            head.push(items[i])

        items[items.len() - 1] match
            Stmt(e) ->
                if items.len() == 1 then return Ok(e)

                Ok(ex(span, Block(head, e)))
            Item(_) ->
                head.push(items[items.len() - 1])
                Ok(ex(span, Block(head, ex(span, UnitLit))))
    end block

    block_item(*self) -> Result[BlockItem, Diagnostic] =
        if self.at_decl() then Ok(Item(self.decl()?)) else Ok(Stmt(self.statement(true)?))

    // An expression, or an assignment to one. A tuple is read where `tuple` says one may stand: on a
    // line of its own, but not as an inline branch, where the comma belongs to what is around it.
    statement(*self, tuple: bool) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        val target = if tuple then self.expr_tuple()? else self.expr()?
        val op = one_of(self.tok(0), assign_ops)

        if op.len == 0 then return Ok(target)

        if is_targets(target)
            if op != "=" then return Err(error(self.toks.here(), s"`${op}` takes one target; a list of targets takes `=`"))
        elif !is_place(target)
            return Err(error(target.span, "only a name, a field or an indexed element can be assigned to"))

        self.bump()

        val value = if tuple then self.expr_tuple()? else self.expr()?

        Ok(ex(self.toks.span_from(m), Assign(op, target, value)))
    end statement

    // A branch of an `if` or a `match` arm: an indented block, or an inline statement.
    branch(*self) -> Result[Expr, Diagnostic] =
        if self.at_block() then self.block() else self.statement(false)

    // -- patterns and types -----------------------------------------------------------------------

    // What a `val`, a `for` or a `match` arm binds: one pattern, or two or more separated by commas,
    // which take a tuple apart. `what` names the expected token in a diagnostic.
    pattern_list(*self, what: string) -> Result[Pattern, Diagnostic]
        val m = self.toks.mark()
        var elems: Buf[Pattern] = buf()

        loop
            elems.push(self.pattern(what)?)

            if !self.accept(",") then break

        if elems.len() == 1 then return Ok(elems[0])

        Ok(Pattern(self.toks.span_from(m), PatternKind.Tuple(elems)))

    // One pattern: a name, `_`, a parenthesised list, or a variant with a pattern for each of its
    // fields. Parentheses are what a type annotation needs, `val (a, b): (real, real) = …`, and what
    // a tuple nested in another is written with, `val a, (b, c) = …`. The grammar is the same in
    // every position; which forms a position accepts is the elaborator's to say.
    pattern(*self, what: string) -> Result[Pattern, Diagnostic]
        val m = self.toks.mark()

        if self.accept("(")
            val inner = self.pattern_list(what)?

            self.expect(")")?
            return Ok(Pattern(self.toks.span_from(m), inner.kind))

        val name = self.ident(what)?

        if !self.accept("(")
            return Ok(Pattern(self.toks.span_from(m), if name == "_" then Wildcard else PatternKind.Name(name)))

        var args: Buf[Pattern] = buf()

        loop
            args.push(self.pattern(what)?)

            if !self.accept(",") then break

        self.expect(")")?
        Ok(Pattern(self.toks.span_from(m), PatternKind.Variant(name, args)))
    end pattern

    // A type. `->` is right-associative, and a parenthesised list is the parameters of a function
    // type when an arrow follows it and a tuple type otherwise; one type in parentheses is itself.
    // A parameter of a function type may say `inout`, so a list is read with modes and the modes are
    // refused afterwards if no `->` makes it a function type's.
    type_expr(*self) -> Result[Type, Diagnostic]
        val m = self.toks.mark()
        var params: Buf[Type] = buf()
        var modes: Buf[Mode] = buf()
        var single = true
        var inout_at: Option[Span] = None

        if self.accept("(")
            single = false

            if !self.at(")")
                loop
                    if self.at("inout") && inout_at.is_none() then inout_at = Some(self.toks.here())

                    modes.push(if self.accept("inout") then Inout else Read)
                    params.push(self.type_expr()?)

                    if !self.accept(",") then break

            self.expect(")")?
        else
            if self.at("inout") then inout_at = Some(self.toks.here())

            modes.push(if self.accept("inout") then Inout else Read)
            params.push(self.simple_type()?)

        if self.accept("->")
            val ret = self.type_expr()?

            return Ok(Type(self.toks.span_from(m), Func(params, modes, ret)))

        inout_at match
            Some(at) -> return Err(error(at, "`inout` is a parameter's mode: it belongs before a parameter's type or a function type's parameter"))
            None -> ()

        if single || params.len() == 1 then return Ok(params[0])

        Ok(Type(self.toks.span_from(m), TypeKind.Tuple(params)))
    end type_expr

    // `[T]`, `[T; axes]`, a name, or a name applied to type arguments.
    simple_type(*self) -> Result[Type, Diagnostic]
        val m = self.toks.mark()

        if self.accept("[")
            val elem = self.type_expr()?

            *elem.kind match
                Array(inner, axes) ->
                    return Err(error(elem.span, s"an array element is a scalar; a matrix is `[${show_type(inner)}; ${colons(axes.len() + 1)}]`"))
                _ -> ()

            var axes: Buf[Axis] = buf()

            if self.accept(";")
                loop
                    axes.push(self.axis()?)

                    if !self.accept(",") then break
            else
                axes.push(AnyExtent)

            self.expect("]")?
            return Ok(Type(self.toks.span_from(m), TypeKind.Array(elem, axes)))

        if self.at("unit")
            return Err(error(self.toks.here(), "`unit` declares a physical unit; the empty type is `void`"))

        var name = self.ident("a type")?

        // `geom.Point`: a type of a module the file imports bare.
        while self.at(".") && is_ident(self.tok(1))
            self.bump()
            name += "." + self.ident("a type")?

        var t = Type(self.toks.span_from(m), Named(name))

        if self.accept("[")
            var args: Buf[Type] = buf()

            loop
                args.push(self.type_expr()?)

                if !self.accept(",") then break

            self.expect("]")?
            t = Type(self.toks.span_from(m), Applied(name, args))
        end if

        if is_unit_open(self.tok(0))
            val u = self.annotation()?

            return Ok(Type(self.toks.span_from(m), Measured(t, u)))

        // A `<` against a type name that the lexer did not take for an annotation has no `>` after
        // it on the line.
        if self.at("<") && self.toks.previous().end == self.toks.here().start
            return Err(error(self.toks.here(), "this unit annotation is not closed: `real<m>` closes it with a `>` on the same line"))

        Ok(t)
    end simple_type

    // One axis of an array type: `:`, a static extent, or a name (a const extent or a rank).
    axis(*self) -> Result[Axis, Diagnostic]
        val want = "an axis (`:`, an integer literal or a const name)"

        if self.accept(":") then return Ok(AnyExtent)

        self.tok(0) match
            Num(text) ->
                val lit = number(self.toks.here(), text, false)?

                *lit.kind match
                    IntLit(n) ->
                        self.bump()
                        Ok(FixedExtent(u64(n)))
                    _ -> self.fail(want)
            Ident(name) ->
                self.bump()
                Ok(NamedExtent(name))
            _ -> self.fail(want)
    end axis

    // -- expressions ------------------------------------------------------------------------------

    // `a, b, c`: the loosest level, a tuple where there is more than one.
    expr_tuple(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        val first = self.expr()?

        if !self.at(",") then return Ok(first)

        var elems: Buf[Expr] = buf()

        elems.push(first)

        while self.accept(",")
            elems.push(self.expr()?)

        Ok(ex(self.toks.span_from(m), ExprKind.Tuple(elems)))
    end expr_tuple

    // An expression short of a tuple, and the `match` that may follow it.
    expr(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        val e = self.arrow()?

        if !self.accept("match") then return Ok(e)

        val cases = self.lines("the match's arms on indented lines", (p) -> p.match_case())?
        val span = self.toks.span_from(m)

        self.end_marker()
        Ok(ex(span, Match(e, cases)))
    end expr

    match_case(*self) -> Result[MatchCase, Diagnostic]
        val pat = self.pattern_list("a pattern")?

        self.expect("->")?
        Ok(MatchCase(pat, self.branch()?))

    // A lambda, or what is below one. A lambda's head is a name or a parenthesised list of names
    // that may carry types; it is one only when the `->` follows, so a parenthesised head is read on
    // trial and given back when it is not.
    arrow(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()

        self.lambda_head() match
            Some(params) ->
                val body = if self.at_block() then self.block()? else self.arrow()?

                return Ok(ex(self.toks.span_from(m), Lambda(params, body)))
            None -> self.toks.reset(m)

        self.or_expr()
    end arrow

    lambda_head(*self) -> Option[Buf[LambdaParam]]
        var params: Buf[LambdaParam] = buf()

        self.tok(0) match
            Ident(name) ->
                if !is_kw(self.tok(1), "->") then return None

                self.bump()
                self.bump()
                params.push(LambdaParam(name, None))
                return Some(params)
            _ -> ()

        if !self.accept("(") then return None

        if !self.at(")")
            loop
                val name = self.tok(0) match
                    Ident(n) -> n
                    _ -> return None

                self.bump()

                var typ: Option[Type] = None

                if self.accept(":")
                    typ = self.type_expr() match
                        Ok(t) -> Some(t)
                        Err(_) -> return None

                params.push(LambdaParam(name, typ))

                if !self.accept(",") then break
        end if

        if !self.accept(")") || !self.accept("->") then return None

        Some(params)
    end lambda_head

    or_expr(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        var e = self.and_expr()?

        while self.accept("or")
            val rhs = self.and_expr()?

            e = ex(self.toks.span_from(m), BinOp("or", e, rhs))

        Ok(e)

    and_expr(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        var e = self.not_expr()?

        while self.accept("and")
            val rhs = self.not_expr()?

            e = ex(self.toks.span_from(m), BinOp("and", e, rhs))

        Ok(e)

    // `not` binds below the comparisons and above `and`: `not a < b < c` is `not (a < b < c)`, a
    // whole chain, and `not a and b` is `(not a) and b`. It nests: `not not a`.
    not_expr(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()

        if !self.accept("not") then return self.comparison()

        val operand = self.not_expr()?

        Ok(ex(self.toks.span_from(m), Unary("not", operand)))

    // One comparison is a `BinOp`; two or more in a row are a chain (§4.6).
    comparison(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        var operands: Buf[Expr] = buf()
        var ops: Buf[string] = buf()

        operands.push(self.range()?)

        loop
            val op = one_of(self.tok(0), compare_ops)

            if op.len == 0 then break

            self.bump()
            ops.push(op)
            operands.push(self.range()?)

        if ops.len() == 0 then return Ok(operands[0])

        val span = self.toks.span_from(m)

        if ops.len() == 1 then return Ok(ex(span, BinOp(ops[0], operands[0], operands[1])))

        Ok(ex(span, Chain(operands, ops)))
    end comparison

    // `lo..hi` or `lo..<hi`, with a `by` step where one is written: `n..1 by -1`.
    range(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        val lo = self.additive()?
        val inclusive = self.at("..")

        if !inclusive && !self.at("..<") then return Ok(lo)

        self.bump()

        val hi = self.additive()?
        var stride: Option[Expr] = None

        if self.at_word("by")
            self.bump()
            stride = Some(self.additive()?)

        Ok(ex(self.toks.span_from(m), Range(Some(lo), Some(hi), inclusive, stride)))
    end range

    additive(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        var e = self.multiplicative()?

        loop
            val op = one_of(self.tok(0), ["+", "-"])

            if op.len == 0 then break

            self.bump()

            val rhs = self.multiplicative()?

            e = ex(self.toks.span_from(m), BinOp(op, e, rhs))

        Ok(e)
    end additive

    multiplicative(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        var e = self.juxtaposition()?

        loop
            val op = one_of(self.tok(0), mul_ops)

            if op.len == 0 then break

            self.bump()

            val rhs = self.juxtaposition()?

            e = ex(self.toks.span_from(m), BinOp(op, e, rhs))

        Ok(e)
    end multiplicative

    // A numeric literal written against a name or a parenthesised expression multiplies it (§4.4):
    // `2x`, `2pi`, `2(x + 1)`, `-4i`. What it multiplies may carry a power, so `2x^3` is `2 * x^3`.
    juxtaposition(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        val negative = self.at("-")
        val n: usize = if negative then 1 else 0

        val text = self.tok(n) match
            Num(t) -> t
            _ -> return self.unary()

        // A contextual word after a number is the clause it opens (`0..10 by 2`, `0..n reduce s: +`),
        // never something the number multiplies.
        self.tok(n + 1) match
            Ident(w) ->
                if w == "by" || w == "reduce" then return self.unary()
            t ->
                if !is_kw(t, "(") then return self.unary()

        if negative then self.bump()
        self.bump()

        val coeff = number(self.toks.span_from(m), text, negative)?
        val body = self.power()?

        Ok(ex(self.toks.span_from(m), Juxtapose(coeff, body)))
    end juxtaposition

    // A unary `-` applies to a whole power: `-x^2` is `-(x^2)` and `-2^2` is `-4`.
    unary(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()

        if self.accept("-")
            val operand = self.unary()?

            return Ok(ex(self.toks.span_from(m), Unary("-", operand)))

        self.power()
    end unary

    // `^` binds tighter than a unary operator on its left and is right-associative: `2^3^2` is
    // `2^(3^2)`. Its exponent may carry a sign of its own, `x^-y`.
    power(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        val base = self.postfix()?

        if !self.accept("^") then return Ok(base)

        val exponent = self.unary()?

        Ok(ex(self.toks.span_from(m), BinOp("^", base, exponent)))

    // A primary expression and the calls, indexing, field accesses and unit annotations after it.
    postfix(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        var e = self.primary()?

        loop
            if self.accept("(")
                val args = self.arguments(")")?

                e = ex(self.toks.span_from(m), Call(e, args))
            elif self.accept("[")
                var indices: Buf[Expr] = buf()
                val outer = self.in_subscript

                self.in_subscript = true

                loop
                    indices.push(self.index_element()?)

                    if !self.accept(",") then break

                self.in_subscript = outer
                self.expect("]")?
                e = ex(self.toks.span_from(m), Index(e, indices))
            elif self.accept(".")
                self.tok(0) match
                    Num(text) ->
                        self.bump()

                        val index = digits_value(text, 10) match
                            Some(v) -> usize(v)
                            None -> return Err(error(self.toks.previous(), "a tuple field is a whole number"))

                        e = ex(self.toks.span_from(m), TupleField(e, index))
                    _ ->
                        val name = self.ident("a field or method name")?

                        if self.accept("(")
                            val args = self.arguments(")")?

                            e = ex(self.toks.span_from(m), MethodCall(e, name, args))
                        else
                            e = ex(self.toks.span_from(m), Field(e, name))
            elif is_unit_open(self.tok(0))
                // `e<unit>`, where the lexer found a unit annotation ending the operand.
                val u = self.annotation()?

                e = ex(self.toks.span_from(m), Measured(e, u))
            else
                break
        end loop

        Ok(e)
    end postfix

    // A call's arguments up to `close`, each positional or `name = value`; a trailing comma is
    // allowed.
    arguments(*self, close: string) -> Result[Buf[Expr], Diagnostic]
        var args: Buf[Expr] = buf()

        while !self.at(close)
            val m = self.toks.mark()

            val named = self.tok(0) match
                Ident(n) -> if is_kw(self.tok(1), "=") then n else ""
                _ -> ""

            if named.len > 0
                self.bump()
                self.bump()

                val value = self.expr()?

                args.push(ex(self.toks.span_from(m), NamedArg(named, value)))
            else
                args.push(self.expr()?)

            if !self.accept(",") then break

        self.expect(close)?
        Ok(args)
    end arguments

    // One position of an index list (DESIGN §5.1): `:` for a whole axis, an index, or a range whose
    // bounds may be left off and which may carry a `by` stride, negative to walk the window
    // downward. `end` may stand in any of the expressions.
    index_element(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()

        if self.accept(":") then return Ok(ex(self.toks.span_from(m), AxisAll))

        val lo = if self.at("..") || self.at("..<") then None else Some(self.additive()?)
        val inclusive = self.at("..")

        if !inclusive && !self.at("..<")
            return Ok(lo.unwrap())

        self.bump()

        val hi = if self.at(",") || self.at("]") || self.at_word("by") then None else Some(self.additive()?)
        var stride: Option[Expr] = None

        if !inclusive && hi.is_none()
            return Err(error(self.toks.previous(), "`..<` needs the bound it stops before: `a[k..]` runs to the end"))

        if self.at_word("by")
            self.bump()
            stride = Some(self.additive()?)

        Ok(ex(self.toks.span_from(m), Range(lo, hi, inclusive, stride)))
    end index_element

    primary(*self) -> Result[Expr, Diagnostic]
        val m = self.toks.mark()
        val t = self.tok(0)

        t match
            Num(text) ->
                self.bump()

                return number(self.toks.span_from(m), text, false)
            Str(v) ->
                self.bump()
                return Ok(ex(self.toks.span_from(m), StrLit(v)))
            Interp(pieces, format) ->
                self.bump()

                val parts = self.interpolation(pieces)?

                return Ok(ex(self.toks.span_from(m), Interp(parts, format)))
            Ident(name) ->
                if is_kw(self.tok(1), ":") && (is_kw(self.tok(2), "for") || is_kw(self.tok(2), "while"))
                    self.bump()
                    self.bump()

                    if self.accept("for") then return self.for_rest(m, Some(name))

                    self.bump()
                    return self.while_rest(m, Some(name))
                end if

                self.bump()
                return Ok(ex(self.toks.span_from(m), ExprKind.Name(name)))
            _ -> ()

        if self.accept("true") then return Ok(ex(self.toks.span_from(m), BoolLit(true)))
        if self.accept("false") then return Ok(ex(self.toks.span_from(m), BoolLit(false)))

        if self.accept("(")
            if self.accept(")") then return Ok(ex(self.toks.span_from(m), UnitLit))

            val inner = self.expr_tuple()?

            self.expect(")")?
            return Ok(inner)
        end if

        if self.accept("[")
            val outer = self.in_subscript

            self.in_subscript = false

            val elems = self.arguments("]")?

            self.in_subscript = outer

            for e in elems
                *e.kind match
                    NamedArg(_, _) -> return Err(error(e.span, "an array element cannot be named"))
                    _ -> ()

            return Ok(ex(self.toks.span_from(m), ExprKind.Array(elems)))
        end if

        if self.accept("if") then return self.if_rest(m)
        if self.accept("for") then return self.for_rest(m, None)
        if self.accept("while") then return self.while_rest(m, None)

        if self.accept("parallel")
            if self.accept("for") then return self.parallel_for_rest(m)

            val body = self.expr()?

            return Ok(ex(self.toks.span_from(m), Parallel(body)))

        if self.accept("return")
            val value = if self.at_expression() then Some(self.expr_tuple()?) else None

            return Ok(ex(self.toks.span_from(m), Return(value)))

        if self.accept("exit") then return Ok(ex(self.toks.span_from(m), Exit(self.loop_label())))
        if self.accept("cycle") then return Ok(ex(self.toks.span_from(m), Cycle(self.loop_label())))

        if self.accept("stop")
            val code = if self.at_expression() then Some(self.expr()?) else None

            return Ok(ex(self.toks.span_from(m), Stop(code)))

        // An `end` that starts a line is an end marker (DESIGN §5.2), out of place wherever it has
        // reached an expression; one anywhere else is an index, which only a subscript has.
        if self.at("end") && !self.at_line_head()
            if !self.in_subscript
                return Err(error(self.toks.here(), "`end` is only an index here inside `a[...]`"))

            self.bump()
            return Ok(ex(self.toks.span_from(m), End))

        self.fail("an expression")
    end primary

    // Whether an expression can begin at the cursor, which is what decides whether a `return` has
    // a value.
    at_expression(self) -> bool = self.tok(0) match
        Num(_) -> true
        Str(_) -> true
        Interp(_, _) -> true
        Ident(_) -> true
        Keyword(_) -> one_of(self.tok(0), ["(", "[", "-", "not", "true", "false", "if", "for", "while", "parallel", "return"]).len > 0
        _ -> false

    // `if cond then a [else b]`, with `then` optional before a block and `elif` for `else if`. The
    // `else` may be on the line after an inline branch or after the block.
    if_rest(*self, m: usize) -> Result[Expr, Diagnostic]
        val cond = self.expr()?
        val yes = if self.accept("then") then self.branch()? else self.block_or("'then' or an indented block")?
        var no: Option[Expr] = None

        if self.at_after_newlines("else") || self.at_after_newlines("elif")
            self.skip_newlines()

            if self.accept("elif")
                no = Some(self.if_rest(self.toks.mark() - 1)?)
            else
                self.bump()
                no = Some(self.branch()?)
        end if

        val span = self.toks.span_from(m)

        self.end_marker()
        Ok(ex(span, If(cond, yes, no)))
    end if_rest

    block_or(*self, want: string) -> Result[Expr, Diagnostic] =
        if self.at_block() then self.block() else self.fail(want)

    // A loop body: `do` and a statement on the header's line, or an indented block with no `do`.
    loop_body(*self) -> Result[Expr, Diagnostic]
        if self.accept("do")
            if self.at_block()
                return Err(error(self.toks.previous(), "`do` introduces a one-line body: drop it before an indented block"))

            return self.statement(false)
        end if

        if self.at("->")
            return Err(error(self.toks.here(), "a `for` body follows `do`, and a `for` has no value: nex has no array comprehensions; write `map(1..n, k -> e)`"))

        self.block_or("'do' or an indented block")
    end loop_body

    // The label after an `exit` or a `cycle`, where one is written on its line.
    loop_label(*self) -> Option[string]
        val label = self.tok(0) match
            Ident(n) -> n
            _ -> return None

        self.bump()
        Some(label)

    for_rest(*self, m: usize, label: Option[string]) -> Result[Expr, Diagnostic]
        val pat = self.pattern_list("a name to bind")?

        self.expect("in")?

        val iterable = self.expr()?
        val body = self.loop_body()?
        val span = self.toks.span_from(m)

        self.end_marker()
        Ok(ex(span, For(label, pat, iterable, body)))
    end for_rest

    // `parallel for i in r (, j in s)* [reduce v: op (, w: op)*]` and a loop body (DESIGN §9.1, §9.2).
    parallel_for_rest(*self, m: usize) -> Result[Expr, Diagnostic]
        var clauses: Buf[LoopClause] = buf()
        var reductions: Buf[Reduction] = buf()

        loop
            val name = self.ident("a loop index")?

            self.expect("in")?
            clauses.push(LoopClause(name, self.expr()?))

            if !self.accept(",") then break

        if self.at_word("reduce")
            self.bump()

            loop
                val name = self.ident("a reduction variable")?

                self.expect(":")?

                // `min`, `max`, `minloc`, `maxloc` and a user function are names; which name is an
                // operator is the elaborator's question.
                val op = self.tok(0) match
                    Ident(w) -> w
                    t -> one_of(t, ["+", "*", "and", "or"])

                if op.len == 0
                    return Err(error(self.toks.here(), "a reduction's operator is `+`, `*`, `and`, `or`, `min`, `max`, `minloc`, `maxloc` or a function's name"))

                self.bump()
                reductions.push(Reduction(name, op))

                if !self.accept(",") then break
        end if

        val body = self.loop_body()?
        val span = self.toks.span_from(m)

        self.end_marker()
        Ok(ex(span, ParallelFor(clauses, reductions, body)))
    end parallel_for_rest

    while_rest(*self, m: usize, label: Option[string]) -> Result[Expr, Diagnostic]
        val cond = self.expr()?
        val body = self.loop_body()?
        val span = self.toks.span_from(m)

        self.end_marker()
        Ok(ex(span, While(label, cond, body)))
    end while_rest

    // The pieces of an interpolated literal as parts of the tree: each `${...}` hole is read here, in
    // place, so a mistake inside one is reported where it was written.
    interpolation(*self, pieces: Buf[Piece]) -> Result[Buf[Part], Diagnostic]
        var parts: Buf[Part] = buf()

        for piece in pieces
            piece match
                Chunk(text) -> parts.push(Text(text))
                NameHole(at, spec) ->
                    val name = from_utf8_unchecked(self.src.text(at)).copy()

                    parts.push(Value(ex(at, ExprKind.Name(name)), spec))
                ExprHole(at, spec) ->
                    var sub = parser(self.src, lex_within(self.src, at.start, at.end)?)

                    parts.push(Value(sub.standalone()?, spec))

        Ok(parts)
    end interpolation
end Parser

// `:, :, :` for `n` axes: the dynamic shape of that rank.
private colons(n: usize) -> string
    var out = ":"

    for _ in 1..<n
        out = out + ", :"

    out

// Whether an expression names a place a value can be stored in.
private is_place(e: Expr) -> bool = *e.kind match
    Name(_) -> true
    Field(_, _) -> true
    TupleField(_, _) -> true
    Index(_, _) -> true
    _ -> false

// Whether an expression is a list of places, `a, b` or `a, (p.x, _)`, that a tuple is stored into.
private is_targets(e: Expr) -> bool = *e.kind match
    Tuple(elems) ->
        for t in elems
            if !is_place(t) && !is_targets(t) then return false

        true
    _ -> false

// The value of the digits of `text` in `base`, or `None` where one of them is not a digit of that
// base or the value does not fit 64 bits.
private digits_value(text: string, base: u64) -> Option[u64]
    var v: u64 = 0

    for c in text.bytes
        val d = c.digit_value(int(base)) match
            Some(k) -> u64(k)
            None -> return None

        if v > (0xFFFF_FFFF_FFFF_FFFFu64 - d) / base then return None

        v = v * base + d

    Some(v)
end digits_value

// A numeric literal's value: an integer in any of the four bases, or a real where it has a point or
// an exponent. An integer's value is its magnitude in any base, up to 64 bits; whether it fits is
// decided by the type it is adopted into.
private number(span: Span, text: string, negative: bool) -> Result[Expr, Diagnostic]
    val prefixes = [("0x", 16u64), ("0b", 2u64), ("0o", 8u64)]
    var base = 10u64
    var digits = text

    for (prefix, b) in prefixes
        if text.starts_with(prefix)
            base = b
            digits = text[2..<text.len]

    if base == 10
        for c in text.bytes
            if c == u8('.') || c == u8('e') || c == u8('E')
                val v = parse_real(text) match
                    Ok(v) -> v
                    Err(_) -> return Err(error(span, "malformed real literal"))

                return Ok(ex(span, RealLit(if negative then -v else v)))

    val v = digits_value(digits, base) match
        Some(v) -> i128(v)
        None -> return Err(error(span, "this literal does not fit in 64 bits"))

    Ok(ex(span, IntLit(if negative then -v else v)))
end number
