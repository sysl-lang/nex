// Traps, and the catching `assert_traps` needs.
//
// A nex trap is raised by generated code calling one of the `nex_trap_*` functions here. With nothing
// catching, it writes its message to standard error and aborts, as the reference's runtime does. Under
// `nex_catch_trap` it returns to the catch instead: the frames between — MLIR-generated ones among
// them — are abandoned, the message is kept for the catcher to read, and the program goes on.
//
// The return is C's `setjmp` and `longjmp`, which is how a nex program's trap crosses frames no
// unwinding table describes. Nothing a sysl frame owns is held across it: the frames abandoned are
// generated code, which holds no counts, and the catcher keeps its state in module storage.

@include("<setjmp.h>")

c const
    JMP_BUF_WORDS: usize = "(sizeof(jmp_buf) + sizeof(long long) - 1) / sizeof(long long)"

@needs(os)
extern setjmp(env: *u64) -> int

@abandons
@needs(os)
extern longjmp(env: *u64, v: int) -> never

@needs(os)
extern abort() -> never

// The innermost catch's saved context, and how deep the catches are nested; at depth zero a trap
// aborts. Each catch saves the context it replaces and restores it on the way out.
private var catch_env: [JMP_BUF_WORDS]u64 = [0; JMP_BUF_WORDS]
private var depth = 0
private var last_message = ""

trap_with(message: string) -> never
    note_trap(message)
    raise_trap()

// A trap's message, kept for the catch; with nothing catching, written out, and the program ends.
// A message built from values is noted here, in a call that returns, so that no frame holds it across
// the `longjmp` of `raise_trap`.
note_trap(message: string)
    if depth == 0 then
        flush()
        eprints(s"trap: $message\n")
        abort()

    last_message = message

raise_trap() -> never
    longjmp(&catch_env[0], 1)

// The one entry generated code traps through, with the message the compiler wrote for the check
// that failed.
@export("nex_trap")
trap(message: *u8) -> never
    note_trap(c_text(message))
    raise_trap()

@export("nex_trap_complex_div_zero")
trap_complex_div_zero() -> never
    trap_with("complex division by zero")

// `stop n`: what was printed is written out, and the program ends with status `n`.
@export("nex_stop")
stop(code: int) -> never
    flush()
    exit(code)

// The end of `main`: what was printed is written out.
@export("nex_finish")
finish()
    flush()

// Run `body`, answering true if it trapped and false if it returned. What it printed before the trap
// stays printed; the trap's message is not written, and `nex_last_trap_message` answers it.
@export("nex_catch_trap")
catch_trap(body: *extern() -> unit) -> bool
    val saved = catch_env

    depth += 1

    val trapped = setjmp(&catch_env[0]) != 0

    if !trapped then body()

    depth -= 1
    catch_env = saved
    trapped

// The message of the last trap a catch caught, written to standard output on a line of its own.
@export("nex_print_last_trap")
print_last_trap()
    print(s"trap: $last_message")
