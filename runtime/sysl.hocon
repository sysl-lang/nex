// nex's runtime, the library every compiled nex program links: printing every value as the reference
// interpreter spells it, and the trap machinery `assert_traps` catches through.
//
//     sysl build-c runtime -o libnex_rt.a
//
// A project of its own rather than a module of the compiler, because it is a different artifact: an
// archive a C link line takes, beside an object MLIR wrote, where the compiler is a program. It is a
// member of the workspace the repository root declares, so the interpreter can depend on it by name
// and call the same functions directly: its module is `sh.sysl.nex_runtime`, reached from another
// member as `nex_runtime.sh.sysl.nex_runtime`.

package {
  name    = "nex_runtime"
  version = "0.1.0"
  sysl    = "0.8.4"
}

// **`os`** for standard output and error and for `abort`; **`heap`** because the formatter builds its
// digits as strings. The allocator is libc's `malloc`, the one MLIR's lowered `memref.alloc` calls.
requires {
  os   = true
  heap = true
}

// **`@` and the linear-algebra prelude** (`la.sysl`): `blas` for the products, `lapack` for the rest,
// both engines calling the same functions.
dependencies {
  blas   { git = "github.com/sysl-lang/blas", version = "0.1.0" }
  lapack { git = "github.com/sysl-lang/lapack", version = "0.1.1" }
}

// **Which BLAS and LAPACK answer is chosen once, here**, and passed on to `lapack`, which passes it on
// to `blas`: the platform's (Accelerate on macOS, OpenBLAS elsewhere), or OpenBLAS everywhere. The
// interpreter links what this choice names, and the `nex` command links every compiled program that
// calls BLAS or LAPACK against the same (`la_libraries`), unless `NEX_BLAS` names other options.
//
// The archive `build-c` writes leaves those symbols to the program's link, so one archive serves
// either choice.
features {
  platform {
    doc     = "the platform's BLAS and LAPACK: Accelerate on macOS, OpenBLAS (-lopenblas) elsewhere"
    enables = ["lapack/platform"]
  }

  openblas {
    doc     = "OpenBLAS, found through openblas.pc — on macOS in place of Accelerate"
    enables = ["lapack/openblas"]
  }
}

choices {
  library { doc = "which BLAS and LAPACK answer the calls", of = [platform, openblas], default = platform }
}
