// The copies an array crossing to C needs where C cannot address it as it lies (DESIGN §10.3): its
// elements gathered into a dense block, nex's first axis fastest, and scattered back after the call.
//
// The array is given by its memref descriptor (`array.sysl`): the allocation, the aligned base, the
// offset, then `rank` sizes and `rank` strides, in elements, the buffer's axes being nex's reversed.

import sysl.raw.ptr_cast

// A dense copy of the array `d` of `size`-byte elements, which `nex_c_scatter` or `nex_c_free` gives
// back.
@export("nex_c_gather")
c_gather(size: long, rank: long, d: *long) -> *u8
    val dense = array_alloc(elements(rank, d) * size)

    walk(size, rank, d, dense, true)
    dense

// A dense copy C only read, given back.
@export("nex_c_free")
c_free(dense: *u8)
    free(dense)

// The dense copy `dense` of the array `d` written back over it, and freed.
@export("nex_c_scatter")
c_scatter(size: long, rank: long, d: *long, dense: *u8)
    walk(size, rank, d, dense, false)
    free(dense)

private elements(rank: long, d: *long) -> long
    var count: long = 1

    for k in 0..<usize(rank)
        count *= d[3 + k]

    count

// Every element of `d` in turn, the buffer's last axis fastest, copied to (`gather`) or from the next
// element of `dense`.
private walk(size: long, rank: long, d: *long, dense: *u8, gather: bool)
    val r = usize(rank)

    if elements(rank, d) == 0 then return

    var index: [16]long = [0; 16]
    val base: *u8 = ptr_cast(usize(d[1]))
    var at: long = 0

    loop
        var a = d[2]

        for k in 0..<r
            a += index[k] * d[3 + r + k]

        for j in 0..<size
            if gather then dense[at * size + j] = base[a * size + j] else base[a * size + j] = dense[at * size + j]

        at += 1

        var k = r

        loop
            if k == 0 then return

            k -= 1
            index[k] += 1

            if index[k] < d[3 + k] then break

            index[k] = 0
