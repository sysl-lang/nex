module sh.sysl.nex_runtime

// Files (DESIGN §17.6): a `File`'s state, the line reader and the write buffer in front of the
// system's file, and the whole-file functions. Both engines run these: the interpreter holds a
// `&NexFile` in its value and calls the functions here directly, and a compiled program reaches them
// through the `nex_file_*` entries at the end, its `File` an object of the counted heap.
//
// **Every operation answers through this thread's outcome**: it sets `FILE_OK`, the end of the input,
// or what went wrong — its status, the path, the system's words and, for text that is not UTF-8, the
// line and column — and the caller's typed IR reads them back (`file_status`, `file_fail_*`) to build
// the `Result` and its `IoError`. A misuse, reading a file opened for writing or using one after
// `close`, is the status `FILE_MISUSE` with the trap's message, which the typed IR traps with.
//
// The system's side is `sysl.fs`: its `File` for the descriptor and the reads, its whole-file
// functions, `exists` and `remove_file`. Writes collect in a buffer here, shared by `print` and
// `write(stdout, …)` for standard output (`text.sysl`'s sinks), and are handed to the system in
// pieces smaller than `sysl.fs`'s own buffer, each followed by its `flush`, so every failure comes
// back as the `IoError` that `flush` answers.

import sysl.buf.{Buf, buf}
import sysl.fs as fs
import sysl.io as sio
import sysl.raw.ptr_cast
import sysl.slices.copy
import sysl.text.{from_utf8, from_utf8_unchecked}

// What the last file operation of a thread came to.
val FILE_OK = 0
// `read_line` at the end of the input.
val FILE_END = 1
val FILE_NOT_FOUND = 2
val FILE_DENIED = 3
// Text that is not UTF-8, at `file_fail_line` and `file_fail_column`.
val FILE_MALFORMED = 4
// Anything else the system reports, in its words (`file_fail_message`).
val FILE_FAILED = 5
// A bug, not an `IoError`: the trap's message is `file_fail_message`.
val FILE_MISUSE = 6

// How a file is open: the prelude's `Mode` by its tag, then the three standard files.
val MODE_READ = 0
val MODE_WRITE = 1
val MODE_APPEND = 2
val MODE_STDIN = 3
val MODE_STDOUT = 4
val MODE_STDERR = 5

// What is read from the system at once, and the most handed to it at once: less than `sysl.fs`'s
// own buffer, so a write is never handed on by `sysl.fs` before the `flush` that reports it.
private const CHUNK: usize = 4096
// What is written before it is handed to the system.
private const HOLD: usize = 8192

// An open file, or one that was: what it was opened as, the system's file (none for standard input
// and the two standard outputs, and for an input read from a string), what was written and not yet
// handed over, what was read and not yet handed out as a line (`held[at..]`), whether the system's
// input has ended, and how many lines have been handed out, which numbers a malformed one.
struct NexFile
    path: string
    mode: int
    os: Option[fs.File]
    shut: bool
    out: Buf[u8]
    held: Buf[u8]
    at: usize
    ended: bool
    lines: long

private new_file(path: string, mode: int, os: Option[fs.File]) -> &NexFile = NexFile(path, mode, os, false, buf(), buf(), 0, false, 0)

// -- the outcome --------------------------------------------------------------------------------------

@thread_local private var status: long = 0
@thread_local private var fail_path = ""
@thread_local private var fail_message = ""
@thread_local private var fail_line: long = 0
@thread_local private var fail_column: long = 0

file_status() -> long = status
file_fail_path() -> string = fail_path
file_fail_message() -> string = fail_message
file_fail_line() -> long = fail_line
file_fail_column() -> long = fail_column

private succeeded()
    status = FILE_OK

private failed(code: int, path: string, message: string)
    status = long(code)
    fail_path = path
    fail_message = message

private malformed(path: string, line: long, column: long)
    failed(FILE_MALFORMED, path, "not UTF-8")
    fail_line = line
    fail_column = column

private misused(message: string)
    failed(FILE_MISUSE, "", message)

// What `sysl.fs` reported about `path`, as nex's outcome: `NotFound`, `Denied`, or `Failed` in the
// system's words.
private reported(path: string, e: fs.IoError) = e match
    NotFound -> failed(FILE_NOT_FOUND, path, "")
    PermissionDenied -> failed(FILE_DENIED, path, "")
    NotPermitted -> failed(FILE_DENIED, path, "")
    _ -> failed(FILE_FAILED, path, e.message())

// The operation on `path` refused: a sandboxed script that no grant lets reach a file, or one
// writing where its grant is for reading only (DESIGN §17.8).
file_denied(path: string) = failed(FILE_DENIED, path, "")

// The outcome `code` set by another part of the runtime (`tables.sysl`), with the line and column a
// `FILE_MALFORMED` is at.
file_set_outcome(code: int, path: string, line: long, column: long, message: string)
    failed(code, path, message)
    fail_line = line
    fail_column = column

// -- beneath a granted directory (DESIGN §17.8) ---------------------------------------------------
//
// Every function here that takes a path also takes `beneath`: `None` for the path as the system
// reads it, or the directory a sandboxed script was granted, which the path is then opened beneath
// through `sysl.fs.Dir`. The kernel confines that opening itself, one component at a time from the
// directory's descriptor, so no `..`, no absolute path and no symbolic link anywhere along the path —
// pointing out of the directory or back into it — is followed. Each such refusal is `Denied`.
//
// Two refusals are this runtime's own, made from a reading of the entry before it is opened: a
// symbolic link as the last component, which `exists` answers false to and `remove` will not delete,
// and a file with more than one hard link, which may be a file outside the directory under a second
// name and is neither read nor written. A link put in place between that reading and the opening is
// still refused by the opening; a second hard link made in between is not, which only a program that
// can already write in the directory can do.

// What a `Dir` reported about `path`: `Denied` where it refused the path as leading out of the
// directory or through a link, else as `reported` says.
private reported_beneath(path: string, e: fs.IoError)
    if e.refused_link() || e.escaped() then failed(FILE_DENIED, path, "") else reported(path, e)

// Whether `path` beneath `d` may be opened, the outcome saying why not where it may not: not a link,
// not a file with a second hard link, and, for `reading`, not a directory. Nothing there yet may be
// opened, to be made or to fail as the opening fails.
private admitted(d: &fs.Dir, path: string, reading: bool) -> bool
    d.link_metadata(path) match
        Ok(m) ->
            if m.is_link() || (m.is_file() && m.links > 1)
                failed(FILE_DENIED, path, "")
                return false

            if reading && m.is_dir()
                failed(FILE_FAILED, path, fs.IoError.IsADirectory.message())
                return false

            true
        Err(e) ->
            if e == fs.IoError.NotFound then return true

            reported_beneath(path, e)
            false

// `path` beneath `d` opened as `mode`, as `file_open` opens one.
private opened_beneath(d: &fs.Dir, path: string, mode: int) -> Option[&NexFile]
    if !admitted(d, path, mode == MODE_READ) then return None

    val opened = if mode == MODE_READ then d.open(path) elif mode == MODE_WRITE then d.create(path) else d.append(path)

    opened match
        Ok(f) ->
            succeeded()
            Some(new_file(path, mode, Some(f)))
        Err(e) ->
            reported_beneath(path, e)
            None

// Every byte of `path` beneath `d`, as `whole` reads a file. The entry is checked first, since the
// directory's own read does not refuse a file with a second hard link.
private whole_beneath(d: &fs.Dir, path: string) -> Option[[]u8]
    if !admitted(d, path, true) then return None

    d.read_bytes(path) match
        Ok(got) ->
            succeeded()
            Some(got)
        Err(e) ->
            reported_beneath(path, e)
            None

// `bytes` made the whole of `path` beneath `d`, or added at its end where `append`: a whole write is
// the directory's own, an append the file opened as `open` opens one with the bytes collected in it.
private written_beneath(d: &fs.Dir, path: string, bytes: []const u8, append: bool)
    if !append
        if !admitted(d, path, false) then return

        d.write_bytes(path, bytes) match
            Ok(_) -> succeeded()
            Err(e) -> reported_beneath(path, e)

        return

    val f = opened_beneath(d, path, MODE_APPEND) match
        Some(f) -> f
        None -> return

    f.out.extend(bytes)
    file_close(f)

// -- opening ------------------------------------------------------------------------------------------

// `path` opened as `mode` (`MODE_READ`, `MODE_WRITE` or `MODE_APPEND`), or `None` with the outcome
// saying why. A directory is not a file to read, though the system opens one.
file_open(path: string, mode: int, beneath: Option[&fs.Dir] = None) -> Option[&NexFile]
    beneath match
        Some(d) -> return opened_beneath(d, path, mode)
        None -> ()

    if mode == MODE_READ && fs.is_dir(path)
        failed(FILE_FAILED, path, fs.IoError.IsADirectory.message())
        return None

    val opened = if mode == MODE_READ then fs.open(path) elif mode == MODE_WRITE then fs.create(path) else fs.append(path)

    opened match
        Ok(f) ->
            succeeded()
            Some(new_file(path, mode, Some(f)))
        Err(e) ->
            reported(path, e)
            None

private var standard: Buf[&NexFile] = buf()

// Standard input (0), output (1) or error (2): one file each, every `stdin` sharing what was read
// ahead.
std_file(k: long) -> &NexFile
    if standard.len() == 0
        standard.push(new_file("stdin", MODE_STDIN, None))
        standard.push(new_file("stdout", MODE_STDOUT, None))
        standard.push(new_file("stderr", MODE_STDERR, None))

    standard[usize(k)]

// A standard input that reads `text` and then ends: a sandboxed script's, which is empty, or a
// host's or a test's own.
text_input(text: string) -> &NexFile
    val f = new_file("stdin", MODE_STDIN, None)

    f.held.extend(text.bytes)
    f.ended = true
    f

// What a `File` prints as inside `File(…)`: its path, or the standard file's name.
file_name(f: &NexFile) -> string = f.path

is_standard_output(f: &NexFile) -> bool = f.mode == MODE_STDOUT || f.mode == MODE_STDERR

private reads(f: &NexFile) -> bool = f.mode == MODE_READ || f.mode == MODE_STDIN

private mode_name(mode: int) -> string = if mode == MODE_READ then "Read" elif mode == MODE_WRITE then "Write" else "Append"

// Whether `what` may use `f`, reading where `reading`; where not, the outcome is the misuse.
private usable(f: &NexFile, what: string, reading: bool) -> bool
    if f.shut
        misused(s"$what on a closed file")
        return false

    if reading == reads(f) then return true

    if f.mode >= MODE_STDIN then misused(s"$what on ${f.path}, which is ${if reading then "written" else "read"}")
    else misused(s"$what on a file opened for ${mode_name(f.mode)}")

    false

// Whether `what` may use `f`, reading where `reading`: the outcome `FILE_OK`, or the misuse. An
// interpreter writing standard output to its host asks this before it writes.
file_usable(f: &NexFile, what: string, reading: bool) -> bool
    if !usable(f, what, reading) then return false

    succeeded()
    true

// -- reading lines --------------------------------------------------------------------------------

// The next line of `f` without its `\n` or `\r\n`, the outcome `FILE_OK`; or `""` with the outcome
// `FILE_END` at the end of the input, or what went wrong. A last line without a newline is still a
// line, and a file ending in a newline has no empty line after it.
file_read_line(f: &NexFile, what: string) -> string
    if !usable(f, what, true) then return ""

    var from = f.at

    loop
        for k in from..<f.held.len()
            if f.held[k] == u8('\n') then return taken_line(f, k, k + 1)

        if f.ended
            if f.at == f.held.len()
                status = FILE_END
                return ""

            return taken_line(f, f.held.len(), f.held.len())

        // What is searched already is not searched again.
        val searched = f.held.len() - f.at

        compact(f)
        from = f.at + searched

        if !filled(f) then return ""
end file_read_line

// The line `held[at..<end]`, a `\r` before its `\n` dropped, handed out with `at` moved to `next`.
private taken_line(f: &NexFile, end: usize, next: usize) -> string
    var stop = end

    if next > end && stop > f.at && f.held[stop - 1] == u8('\r') then stop -= 1

    val bytes = f.held.view()[f.at..<stop]

    f.at = next
    f.lines += 1

    from_utf8(bytes) match
        Ok(_) ->
            succeeded()
            from_utf8_unchecked(bytes).copy()
        Err(e) ->
            malformed(f.path, f.lines, long(e.offset) + 1)
            ""

// What was handed out dropped from the front of the buffer, once it is all of it or a good part.
private compact(f: &NexFile)
    if f.at == 0 then return

    if f.at < f.held.len() && f.at < 65536 then return

    var rest: Buf[u8] = buf()

    rest.extend(f.held.view()[f.at..])
    f.held = rest
    f.at = 0

// More of the input read onto the end of `f.held`, or its end noted; false with the outcome where
// the read failed.
private filled(f: &NexFile) -> bool
    var chunk: [CHUNK]u8 = [0; CHUNK]

    f.os match
        Some(os) ->
            var file = if read_faulty(f.path) then fs.open("/").unwrap() else os
            val got = file.read(chunk[..])

            if got.len == 0
                // A failed read is reported with the system's own reason.
                file.read_failure() match
                    Some(e) ->
                        reported(f.path, e)
                        return false
                    None -> ()

                f.ended = true
            else
                f.held.extend(got)
        None ->
            var input = sio.stdin()
            val got = input.read(chunk[..])

            if got.len == 0
                if input.failed()
                    failed(FILE_FAILED, f.path, "standard input could not be read")
                    return false

                f.ended = true
            else
                f.held.extend(got)

    true
end filled

// -- writing --------------------------------------------------------------------------------------

// `s`, followed by a newline where `line`, written to `f`: collected, and handed to the system once
// enough has. Standard output and error go to the sinks `print` and `eprint` write to.
file_write(f: &NexFile, s: string, line: bool, what: string)
    if !usable(f, what, false) then return

    succeeded()

    if is_standard_output(f)
        val sink: long = if f.mode == MODE_STDOUT then 1 else 2

        put(sink, if line then s + "\n" else s)
        return

    f.out.extend(s.bytes)

    if line then f.out.push(u8('\n'))

    if f.out.len() >= HOLD then _ = handed_over(f)

// What `f` collected handed to the system, in pieces each followed by `sysl.fs`'s `flush`; false
// with the outcome where the system refused one. What could not be handed over is dropped: keeping
// it would only have it fail again.
private handed_over(f: &NexFile) -> bool
    if f.out.len() == 0 then return true

    if faulty(f.path)
        f.out.clear()
        reported(f.path, fs.IoError.NoSpaceLeft)
        return false

    var file = f.os.unwrap()
    var k: usize = 0
    val n = f.out.len()

    while k < n
        val end = if n - k > CHUNK then k + CHUNK else n

        file.write(f.out.view()[k..<end])

        file.flush() match
            Ok(_) -> ()
            Err(e) ->
                f.out.clear()
                reported(f.path, e)
                return false

        if file.failed()
            f.out.clear()
            failed(FILE_FAILED, f.path, "the file could not be written")
            return false

        k = end

    f.out.clear()
    true
end handed_over

// What `f` collected handed to the system now.
file_flush(f: &NexFile)
    if f.shut
        misused("flush on a closed file")
        return

    succeeded()

    if is_standard_output(f) then flush_output()
    elif !reads(f) then _ = handed_over(f)

// `f` flushed and closed, for every reference to it; closing it again does nothing. A standard file
// is flushed and stays open.
file_close(f: &NexFile)
    succeeded()

    if f.shut then return

    if f.mode >= MODE_STDIN
        if is_standard_output(f) then flush_output()
        return

    val written = reads(f) || handed_over(f)

    f.shut = true
    f.held = buf()

    var file = f.os.unwrap()
    val closed = file.close()

    if written
        closed match
            Ok(_) -> ()
            Err(e) -> reported(f.path, e)

// `f` closed as its last reference goes: `""`, or the sentence of the failure, which the caller
// writes as a warning (`dropped_warning`), since nobody is left to hand it to.
file_dropped(f: &NexFile) -> string
    if f.shut || f.mode >= MODE_STDIN then return ""

    file_close(f)

    if status == FILE_OK then return ""

    if status == FILE_NOT_FOUND then s"$fail_path: no such file"
    elif status == FILE_DENIED then s"$fail_path: permission denied"
    else s"$fail_path: $fail_message"

// The line standard error is given for a close that failed as the last reference went (DESIGN
// §17.6); the program goes on.
dropped_warning(message: string) -> string = s"warning: $message\n"

// -- the fault the tests set ---------------------------------------------------------------------------
//
// A test cannot make the system refuse a write on demand — macOS has no `/dev/full` — so the suite
// names a prefix, and every hand-over to the system of a file whose path starts with it fails as a
// full disk would, `NoSpaceLeft`: from sysl with `fail_flushes_under`, from a compiled program by
// linking a constructor that calls `nex_test_fail_flushes`. Nothing else sets it; an empty prefix is
// no fault.
@thread_local private var faulty_prefix = ""
@thread_local private var faulty_c: *u8 = null

fail_flushes_under(prefix: string)
    faulty_prefix = prefix

@export("nex_test_fail_flushes")
fail_flushes_under_c(prefix: *u8)
    faulty_c = prefix

// The same for reads: every read of a file whose path starts with the prefix is made from a directory
// instead, which the system refuses with `IsADirectory` as it does any read that fails. Set from sysl
// with `fail_reads_under`, from a compiled program with `nex_test_fail_reads`.
@thread_local private var faulty_read_prefix = ""
@thread_local private var faulty_read_c: *u8 = null

fail_reads_under(prefix: string)
    faulty_read_prefix = prefix

@export("nex_test_fail_reads")
fail_reads_under_c(prefix: *u8)
    faulty_read_c = prefix

private read_faulty(path: string) -> bool =
    (faulty_read_prefix != "" && path.starts_with(faulty_read_prefix)) || (faulty_read_c != null && path.starts_with(c_text(faulty_read_c)))

private faulty(path: string) -> bool =
    (faulty_prefix != "" && path.starts_with(faulty_prefix)) || (faulty_c != null && path.starts_with(c_text(faulty_c)))

// -- whole files ----------------------------------------------------------------------------------

// The bytes of `path`, or `None` with the outcome.
private whole(path: string, beneath: Option[&fs.Dir]) -> Option[[]u8]
    beneath match
        Some(d) -> return whole_beneath(d, path)
        None -> ()

    if fs.is_dir(path)
        failed(FILE_FAILED, path, fs.IoError.IsADirectory.message())
        return None

    fs.read_bytes(path) match
        Ok(b) ->
            succeeded()
            Some(b)
        Err(e) ->
            reported(path, e)
            None

// Where `b` is not UTF-8, the outcome says so at the line and column of the first byte that is not;
// false then.
private checked_text(path: string, b: []const u8) -> bool
    from_utf8(b) match
        Ok(_) -> true
        Err(e) ->
            var line: long = 1
            var start: usize = 0

            for k in 0..<e.offset
                if b[k] == u8('\n')
                    line += 1
                    start = k + 1

            malformed(path, line, long(e.offset - start) + 1)
            false

// The whole of `path` as text.
file_read_text(path: string, beneath: Option[&fs.Dir] = None) -> string
    whole(path, beneath) match
        Some(b) -> if checked_text(path, b) then from_utf8_unchecked(b).copy() else ""
        None -> ""

// The lines of `path`, as `read_line` reads them.
file_read_lines(path: string, beneath: Option[&fs.Dir] = None) -> Buf[string]
    var out: Buf[string] = buf()

    val b = whole(path, beneath) match
        Some(b) -> b
        None -> return out

    if !checked_text(path, b) then return out

    var start: usize = 0

    for k in 0..<b.len
        if b[k] == u8('\n')
            val stop = if k > start && b[k - 1] == u8('\r') then k - 1 else k

            out.push(from_utf8_unchecked(b[start..<stop]).copy())
            start = k + 1

    if start < b.len then out.push(from_utf8_unchecked(b[start..]).copy())

    out
end file_read_lines

// `bytes` made the whole of `path`, or added at its end where `append`.
file_write_all(path: string, bytes: []const u8, append: bool, beneath: Option[&fs.Dir] = None)
    beneath match
        Some(d) -> return written_beneath(d, path, bytes, append)
        None -> ()

    val r =if append then fs.append_bytes(path, bytes) else fs.write_bytes(path, bytes)

    r match
        Ok(_) -> succeeded()
        Err(e) -> reported(path, e)

// Each of `lines` followed by a newline, made the whole of `path`.
file_write_lines(path: string, lines: []const string, beneath: Option[&fs.Dir] = None)
    var bytes: Buf[u8] = buf()

    for s in lines
        bytes.extend(s.bytes)
        bytes.push(u8('\n'))

    file_write_all(path, bytes.view(), false, beneath)

// Whether anything is at `path`; beneath a directory, anything but a symbolic link, which nothing
// there opens.
file_exists(path: string, beneath: Option[&fs.Dir] = None) -> bool = beneath match
    Some(d) -> d.link_metadata(path) match
        Ok(m) -> !m.is_link()
        Err(_) -> false
    None -> fs.exists(path)

// The file at `path` deleted; beneath a directory, never a symbolic link.
file_remove(path: string, beneath: Option[&fs.Dir] = None)
    val linked = beneath match
        Some(d) -> d.link_metadata(path) match
            Ok(m) -> m.is_link()
            Err(_) -> false
        None -> false

    if linked
        failed(FILE_DENIED, path, "")
        return

    val removed = beneath match
        Some(d) -> d.remove_file(path)
        None -> fs.remove_file(path)

    removed match
        Ok(_) -> succeeded()
        Err(e) -> reported_beneath(path, e)

// The bytes `read_bytes` read, held between the call that reads them and the one that hands them
// to the new array, whole.
@thread_local private var bytes_held: Option[&Buf[u8]] = None

// This thread's held bytes, made the first time it needs them.
private held_bytes() -> &Buf[u8]
    bytes_held match
        Some(b) -> return b
        None -> ()

    val b: &Buf[u8] = buf()

    bytes_held = Some(b)
    b

// The bytes of `path` held for `file_bytes_taken`, and how many there are.
file_read_bytes(path: string, beneath: Option[&fs.Dir] = None) -> long
    val held = held_bytes()

    held.clear()

    whole(path, beneath) match
        Some(b) ->
            held.extend(b)
            long(b.len)
        None -> 0

// The bytes `file_read_bytes` holds, handed over: the storage of the interpreter's new array. The
// thread holds none after.
file_bytes_taken() -> Buf[u8]
    var out: Buf[u8] = buf()

    out.extend(held_bytes().view())
    bytes_held = None
    out

// The bytes `file_read_bytes` holds copied to `dest`, which has room for them all: the storage of the
// compiled program's new array. The thread holds none after.
private bytes_taken_to(dest: *u8)
    val held = held_bytes()

    _ = copy(dest[0..<held.len()], held.view())
    bytes_held = None

// -- the compiled program's entries ----------------------------------------------------------------
//
// A compiled `File` is an object of the counted heap whose payload is a slot of `table`, and whose
// release closes the file once the last reference goes. Where that close fails, standard error is
// given a warning and the program goes on (DESIGN §17.6): a release is a call no frame can be
// abandoned across, so it could not trap even if the failure were one. The three standard files are
// slots 0 to 2, never closed.

private var table: Buf[Option[&NexFile]] = buf()
private var free_slots: Buf[usize] = buf()

private slot_of(p: *u8) -> usize
    val words: *long = ptr_cast(p)

    usize(words[0])

private file_at(p: *u8) -> &NexFile = table[slot_of(p)].unwrap()

// The file a compiled `File` object holds, for another part of the runtime (`tables.sysl`).
file_object(p: *u8) -> &NexFile = file_at(p)

private standard_slots()
    if table.len() == 0
        for k in 0..<3
            table.push(Some(std_file(long(k))))

// The file in `slot` as a new counted object, which the caller owns.
private object_of(slot: usize) -> *u8
    val p = new_object(8, &file_release)
    val words: *long = ptr_cast(p)

    words[0] = long(slot)
    p

private new_slot(f: &NexFile) -> usize
    standard_slots()

    if free_slots.len() > 0
        val k = free_slots.pop().unwrap()

        table[k] = Some(f)
        return k

    table.push(Some(f))
    table.len() - 1

@export("nex_file_release")
file_release(p: *u8)
    val k = slot_of(p)

    if k < 3 then return

    val f = table[k].unwrap()

    table[k] = None
    free_slots.push(k)

    val message = file_dropped(f)

    if message != "" then warned(message)

// Every file still open as the program ends, closed as its last reference going would close it.
files_at_exit()
    for k in 3..<table.len()
        table[k] match
            Some(f) ->
                val message = file_dropped(f)

                if message != "" then warned(message)
            None -> ()

@export("nex_file_std")
file_std(k: long) -> *u8
    standard_slots()
    object_of(usize(k))

@export("nex_file_open")
file_open_c(path: *u8, mode: long) -> *u8
    val slot = opened_slot(c_text(path), int(mode))

    if slot < 0 then null else object_of(usize(slot))

// The slot of `path` opened as `mode`, or -1 with the outcome.
private opened_slot(path: string, mode: int) -> long = file_open(path, mode) match
    Some(f) -> long(new_slot(f))
    None -> -1

@export("nex_file_read_line")
file_read_line_c(f: *u8) -> *u8 = c_string(file_read_line(file_at(f), "read_line"))

@export("nex_file_write")
file_write_c(f: *u8, s: *u8) = file_write(file_at(f), c_text(s), false, "write")

@export("nex_file_write_line")
file_write_line_c(f: *u8, s: *u8) = file_write(file_at(f), c_text(s), true, "write_line")

@export("nex_file_flush")
file_flush_c(f: *u8) = file_flush(file_at(f))

@export("nex_file_close")
file_close_c(f: *u8) = file_close(file_at(f))

@export("nex_file_name")
file_name_c(f: *u8) -> *u8 = c_string(file_name(file_at(f)))

@export("nex_file_read_text")
file_read_text_c(path: *u8) -> *u8 = c_string(file_read_text(c_text(path)))

@export("nex_file_read_lines")
file_read_lines_c(path: *u8) -> *u8 = string_items(file_read_lines(c_text(path)))

@export("nex_file_write_text")
file_write_text_c(path: *u8, s: *u8) = file_write_all(c_text(path), c_text(s).bytes, false)

@export("nex_file_append_text")
file_append_text_c(path: *u8, s: *u8) = file_write_all(c_text(path), c_text(s).bytes, true)

@export("nex_file_write_lines")
file_write_lines_c(path: *u8, lines: *u8) = file_write_lines(c_text(path), item_strings(lines).view())

@export("nex_file_exists")
file_exists_c(path: *u8) -> bool = file_exists(c_text(path))

@export("nex_file_remove")
file_remove_c(path: *u8) = file_remove(c_text(path))

@export("nex_file_read_bytes")
file_read_bytes_c(path: *u8) -> long = file_read_bytes(c_text(path))

@export("nex_file_bytes_taken")
file_bytes_taken_c(dest: *u8) = bytes_taken_to(dest)

// `write_bytes(path, data)`: the `n` bytes from `data`, a dense buffer, made the whole of `path`.
@export("nex_file_write_buffer")
file_write_buffer_c(path: *u8, data: *u8, n: long) = file_write_all(c_text(path), data[0..<usize(n)], false)

@export("nex_file_status")
file_status_c() -> long = file_status()

@export("nex_file_fail_path")
file_fail_path_c() -> *u8 = c_string(fail_path)

@export("nex_file_fail_message")
file_fail_message_c() -> *u8 = c_string(fail_message)

@export("nex_file_fail_line")
file_fail_line_c() -> long = fail_line

@export("nex_file_fail_column")
file_fail_column_c() -> long = fail_column
