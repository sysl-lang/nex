module sh.sysl.nex_runtime

// Traps, and the catching `assert_traps` needs.
//
// A nex trap is raised by generated code calling one of the `nex_trap_*` functions here. With nothing
// catching, it writes its message to standard error and aborts, as the reference's runtime does. Under
// `nex_catch_trap` it returns to the catch instead: the frames between — MLIR-generated ones among
// them — are abandoned, the message is kept for the catcher to read, and the program goes on.
//
// The return is C's `setjmp` and `longjmp`, which is how a nex program's trap crosses frames no
// unwinding table describes. Nothing a sysl frame owns is held across it: the frames abandoned are
// generated code and the trap entries here, and the catcher keeps its state in module storage and in
// a `Mark` of plain addresses. What the generated frames owned — their counts and their arrays'
// storage — the catch gives back as it ends (`unwind.sysl`).

@include("<setjmp.h>")

import sysl.sync.{Acquire, Atomic, Release, SpinLock}

c const
    JMP_BUF_WORDS: usize = "(sizeof(jmp_buf) + sizeof(long long) - 1) / sizeof(long long)"

@needs(os)
extern setjmp(env: *u64) -> int

@abandons
@needs(os)
extern longjmp(env: *u64, v: int) -> never

@needs(os)
extern abort() -> never

// The innermost catch's saved context, and how deep the catches are nested; at depth zero a trap
// aborts. Each catch saves the context it replaces and restores it on the way out. Every thread has
// its own: a `longjmp` never leaves the thread that trapped.
@thread_local private var catch_env: [JMP_BUF_WORDS]u64 = [0; JMP_BUF_WORDS]
@thread_local private var depth = 0
@thread_local private var last_message = ""

trap_with(message: string) -> never
    note_trap(message)
    raise_trap()

// A trap's message, kept for the catch; with nothing catching, written out, and the program ends.
// A message built from values is noted here, in a call that returns, so that no frame holds it across
// the `longjmp` of `raise_trap`.
note_trap(message: string)
    if depth == 0 then
        flush_output()
        put(2, uncaught_text(message))
        abort()

    last_message = message

// The trap raised: what the frames between here and the catch hold given back while they are still
// on the stack, then the return to the catch.
raise_trap() -> never
    abandon()
    longjmp(&catch_env[0], 1)

// The one entry generated code traps through, with the message the compiler wrote for the check
// that failed.
@export("nex_trap")
trap(message: *u8) -> never
    note_trap(c_text(message))
    raise_trap()

// The same for a message built at run time, which the trap releases once it has its text.
@export("nex_trap_owned")
trap_owned(message: *u8) -> never
    note_trap(c_text(message))
    release(message)
    raise_trap()

// The same for a message the compiler wrote with a number to come: each `#` in `message` is `n`,
// as LAPACK's `info` names the pivot or minor that failed.
@export("nex_trap_info")
trap_info(message: *u8, n: long) -> never
    note_trap(with_number(c_text(message), n))
    raise_trap()

private with_number(text: string, n: long) -> string
    var out = ""

    for k in 0..<text.len
        val c = text[k..<k + 1]

        out += if c == "#" then s"$n" else c

    out

@export("nex_trap_complex_div_zero")
trap_complex_div_zero() -> never
    note_trap(COMPLEX_DIVISION_BY_ZERO)
    raise_trap()

// `stop n`: what was printed is written out, and the program ends with status `n`.
@export("nex_stop")
stop(code: int) -> never
    flush_output()
    exit(code)

// The end of `main`: what was printed is written out.
@export("nex_finish")
finish()
    flush_output()

// Run `body`, answering true if it trapped and false if it returned. What it printed before the trap
// stays printed; the trap's message is not written, and `nex_last_trap_message` answers it.
@export("nex_catch_trap")
catch_trap(body: *extern() -> unit) -> bool
    val saved = catch_env
    val mark = open_catch()

    depth += 1

    val trapped = setjmp(&catch_env[0]) != 0

    if !trapped then body()

    depth -= 1
    catch_env = saved
    close_catch(mark)
    trapped

// The same for a nex function value of no parameters: its code, called with its environment.
private catch_closure(code: *extern(*u8) -> unit, env: *u8) -> bool
    val saved = catch_env
    val mark = open_catch()

    depth += 1

    val trapped = setjmp(&catch_env[0]) != 0

    if !trapped then code(env)

    depth -= 1
    catch_env = saved
    close_catch(mark)
    trapped

// `assert_traps(f)` and `assert_traps(f, text)`: `f` must trap, with a message containing `text`
// where one is given (`expected` is null where it is not); otherwise the assertion traps.
@export("nex_assert_traps")
assert_traps(code: *extern(*u8) -> unit, env: *u8, expected: *u8)
    if !catch_closure(code, env)
        note_trap(DID_NOT_TRAP)
        raise_trap()

    if !(expected == null || mentions(expected))
        note_trap(NOT_MENTIONED)
        raise_trap()

private mentions(expected: *u8) -> bool = last_message.contains(c_text(expected))

// The message of the last trap a catch caught, written to standard output on a line of its own.
@export("nex_print_last_trap")
print_last_trap()
    put(1, s"trap: $last_message\n")

// -- parallel regions -------------------------------------------------------------------------------
//
// A `parallel` construct runs as one OpenMP region whose every thread calls `nex_par_run` with the
// region's code (DESIGN §9.5). A trap inside the region must not `longjmp` out of an OpenMP thread,
// so each thread runs the code under a catch of its own: a trap returns to that catch, the first
// trap's message is kept, and `nex_par_stopped` tells the other threads to start no new iteration.
// After the region the thread that started it calls `nex_par_end`, which raises the kept trap there,
// where a catch around the loop (`assert_traps`) or the program's end sees it like any other.

// Whether a trap has ended the region running now, and its message.
private var stopped = Atomic[i32](0)
private var region_message = ""
private var region_lock = SpinLock(0)

@export("nex_par_begin")
par_begin()
    stopped.store(0, Release)
    regions_begin()

// One thread's share of a region: `code(env, worker, workers)` under a catch.
@export("nex_par_run")
par_run(code: *extern(*u8, long, long) -> unit, env: *u8, worker: long, workers: long)
    val saved = catch_env
    val mark = open_catch()

    depth += 1

    val trapped = setjmp(&catch_env[0]) != 0

    if !trapped then code(env, worker, workers)

    depth -= 1
    catch_env = saved
    close_catch(mark)

    if trapped
        region_lock.lock()

        if stopped.load(Acquire) == 0
            region_message = last_message
            stopped.store(1, Release)

        region_lock.unlock()

        // The message is the region's now; a worker thread keeps no copy of its own.
        last_message = ""

// The word that turns nonzero once a trap has ended the region, which generated code reads with an
// atomic load before each iteration: an iteration not yet started does not start.
@export("nex_par_stop_word")
par_stop_word() -> *i32 = &stopped.v

// The region is over: its trap, if one ended it, is raised in the thread that started it.
@export("nex_par_end")
par_end()
    regions_end()

    if stopped.load(Acquire) == 0 then return

    stopped.store(0, Release)
    note_trap(region_message)
    raise_trap()

// -- callbacks --------------------------------------------------------------------------------------
//
// A nex function C calls back (DESIGN §10.2.1) runs through `nex_cb_run`, between the `nex_cb_begin`
// and `nex_cb_end` around the extern call that passed it. A trap inside it must not `longjmp` across
// the C frames between the callback and that call, which no unwinding table describes and which may
// hold what C will give back only by returning. So under a catch a callback runs under one of its
// own, as a parallel region's thread does: the trap's message is kept, every later callback of the
// call returns zero without running, and `nex_cb_end` raises the trap once C has returned. With
// nothing catching, the trap ends the program where it happens, as any trap does.

// How many extern calls passing callbacks this thread is inside, and the trap one of their callbacks
// raised.
@thread_local private var callback_calls = 0
@thread_local private var callback_trapped = false
@thread_local private var callback_message = ""

@export("nex_cb_begin")
cb_begin()
    callback_calls += 1

// The extern call is over: a callback's trap is raised here, in the nex frame that made it.
@export("nex_cb_end")
cb_end()
    callback_calls -= 1

    if !callback_trapped then return

    callback_trapped = false
    note_trap(callback_message)
    callback_message = ""
    raise_trap()

// One callback: `code(env, frame)`, where `frame` holds its arguments and receives its result, which
// is left zero where it does not run. Outside every extern call on this thread — after the call that
// passed it returned, or on a thread C started — there is no nex frame to give a trap back to, so
// the call itself ends the program.
@export("nex_cb_run")
cb_run(code: *extern(*u8, *u8) -> unit, env: *u8, frame: *u8)
    if callback_calls == 0
        flush_output()
        put(2, "trap: a callback was called outside the extern call that passed it: after the call returned, or on a thread of C's own\n")
        abort()

    if callback_trapped then return

    if depth == 0
        code(env, frame)
        return

    val saved = catch_env
    val mark = open_catch()

    depth += 1

    val trapped = setjmp(&catch_env[0]) != 0

    if !trapped then code(env, frame)

    depth -= 1
    catch_env = saved
    close_catch(mark)

    if trapped
        callback_trapped = true
        callback_message = last_message
