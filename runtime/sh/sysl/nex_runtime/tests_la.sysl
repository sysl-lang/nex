module sh.sysl.nex_runtime
@tests

// The linear algebra's sysl functions (`la.sysl`), as the interpreter calls them: the words of every
// failure, which are a compiled program's traps, and the `inout` forms working where their arrays lie.
// That their answers are a compiled program's to the bit is `compiler/tests_la_runtime.sysl`.

import sh.sysl.blas.{MatrixView, Op}

@test("the runtime's linear algebra fails with the words a compiled program traps with")
la_messages()
    val singular = matrix(2, 2, (i, j) -> real(i * j))
    val wide = matrix(2, 3, (i, j) -> real(i + j))
    val indefinite = matrix(2, 2, (i, j) -> if i == j then 1.0 else 2.0)

    assert_eq(la_solve(singular, column([1.0, 1.0])).unwrap_err(), "solve: matrix is singular (U[2,2] = 0)")
    assert_eq(la_solve(wide, column([1.0, 1.0])).unwrap_err(), "solve: the matrix is not square")
    assert_eq(la_solve(indefinite, column([1.0, 1.0, 1.0])).unwrap_err(), "solve: the right-hand side has not the matrix's number of rows")
    assert_eq(la_lstsq(wide, column([1.0])).unwrap_err(), "lstsq: the right-hand side has not the matrix's number of rows")
    assert_eq(la_inv(singular).unwrap_err(), "inv: matrix is singular (U[2,2] = 0)")
    assert_eq(la_inv(wide).unwrap_err(), "inv: the matrix is not square")
    assert_eq(la_det(wide).unwrap_err(), "det: the matrix is not square")
    assert_eq(la_chol(wide, false).unwrap_err(), "chol: the matrix is not square")
    assert_eq(la_chol(indefinite, false).unwrap_err(), "chol: matrix is not positive definite (leading minor 2)")
    assert_eq(la_eigvals(wide).unwrap_err(), "eigvals: the matrix is not square")
    assert_eq(la_eig(wide).unwrap_err(), "eig: the matrix is not square")
    assert_eq(la_eigh(wide).unwrap_err(), "eigh: the matrix is not square")
    assert_eq(la_product(wide, false, Op.NoTrans, wide, false, Op.NoTrans).unwrap_err(), SHAPE_MISMATCH)
    assert_eq(la_product(wide, false, Op.NoTrans, column([1.0, 2.0]), true, Op.NoTrans).unwrap_err(), SHAPE_MISMATCH)
    assert_eq(la_product(column([1.0, 2.0, 3.0]), true, Op.NoTrans, wide, false, Op.NoTrans).unwrap_err(), SHAPE_MISMATCH)
    assert_eq(la_product(column([1.0, 2.0]), true, Op.NoTrans, wide, false, Op.ConjTrans).unwrap_err(), SHAPE_MISMATCH)
    assert_eq(la_dot(column([1.0, 2.0]).col(0), column([1.0]).col(0)).unwrap_err(), SHAPE_MISMATCH)

@test("a singular matrix's determinant is exactly zero, and it factors; an interchange negates the determinant")
la_singular()
    assert_eq(la_det(matrix(2, 2, (i, j) -> real(i * j))).unwrap(), 0.0)
    assert(la_lu(matrix(2, 2, (i, j) -> real(i * j))).is_ok())

    // [[0, 1], [1, 0]] needs one interchange: its determinant is −1, and its permutation, from 1,
    // takes the second row first.
    val swap = matrix(2, 2, (i, j) -> if i == j then 0.0 else 1.0)
    val (_, _, p) = la_lu(swap).unwrap()

    assert_eq(la_det(swap).unwrap(), -1.0)
    assert_eq(p[0], 2)
    assert_eq(p[1], 1)

@test("each product shape answers the product: a matrix by a matrix, a matrix and a vector either way, and every flag")
la_products()
    // A = [[1, 2, 3], [4, 5, 6]], B = [[1, 0], [0, 1], [1, 1]], x = [1, 1, 1], y = [1, 2].
    val a = matrix(2, 3, (i, j) -> real((i - 1) * 3 + j))
    val b = matrix(3, 2, (i, j) -> if i == 3 || i == j then 1.0 else 0.0)

    assert_eq(rows_of(la_product(a, false, Op.NoTrans, b, false, Op.NoTrans).unwrap()), "4 5 / 10 11")
    assert_eq(rows_of(la_product(a, false, Op.Trans, a, false, Op.NoTrans).unwrap()), "17 22 27 / 22 29 36 / 27 36 45")
    assert_eq(rows_of(la_product(a, false, Op.NoTrans, column([1.0, 1.0, 1.0]), true, Op.NoTrans).unwrap()), "6 / 15")
    assert_eq(rows_of(la_product(column([1.0, 2.0]), true, Op.NoTrans, a, false, Op.NoTrans).unwrap()), "9 / 12 / 15")
    assert_eq(rows_of(la_product(column([1.0, 1.0, 1.0]), true, Op.NoTrans, a, false, Op.Trans).unwrap()), "6 / 15")
    assert_eq(rows_of(la_product(column([1.0, 1.0, 1.0]), true, Op.NoTrans, a, false, Op.ConjTrans).unwrap()), "6 / 15")
    assert_eq(la_dot(column([1.0, 2.0, 3.0]).col(0), column([4.0, 5.0, 6.0]).col(0)).unwrap(), 32.0)

@test("the runtime's inout forms answer LAPACK's info, refuse storage too small, and work where the arrays lie")
la_in_place()
    var store: []real = [0.0; 16]
    val big = MatrixView.of(store, 4, 4).unwrap()

    // The 2 × 2 block at (1, 1) of a 4 × 4 matrix, its columns 4 apart, holding [[1, 2], [2, 4]].
    val block = big.block(1, 1, 2, 2).unwrap()

    block.set(0, 0, 1.0)
    block.set(0, 1, 2.0)
    block.set(1, 0, 2.0)
    block.set(1, 1, 4.0)

    var ipiv: []i32 = [0; 2]

    assert_eq(la_lu_inplace(block, ipiv).unwrap(), 2)
    assert_eq(ipiv[0], 2)
    assert_eq(store[5], 2.0)
    assert_eq(store[0], 0.0)
    assert_eq(store[15], 0.0)

    var short: []i32 = [0; 1]

    assert_eq(la_lu_inplace(block, short).unwrap_err(), LU_PIVOTS)
    assert_eq(la_solve_inplace(block, short, column([1.0, 1.0])).unwrap_err(), SOLVE_PIVOTS)
    assert_eq(la_solve_inplace(block, ipiv, column([1.0])).unwrap_err(), "solve_inplace: the right-hand side has not the matrix's number of rows")
    assert_eq(la_solve_inplace(matrix(2, 3, (i, j) -> 1.0), ipiv, column([1.0, 1.0])).unwrap_err(), "solve_inplace: the matrix is not square")
    assert_eq(la_chol_inplace(matrix(2, 3, (i, j) -> 1.0), false).unwrap_err(), "chol_inplace: the matrix is not square")
    assert_eq(la_chol_inplace(matrix(2, 2, (i, j) -> if i == j then 1.0 else 2.0), false).unwrap(), 2)

    var tau: []real = [0.0; 1]

    assert_eq(la_qr_inplace(matrix(3, 2, (i, j) -> real(i + j)), tau).unwrap_err(), QR_TAU)

    // diag(2, 4) x = [3, 5].
    val b = column([3.0, 5.0])

    assert_eq(la_solve_inplace(matrix(2, 2, (i, j) -> if i == j then real(2 * i) else 0.0), ipiv, b).unwrap(), 0)
    assert_eq(b.at(0, 0), 1.5)
    assert_eq(b.at(1, 0), 1.25)

// A dense m × n matrix whose element (i, j), from 1, is `at(i, j)`.
private matrix(m: usize, n: usize, at: (usize, usize) -> real) -> MatrixView[real]
    var xs: []real = [0.0; m * n]

    for j in 0..<n
        for i in 0..<m do xs[i + j * m] = at(i + 1, j + 1)

    MatrixView.of(xs, m, n).unwrap()

// A vector as the runtime takes one: one column.
private column(xs: []real) -> MatrixView[real] = MatrixView.of(xs, xs.len, 1).unwrap()

// `m`'s rows, `/` between them, each element a whole number.
private rows_of(m: MatrixView[real]) -> string
    var out = ""

    for i in 0..<m.rows
        if i > 0 then out += " / "

        for j in 0..<m.cols
            if j > 0 then out += " "
            out += s"${long(m.at(i, j))}"

    out
