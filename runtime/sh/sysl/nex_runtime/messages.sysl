module sh.sysl.nex_runtime

// The words of the traps and the text of the values both engines share. The compiler writes these
// messages into the checks it emits, the runtime raises them, and the interpreter returns them as
// values, so a trap reads the same whichever engine ran the program; and a value printed or
// interpolated is spelled here once.

import sysl.fmt.{format_int, format_real, format_str}

// An integer type's name: `int8`, `uint64`.
int_name(bits: int, signed: bool) -> string = if signed then s"int$bits" else s"uint$bits"

// An integer result outside its type's range.
overflow_message(bits: int, signed: bool) -> string = s"${int_name(bits, signed)} overflow"

// A conversion whose value is outside the target's range, between types named as nex names them.
out_of_range_message(from: string, to: string) -> string = s"$from value out of range for $to"

val INT_DIVISION_BY_ZERO = "integer division by zero"
val REMAINDER_BY_ZERO = "`%` by zero"
val COMPLEX_DIVISION_BY_ZERO = "complex division by zero"

// Under `--fpe-trap` (DESIGN §2.5).
val REAL_DIVISION_BY_ZERO = "floating-point division by zero"
val REAL_INVALID = "floating-point invalid operation"
val REAL_OVERFLOW = "floating-point overflow"

val ZERO_STEP = "a `for` step of 0"

// Arrays (DESIGN §3–§7).
val INDEX_OUT_OF_BOUNDS = "index out of bounds"
val SLICE_OUT_OF_BOUNDS = "slice out of bounds"
val ZERO_SLICE_STRIDE = "a slice stride of 0"
val ZERO_RANGE_STEP = "a range step of 0"
val SHAPE_MISMATCH = "shape mismatch"
val SLICE_LENGTH_MISMATCH = "slice assignment length mismatch"
val NOT_AN_AXIS = "not an axis of the array"
val NEGATIVE_EXTENT = "a negative extent"
val RESHAPE_SIZE = "reshape to a different size"
val NOT_A_PERMUTATION = "not a permutation of the axes"

val ASSERTION_FAILED = "assertion failed"
val ASSERT_EQ_FAILED = "assert_eq failed"
val DID_NOT_TRAP = "assert_traps: the function did not trap"
val NOT_MENTIONED = "assert_traps: expected substring not present in trap"

// Operands of `@` or of an elementwise operation whose extents do not agree.
val SHAPE_MISMATCH = "shape mismatch"

// -- the linear-algebra prelude (DESIGN §10.5) -------------------------------------------------------

// `name`'s matrix has not as many rows as columns.
not_square_message(name: string) -> string = s"$name: the matrix is not square"

// `name`'s right-hand side has not as many rows as its matrix.
rows_message(name: string) -> string = s"$name: the right-hand side has not the matrix's number of rows"

// LAPACK's `info` above zero, by what it means for the routine `name` called: a zero pivot `U[i,i]`,
// the leading minor of order `i` not positive definite, or an iteration that did not converge.
singular_message(name: string, i: long) -> string = s"$name: matrix is singular (U[$i,$i] = 0)"

indefinite_message(name: string, i: long) -> string = s"$name: matrix is not positive definite (leading minor $i)"

unconverged_message(name: string) -> string = s"$name: did not converge"

// LAPACK's `info` below zero: the argument at `position` of `routine` refused, which no well-typed
// call makes.
refused_message(name: string, routine: string, position: long) -> string = s"$name: LAPACK's $routine refused its argument $position"

val LU_PIVOTS = "lu_inplace: ipiv holds fewer than min(m, n) pivots"
val QR_TAU = "qr_inplace: tau holds fewer than min(m, n) elements"
val SOLVE_PIVOTS = "solve_inplace: ipiv holds fewer pivots than the matrix has rows"

// `assert(c, text)` failing.
assertion_message(text: string) -> string = s"$ASSERTION_FAILED: $text"

// `args[k]` past the arguments there are, `count` of them.
arg_index_message(k: long, count: long) -> string = s"index $k out of bounds 1..$count"

// What a trap nothing catches writes to standard error before the program aborts.
uncaught_text(message: string) -> string = s"trap: $message\n"

// -- the text of a value ----------------------------------------------------------------------------

// An integer of any width, its value widened to 64 bits by its own signedness; a `uint64` is
// `uint_text`'s.
int_text(v: long) -> string = s"$v"

uint_text(v: ulong) -> string = s"$v"

bool_text(v: bool) -> string = if v then "true" else "false"

// `${n}%08x`: an integer of `bits` bits, its value arriving widened to 64 by its own signedness.
int_spec_text(v: long, bits: int, signed: bool, spec: string) -> string =
    format_int(if signed then i128(v) else i128(ulong.wrap(v)), bits, spec, 0, 0)

// `${x}%.3f`: a real of any width, widened exactly to `real64`.
real_spec_text(v: real, spec: string) -> string = format_real(v, spec, 0, 0)

// `${s}%-8s`: any value's text, through the width and precision a string takes.
str_spec_text(s: string, spec: string) -> string = format_str(s, spec, 0, 0)

// -- the text of an aggregate -----------------------------------------------------------------------

// The pieces `print` writes around an aggregate's fields (DESIGN §11.4): a tuple `(1, a)`, a struct
// `Point { x=1.0, y=2.0 }`, a variant `Converged(3.14)` or `Diverged`. Each field is spelled as `print`
// spells it alone, between these.
val TUPLE_OPEN = "("
val TUPLE_CLOSE = ")"
val FIELD_SEPARATOR = ", "
val STRUCT_CLOSE = " }"

// The brackets `print` writes around each axis of an array, nex axis 1 outermost: `[1, 2]`,
// `[[1, 2], [3, 4]]`; the elements between them separated by `FIELD_SEPARATOR`.
val ARRAY_OPEN = "["
val ARRAY_CLOSE = "]"

// A struct's text up to its first field, `name` being the struct's own, without its module or type
// arguments.
struct_open(name: string) -> string = s"$name { "

// What comes before a struct's field: `x=`.
field_label(name: string) -> string = s"$name="
