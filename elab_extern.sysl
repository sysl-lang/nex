// `extern def`: a C function declared and called (DESIGN §10, §13.7).
//
// **An extern's signature is resolved before any body is elaborated**, since it has no body to infer
// a result from. **Its parameters and result never carry a unit**: a C function takes the number, so
// a caller passes `strip(x)` and gives the result a unit by multiplying.
//
// **What crosses is DESIGN §10.2's table**: integers, reals, complexes and `bool` by value (by
// pointer as `inout`), a `string` read-only, an array of numbers or `bool` as a pointer to its first
// element, a `@c` struct by pointer, a function as a callback with `c_ptr` as its `@data` partner. A
// result is a scalar, a complex or nothing. The attributes say the rest: `@link` and `@symbol` on the
// declaration, `@pure`, `@strided` on an array parameter.

import sysl.buf.{Buf, buf}
import sh.sysl.parsing.Span

// An `extern def` as written.
struct ExternSrc
    decl: Decl
    name: string
    params: Buf[Param]
    ret: Option[Type]

impl Elab
    // The `k`th extern's parameter and result types and what its attributes say.
    resolve_extern(*self, k: usize)
        val x = self.externs[k]
        var tys: Buf[Ty] = buf()
        var modes: Buf[Mode] = buf()
        var names: Buf[string] = buf()
        var strided: Buf[bool] = buf()
        var partner: Buf[Option[usize]] = buf()

        self.in_extern = true

        for p in x.params
            if contains(names, p.name) then self.fail(x.decl.span, s"redeclaration of `${p.name}`")
            if p.default.is_some() then self.fail(p.typ.span, "an `extern` parameter has no default")

            val ty = self.resolve_type(p.typ)

            if carries_unit(ty) then self.fail(p.typ.span, s"an `extern` parameter never carries a unit: C takes the number, so declare it ${show_ty(stripped(ty))} and pass `strip(x)`")
            else self.check_crossing(p, ty)

            names.push(p.name)
            tys.push(ty)
            modes.push(p.mode)
            strided.push(self.strided_attr(p, ty))

        // A `@data(f)` partner names a parameter of function type, which may stand after it.
        for j in 0..<x.params.len()
            partner.push(self.data_partner(x.params[j], tys[j], names, tys))

        val ret = x.ret match
            Some(t) ->
                val r = self.resolve_type(t)

                if carries_unit(r) then self.fail(t.span, s"an `extern` result never carries a unit: declare it ${show_ty(stripped(r))} and give the result its unit by multiplying, `${x.name}(...) * 1.0<${spell(elem_unit(r))}>`")
                elif !c_scalar(r) && !is_error(r) then self.fail(t.span, s"an `extern` returns a number, a `bool`, a complex or nothing, and ${show_ty(r)} does not cross back from C")
                r
            None -> Void

        self.in_extern = false

        var symbol = x.name
        var links: Buf[string] = buf()
        var frameworks: Buf[string] = buf()
        var pure = false
        var named = false

        for a in x.decl.attrs
            if a.name == "link"
                if a.args.len() != 1 then self.fail(x.decl.span, LINK_FORM)
                else a.args[0] match
                    Str(lib) -> links.push(lib)
                    Named(n, v) -> if n == "framework" then frameworks.push(v) else self.fail(x.decl.span, LINK_FORM)
                    _ -> self.fail(x.decl.span, LINK_FORM)
            elif a.name == "symbol"
                if named then self.fail(x.decl.span, s"`${x.name}` has one C symbol, and `@symbol` is given twice")

                named = true

                if a.args.len() != 1 then self.fail(x.decl.span, SYMBOL_FORM)
                else a.args[0] match
                    Str(s) -> symbol = s
                    _ -> self.fail(x.decl.span, SYMBOL_FORM)
            elif a.name == "pure"
                if a.args.len() > 0 then self.fail(x.decl.span, "`@pure` takes no arguments")

                pure = true
            elif a.name == "fortran"
                self.later(x.decl.span, "a `@fortran` extern")
            else
                self.fail(x.decl.span, s"`@${a.name}` is not an attribute of an `extern def`, which takes `@link`, `@symbol`, `@pure` and `@fortran`")

        for j in 0..<k
            if self.xout[j].symbol == symbol then self.fail(x.decl.span, s"`${x.name}` and `${self.xout[j].name}` both name the C symbol `${symbol}`")

        self.xout.push(TExtern(x.decl.span, x.name, tys, modes, ret, symbol, links, frameworks, pure, strided, partner))
    end resolve_extern

    // Whether a parameter of type `ty` crosses to C as DESIGN §10.2 says, and if not, why.
    private check_crossing(*self, p: Param, ty: Ty)
        if is_error(ty) || c_scalar(ty) then return

        base_of(ty) match
            Str -> if p.mode == Inout then self.fail(p.typ.span, s"a `string` crosses to C as a `const char *` it may not write, so `${p.name}` cannot be `inout`")
            Array(_, _) ->
                if !c_scalar(elem_of(ty)) then self.fail(p.typ.span, s"an array crosses to C as a pointer to its elements, which must be numbers or `bool`, and ${show_ty(ty)} holds ${show_ty(elem_of(ty))}")
            Nominal(name, _) ->
                if !self.is_c_struct(ty) then self.fail(p.typ.span, s"a struct crosses to C by pointer only where it is declared `@c`, which lays it out as C does, and `${name}` is not")
            Fn(_) -> if p.mode == Inout then self.fail(p.typ.span, s"a callback crosses to C as a function pointer, so `${p.name}` cannot be `inout`")
            CPtr -> if p.mode == Inout then self.fail(p.typ.span, s"a `c_ptr` is a callback's user data, passed by value, so `${p.name}` cannot be `inout`")
            _ -> self.fail(p.typ.span, s"${show_ty(ty)} does not cross to C: an `extern` takes numbers, `bool`, `string`, arrays of numbers, `@c` structs and callbacks")

    // Whether the parameter is marked `@strided`, which only an array parameter may be.
    private strided_attr(*self, p: Param, ty: Ty) -> bool
        var marked = false

        for a in p.attrs
            if a.name == "strided"
                if a.args.len() > 0 then self.fail(p.typ.span, "`@strided` takes no arguments")
                elif !is_array(ty) && !is_error(ty) then self.fail(p.typ.span, s"`@strided` passes an array's view as it lies, and `${p.name}` is not an array")

                marked = true
            else
                self.fail(p.typ.span, s"`@${a.name}` is not an attribute of an `extern` parameter, which takes `@strided`")

        marked

    // The function parameter a `c_ptr` parameter's `@data(f)` names, by number; a `c_ptr` has one,
    // and nothing else does.
    private data_partner(*self, p: Param, ty: Ty, names: Buf[string], tys: Buf[Ty]) -> Option[usize]
        var out: Option[usize] = None

        for a in p.type_attrs
            if a.name != "data"
                self.fail(p.typ.span, s"`@${a.name}` is not an attribute of an `extern` parameter's type, which takes `@data(f)`")
                continue

            val f = if a.args.len() == 1 then (a.args[0] match
                Name(n) -> n
                _ -> "") else ""

            if f == ""
                self.fail(p.typ.span, "`@data` names the callback parameter its user data goes with, `@data(f)`")
                continue

            for j in 0..<names.len()
                if names[j] == f then out = Some(j)

            out match
                Some(j) -> if !is_callback(tys[j]) then self.fail(p.typ.span, s"`@data(${f})` names the callback its user data goes with, and `${f}` is ${show_ty(tys[j])}, not a function")
                None -> self.fail(p.typ.span, s"`@data(${f})` names no parameter of this `extern`")

        val is_ptr = base_of(ty) match
            CPtr -> true
            _ -> false

        if is_ptr && out.is_none() && p.type_attrs.len() == 0 then self.fail(p.typ.span, s"a `c_ptr` is a callback's user data: declare `${p.name}: @data(f) c_ptr`, naming the callback parameter it goes with")
        elif !is_ptr && out.is_some() then self.fail(p.typ.span, s"a `@data` parameter is C's `void *` for its callback's user data, so `${p.name}` is declared `c_ptr`")

        out

    // Whether `ty` is a struct declared `@c`.
    is_c_struct(self, ty: Ty) -> bool = base_of(ty) match
        Nominal(name, args) ->
            if args.len() > 0 then return false

            self.find_struct(name) match
                Some(k) -> has_attr(self.agg.structs[k].decl.attrs, "c")
                None -> false
        _ -> false

    // Every struct's attributes: `@c` is the one, and a `@c` struct's fields are what C lays out —
    // numbers, `bool` and other `@c` structs.
    check_c_structs(*self)
        for s in self.agg.structs
            for a in s.decl.attrs
                if a.name != "c" then self.fail(s.decl.span, s"`@${a.name}` is not an attribute of a struct, which takes `@c`")
                elif a.args.len() > 0 then self.fail(s.decl.span, "`@c` takes no arguments")

            if !has_attr(s.decl.attrs, "c") then continue

            if s.generic
                self.fail(s.decl.span, s"a `@c` struct is laid out as C lays it out, so `${s.name}` cannot be generic")
                continue

            for f in s.fields
                if !c_scalar(f.ty) && !self.is_c_struct(f.ty) && !is_error(f.ty) then self.fail(s.decl.span, s"a `@c` struct holds numbers, `bool` and `@c` structs, as C lays them out, and its field `${f.name}` is ${show_ty(f.ty)}")

    extern_type(self, k: usize) -> Ty = fn_type(self.xout[k].params, self.xout[k].modes, self.xout[k].ret)

    // A call of the `k`th extern: positional arguments, each a plain number where it is one.
    call_extern(*self, span: Span, at: Span, k: usize, args: Buf[Expr]) -> TExpr
        val x = self.xout[k]

        for t in x.params
            if is_callback(t)
                self.later(span, "a call of an `extern` taking a callback")
                return self.invalid(span)

        if args.len() != x.params.len()
            self.fail(span, s"`${x.name}` takes ${x.params.len()} argument${if x.params.len() == 1 then "" else "s"}, and ${args.len()} ${if args.len() == 1 then "is" else "are"} given")
            return self.invalid(span)

        var out: Buf[TExpr] = buf()

        for j in 0..<args.len()
            val a = args[j]
            val ty = x.params[j]

            *a.kind match
                NamedArg(_, _) ->
                    self.fail(a.span, s"an `extern` takes its arguments by position")
                    out.push(self.invalid(a.span))
                    continue
                _ -> ()

            if x.modes[j] == Inout
                out.push(self.borrow(a, ty, ""))
                continue

            val v = self.elab(a, Some(ty))

            if carries_unit(v.ty)
                self.fail(a.span, s"`${x.name}` is an `extern`, whose parameters never carry a unit; pass the number: `${x.name}(strip(x))`")
                out.push(self.invalid(a.span))
            else
                out.push(self.coerce(v, ty, s"argument ${j + 1}"))

        texpr(span, x.ret, TCall(texpr(at, self.extern_type(k), TFnRef(x.name)), out))
    end call_extern
end Elab

private val LINK_FORM = "`@link` names a library, `@link(\"m\")`, or a framework, `@link(framework = \"Accelerate\")`"
private val SYMBOL_FORM = "`@symbol` names the C symbol, `@symbol(\"dgesv_\")`"

// Whether a value of `ty` crosses to C as itself: an integer of 8 to 64 bits, a `real16`, `real32` or
// `real64`, a complex of `real32` or `real64` parts, or a `bool`.
c_scalar(ty: Ty) -> bool = ty match
    Int(b, _) -> b == 8 || b == 16 || b == 32 || b == 64
    Real(b) -> b == 16 || b == 32 || b == 64
    Complex(b) -> b == 32 || b == 64
    Bool -> true
    _ -> false

private is_callback(ty: Ty) -> bool = base_of(ty) match
    Fn(_) -> true
    _ -> false

private has_attr(attrs: Buf[Attribute], name: string) -> bool
    for a in attrs
        if a.name == name then return true

    false
