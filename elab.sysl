// The elaborator: the tree the parser builds to the typed IR of `tir.sysl`.
//
// **It works on demand.** The top level is first collected, every name once, so a declaration may
// use one written after it. Then each declaration is elaborated in source order, and whenever one
// needs something not yet known — a module-level binding's type, a function's result type where the
// function does not declare it — that declaration is elaborated there and then. A declaration that
// is reached again while it is being elaborated depends on itself, which is reported.
//
// **The state of the body being elaborated is one value, `Fx`**: the names in scope, the loops an
// `exit` may leave, and a stack of frames, one for the function and one for each lambda inside it.
// Elaborating some other declaration on demand sets it aside and gives that declaration an empty one.
// A lambda whose parameter types come from its first call keeps a copy of the `Fx` it was written
// in, and is elaborated inside that copy when the call is reached.
//
// **A mistake is reported once.** What could not be typed has the type `Error`, which every check
// accepts, so one unknown name gives one diagnostic and not one at every operator it reaches.
//
// The expressions are elaborated in `elab_expr.sysl`, the calls in `elab_call.sysl` and the prelude
// in `elab_prelude.sysl`.

import sysl.buf.{Buf, buf}
import sh.sysl.parsing.{Diagnostic, Span, error, nearest_name}

// The whole program, or every diagnostic it earned.
elaborate(p: Program) -> Result[TProgram, Buf[Diagnostic]]
    var e = elab(p)

    e.run()

    if e.diags.len() > 0 then return Err(e.diags)

    Ok(e.program())

private elab(p: Program) -> Elab =
    Elab(p, buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), empty_fx(), buf(), buf(), empty_units())

// How far a declaration has got.
enum Progress
    Waiting
    Working
    Finished

// What a top-level name denotes: the `k`th module-level binding, function or extern.
enum TopKind
    TopValue(k: usize)
    TopFun(k: usize)
    TopExtern(k: usize)

struct Top
    name: string
    kind: TopKind

// A module-level `val`, `var` or `const` as written.
struct GlobalSrc
    decl: Decl
    name: string
    kind: BindKind
    typ: Option[Type]
    init: Expr

// A function's parameters once their types are resolved: each one's local, name, type, mode and
// default.
struct Sig
    params: Buf[usize]
    names: Buf[string]
    tys: Buf[Ty]
    modes: Buf[Mode]
    defaults: Buf[Option[TExpr]]

// A `def` as written, with the names of its unit parameters (`[U: Unit]`).
struct FunSrc
    decl: Decl
    name: string
    params: Buf[Param]
    ret: Option[Type]
    body: Expr
    uparams: Buf[string]

struct ScopeEntry
    name: string
    local: usize

// One function or lambda being elaborated: the lambda it is (none for a top-level function), its
// result type and whether that is known yet, and where its loops begin in `Fx.loops`.
struct Frame
    lambda: Option[usize]
    ret: Ty
    ret_known: bool
    loop_base: usize

struct Fx
    scope: Buf[ScopeEntry]
    // Where each open block's names begin in `scope`.
    marks: Buf[usize]
    // The loops around the cursor, innermost last.
    loops: Buf[usize]
    frames: Buf[Frame]
    // Inside a `const` initializer, where a module-level `var` may not be read.
    in_const: bool

empty_fx() -> Fx = Fx(buf(), buf(), buf(), buf(), false)

// A lambda bound by `val f = x -> ...` whose parameter types are not written: it is elaborated at
// the first use that fixes them, inside the copy of the scope it was written in.
struct Pending
    local: usize
    lambda: usize
    span: Span
    params: Buf[LambdaParam]
    body: Expr
    saved: Fx

// A local a lambda captures.
struct Capture
    lambda: usize
    local: usize

struct Elab
    prog: Program
    diags: Buf[Diagnostic]
    tops: Buf[Top]

    globals: Buf[GlobalSrc]
    gstate: Buf[Progress]
    gty: Buf[Ty]
    gout: Buf[TGlobal]

    funs: Buf[FunSrc]
    fsig: Buf[Sig]
    fret: Buf[Ty]
    fret_known: Buf[bool]
    fstate: Buf[Progress]
    fout: Buf[TFun]

    locals: Buf[LocalInfo]
    // The frame depth each local was bound at, which is what decides whether a lambda captures it.
    depth: Buf[usize]
    lambdas: Buf[TLambda]
    captures: Buf[Capture]
    loops: Buf[TLoop]
    pending: Buf[Pending]
    fx: Fx

    externs: Buf[ExternSrc]
    xout: Buf[TExtern]
    units: Units

    // -- diagnostics ------------------------------------------------------------------------------

    fail(*self, span: Span, message: string)
        self.diags.push(error(span, message))

    // A construct whose elaboration belongs to a part of the language the elaborator does not
    // handle yet: arrays, tuples, structs, enums, generics, units, parallelism.
    later(*self, span: Span, what: string)
        self.fail(span, s"${what} is not elaborated yet")

    // An expression of type `Error`, standing where the diagnostic was given.
    invalid(*self, span: Span) -> TExpr = texpr(span, Error, TInvalid)

    // -- the top level ----------------------------------------------------------------------------

    run(*self)
        self.collect()
        self.resolve_units()

        for k in 0..<self.externs.len()
            self.resolve_extern(k)

        for k in 0..<self.funs.len()
            self.ensure_sig(k)

        for top in self.tops
            top.kind match
                TopValue(k) -> self.ensure_global(k)
                TopFun(k) -> self.ensure_body(k)
                TopExtern(_) -> ()

        self.check_main()
    end run

    find_top(self, name: string) -> Option[TopKind]
        for t in self.tops
            if t.name == name then return Some(t.kind)

        None

    // Every top-level declaration, by name, in source order.
    collect(*self)
        self.load_prelude_units()

        for d in self.prog.decls
            *d.kind match
                Bind(kind, pat, typ, init) ->
                    *pat.kind match
                        Name(name) ->
                            if self.declare(d.span, name)
                                self.tops.push(Top(name, TopValue(self.globals.len())))
                                self.globals.push(GlobalSrc(d, name, kind, typ, init))
                                self.gstate.push(Waiting)
                                self.gty.push(Error)
                        _ ->
                            self.later(pat.span, "a destructuring binding")

                            // Its names are declared, untyped and already finished, so their uses
                            // are not reported too.
                            for n in pattern_names(pat)
                                if self.declare(d.span, n)
                                    self.tops.push(Top(n, TopValue(self.globals.len())))
                                    self.globals.push(GlobalSrc(d, n, kind, typ, init))
                                    self.gstate.push(Finished)
                                    self.gty.push(Error)
                Fun(name, tparams, params, ret, body) ->
                    val uparams = unit_params(tparams)

                    if uparams.len() < tparams.len() then
                        self.later(d.span, "a generic function")
                    elif d.attrs.len() > 0 then
                        self.later(d.span, s"the attribute `@${d.attrs[0].name}`")
                    else
                        body match
                            Some(b) ->
                                if self.declare(d.span, name)
                                    self.tops.push(Top(name, TopFun(self.funs.len())))
                                    self.funs.push(FunSrc(d, name, params, ret, b, uparams))
                                    self.fret.push(Error)
                                    self.fret_known.push(false)
                                    self.fstate.push(Waiting)
                            None -> self.fail(d.span, s"`${name}` has no body")
                Extern(name, params, ret) ->
                    if d.attrs.len() > 0
                        self.later(d.span, s"the attribute `@${d.attrs[0].name}`")
                    elif self.declare(d.span, name)
                        self.tops.push(Top(name, TopExtern(self.externs.len())))
                        self.externs.push(ExternSrc(d, name, params, ret))
                Struct(_, _, _) -> self.later(d.span, "a struct")
                Enum(_, _, _) -> self.later(d.span, "an enum")
                Module(_) -> self.later(d.span, "a module declaration")
                Import(_, _, _) -> self.later(d.span, "an import")
                UnitDecl(name, factor, body) -> self.declare_unit(d.span, name, factor, body)
    end collect

    // Whether `name` is free at the top level; if not, says so.
    declare(*self, span: Span, name: string) -> bool
        if self.find_top(name).is_some()
            self.fail(span, s"redeclaration of `${name}`")
            return false

        true

    // The program `main` must be (DESIGN §11.2): `def main()` or `def main(args: [string])`,
    // returning nothing.
    check_main(*self)
        val k = self.find_top("main") match
            Some(TopFun(k)) -> k
            Some(TopValue(k)) ->
                self.fail(self.globals[k].decl.span, "`main` must be a function: `def main()` or `def main(args: [string])`")
                return
            Some(TopExtern(k)) ->
                self.fail(self.externs[k].decl.span, "`main` is the program's own function, not an `extern`: `def main()` or `def main(args: [string])`")
                return
            None ->
                self.fail(Span(0, 0), "a program needs a `def main()` or a `def main(args: [string])`")
                return

        val sig = self.fsig[k]
        val span = self.funs[k].decl.span
        var shaped = sig.tys.len() == 0

        if sig.tys.len() == 1
            val strings = sig.tys[0] match
                Array(elem, axes) -> axes.len() == 1 && ty_eq(*elem, Str) && is_dynamic(axes[0])
                _ -> false

            shaped = strings && sig.modes[0] == Read && sig.defaults[0].is_none()

        if !shaped
            self.fail(span, "`main` takes no parameters or `args: [string]`: `def main()` or `def main(args: [string])`")
        elif self.fret_known[k] && !is_void(self.fret[k]) && !is_wild(self.fret[k])
            self.fail(span, s"`main` returns nothing, but this one returns ${show_ty(self.fret[k])}")
    end check_main

    // -- module-level bindings --------------------------------------------------------------------

    ensure_global(*self, k: usize)
        if self.gstate[k] != Waiting then return

        self.gstate.set(k, Working)

        val g = self.globals[k]
        val saved = self.fx
        self.fx = empty_fx()
        self.fx.in_const = g.kind == Const

        val init = g.typ match
            Some(t) -> self.check(g.init, self.resolve_type(t), "this binding")
            None -> self.bound_value(g.init, g.name)

        self.fx = saved
        self.gty.set(k, init.ty)
        self.gout.push(TGlobal(g.decl.span, g.name, g.kind, self.gty[k], init))
        self.gstate.set(k, Finished)
    end ensure_global

    // The type of a module-level binding, elaborating it first where it has not been.
    global_type(*self, k: usize, span: Span) -> Ty
        if self.gstate[k] == Working
            self.fail(span, s"`${self.globals[k].name}` is used in its own initializer")
            return Error

        self.ensure_global(k)
        self.gty[k]

    // -- functions --------------------------------------------------------------------------------

    // A function's parameter types, modes and defaults, and its result type where it declares one.
    ensure_sig(*self, k: usize)
        val f = self.funs[k]
        var sig = Sig(buf(), buf(), buf(), buf(), buf())
        val saved = self.fx
        val saved_units = self.enter_unit_params(f.uparams)
        self.fx = empty_fx()

        for p in f.params
            if sig.names.len() > 0 && contains(sig.names, p.name)
                self.fail(f.decl.span, s"redeclaration of `${p.name}`")

            val ty = self.resolve_type(p.typ)
            val default = p.default match
                Some(d) ->
                    if p.mode == Inout then self.fail(d.span, "an `inout` parameter cannot have a default")

                    Some(self.check(d, ty, "this default"))
                None -> None

            sig.params.push(self.new_local(p.name, ty, LParam(p.mode)))
            sig.names.push(p.name)
            sig.tys.push(ty)
            sig.modes.push(p.mode)
            sig.defaults.push(default)

        self.fx = saved
        self.fsig.push(sig)

        f.ret match
            Some(t) ->
                self.fret.set(k, self.resolve_type(t))
                self.fret_known.set(k, true)
            None ->
                if f.name == "main"
                    self.fret.set(k, Void)
                    self.fret_known.set(k, true)

        self.leave_unit_params(saved_units)
    end ensure_sig

    ensure_body(*self, k: usize)
        if self.fstate[k] != Waiting then return

        self.fstate.set(k, Working)

        val f = self.funs[k]
        val sig = self.fsig[k]
        val saved = self.fx
        val pending_base = self.pending.len()
        val diags_base = self.diags.len()
        val saved_units = self.enter_unit_params(f.uparams)

        self.fx = empty_fx()
        self.fx.frames.push(Frame(None, self.fret[k], self.fret_known[k], 0))
        self.open()

        for id in sig.params
            self.bind(id)

        val body = self.body_of(f.body)
        val frame = self.fx.frames[0]

        self.fret.set(k, frame.ret)
        self.fret_known.set(k, true)
        self.close()
        self.unresolved_lambdas(pending_base, diags_base)
        self.leave_unit_params(saved_units)
        self.fx = saved
        self.fout.push(TFun(f.decl.span, f.name, sig.params, sig.defaults, frame.ret, body))
        self.fstate.set(k, Finished)
    end ensure_body

    // The result type of a function, elaborating its body first where it does not declare one.
    fun_ret(*self, k: usize, span: Span) -> Ty
        if self.fret_known[k] then return self.fret[k]

        if self.fstate[k] == Working
            self.fail(span, s"`${self.funs[k].name}` is used before its result type is known; declare it: `def ${self.funs[k].name}(...): T`")
            return Error

        self.ensure_body(k)
        self.fret[k]

    fun_type(*self, k: usize, span: Span) -> Ty
        val sig = self.fsig[k]

        fn_type(sig.tys, sig.modes, self.fun_ret(k, span))

    // The body of the innermost frame, checked against its declared result type or giving it one.
    body_of(*self, body: Expr) -> TExpr
        val top = self.fx.frames.len() - 1
        val frame = self.fx.frames[top]

        // A function that returns nothing discards what its body ends with, as a statement would.
        if frame.ret_known && is_void(frame.ret)
            val v = self.elab(body, Some(Void))

            if is_void(v.ty) || is_wild(v.ty) then return v

            var items: Buf[TExpr] = buf()

            items.push(v)
            return texpr(v.span, Void, TBlock(items, texpr(v.span, Void, TLiteral(VoidVal, false))))

        if frame.ret_known then return self.check(body, frame.ret, "the result")

        val v = self.infer(body)
        val now = self.fx.frames[top]

        // A `return` inside fixed the type first; the body's own value has to agree with it.
        if now.ret_known then return self.coerce(v, now.ret, "the result")

        self.fx.frames.set(top, Frame(now.lambda, v.ty, true, now.loop_base))
        v
    end body_of

    // Lambdas still waiting for their parameter types when the body that bound them ends. Where the
    // body has had a diagnostic already, the use that would have fixed them may be what it refused,
    // so they are not reported again.
    unresolved_lambdas(*self, base: usize, diags_base: usize)
        val quiet = self.diags.len() > diags_base

        for k in base..<self.pending.len()
            val p = self.pending[k]

            if !quiet then self.fail(p.span, s"the parameter types of `${self.locals[p.local].name}` are never fixed: call it, or write them (`(x: real) -> ...`)")

        self.pending.truncate(base)

    // -- scopes and locals ------------------------------------------------------------------------

    open(*self)
        self.fx.marks.push(self.fx.scope.len())

    close(*self)
        val m = self.fx.marks.pop().unwrap()

        self.fx.scope.truncate(m)

    new_local(*self, name: string, ty: Ty, kind: LocalKind) -> usize
        self.locals.push(LocalInfo(name, ty, kind))
        self.depth.push(self.fx.frames.len())
        self.locals.len() - 1

    // Puts a local in the innermost block's scope.
    bind(*self, id: usize)
        self.fx.scope.push(ScopeEntry(self.locals[id].name, id))

    // A new local bound in the innermost block, refused where that block already binds the name.
    declare_local(*self, span: Span, name: string, ty: Ty, kind: LocalKind) -> usize
        val base = if self.fx.marks.len() > 0 then self.fx.marks[self.fx.marks.len() - 1] else 0

        for k in base..<self.fx.scope.len()
            if self.fx.scope[k].name == name then self.fail(span, s"redeclaration of `${name}`")

        val id = self.new_local(name, ty, kind)

        self.bind(id)
        id

    lookup_local(self, name: string) -> Option[usize]
        var k = self.fx.scope.len()

        while k > 0
            k -= 1
            if self.fx.scope[k].name == name then return Some(self.fx.scope[k].local)

        None

    // Records that every lambda between the local's own frame and the innermost one captures it.
    note_capture(*self, id: usize)
        for f in self.depth[id]..<self.fx.frames.len()
            self.fx.frames[f].lambda match
                Some(l) ->
                    var seen = false

                    for c in self.captures
                        if c.lambda == l && c.local == id then seen = true

                    if !seen then self.captures.push(Capture(l, id))
                None -> ()
    end note_capture

    // Every name in scope, for a suggestion beside an unknown one.
    visible_names(self) -> Buf[string]
        var out: Buf[string] = buf()

        for s in self.fx.scope
            out.push(s.name)

        for t in self.tops
            out.push(t.name)

        out

    unknown_name(*self, span: Span, name: string)
        nearest_name(name, self.visible_names()) match
            Some(near) -> self.fail(span, s"unknown name `${name}`; did you mean `${near}`?")
            None -> self.fail(span, s"unknown name `${name}`")

    // -- types ------------------------------------------------------------------------------------

    resolve_type(*self, t: Type) -> Ty
        *t.kind match
            Named(name) ->
                scalar_named(name) match
                    Some(ty) -> ty
                    None ->
                        if name == "byte"
                            self.fail(t.span, "there is no `byte` type; raw bytes are `uint8`")
                        else
                            self.fail(t.span, s"unknown type `${name}`")
                        Error
            Applied(name, args) ->
                if name == "complex" && args.len() == 1
                    val part = self.resolve_type(args[0])

                    complex_of(part) match
                        Some(c) -> return c
                        None ->
                            if !is_error(part) then self.fail(args[0].span, s"a complex type names a real part type, `complex[real32]`; found ${show_ty(part)}")
                            return Error

                self.later(t.span, s"the type `${name}[...]`")
                Error
            Array(elem, axes) ->
                val e = self.resolve_type(elem)
                var out: Buf[Extent] = buf()

                for a in axes
                    out.push(a match
                        AnyExtent -> Dynamic
                        FixedExtent(n) -> Fixed(n)
                        NamedExtent(n) -> Extent.Named(n))

                Ty.Array(e, out)
            Tuple(elems) ->
                if elems.len() == 0 then return Void

                var out: Buf[Ty] = buf()

                for e in elems
                    out.push(self.resolve_type(e))

                Ty.Tuple(out)
            Func(params, modes, ret) ->
                var ps: Buf[Ty] = buf()

                for p in params
                    ps.push(self.resolve_type(p))

                fn_type(ps, modes, self.resolve_type(ret))
            Measured(base, unit) -> self.measured_type(t.span, base, unit)
    end resolve_type

    // -- the result -------------------------------------------------------------------------------

    program(self) -> TProgram
        var decls: Buf[TDecl] = buf()

        for top in self.tops
            top.kind match
                TopValue(k) ->
                    for g in self.gout
                        if g.name == self.globals[k].name then decls.push(GlobalDecl(g))
                TopFun(k) ->
                    for f in self.fout
                        if f.name == self.funs[k].name then decls.push(FunDecl(f))
                TopExtern(k) -> decls.push(ExternDecl(self.xout[k]))

        var lambdas: Buf[TLambda] = buf()

        for l in 0..<self.lambdas.len()
            val x = self.lambdas[l]
            var caps: Buf[usize] = buf()

            for c in self.captures
                if c.lambda == l then caps.push(c.local)

            lambdas.push(TLambda(x.name, x.params, x.ret, caps, x.body))

        TProgram(decls, self.locals, lambdas, self.loops)
    end program
end Elab

// The names of a generic list's unit parameters, `U` of `[U: Unit]`.
private unit_params(tparams: Buf[TypeParam]) -> Buf[string]
    var out: Buf[string] = buf()

    for t in tparams
        if t.constraint == Some("Unit") then out.push(t.name)

    out

contains(names: Buf[string], name: string) -> bool
    for n in names
        if n == name then return true

    false
