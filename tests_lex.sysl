@tests

// The token stream, in the compact form `nex tokens` prints: a keyword or an operator is `K(..)`, a
// name `ID(..)`, a number `N(..)` with its underscores gone, a string `S(..)`, and the layout is `NL`,
// `INDENT` and `DEDENT`.

@test("integers keep their radix prefix and lose their underscores")
integer_literals()
    assert_eq(lexed("42"), "N(42) NL")
    assert_eq(lexed("1_000_000"), "N(1000000) NL")
    assert_eq(lexed("0xFF"), "N(0xFF) NL")
    assert_eq(lexed("0b1010_1010"), "N(0b10101010) NL")
    assert_eq(lexed("0o755"), "N(0o755) NL")

@test("reals take a fraction, an exponent, or both")
real_literals()
    assert_eq(lexed("3.14"), "N(3.14) NL")
    assert_eq(lexed("2.5e-3"), "N(2.5e-3) NL")
    assert_eq(lexed("6e23"), "N(6e23) NL")
    assert_eq(lexed("1_234.567_89"), "N(1234.56789) NL")

@test("a string's escapes are decoded and printed escaped again")
string_literals()
    assert_eq(lexed("\"hello\""), "S(hello) NL")
    assert_eq(lexed("\"line\\nbreak\""), "S(line\\nbreak) NL")
    assert_eq(lexed("\"\\x41\""), "S(A) NL")
    assert_eq(lexed("\"\\u{41}\""), "S(A) NL")
    assert_eq(lexed("\"\""), "S() NL")

@test("an interpolated string keeps its body whole and says which kind it is")
interpolated_strings()
    assert_eq(lexed("s\"hello\""), "S(s:hello) NL")
    assert_eq(lexed("s\"hi $name, x=${x+1}\""), "S(s:hi $name, x=${x+1}) NL")
    assert_eq(lexed("print(s\"x = ${x + 1}, name = $name\")"), "ID(print) K(() S(s:x = ${x + 1}, name = $name) K()) NL")

@test("an interpolation hole may hold a string holding a brace")
interpolation_holes_nest()
    assert_eq(lexed("s\"a${\"}\"}b\""), "S(s:a${\"}\"}b) NL")

@test("a keyword is a keyword only as a whole word")
keywords_and_names()
    assert_eq(lexed("def foo"), "K(def) ID(foo) NL")
    assert_eq(lexed("defy iffy whilex"), "ID(defy) ID(iffy) ID(whilex) NL")
    assert_eq(lexed("_foo _ x_y"), "ID(_foo) ID(_) ID(x_y) NL")

@test("every keyword of the language is one")
every_keyword()
    val words = "and as const cycle def div do elif else end enum exit extern false for if import in inout match module mut not or parallel private return stop struct then true val var while"
    val out = lexed(words)

    assert_eq(out, "K(and) K(as) K(const) K(cycle) K(def) K(div) K(do) K(elif) K(else) K(end) K(enum) K(exit) K(extern) K(false) K(for) K(if) K(import) K(in) K(inout) K(match) K(module) K(mut) K(not) K(or) K(parallel) K(private) K(return) K(stop) K(struct) K(then) K(true) K(val) K(var) K(while) NL")

@test("by, reduce, break, continue and the type names are names, not keywords")
contextual_words()
    assert_eq(lexed("by reduce int8 uint8 real16 real64 complex"), "ID(by) ID(reduce) ID(int8) ID(uint8) ID(real16) ID(real64) ID(complex) NL")
    assert_eq(lexed("break continue exits cycles stopper"), "ID(break) ID(continue) ID(exits) ID(cycles) ID(stopper) NL")

@test("`**` is refused by name, and `^` is a power")
no_double_star()
    assert_eq(lexed("x^2"), "ID(x) K(^) N(2) NL")
    assert_eq(lexed("val y = x**2\n"), "error: there is no `**`: a power is written `x^n` @1:10")
    assert_eq(lexed("val y = x ** 2\n"), "error: there is no `**`: a power is written `x^n` @1:11")
    assert_eq(lexed("val y = x * *p\n"), "K(val) ID(y) K(=) ID(x) K(*) K(*) ID(p) NL")
    assert_eq(lexed("/** doc */ x"), "ID(x) NL")

@test("operators are read longest first")
operators()
    assert_eq(lexed("a == b != c <= d >= e"), "ID(a) K(==) ID(b) K(!=) ID(c) K(<=) ID(d) K(>=) ID(e) NL")
    assert_eq(lexed("0..<10 0..10"), "N(0) K(..<) N(10) N(0) K(..) N(10) NL")
    assert_eq(lexed("a[..<k] a[k..]"), "ID(a) K([) K(..<) ID(k) K(]) ID(a) K([) ID(k) K(..) K(]) NL")
    assert_eq(lexed("1..n by -1"), "N(1) K(..) ID(n) ID(by) K(-) N(1) NL")
    assert_eq(lexed("a div b"), "ID(a) K(div) ID(b) NL")
    assert_eq(lexed("(){}[],;:"), "K(() K()) K({) K(}) K([) K(]) K(,) K(;) K(:) NL")
    assert_eq(lexed("A @ B"), "ID(A) K(@) ID(B) NL")
    assert_eq(lexed("x -> x * x"), "ID(x) K(->) ID(x) K(*) ID(x) NL")
    assert_eq(lexed("x += 1"), "ID(x) K(+=) N(1) NL")

@test("a number beside a name is two tokens, left for the parser to join")
juxtaposition_is_two_tokens()
    assert_eq(lexed("2x 2pi 3sin"), "N(2) ID(x) N(2) ID(pi) N(3) ID(sin) NL")

@test("an attribute is an at sign and a name")
attributes()
    assert_eq(lexed("@test"), "K(@) ID(test) NL")
    assert_eq(lexed("@strict"), "K(@) ID(strict) NL")

@test("comments leave no token behind")
comments()
    assert_eq(lexed("foo // ignored\nbar"), "ID(foo) NL ID(bar) NL")
    assert_eq(lexed("a // this is a comment\nb"), "ID(a) NL ID(b) NL")
    assert_eq(lexed("foo /* ignored */ bar"), "ID(foo) ID(bar) NL")
    assert_eq(lexed("foo /* one\ntwo */ bar"), "ID(foo) ID(bar) NL")

@test("a deeper line opens a block and a shallower one closes it")
indentation()
    assert_eq(lexed("a\n  b\nc"), "ID(a) NL INDENT ID(b) NL DEDENT NL ID(c) NL")
    assert_eq(lexed("a\n  b\n    c\n  d\ne"), "ID(a) NL INDENT ID(b) NL INDENT ID(c) NL DEDENT NL ID(d) NL DEDENT NL ID(e) NL")

@test("blocks still open at the end of the file are closed there")
dedent_at_end_of_file()
    assert_eq(lexed("a\n  b\n    c\n"), "ID(a) NL INDENT ID(b) NL INDENT ID(c) NL DEDENT NL DEDENT NL")

@test("blank lines and comment-only lines do not disturb the blocks")
blank_lines_and_comments_in_blocks()
    assert_eq(lexed("a\n\n  // a comment\n  b\n\nc"), "ID(a) NL INDENT ID(b) NL DEDENT NL ID(c) NL")

@test("a line break inside brackets is not a line break")
brackets_suppress_newlines()
    assert_eq(lexed("f(\n  1,\n  2,\n)"), "ID(f) K(() N(1) K(,) N(2) K(,) K()) NL")
    assert_eq(lexed("[1,\n 2]"), "K([) N(1) K(,) N(2) K(]) NL")

@test("a trailing binary operator continues the line")
continuation()
    assert_eq(lexed("a +\n  b"), "ID(a) K(+) ID(b) NL")
    assert_eq(lexed("x and\n  y or\n  z"), "ID(x) K(and) ID(y) K(or) ID(z) NL")

@test("an equals sign at the end of a line opens a block rather than continuing")
equals_opens_a_block()
    assert_eq(lexed("val x =\n  a\n  b"), "K(val) ID(x) K(=) NL INDENT ID(a) NL ID(b) NL DEDENT NL")

@test("an arrow ending a line inside brackets opens a block")
arrow_in_brackets_opens_a_block()
    assert_eq(lexed("f(x ->\n  x + 1\n)"), "ID(f) K(() ID(x) K(->) NL INDENT ID(x) K(+) N(1) NL DEDENT K()) NL")

@test("small programs lex the way they read")
small_programs()
    assert_eq(lexed("def main() =\n  print(\"Hello, Nex!\")"), "K(def) ID(main) K(() K()) K(=) NL INDENT ID(print) K(() S(Hello, Nex!) K()) NL DEDENT NL")
    assert_eq(lexed("struct Point\n  x: real\n  y: real\nend Point"), "K(struct) ID(Point) NL INDENT ID(x) K(:) ID(real) NL ID(y) K(:) ID(real) NL DEDENT NL K(end) ID(Point) NL")
    assert_eq(lexed("for k, x in enumerate(arr) do\n  print(k)"), "K(for) ID(k) K(,) ID(x) K(in) ID(enumerate) K(() ID(arr) K()) K(do) NL INDENT ID(print) K(() ID(k) K()) NL DEDENT NL")
    assert_eq(lexed("@test\ndef test_addition() =\n  assert_eq(2 + 2, 4)"), "K(@) ID(test) NL K(def) ID(test_addition) K(() K()) K(=) NL INDENT ID(assert_eq) K(() N(2) K(+) N(2) K(,) N(4) K()) NL DEDENT NL")

@test("empty input, blanks and a lone comment lex to one line end and nothing else")
trivial_inputs()
    assert_eq(lexed(""), "NL")
    assert_eq(lexed("   \n  \n"), "NL")
    assert_eq(lexed("// just a comment\n"), "NL")

// What the lexer refuses, and where it says so.

@test("a string that is not closed is refused at its opening quote")
unterminated_string()
    assert_eq(lexed("val s = \"unterminated\n"), "error: unterminated string literal @1:9")

@test("a character that starts no token is refused")
illegal_character()
    assert_eq(lexed("val x = 1 $ 2\n"), "error: illegal character @1:11")

@test("`..=` is refused by name, wherever it is written")
no_inclusive_equals_range()
    assert_eq(lexed("for k in 0..=10 do f(k)\n"), "error: there is no `..=`: `a..b` already includes `b`, and `a..<b` stops before it @1:11")
    assert_eq(lexed("a[..=3]\n"), "error: there is no `..=`: `a..b` already includes `b`, and `a..<b` stops before it @1:3")
    assert_eq(lexed("a[1..= 3]\n"), "error: there is no `..=`: `a..b` already includes `b`, and `a..<b` stops before it @1:4")

@test("a line that lines up with no open block is refused")
ragged_dedent()
    assert_eq(lexed("def f() =\n    a\n  b\n"), "error: this line is indented to column 2, which lines up with no open block — the block it closed starts at column 4 and the one around it at column 0 @3:3")

// Units of measure: `U<` and `U>` are the brackets of a unit annotation.

@test("a `<` against a number opens a unit annotation")
unit_annotation_on_a_number()
    assert_eq(lexed("9.81<m/s^2>"), "N(9.81) U< ID(m) K(/) ID(s) K(^) N(2) U> NL")
    assert_eq(lexed("1<1>"), "N(1) U< N(1) U> NL")
    assert_eq(lexed("2.0<in>"), "N(2.0) U< K(in) U> NL")
    assert_eq(lexed("1<m^(1/2)>"), "N(1) U< ID(m) K(^) K(() N(1) K(/) N(2) K()) U> NL")
    assert_eq(lexed("1<s^-1>"), "N(1) U< ID(s) K(^) K(-) N(1) U> NL")

@test("a `<` against a type name or a name opens a unit annotation when a `>` closes it")
unit_annotation_on_a_name()
    assert_eq(lexed("real<m>"), "ID(real) U< ID(m) U> NL")
    assert_eq(lexed("to<mm>(x)"), "ID(to) U< ID(mm) U> K(() ID(x) K()) NL")
    assert_eq(lexed("[real<m>; :, :]"), "K([) ID(real) U< ID(m) U> K(;) K(:) K(,) K(:) K(]) NL")
    assert_eq(lexed("complex[real32]<V>"), "ID(complex) K([) ID(real32) K(]) U< ID(V) U> NL")
    assert_eq(lexed("real<>"), "ID(real) U< U> NL")

@test("a `<` with a blank before it, or against a name with no unit after it, is a comparison")
less_than_stays_a_comparison()
    assert_eq(lexed("9.81 <m>"), "N(9.81) K(<) ID(m) K(>) NL")
    assert_eq(lexed("a < b"), "ID(a) K(<) ID(b) NL")
    assert_eq(lexed("n<3"), "ID(n) K(<) N(3) NL")
    assert_eq(lexed("x<y"), "ID(x) K(<) ID(y) NL")
    assert_eq(lexed("a[i]<b"), "ID(a) K([) ID(i) K(]) K(<) ID(b) NL")
    assert_eq(lexed("lo<x and x>hi"), "ID(lo) K(<) ID(x) K(and) ID(x) K(>) ID(hi) NL")
    assert_eq(lexed("f(a<b, c>d)"), "ID(f) K(() ID(a) K(<) ID(b) K(,) ID(c) K(>) ID(d) K()) NL")
    assert_eq(lexed("1<=x"), "N(1) K(<=) ID(x) NL")
    assert_eq(lexed("2pi"), "N(2) ID(pi) NL")

@test("the `>` closing a unit annotation does not continue the line, and a comparison's does")
unit_close_ends_a_line()
    assert_eq(lexed("val g = 9.81<m/s^2>\nval h = 1\n"), "K(val) ID(g) K(=) N(9.81) U< ID(m) K(/) ID(s) K(^) N(2) U> NL K(val) ID(h) K(=) N(1) NL")
    assert_eq(lexed("val g = a >\n  b\n"), "K(val) ID(g) K(=) ID(a) K(>) ID(b) NL")
    assert_eq(lexed("val g = 1<m> > 2<m>\n"), "K(val) ID(g) K(=) N(1) U< ID(m) U> K(>) N(2) U< ID(m) U> NL")

@test("`unit` is a name to the lexer: it declares only where the parser finds a unit's name after it")
unit_is_not_reserved()
    assert_eq(lexed("unit N = kg m / s^2"), "ID(unit) ID(N) K(=) ID(kg) ID(m) K(/) ID(s) K(^) N(2) NL")
    assert_eq(lexed("unit in = 0.0254 m"), "ID(unit) K(in) K(=) N(0.0254) ID(m) NL")

@test("a unit annotation against a number must close on its line")
unclosed_unit_annotation()
    assert_eq(lexed("val g = 9.81<m/s\n"), "error: this unit annotation is not closed: a `<` written against a number opens one, closed by a `>` on the same line; a comparison is written with a blank, `a < b` @1:13")
    assert_eq(lexed("val g = 1<m\n>\n"), "error: this unit annotation is not closed: a `<` written against a number opens one, closed by a `>` on the same line; a comparison is written with a blank, `a < b` @1:10")
    assert_eq(lexed("val b = 0<x\n"), "error: this unit annotation is not closed: a `<` written against a number opens one, closed by a `>` on the same line; a comparison is written with a blank, `a < b` @1:10")
