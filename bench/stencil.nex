// The perf oracle's stencil kernel (PLAN.md): a 3-point Jacobi sweep over 10⁷ `real64`, a hundred
// sweeps as fifty pairs that alternate between two arrays, the ends held fixed. Prints nanoseconds
// per sweep, then a checksum; `stencil.f90` is its twin.

extern def clock_gettime_nsec_np(clock: int32): uint64

def main() =
  val n = 10000000
  val pairs = 50
  var x: [real] = zeros(n)
  var y: [real] = zeros(n)
  for i in 1..n
    x[i] = 1.0 * (i % 13)
    y[i] = x[i]
  val start = clock_gettime_nsec_np(4)
  for s in 1..pairs
    for i in 2..n - 1 do y[i] = (x[i - 1] + x[i] + x[i + 1]) / 3.0
    for i in 2..n - 1 do x[i] = (y[i - 1] + y[i] + y[i + 1]) / 3.0
  val done = clock_gettime_nsec_np(4)
  print((done - start) / (2 * pairs))
  print(sum(x))
