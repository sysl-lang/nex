// gemm.nex for the Scala reference's AOT backend: the triple loop of ../gemm.nex, 0-based, timed
// from outside. Its loops are blocks, not `do` lines, and avoid `i`, the imaginary unit.

def main() =
  val n = 1000
  var a = fill((n, n), 0.0)
  var b = fill((n, n), 0.0)
  var c = fill((n, n), 0.0)
  for q in 0..n
    for p in 0..n
      a[p, q] = 1.0 / to_real(p + q + 2)
      b[p, q] = to_real(((p + 1) * 7 + (q + 1) * 3) % 11) - 5.0
  for r in 0..3
    for q in 0..n
      for p in 0..n
        c[p, q] = 0.0
      for k in 0..n
        val bkq = b[k, q]
        for p in 0..n
          c[p, q] = c[p, q] + a[p, k] * bkq
  var s = 0.0
  for q in 0..n
    for p in 0..n
      s = s + c[p, q]
  print(s)
