// The perf oracle's nrm2 kernel (PLAN.md): `sqrt(sum(x * x))` over 10⁷ `real64`, fifty passes, each
// nudging `x[1]` by the running total. Prints nanoseconds per pass, then a checksum; `nrm2.f90` is
// its twin.

extern def clock_gettime_nsec_np(clock: int32): uint64

def main() =
  val n = 10000000
  val reps = 50
  var x: [real] = zeros(n)
  for i in 1..n
    x[i] = 1.0 / i + 1.0 * (i % 7)
  var s = 0.0
  val start = clock_gettime_nsec_np(4)
  for r in 1..reps
    s = s + sqrt(sum(x * x))
    x[1] = 1.0 + s * 1.0e-30
  val done = clock_gettime_nsec_np(4)
  print((done - start) / reps)
  print(s)
