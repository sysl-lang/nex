// The perf oracle's point-distance kernel (PLAN.md), a fusion check: `sqrt((x2-x1)^2 + (y2-y1)^2)`
// elementwise over 10⁷ points, fifty passes into one result array. One fused loop reads four arrays
// and writes one; a temporary per operator would cost several more passes. Prints nanoseconds per
// pass, then a checksum; `point-distance.f90` is its twin.

extern def clock_gettime_nsec_np(clock: int32): uint64

def main() =
  val n = 10000000
  val reps = 50
  var x1: [real] = zeros(n)
  var y1: [real] = zeros(n)
  var x2: [real] = zeros(n)
  var y2: [real] = zeros(n)
  var d: [real] = zeros(n)
  for i in 1..n
    x1[i] = 1.0 * (i % 7)
    y1[i] = 1.0 * (i % 11)
    x2[i] = 1.0 / i
    y2[i] = 1.0 * (i % 3)
  val start = clock_gettime_nsec_np(4)
  for r in 1..reps
    d = sqrt((x2 - x1)^2 + (y2 - y1)^2)
  val done = clock_gettime_nsec_np(4)
  print((done - start) / reps)
  print(sum(d))
