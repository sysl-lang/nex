// The perf oracle's naive gemm kernel (PLAN.md): `C = A B` at 1000 × 1000 `real64` as the textbook
// triple loop in column order (j, k, i), three products, no BLAS. Prints nanoseconds per product,
// then a checksum; `gemm.f90` is its twin.

extern def clock_gettime_nsec_np(clock: int32): uint64

def main() =
  val n = 1000
  val reps = 3
  var a: [real; :, :] = zeros((n, n))
  var b: [real; :, :] = zeros((n, n))
  var c: [real; :, :] = zeros((n, n))
  for j in 1..n
    for i in 1..n
      a[i, j] = 1.0 / (i + j)
      b[i, j] = 1.0 * ((i * 7 + j * 3) % 11) - 5.0
  val start = clock_gettime_nsec_np(4)
  for r in 1..reps
    for j in 1..n
      for i in 1..n do c[i, j] = 0.0
      for k in 1..n
        val bkj = b[k, j]
        for i in 1..n
          c[i, j] = c[i, j] + a[i, k] * bkj
  val done = clock_gettime_nsec_np(4)
  print((done - start) / reps)
  print(sum(c))
