// The interpreter's calls of a function value once an element (PLAN.md M13): 200 000 `real64`
// elements, 20 passes of `map` with a lambda, `map` with a lambda capturing a local, `filter` and
// `reduce`. Timed from outside, on either engine.

def main() =
  val n = 200000
  var x: [real; :] = zeros(n)
  for i in 1..n
    x[i] = 1.0 / i
  var s = 0.0
  var kept = 0
  for k in 1..20
    val scale = 1.0 / k
    val m = map(x, v -> v * 0.25 + 1.0)
    val c = map(m, v -> v * scale)
    val f = filter(c, v -> v > 0.03)
    s = s + reduce(c, 0.0, (a, v) -> a + v)
    kept = kept + length(f)
  print(s)
  print(kept)
