// The perf oracle's axpy kernel (PLAN.md): `y = a*x + y` over 10⁷ `real64`, fifty passes, timed
// inside the program. Prints nanoseconds per pass, then a checksum; `axpy.f90` is its twin.

extern def clock_gettime_nsec_np(clock: int32): uint64

def main() =
  val n = 10000000
  val reps = 50
  val a = 1.0e-3
  var x: [real] = zeros(n)
  var y: [real] = zeros(n)
  for i in 1..n
    x[i] = 1.0 / i
    y[i] = 1.0 * (i % 7)
  val start = clock_gettime_nsec_np(4)
  for r in 1..reps
    y = a * x + y
    // Each pass feeds the next, so an optimizer cannot turn the passes inside out: `gfortran -O3`
    // otherwise runs the fifty passes as one, with `a * x[i]` computed once and added fifty times.
    x[1] = x[1] + y[n] * 1.0e-30
  val done = clock_gettime_nsec_np(4)
  print((done - start) / reps)
  print(sum(y))
