// The perf oracle's dot kernel (PLAN.md): `sum(x * y)` over 10⁷ `real64`, fifty passes, each
// nudging `x[1]` by the running total so no pass can be hoisted. Prints nanoseconds per pass, then a
// checksum; `dot.f90` is its twin.

extern def clock_gettime_nsec_np(clock: int32): uint64

def main() =
  val n = 10000000
  val reps = 50
  var x: [real] = zeros(n)
  var y: [real] = zeros(n)
  for i in 1..n
    x[i] = 1.0 / i
    y[i] = 1.0 * (i % 7)
  var s = 0.0
  val start = clock_gettime_nsec_np(4)
  for r in 1..reps
    s = s + sum(x * y)
    x[1] = 1.0 + s * 1.0e-30
  val done = clock_gettime_nsec_np(4)
  print((done - start) / reps)
  print(s)
