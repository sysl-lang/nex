// The `nex` command. The subcommands arrive with the phases they drive, in the order PLAN.md
// gives: `tokens` prints what the lexer reads, `parse` the tree the parser builds, `elaborate` the
// typed IR, or every diagnostic the elaborator gives.

import sysl.fs.read_bytes
import sh.sysl.parsing.{Source, full_report, source}

private val usage = "usage: nex <tokens | parse | elaborate | run | test | compile> <file.nex>"

main(args: []string)
    if args.len < 3
        print(usage)
        exit(2)

    val command = args[1]
    val file = args[2]

    if command != "tokens" && command != "parse" && command != "elaborate"
        print(s"nex: '${command}' is not implemented yet")
        exit(1)

    val bytes = read_bytes(file) match
        Ok(b) -> b
        Err(e) -> fail(s"nex: cannot read ${file}: ${e}")

    val doc = source(file, bytes)
    val src = program_text(doc) match
        Ok(s) -> s
        Err(d) -> fail(d.render(doc))

    if command == "tokens"
        lex(src) match
            Ok(toks) -> prints(show_tokens(src, toks))
            Err(d) -> fail(d.render(src))
        return

    val p = parse_program(src) match
        Ok(p) -> p
        Err(d) -> fail(d.render(src))

    if command == "parse"
        print(show_program(p))
        return

    elaborate(p) match
        Ok(t) -> print(show_tprogram(t))
        Err(ds) ->
            var r = full_report()

            for d in ds
                r.add(d)

            fail(r.render(src))
end main

private fail(text: string) -> never
    eprints(text)
    eprints("\n")
    exit(1)
