// MLIR emission: the typed IR to the text of one MLIR module, which `driver.sysl` lowers to a native
// program.
//
// **Every local lives in memory.** A local is an `llvm.alloca` in its function's entry block, read
// with `llvm.load` and written with `llvm.store`; LLVM's `mem2reg` turns them back into registers. So
// nothing has to thread a variable's current value through a structured region.
//
// **Control flow is structured**: `scf.if` and `scf.while`, as bufferization requires of every
// function (it refuses a `cf` loop). `exit`, `cycle` and `return` cannot leave a region, so a function
// that has them keeps a control word in memory: `exit` and `cycle` of loop `L` set it to `2L + 2` and
// `2L + 3`, `return` to 1 with its value stored aside. A statement after one that may set it runs
// under `scf.if` on the word being 0, a loop runs while it is 0, and the loop it names clears it.
//
// **A local a lambda captures lives in a cell**: an object of the runtime's counted heap, whose
// address the entry-block slot holds. The lambda's environment is the count of cells it holds and
// their addresses, so a lambda sees later writes to them and they to it (corpus 079), and it may
// outlive the frame that made it. An `inout` parameter is held the same way, its slot holding the
// caller's place, which an environment borrows after its cells. A local `def` that calls itself, and
// that no other lambda captures, reaches itself through its own code and environment instead of a
// cell, which would hold the environment that holds it.
//
// **A function value is a pair of pointers**, `!llvm.struct<(ptr, ptr)>`: code that takes the
// environment as its first argument, and the environment. A lambda is emitted as such code; a
// top-level `def` used as a value gets a wrapper that drops the environment and calls it.
//
// **A string is a pointer to NUL-terminated UTF-8**: a literal is a private constant global behind
// the header of a counted object that is never freed, and every other string is built by the runtime
// (`runtime/text.sysl`). Who holds a count on what is `emit_own.sysl`'s; structs, tuples and enums
// are `emit_aggregate.sysl`'s.
//
// **Every check that fails calls the runtime's one trap entry**, `nex_trap`, with the message as a
// constant string, inside an `scf.if` on the failed condition.
//
// Symbols are prefixed so that no user name meets a C one: a function is `@"n.name"`, a module-level
// binding `@"g.name"`, a lambda `@"l.N"`, a function's value wrapper `@"r.name"`, a string `@"s.N"`.
// The program's C `main` sets the arguments aside, initializes the module-level bindings in the order
// their initializers need, and calls `@"n.main"`.

import sysl.buf.{Buf, buf}
import sysl.text.{StrBuilder, str_builder}
import sh.sysl.parsing.{Diagnostic, Span, error}

struct Emitter
    prog: TProgram
    diags: Buf[Diagnostic]
    // `--fpe-trap`: real division by zero, an invalid operation and an overflow trap.
    fpe_trap: bool

    // The module's declarations: externs, string constants, module-level storage.
    top: StrBuilder
    // The finished functions.
    funcs: StrBuilder
    // The current function's entry-block allocations, and the rest of its body.
    entry: StrBuilder
    body: StrBuilder
    next: usize
    ret: Ty
    // The current function's control word and the slot a `return` stores its value in, `""` where
    // it has no `exit`, `cycle` or `return`.
    ctl: string
    ret_slot: string

    declared: Buf[string]
    strings: Buf[string]
    // By local number: the entry-block slot, and whether it holds a cell's address.
    slot: Buf[string]
    boxed: Buf[bool]
    // The operand values of the chains around the cursor, innermost last.
    chains: Buf[Buf[string]]
    lambdas_wanted: Buf[usize]
    lambdas_done: Buf[bool]
    wrappers: Buf[string]
    // The local `main(args: [string])` binds, which the runtime holds.
    args_local: Option[usize]
    // Whether the current function has reported something not compiled yet.
    reported: bool
    // Whether an `exit`, `cycle` or `return` may already have run in the statement being emitted, so
    // that what the rest of it does — a call, a store, a trap — runs only where none did.
    dirty: bool
    // By local number, the tensor each array local held as an SSA value holds now, `""` where it is
    // not bound here; one more entry is the value a `return` has given (`emit_array.sysl`).
    arr: Buf[string]
    // The targets of the index lists around the cursor, innermost last, which `end` reads.
    ends: Buf[string]
    end_tys: Buf[Ty]
    // The current function's `inout` array parameters, which it returns after its value.
    inout_arrays: Buf[usize]

    // The counted values the statements being emitted own, released where each statement ends, and
    // the locals the current function owns, released where it returns (`emit_own.sysl`).
    temps: Buf[Temp]
    owned: Buf[usize]
    // By lambda: the local `def` it is bound to where it calls itself and no other lambda captures it.
    self_local: Buf[Option[usize]]
    // The types whose retain, release and cell-release functions the module needs, by number.
    helpers: Buf[Ty]
    // The `origin` views bound to locals, the shifts of the index lists around the cursor (beside
    // `ends`), and those of the `origin` node emitted last (`emit_view.sysl`).
    origins: Buf[OriginLocal]
    end_shifts: Buf[Buf[string]]
    last_shifts: Buf[string]

    // The parallel regions whose code is still to be emitted, and those emitted (`emit_parallel.sysl`);
    // inside a `parallel for`'s code, its reductions' accumulators; whether a `parallel` expression is
    // being emitted; whether the program runs threads at all.
    par_jobs: Buf[ParJob]
    par_accs: Buf[ParAcc]
    par_kernel: bool
    threaded: bool
    // Inside a `parallel for`'s code, the word a trap in the region sets.
    par_stop: string
    // The slots the current function's frame record lists, and those its temporaries use
    // (`emit_own.sysl`).
    guards: Buf[Guard]
    temp_slots: Buf[TempSlot]

    // -- diagnostics ------------------------------------------------------------------------------

    // A construct the emitter does not compile yet: reported once per function, at the first, since
    // what surrounds it reports the same gap again.
    later(*self, span: Span, what: string)
        if self.reported then return

        self.reported = true
        self.diags.push(error(span, s"${what} is not compiled yet"))

    // -- text -------------------------------------------------------------------------------------

    fresh(*self) -> string
        self.next += 1
        s"%v${self.next}"

    // One operation, or one line of a region's braces.
    op(*self, text: string)
        self.body.push("    ")
        self.body.push(text)
        self.body.push("\n")

    // An operation that defines a value, and the value.
    def(*self, text: string) -> string
        val v = self.fresh()

        self.op(s"$v = $text")
        v

    // The zero of `t`: what a branch that never yields stands in with, where its region must yield.
    zero_of(*self, span: Span, t: Ty) -> string = base_of(t) match
        Int(b, _) -> self.def(s"arith.constant 0 : i$b")
        Real(b) -> self.real_const(0.0, b)
        Complex(b) -> self.complex_const(self.real_const(0.0, b), self.real_const(0.0, b), b)
        Bool -> self.def("arith.constant false")
        Array(_, _) -> if is_arr(t) then self.zero_array(span, t) else self.def("llvm.mlir.zero : !llvm.ptr")
        _ -> self.def(s"llvm.mlir.zero : ${self.ty(span, t)}")

    // The control word is 0: no `exit`, `cycle` or `return` is under way.
    flowing(*self) -> string
        val w = self.def(s"llvm.load ${self.ctl} : !llvm.ptr -> i64")

        self.def(s"arith.cmpi eq, $w, ${self.def("arith.constant 0 : i64")} : i64")

    set_ctl(*self, word: usize)
        self.op(s"llvm.store ${self.def(s"arith.constant $word : i64")}, ${self.ctl} : i64, !llvm.ptr")

    // `exit`, `cycle` or `return` setting the control word, unless one has already run in the
    // statement.
    leave(*self, word: usize)
        self.effect(s"llvm.store ${self.def(s"arith.constant $word : i64")}, ${self.ctl} : i64, !llvm.ptr", "")

    // The control word cleared where it holds `word`.
    clear_ctl(*self, word: usize)
        val w = self.def(s"llvm.load ${self.ctl} : !llvm.ptr -> i64")

        self.op(s"scf.if ${self.def(s"arith.cmpi eq, $w, ${self.def(s"arith.constant $word : i64")} : i64")} {")
        self.set_ctl(0)
        self.op("}")

    // A declaration at module level, written once.
    declare(*self, name: string, text: string)
        for d in self.declared
            if d == name then return

        self.declared.push(name)
        self.top.push(s"  $text\n")

    // A runtime or C function, by its C name. One that never returns says so, so LLVM treats the path
    // through a failed check as leaving the loop it is in: the check can then be hoisted out of the
    // loop and the loop vectorized.
    external(*self, name: string, params: string, result: string)
        val never = if never_returns(name) then " attributes {llvm.passthrough = [\"noreturn\", \"nounwind\"]}" else ""

        self.declare(name, s"func.func private @$name($params)${arrow(result)}$never")

    call(*self, name: string, args: string, params: string, result: string) -> string
        self.external(name, params, result)
        self.effect(s"func.call @$name($args) : ($params) -> ${result_text(result)}", result)

    // An operation that may have an effect, a call, and its value of MLIR type `result` (`""` for
    // none). Where an `exit`, `cycle` or `return` may already have run in the statement, it runs only
    // where none did, a zero standing in for its value.
    effect(*self, text: string, result: string) -> string
        if !self.dirty
            if result == ""
                self.op(text)
                return ""

            return self.def(text)

        val ok = self.flowing()

        if result == ""
            self.op(s"scf.if $ok {")
            self.op(text)
            self.op("}")
            return ""

        val r = self.fresh()

        self.op(s"$r = scf.if $ok -> ($result) {")
        self.op(s"scf.yield ${self.def(text)} : $result")
        self.op("} else {")
        self.op(s"scf.yield ${self.zero_text(result)} : $result")
        self.op("}")
        r

    // The zero of an MLIR type.
    zero_text(*self, t: string) -> string =
        if t == "i1" then self.def("arith.constant false")
        elif t.starts_with("i") then self.def(s"arith.constant 0 : $t")
        elif t.starts_with("f") then self.def(s"arith.constant 0.0 : $t")
        elif t.starts_with("complex<")
            val part = t[8..<t.len - 1]
            val z = self.def(s"arith.constant 0.0 : $part")

            self.def(s"complex.create $z, $z : $t")
        elif t.starts_with("tensor<") then self.zero_tensor_text(t)
        else self.def(s"llvm.mlir.zero : $t")

    // The address of a string constant: its bytes, after the header of a counted object whose count
    // marks it as never freed (`runtime/heap.sysl`).
    string_ref(*self, text: string) -> string
        var k = 0
        val t = s"!llvm.struct<(i64, ptr, array<${text.len + 1} x i8>)>"

        loop
            if k == self.strings.len()
                self.strings.push(text)
                self.top.push(s"  llvm.mlir.global private constant @\"s.$k\"() {addr_space = 0 : i32} : $t {\n")
                self.top.push(s"    %u = llvm.mlir.undef : $t\n    %c = llvm.mlir.constant(-1 : i64) : i64\n")
                self.top.push(s"    %h = llvm.insertvalue %c, %u[0] : $t\n    %z = llvm.mlir.zero : !llvm.ptr\n")
                self.top.push(s"    %d = llvm.insertvalue %z, %h[1] : $t\n")
                self.top.push(s"    %b = llvm.mlir.constant(\"${mlir_bytes(text)}\\00\") : !llvm.array<${text.len + 1} x i8>\n")
                self.top.push(s"    %s = llvm.insertvalue %b, %d[2] : $t\n    llvm.return %s : $t\n  }\n")
                break

            if self.strings[k] == text then break
            k += 1

        val g = self.def(s"llvm.mlir.addressof @\"s.$k\" : !llvm.ptr")

        self.def(s"llvm.getelementptr $g[0, 2] : (!llvm.ptr) -> !llvm.ptr, $t")

    // A trap with `message` where `cond` holds.
    trap_if(*self, cond: string, message: string)
        self.external("nex_trap", "!llvm.ptr", "")

        val m = self.string_ref(message)
        val c = if self.dirty then self.def(s"arith.andi $cond, ${self.flowing()} : i1") else cond

        self.op(s"scf.if $c {")
        self.op(s"  func.call @nex_trap($m) : (!llvm.ptr) -> ()")
        self.op("}")

    // -- types ------------------------------------------------------------------------------------

    // A value's MLIR type; `""` for `void` and `never`, which have no value.
    ty(*self, span: Span, t: Ty) -> string = base_of(t) match
        Int(b, _) -> s"i$b"
        Real(b) -> s"f$b"
        Complex(b) -> s"complex<f$b>"
        Bool -> "i1"
        Str -> "!llvm.ptr"
        Fn(_) -> CLOSURE
        Array(_, _) -> if is_arr(t) then self.tensor_ty(span, t) else "!llvm.ptr"
        Tuple(_) -> self.agg_ty(span, t)
        Nominal(_, _) -> self.agg_ty(span, t)
        Void -> ""
        Never -> ""
        _ ->
            self.later(span, s"a value of type ${show_ty(t)}")
            "i64"

    // The type a value of `t` is stored as, in memory and inside an aggregate: a complex as a struct
    // of its parts, an array as the address of the object holding it (`emit_array.sysl`).
    mem_ty(*self, span: Span, t: Ty) -> string = base_of(t) match
        Complex(b) -> s"!llvm.struct<(f$b, f$b)>"
        Array(_, _) -> "!llvm.ptr"
        _ -> self.ty(span, t)

    // A value of `t` read in its stored form; an array of numbers as a view pinned for the statement.
    from_mem(*self, v: string, t: Ty) -> string = base_of(t) match
        Complex(b) ->
            val m = s"!llvm.struct<(f$b, f$b)>"
            val re = self.def(s"llvm.extractvalue $v[0] : $m")
            val im = self.def(s"llvm.extractvalue $v[1] : $m")

            self.def(s"complex.create $re, $im : complex<f$b>")
        Array(_, _) -> if is_arr(t) then self.stored_view(Span(0, 0), v, t) else v
        _ -> v

    // A value of `t` in its stored form; an array of numbers as a new object the statement owns.
    to_mem(*self, v: string, t: Ty) -> string = base_of(t) match
        Array(_, _) -> if is_arr(t) then self.own_ref(self.boxed_array(Span(0, 0), v, t)) else v
        Complex(b) ->
            val m = s"!llvm.struct<(f$b, f$b)>"
            val re = self.def(s"complex.re $v : complex<f$b>")
            val im = self.def(s"complex.im $v : complex<f$b>")
            val u = self.def(s"llvm.mlir.undef : $m")

            self.def(s"llvm.insertvalue $im, ${self.def(s"llvm.insertvalue $re, $u[0] : $m")}[1] : $m")
        _ -> v

    load(*self, span: Span, ptr: string, t: Ty) -> string
        self.from_mem(self.def(s"llvm.load $ptr : !llvm.ptr -> ${self.mem_ty(span, t)}"), t)

    store(*self, span: Span, ptr: string, v: string, t: Ty)
        if is_arr(t)
            self.store_array(span, ptr, v, t)
            return

        val w = self.to_mem(v, t)

        self.effect(s"llvm.store $w, $ptr : ${self.mem_ty(span, t)}, !llvm.ptr", "")

    // -- locals -----------------------------------------------------------------------------------

    alloca(*self, ty: string) -> string
        val v = self.fresh()

        self.entry.push(s"    $v = llvm.alloca %one x $ty : (i64) -> !llvm.ptr\n")
        v

    // Storage for local `id` where it is bound; a captured one gets a fresh cell each time, the one
    // bound before released: one bound in a loop is bound again on every pass, by the same code, so
    // the release is made wherever the slot already holds a cell (its slot starts null). The
    // function owns what the slot holds unless `borrowed` (a parameter's value, which its caller
    // owns).
    bind_local(*self, span: Span, id: usize, borrowed: bool = false)
        val t = self.prog.locals[id].ty

        if self.boxed[id]
            if self.slot[id] == ""
                self.slot.set(id, self.zeroed_alloca("!llvm.ptr"))
                self.owned.push(id)

            // A binding inside a loop runs once per pass: the cell the pass before bound is released
            // here, as is one an earlier binding of the same local left (zero where there is none).
            val old = self.def(s"llvm.load ${self.slot[id]} : !llvm.ptr -> !llvm.ptr")
            val cell = self.new_object((self.words(t) + self.shift_words(id)) * 8, if self.part_managed(t) then self.helper_ref("cell", t) else "")

            self.op(s"llvm.store $cell, ${self.slot[id]} : !llvm.ptr, !llvm.ptr")
            self.release_ref(old)
        elif self.slot[id] == ""
            if self.managed(t) && !borrowed
                self.slot.set(id, self.zeroed_alloca(self.mem_ty(span, t)))
                self.owned.push(id)
            else
                self.slot.set(id, self.alloca(self.mem_ty(span, t)))

    // A local whose slot holds the address of storage someone else owns: an `inout` parameter, or a
    // capture inside the lambda.
    bind_borrowed(*self, id: usize, address: string)
        if self.slot[id] == "" then self.slot.set(id, self.alloca("!llvm.ptr"))
        self.op(s"llvm.store $address, ${self.slot[id]} : !llvm.ptr, !llvm.ptr")

    // The address local `id`'s value is stored at.
    local_ptr(*self, span: Span, id: usize) -> string
        if self.slot[id] == ""
            self.later(span, s"`${self.prog.locals[id].name}` here")
            return "%one"

        if self.boxed[id] || is_inout(self.prog.locals[id].kind) then return self.def(s"llvm.load ${self.slot[id]} : !llvm.ptr -> !llvm.ptr")

        self.slot[id]

    // The address a place is stored at: a local, a module-level binding, or a field of a place.
    place_ptr(*self, e: TExpr) -> string = *e.kind match
        TLocal(id) -> self.local_ptr(e.span, id)
        TGlobalRef(name) -> self.def(s"llvm.mlir.addressof @\"g.$name\" : !llvm.ptr")
        TField(v, _, k) -> self.field_ptr(v, k)
        TTupleField(v, k) -> self.field_ptr(v, k)
        TArray(op) ->
            *op match
                TIndex(target, subs) -> if is_items(target.ty) then return self.items_place(e.span, target, subs, true)
                _ -> ()

            self.later(e.span, "this place")
            "%one"
        _ ->
            self.later(e.span, "this place")
            "%one"

    // The address of field `k` of the place `v`.
    field_ptr(*self, v: TExpr, k: usize) -> string =
        self.def(s"llvm.getelementptr ${self.place_ptr(v)}[0, $k] : (!llvm.ptr) -> !llvm.ptr, ${self.ty(v.span, v.ty)}")

    // -- functions --------------------------------------------------------------------------------

    // Per-function state, cleared.
    begin(*self, ret: Ty, body: TExpr)
        self.entry = str_builder()
        self.body = str_builder()
        self.ret = ret
        self.chains = buf()
        self.ctl = ""
        self.ret_slot = ""
        self.reported = false
        self.dirty = false
        self.temps = buf()
        self.owned = buf()
        self.guards = buf()
        self.temp_slots = buf()

        for k in 0..<self.slot.len()
            self.slot.set(k, "")

        self.arr = buf()
        self.inout_arrays = buf()

        for _ in 0..<self.prog.locals.len() + 1
            self.arr.push("")

        self.entry.push("    %one = arith.constant 1 : i64\n")

        if may_leave(body)
            self.ctl = self.alloca("i64")
            self.entry.push(s"    %zero = arith.constant 0 : i64\n    llvm.store %zero, ${self.ctl} : i64, !llvm.ptr\n")

            val r = self.ty(body.span, ret)

            // An array a `return` gives is carried as a value; any other in a slot.
            if is_arr(ret) then self.arr.set(self.ret_id(), self.zero_array(body.span, ret))
            elif r != "" then self.ret_slot = self.zeroed_alloca(self.mem_ty(body.span, ret))

    // The current function, finished, under `header`.
    end(*self, header: string)
        self.funcs.push(header)
        self.funcs.push(" {\n")
        self.funcs.push(self.entry.finish())
        self.funcs.push(self.body.finish())
        self.funcs.push("  }\n\n")

    // A function body's value; an array one that outlives the body's statements.
    body_value(*self, body: TExpr) -> string = if is_arr(self.ret) then self.lasting(body) else self.ex(body)

    // The end of a body whose value is `v`: the value kept for the caller, which owns it, what the
    // function still holds released, and then each `inout` array parameter as the body left it.
    finish_body(*self, span: Span, v: string)
        val r = self.ty(span, self.ret)
        var vals: Buf[string] = buf()
        var tys: Buf[string] = buf()
        // Whether the value is read back from the slot a `return` stores into.
        var from_slot = false
        var value = ""

        if r != ""
            value = if v == "" then self.zero_of(span, self.ret) else v

            if self.ctl == ""
                self.retain(value, self.ret)
            elif is_arr(self.ret)
                // A body that ran to its end gives its value; one that returned set it aside already.
                value = self.def(s"arith.select ${self.flowing()}, $value, ${self.arr[self.ret_id()]} : $r")
            else
                self.op(s"scf.if ${self.flowing()} {")
                self.dirty = false
                self.keep(span, self.ret_slot, value, self.ret)
                self.op("}")
                from_slot = true

        self.release_all()
        self.frame_record()

        if r != ""
            vals.push(if from_slot then self.load(span, self.ret_slot, self.ret) else value)
            tys.push(r)

        for id in self.inout_arrays
            vals.push(self.read_array(span, id))
            tys.push(self.ty(span, self.prog.locals[id].ty))

        if vals.len() == 0 then self.op("func.return")
        else self.op(s"func.return ${joined(vals)} : ${joined(tys)}")

    // A function's results: its value, then each `inout` array parameter.
    results_text(*self, span: Span, params: Buf[usize], ret: Ty) -> string
        var tys: Buf[string] = buf()
        val r = self.ty(span, ret)

        if r != "" then tys.push(r)

        for id in params
            if self.inout_array(id) then tys.push(self.ty(span, self.prog.locals[id].ty))

        if tys.len() == 1 then tys[0] elif tys.len() == 0 then "" else s"(${joined(tys)})"

    // Whether parameter `id` is an `inout` array, passed in and handed back as a value.
    inout_array(*self, id: usize) -> bool = is_inout(self.prog.locals[id].kind) && is_arr(self.prog.locals[id].ty)

    // A parameter's MLIR type: an `inout` one is its caller's place, but for an array, which is
    // passed and returned.
    param_ty(*self, span: Span, id: usize) -> string =
        if is_inout(self.prog.locals[id].kind) && !is_arr(self.prog.locals[id].ty) then "!llvm.ptr" else self.ty(span, self.prog.locals[id].ty)

    // The parameters bound in the prologue, from block arguments `%a0`, `%a1`, ...
    bind_params(*self, span: Span, params: Buf[usize])
        for k in 0..<params.len()
            val id = params[k]

            if self.in_ssa(id)
                self.arr.set(id, s"%a$k")
                if self.inout_array(id) then self.inout_arrays.push(id)
            elif self.inout_array(id)
                self.later(span, "an `inout` array a lambda captures")
            elif is_inout(self.prog.locals[id].kind)
                self.bind_borrowed(id, s"%a$k")
            elif self.boxed[id]
                // A captured parameter's cell keeps its own count on the value.
                self.bind_local(span, id)
                self.keep(span, self.local_ptr(span, id), s"%a$k", self.prog.locals[id].ty)
            else
                self.bind_local(span, id, true)
                self.store(span, self.local_ptr(span, id), s"%a$k", self.prog.locals[id].ty)

    params_text(*self, span: Span, params: Buf[usize], env: bool) -> string
        var out = if env then "%env: !llvm.ptr" else ""

        for k in 0..<params.len()
            if out != "" then out += ", "
            out += s"%a$k: ${self.param_ty(span, params[k])}"

        out

    fun(*self, f: TFun)
        self.begin(f.ret, f.body)

        var params = f.params

        if f.name == "main" && f.params.len() == 1
            self.args_local = Some(f.params[0])
            params = buf()

        self.bind_params(f.span, params)
        self.finish_body(f.span, self.body_value(f.body))
        self.end(s"  func.func private @\"n.${f.name}\"(${self.params_text(f.span, params, false)})${arrow(self.results_text(f.span, params, f.ret))}")

    lambda(*self, id: usize)
        val l = self.prog.lambdas[id]

        self.begin(l.ret, l.body)

        val order = self.env_order(id)

        for k in 0..<order.len()
            val p = self.def(s"llvm.getelementptr %env[${k + 1}] : (!llvm.ptr) -> !llvm.ptr, !llvm.ptr")

            self.bind_borrowed(order[k], self.def(s"llvm.load $p : !llvm.ptr -> !llvm.ptr"))

        // A local `def` that calls itself reaches itself through its own code and environment.
        self.self_local[id] match
            Some(me) ->
                self.slot.set(me, self.alloca(CLOSURE))
                self.op(s"llvm.store ${self.closure(self.adapted(l.body.span, s"l.$id", l.params, l.ret), self.code_type(l.body.span, l.params, l.ret), "%env")}, ${self.slot[me]} : $CLOSURE, !llvm.ptr")
            None -> ()

        self.bind_params(l.body.span, l.params)
        self.finish_body(l.body.span, self.body_value(l.body))
        self.end(s"  func.func private @\"l.$id\"(${self.params_text(l.body.span, l.params, true)})${arrow(self.results_text(l.body.span, l.params, l.ret))}")

    // The function type of code taking an environment and `params`.
    code_type(*self, span: Span, params: Buf[usize], ret: Ty) -> string
        var out = "!llvm.ptr"

        for id in params
            val t = self.prog.locals[id].ty

            out += s", ${if is_arr(t) then self.boundary_ty(span, t) else self.param_ty(span, id)}"

        // An `inout` array is written in place through the adapter (`adapted`), so only the value
        // comes back.
        s"($out) -> ${result_text(if is_arr(ret) then self.memref_ty(span, ret) else self.ty(span, ret))}"

    // A function value: `code` and the environment `env`.
    closure(*self, code: string, ty: string, env: string) -> string
        val c = self.def(s"func.constant @\"$code\" : $ty")
        val p = self.def(s"builtin.unrealized_conversion_cast $c : $ty to !llvm.ptr")
        val u = self.def(s"llvm.mlir.undef : $CLOSURE")
        val a = self.def(s"llvm.insertvalue $p, $u[0] : $CLOSURE")

        self.def(s"llvm.insertvalue $env, $a[1] : $CLOSURE")

    // Lambda `id` as a value, its environment the cells of what it captures; the caller owns it.
    lambda_value(*self, span: Span, id: usize) -> string
        val l = self.prog.lambdas[id]

        if !self.lambdas_done[id]
            self.lambdas_done.set(id, true)
            self.lambdas_wanted.push(id)

        val order = self.env_order(id)
        var env = ""

        if order.len() == 0
            env = self.def("llvm.mlir.zero : !llvm.ptr")
        else
            // The cells it holds a count on, how many, and then the places of the `inout` parameters it
            // borrows for the call it is an argument of.
            self.declare("nex_env_drop", "llvm.func @nex_env_drop(!llvm.ptr)")
            env = self.new_object(8 * (order.len() + 1), self.def("llvm.mlir.addressof @nex_env_drop : !llvm.ptr"))

            var counted = 0

            for k in 0..<order.len()
                val c = order[k]
                val cell = self.local_ptr(span, c)
                val p = self.def(s"llvm.getelementptr $env[${k + 1}] : (!llvm.ptr) -> !llvm.ptr, !llvm.ptr")

                if !is_inout(self.prog.locals[c].kind)
                    self.retain_ref(cell)
                    counted += 1

                self.op(s"llvm.store $cell, $p : !llvm.ptr, !llvm.ptr")

            self.op(s"llvm.store ${self.def(s"arith.constant $counted : i64")}, $env : i64, !llvm.ptr")

        self.closure(self.adapted(span, s"l.$id", l.params, l.ret), self.code_type(span, l.params, l.ret), env)

    // A top-level `def` as a value, through a wrapper that takes and ignores an environment.
    fn_value(*self, span: Span, name: string) -> string
        val f = self.find_fun(name)

        if f.is_none()
            self.later(span, s"`$name` as a value")
            return ""

        val g = f.unwrap()
        val ty = self.code_type(span, g.params, g.ret)

        if !contains(self.wrappers, name)
            self.wrappers.push(name)

            var params = "%env: !llvm.ptr"
            var args = ""
            var tys = ""

            for k in 0..<g.params.len()
                val t = self.param_ty(span, g.params[k])

                params += s", %a$k: $t"
                if k > 0
                    args += ", "
                    tys += ", "
                args += s"%a$k"
                tys += t

            // The value, then each `inout` array as the function hands it back.
            val r = self.results_text(span, g.params, g.ret)
            var text = s"  func.func private @\"r.$name\"($params)${arrow(r)} {\n"

            if r == ""
                text += s"    func.call @\"n.$name\"($args) : ($tys) -> ()\n    func.return\n  }\n\n"
            else
                var outs: Buf[string] = buf()
                var names: Buf[string] = buf()

                if self.ty(span, g.ret) != "" then outs.push(self.ty(span, g.ret))

                for id in g.params
                    if self.inout_array(id) then outs.push(self.ty(span, self.prog.locals[id].ty))

                for k in 0..<outs.len()
                    names.push(result_name("%r", k, outs.len()))

                text += s"    ${result_def("%r", outs.len())}func.call @\"n.$name\"($args) : ($tys) -> $r\n    func.return ${joined(names)} : ${joined(outs)}\n  }\n\n"

            self.funcs.push(text)

        self.closure(self.adapted(span, s"r.$name", g.params, g.ret), ty, self.def("llvm.mlir.zero : !llvm.ptr"))

    find_fun(*self, name: string) -> Option[TFun]
        for d in self.prog.decls
            d match
                FunDecl(f) -> if f.name == name then return Some(f)
                _ -> ()

        None

    // -- the module -------------------------------------------------------------------------------

    whole_module(*self) -> string
        var globals: Buf[TGlobal] = buf()
        var tuples: Buf[TGlobalTuple] = buf()

        for d in self.prog.decls
            self.reported = false

            d match
                FunDecl(f) -> self.fun(f)
                GlobalDecl(g) -> globals.push(g)
                TupleGlobalDecl(g) -> tuples.push(g)
                StructDecl(_) -> ()
                EnumDecl(_) -> ()
                ExternDecl(x) -> self.later(x.span, "an `extern` declaration")

        // Each lambda and each parallel region's code is emitted after the function that makes it,
        // and may make more.
        var k = 0
        var j = 0

        while k < self.lambdas_wanted.len() || j < self.par_jobs.len()
            if k < self.lambdas_wanted.len()
                self.lambda(self.lambdas_wanted[k])
                k += 1
            else
                self.par_code(j)
                j += 1

        self.entry_point(globals, tuples)

        while k < self.lambdas_wanted.len() || j < self.par_jobs.len()
            if k < self.lambdas_wanted.len()
                self.lambda(self.lambdas_wanted[k])
                k += 1
            else
                self.par_code(j)
                j += 1

        self.helper_bodies()

        var out = str_builder()

        out.push("module {\n")
        out.push(self.top.finish())
        out.push("\n")
        out.push(self.funcs.finish())
        out.push("}\n")
        out.finish()
    end whole_module

    // The C `main`: the arguments set aside, every module-level binding initialized before anything
    // reads it, the program's `main` called and what it printed written out.
    entry_point(*self, globals: Buf[TGlobal], tuples: Buf[TGlobalTuple])
        self.begin(Void, texpr(Span(0, 0), Void, TLiteral(VoidVal, false)))

        self.call("nex_set_args", "%argc, %argv", "i32, !llvm.ptr", "")

        for k in init_order(self.prog, globals, tuples)
            val m = self.mark()

            if k < globals.len()
                val g = globals[k]

                self.keep(g.span, self.global_storage(g.span, g.name, g.ty), self.ex(g.init), g.ty)
            else
                val g = tuples[k - globals.len()]

                self.destructure(g.span, g.pat, self.ex(g.init), g.ty)

            self.release_from(m)

        if self.prog.test_build then self.run_test(self.prog.tests) else self.op("func.call @\"n.main\"() : () -> ()")

        self.call("nex_finish", "", "", "")

        val z = self.def("arith.constant 0 : i32")

        self.op(s"func.return $z : i32")
        self.end("  func.func @main(%argc: i32, %argv: !llvm.ptr) -> i32")

    // The test build's entry: the test the first argument numbers, from 0, is run, and nothing else.
    // The runner of `nex test` runs the program once per test, so each test starts from the
    // module-level bindings' initial values and a trap in one ends only that one.
    run_test(*self, tests: Buf[string])
        self.external("atoi", "!llvm.ptr", "i32")

        val slot = self.def("llvm.getelementptr %argv[1] : (!llvm.ptr) -> !llvm.ptr, !llvm.ptr")
        val text = self.def(s"llvm.load $slot : !llvm.ptr -> !llvm.ptr")
        val n = self.def(s"func.call @atoi($text) : (!llvm.ptr) -> i32")
        val k = self.def(s"arith.index_cast $n : i32 to index")
        var cases = s"scf.index_switch $k\n"

        for j in 0..<tests.len()
            cases += s"    case $j {\n      func.call @\"n.${tests[j]}\"() : () -> ()\n      scf.yield\n    }\n"

        self.op(cases + "    default {\n      scf.yield\n    }")
end Emitter

val CLOSURE = "!llvm.struct<(ptr, ptr)>"

// The runtime functions that never return: each traps or ends the program.
private never_returns(name: string) -> bool = name == "nex_trap" || name == "nex_trap_owned" || name == "nex_trap_complex_div_zero" || name == "nex_stop"

// The program as an MLIR module, or why it cannot be compiled.
emit_program(p: TProgram, fpe_trap: bool) -> Result[string, Buf[Diagnostic]]
    var slots: Buf[string] = buf()
    var boxed: Buf[bool] = buf()

    for _ in 0..<p.locals.len()
        slots.push("")
        boxed.push(false)

    var done: Buf[bool] = buf()

    val selves = self_locals(p)

    for k in 0..<p.lambdas.len()
        done.push(false)

        for c in p.lambdas[k].captures
            if selves[k] != Some(c) then boxed.set(c, true)

    var e = Emitter(p, buf(), fpe_trap, str_builder(), str_builder(), str_builder(), str_builder(), 0, Void, "", "",
                    buf(), buf(), slots, boxed, buf(), buf(), done, buf(), None, false, false, buf(), buf(), buf(), buf(),
                    buf(), buf(), selves, buf(), buf(), buf(), buf(), buf(), buf(), false, uses_parallel(p), "", buf(), buf())
    val text = e.whole_module()

    if e.diags.len() > 0 then return Err(e.diags)

    Ok(text)

private arrow(result: string) -> string = if result == "" then "" else s" -> $result"

result_text(t: string) -> string = if t == "" then "()" else t

is_inout(k: LocalKind) -> bool = k match
    LParam(m) -> m == Inout
    _ -> false

private contains(names: Buf[string], name: string) -> bool
    for n in names
        if n == name then return true

    false

// Whether `e` holds an `exit`, a `cycle` or a `return` of the function it is in.
may_leave(e: TExpr) -> bool
    *e.kind match
        TReturn(_) -> return true
        TExit(_) -> return true
        TCycle(_) -> return true
        _ -> ()

    for c in children(e)
        if may_leave(c) then return true

    false

// A string's bytes as an MLIR string attribute spells them: printable ASCII as itself, the rest, a
// quote and a backslash as two hex digits after a backslash.
mlir_bytes(text: string) -> string
    var out = str_builder()
    val digits = "0123456789ABCDEF"

    for k in 0..<text.len
        val c = text.bytes[k]

        if c >= 32 && c < 127 && c != u8('"') && c != u8('\\')
            out.push(text[k..<k + 1])
        else
            out.push("\\")
            out.push(digits[usize(c >> 4)..<usize(c >> 4) + 1])
            out.push(digits[usize(c & 15)..<usize(c & 15) + 1])

    out.finish()

// The module-level bindings in an order where each is initialized before any initializer reads it,
// through the functions it calls too. The elaborator has refused a cycle.
// The initializers are numbered the plain bindings first, then the destructuring ones.
private init_order(p: TProgram, globals: Buf[TGlobal], tuples: Buf[TGlobalTuple]) -> Buf[usize]
    var inits: Buf[TExpr] = buf()
    var binds: Buf[Buf[string]] = buf()

    for g in globals
        inits.push(g.init)

        var names: Buf[string] = buf()

        names.push(g.name)
        binds.push(names)

    for g in tuples
        inits.push(g.init)

        var names: Buf[string] = buf()

        bound_names(g.pat, &names)
        binds.push(names)

    var out: Buf[usize] = buf()
    var placed: Buf[bool] = buf()

    for _ in inits
        placed.push(false)

    for k in 0..<inits.len()
        place_global(p, inits, binds, k, &placed, &out)

    out

private bound_names(pat: TBind, out: *Buf[string])
    pat match
        BGlobal(n) -> out.push(n)
        BTuple(elems) ->
            for e in elems
                bound_names(e, out)
        _ -> ()

private place_global(p: TProgram, inits: Buf[TExpr], binds: Buf[Buf[string]], k: usize, placed: *Buf[bool], out: *Buf[usize])
    if placed[k] then return

    placed.set(k, true)

    var names: Buf[string] = buf()
    var seen: Buf[string] = buf()

    reads(p, inits[k], &names, &seen)

    for n in names
        for j in 0..<inits.len()
            if contains(binds[j], n) then place_global(p, inits, binds, j, placed, out)

    out.push(k)

// The module-level bindings `e` reads, directly or through the functions and lambdas it reaches;
// `seen` holds the functions already walked.
private reads(p: TProgram, e: TExpr, names: *Buf[string], seen: *Buf[string])
    for c in children(e)
        reads(p, c, names, seen)

    *e.kind match
        TGlobalRef(n) -> names.push(n)
        TFnRef(n) ->
            if !contains(*seen, n)
                seen.push(n)

                for d in p.decls
                    d match
                        FunDecl(f) -> if f.name == n then reads(p, f.body, names, seen)
                        _ -> ()
        TLambdaRef(id) ->
            val key = s"#$id"

            if !contains(*seen, key)
                seen.push(key)
                reads(p, p.lambdas[id].body, names, seen)
        _ -> ()
