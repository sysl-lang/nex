
def normalize(v: [real]) =
  val mag = sqrt(sum(v * v))
  if mag == 0.0 then v
  else v / mag

def normalize_loop(v: [real]) =
  val n = length(v)
  val mag = sqrt(sum(v * v))
  if mag == 0.0 then v
  else
    var out = fill(n, 0.0)
    for i in 1..n do
      out[i] = v[i] / mag
    end for
    out

def main() =
  val a = [3.0, 4.0]
  val b = normalize(a)
  print(b)

  val c = normalize_loop([3.0, 4.0])
  print(c)

  var d = [9.0, 9.0, 9.0, 9.0]
  d[1..2] = [0.6, 0.8]
  print(d)
      