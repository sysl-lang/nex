
def rk4_step(f: (real, [real]) -> [real], t: real, y: [real], h: real) =
  val k1 = f(t,       y)
  val k2 = f(t + h/2, y + h/2 * k1)
  val k3 = f(t + h/2, y + h/2 * k2)
  val k4 = f(t + h,   y + h   * k3)
  y + h/6 * (k1 + 2k2 + 2k3 + k4)

def harmonic(t: real, y: [real]) =
  [y[2], -y[1]]

def main() =
  var y = [1.0, 0.0]
  var t = 0.0
  val h = 0.01
  val steps = 100

  for k in 1..steps do
    y = rk4_step(harmonic, t, y, h)
    t = t + h
  end for

  print(s"position=${y[1]}, velocity=${y[2]}")
      