
def power_iteration(A: [[real]], iters: integer) =
  val n = rows(A)
  var v = fill(n, 1.0)
  var lambda = 0.0

  for k in 0..iters do
    val Av = A @ v
    val norm = sqrt(dot(Av, Av))
    v = Av / norm
    lambda = dot(v, A @ v)
  end for

  (lambda, v)

def main() =
  val A = [[3.0, 2.0],
           [2.0, 3.0]]

  val lambda, v = power_iteration(A, 50)

  print(s"dominant eigenvalue ~ $lambda")
  print(s"corresponding eigenvector ~ $v")
      