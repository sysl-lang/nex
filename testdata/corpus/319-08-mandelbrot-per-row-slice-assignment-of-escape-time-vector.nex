
def escape_iters(c: complex, max_iter: integer) =
  var z = 0i
  var k = 0
  while k < max_iter and z.abs() <= 2.0
    z = z*z + c
    k = k + 1
  end while
  k

def row_at(py: integer, width: integer, height: integer, max_iter: integer) =
  var row = fill(width, 0)
  for px in 1..width
    val x = -2.0 + 3.0 * to_real(px - 1) / to_real(width)
    val y = -1.5 + 3.0 * to_real(py) / to_real(height)
    row[px] = escape_iters(x + y*i, max_iter)
  end for
  row

def main() =
  var result = fill((3, 8), 0)
  for py in 1..3
    result[py, :] = row_at(py - 1, 8, 3, 20)
  end for
  for py in 1..3
    print(maxval(result[py]))
  end for
      