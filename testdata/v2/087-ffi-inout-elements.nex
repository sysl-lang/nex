// An element of an array place passed `inout` to C (DESIGN §8.2, §10.7): to a scalar `inout`
// parameter, as the address C writes through, and to a `[*; ..]` one, as a descriptor of rank 0;
// of a vector, a matrix, a window, a strided and a reversed one; an index with an effect, evaluated
// once; an element of a struct's array field and a field of an array's element; a complex element;
// two elements of one array in one call; an element of an `inout` parameter passed on; and an index
// out of bounds trapping before C is called.

@link("nexffi")
extern def nf_divmod(a: int32, b: int32, q: inout int32, r: inout int32)
@link("nexffi")
extern def nf_accumulate(x: real, total: inout real, count: inout integer)
@link("nexffi")
extern def nf_desc_fill(x: inout [*; ..])
@link("nexffi")
extern def nf_desc_add(a: inout [*; ..], b: [*; ..])

struct P
  x: real
  y: real

struct S
  v: [int32]
  n: int32

var calls = 0

def at(k: integer): integer =
  calls += 1
  k

def accumulate_last(t: inout [real], c: inout [integer]) =
  nf_accumulate(2.5, t[end], c[end])
  nf_desc_add(t[1], t[end])

def main() =
  var qr: [int32] = [0, 0, 0, 0]
  nf_divmod(17, 5, qr[2], qr[3])
  print(qr)
  var rs: [int32] = [0, 0]
  nf_divmod(23, 4, qr[.. by -1][1], rs[1])
  nf_divmod(19, 7, qr[1..3 by 2][1], rs[2])
  print(qr)
  print(rs)

  var m: [int32; :, :] = [[0, 0, 0], [0, 0, 0]]
  nf_divmod(9, 2, m[2, 3], m[1, 1])
  nf_divmod(7, 3, m[:, 2][1], rs[1])
  nf_divmod(8, 3, m[2, :][1], rs[2])
  nf_desc_fill(m[1, 3])
  print(m)
  print(rs)

  var t = [0.0, 0.0, 0.0]
  var c = [0, 0, 0]
  nf_accumulate(1.5, t[at(2)], c[at(2)])
  print(t)
  print(c)
  print(calls)
  accumulate_last(t, c)
  print(t)
  print(c)

  var a = [0.0, 0.0, 0.0, 0.0]
  nf_desc_fill(a[3])
  nf_desc_fill(a[2..][1])
  nf_desc_add(a[4], a[3])
  print(a)

  var zs = [1 + 2i, 3 - 1i]
  nf_desc_fill(zs[2])
  print(zs)

  var s = S([0, 0, 0], 0)
  nf_divmod(11, 4, s.v[2], s.n)
  print(s.v)
  print(s.n)

  var ps = [P(0.0, 0.0), P(0.0, 0.0)]
  var counts = [0, 0]
  nf_accumulate(4.0, ps[2].x, counts[1])
  nf_desc_fill(ps[1].y)
  print(s"${ps[1].x} ${ps[1].y} ${ps[2].x} ${ps[2].y}")
  print(counts)

  var w: [int32] = [1, 2]
  assert_traps(() -> nf_divmod(1, 1, w[3], w[1]), "out of bounds")
  print(w)
  var w0 = [1.0, 2.0]
  assert_traps(() -> nf_desc_fill(w0[0]), "out of bounds")
  print(w0)
