// DESIGN §9.1 and §9.4 rule 1: a `parallel for` writes elements and slices each iteration owns,
// over one or two clauses, with steps; a body binds its own locals, runs inner loops and `cycle`s.

def scale_all(a: inout [real], k: real) =
  parallel for i in 1..length(a)
    a[i] = a[i] * k

def main() =
  // An element per iteration, across many blocks of iterations.
  val n = 100000
  val x: [real] = linspace(0.0, 1.0, n)
  var y: [real] = ones(n)
  parallel for i in 1..n do y[i] = 2.0 * x[i] + y[i]
  print(y[1])
  print(y[n])
  print(y[50001])

  // A column per iteration, written and read through its slice.
  val m = 5
  var g: [real; :, :] = ones((m, m))
  parallel for j in 1..m
    g[:, j] = g[:, j] * j
    g[:, j] = g[:, j] / sum(g[:, j])
  print(g[:, 3])
  print(sum(g))

  // Two clauses, the first varying fastest; an element per pair.
  var c: [integer; :, :] = zeros((3, 4))
  parallel for i in 1..3, j in 1..4
    c[i, j] = 10 * i + j
  print(c)

  // Inner loops, a local of the body's own, and `cycle`.
  var w: [real] = zeros(9000)
  parallel for i in 1..9000
    var acc = 0.0
    for k in 1..3
      acc += k * 1.0
      w[i] += 1.0
    if i % 2 == 0 then cycle
    w[i] = -acc
  print(w[1])
  print(w[2])
  print(sum(w))

  // A step, a negative step and an empty range.
  var s: [integer] = zeros(10)
  parallel for i in 1..10 by 3 do s[i] = 1
  parallel for i in 10..1 by -4 do s[i] = s[i] + 2
  parallel for i in 1..0 do s[i] = 99
  print(s)

  // An `inout` array parameter written in parallel, and the array a loop copies first.
  var z: [real] = linspace(1.0, 2.0, 5)
  val before = z
  scale_all(z, 2.0)
  print(z)
  print(before)
