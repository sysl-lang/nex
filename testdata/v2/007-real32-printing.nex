def main() =
  val a: real32 = 0.1
  val b: real32 = 1.0e-10
  val c: real32 = 3.4028235e38
  val d: real32 = 16777217.0
  val e: real32 = 1.0e7
  val f: real32 = 0.001
  val g: real32 = 0.0001
  val h: real32 = 123456.79
  val k: real32 = -2.5
  val m: real32 = 1.0e15
  val z: real32 = 0.0
  print(a)
  print(b)
  print(c)
  print(d)
  print(e)
  print(f)
  print(g)
  print(h)
  print(k)
  print(m)
  print(z)
  print(1.0 / z)
  print(z / z)
  print(s"$a and $k")
  print(f"$a%.10f")
