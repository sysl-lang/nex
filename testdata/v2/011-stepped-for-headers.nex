def count_by(s: integer) =
  for k in 1..3 by s do print(k)

def main() =
  for k in 1..10 by 3 do print(k)
  print("-")
  for k in 10..1 by -4 do print(k)
  print("-")
  for k in 1..<10 by 3 do print(k)
  print("-")
  for k in 10..<1 by -3 do print(k)
  print("-")
  for k in 5..1 do print(k)
  for k in 1..5 by -1 do print(k)
  print("-")
  val hi: int8 = 127
  var count = 0
  for k in hi - 3..hi do count += 1
  print(count)
  val lo: int8 = -128
  for k in lo + 2..lo by -1 do print(k)
  val first: uint8 = 0
  for k in first..3 do print(k)
  assert_traps(() -> count_by(0), "step of 0")
  print("a step of 0 traps")
