// DESIGN §7.4: `findloc(a, value)` is the index of the first element equal to `value`, a tuple of
// indices for rank ≥ 2, every index 0 where there is none, as Fortran 2008's FINDLOC. `back = true`
// takes the last, `dim =` finds along an axis, and `value` meets the elements as `==`'s right
// operand does.

def ax(k: integer) = k

def main() =
  // Rank 1: first, last, absent, empty.
  val v = [3, 1, 4, 1, 5, 9]
  print(findloc(v, 1))
  print(findloc(v, 1, back = true))
  print(findloc(v, 7))
  print(findloc(v, 7, back = true))
  val e: [integer] = zeros(0)
  print(findloc(e, 1))
  val late = 2 > 1
  print(findloc(v, 1, back = late))

  // The value meets the elements as `==` does: a real value against integers, a literal adopting.
  print(findloc(v, 4.0))
  print(findloc(v, 4.5))
  val r = [0.5, nan, -0.0, 2.0]
  print(findloc(r, 0.0))
  print(findloc(r, nan))
  print(findloc([true, false, true], true, back = true))

  // Rank 2 in storage order, the first index fastest, and along each axis.
  val m = [[1, 3, 5], [2, 2, 2]]
  print(findloc(m, 2))
  print(findloc(m, 2, back = true))
  print(findloc(m, 8))
  print(findloc(m, 2, dim = 1))
  print(findloc(m, 2, dim = 2))
  print(findloc(m, 2, dim = 1, back = true))
  print(findloc(m, 2, dim = 2, back = true))
  print(findloc(m, 2, dim = ax(2)))
  print(findloc(m, 5, dim = ax(1), back = true))
  assert_traps(() -> print(findloc(m, 2, dim = ax(3))), "not an axis")

  // Rank 3.
  val c = reshape([1, 2, 3, 4, 5, 6, 7, 8], (2, 2, 2))
  print(findloc(c, 7))
  print(findloc(c, 4, dim = 3))

  // Views: strided, reversed, a column, a window; the index is the view's own.
  print(findloc(v[1..end by 2], 5))
  print(findloc(v[end..1 by -1], 1))
  print(findloc(v[end..1 by -2], 1, back = true))
  print(findloc(m[:, 3], 2))
  print(findloc(m[2, 2..3], 2, back = true))

  // Widths: int8 elements and a value of int64 meet in int64; real32 and its literal.
  val s: [int8] = [-1, 0, 1]
  print(findloc(s, 1))
  val f: [real32] = [0.1, 0.2, 0.3]
  print(findloc(f, 0.2))
  print(findloc(f, 0.2, dim = 1, back = true))

  // Units: the value is converted to the elements' unit.
  val d = [1.0<m>, 0.5<m>, 2.0<m>]
  print(findloc(d, 50.0<cm>))
  print(findloc(d, 2000.0<mm>, back = true))

  // Inside a `parallel for`, each iteration a lane of its own.
  val g = [[1, 0, 1], [0, 1, 1], [1, 1, 0], [0, 0, 0]]
  var where: [integer] = zeros(3)
  parallel for j in 1..3
    where[j] = findloc(g[:, j], 0)
  print(where)
  print("done")
