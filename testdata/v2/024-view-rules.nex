// The rules of DESIGN §6.2: a view bound to a `var` is a copy that changes alone; a view returned,
// captured by an escaping lambda or bound at module level keeps its values; a view of a
// `var` keeps the values it was taken with when the source is written; an overlapping self-assignment
// shifts; and a strided plane of a rank-3 array is read where it lies.

val primes = [2, 3, 5, 7, 11, 13]
val odd_primes = primes[2..]

def middle(v: [integer]) = v[2..end-1]

def reader(v: [integer]): () -> integer =
  val tail = v[3..]
  () -> sum(tail)

def main() =
  var a = [1, 2, 3, 4, 5, 6]
  var w = a[2..4]
  w[1] = 100
  print(s"$a $w")

  val m = middle(a)
  a[3] = -3
  print(s"$m $a")

  val f = reader(a)
  a[end] = 0
  print(s"${f()} $a")
  print(odd_primes)

  val before = a[2..5]
  val shifted = origin(a, 0)
  val back = a[.. by -1]
  a[2..5] = 9
  print(s"$before ${shifted[0]} $back $a")

  var b = [1, 2, 3, 4, 5]
  b[2..] = b[..end-1]
  print(b)
  b[..end-1] = b[2..]
  print(b)
  b[.. by -1] = b
  print(b)

  val t = reshape(linspace(1.0, 24.0, 24), (2, 3, 4))
  val plane = t[2, :, 1..4 by 2]
  print(plane)
  print(sum(plane))
  print(shape(t[:, 1..3 by 2, end]))
  print(t[:, 1..3 by 2, end])
