// args: a scratch directory
// A table of 100000 rows (DESIGN §17.7): three columns of reals written by `write_table` and read
// back exactly, its first and last lines as written; two columns of integers written as comma
// lines by `write_line` and read with a header skipped.

def main(args: [string]) =
  val dir = args[1]
  val path = s"$dir/large.dat"
  val n = 100000
  var a: [real; :, :] = zeros((n, 3))
  for i in 1..n
    a[i, 1] = to_real(i)
    a[i, 2] = to_real(i) / 7.0
    a[i, 3] = sqrt(to_real(i)) * 1.0e-300
  write_table(path, a)!
  val lines = read_lines(path)!
  print(s"${length(lines)} lines: ${lines[1]} | ${lines[n]}")
  val b = read_table(path)!
  var bad = 0
  for i in 1..n
    for j in 1..3
      if a[i, j] != b[i, j] then bad += 1
  print(s"${extent(b, 1)}x${extent(b, 2)}, $bad differ, sum ${sum(b[:, 1])}")

  val out = open(path, Write)!
  write_line(out, "k, k squared")!
  for k in 1..n
    write_line(out, s"$k, ${k * k}")!
  close(out)!
  val c: [int64; :, :] = read_table(path, skip = 1)!
  print(s"${extent(c, 1)}x${extent(c, 2)}: ${c[n, 1]} ${c[n, 2]}, sum ${sum(c[:, 2])}")
  remove(path)!
