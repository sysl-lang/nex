// A window of a place passed `inout` is written where it lies (DESIGN §8.2), in a `parallel for`
// whose iteration owns it (§9.4 rule 3) as in sequential code: a column, a row, strided and reversed
// windows, a plane's line of a rank-3 array, windows of an `inout` parameter, and two windows of one
// owned column in turn. The callee may be a top-level function, a local `def`, a function value or a
// parameter of function type; the array may be one a lambda captures, also from inside a nested
// `def`, and a `val` sharing it keeps the values it had.

def normalize(v: inout [real]) =
  v = v / norm2(v)

def bump(v: inout [integer], by: integer) =
  for k in 1..length(v)
    v[k] += by

def apply(f: (inout [integer], integer) -> void, v: inout [integer]) =
  f(v[2..], 5)

def columns(m: inout [integer; :, :]) =
  parallel for j in 1..cols(m)
    bump(m[:, j], j)

def main() =
  var u = [[3.0, 0.0, 6.0], [4.0, 5.0, 8.0]]
  parallel for j in 1..3
    normalize(u[:, j])
  print(u)

  var m = fill((3, 4), 0)
  parallel for i in 1..3
    bump(m[i, :], 10 * i)
  print(m)
  parallel for j in 1..4
    bump(m[1..3 by 2, j], 100)
    bump(m[.. by -2, j], 1000)
  print(m)
  columns(m)
  print(m)

  var t = fill((2, 3, 4), 0)
  parallel for i in 1..2, k in 1..4
    bump(t[i, :, k], 10 * i + k)
  print(t[2, :, :])

  var w = fill((3, 4), 0)
  def twice(v: inout [integer]) =
    bump(v, 1)
    bump(v, 1)
  twice(w[:, 2])
  twice(w[3, :])
  parallel for j in 1..4
    twice(w[:, j])
  print(w)
  val f = bump
  f(w[2, 1..4 by 3], 100)
  apply(bump, w[:, 4])
  print(w)

  var c = fill((2, 3), 1)
  def show() = print(c)
  val before = c
  parallel for j in 1..3
    bump(c[:, j], j)
  show()
  print(before)

  var d = fill((2, 3), 0)
  def rows() =
    parallel for i in 1..2
      bump(d[i, :], i)
  rows()
  print(d)
