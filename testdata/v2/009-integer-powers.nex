def main() =
  print(2 ^ 10)
  print(3 ^ 0)
  print((-2) ^ 3)
  print(2 ^ -1)
  print(1 ^ -5)
  print((-1) ^ -3)
  print((-1) ^ -4)
  val z = 0
  assert_traps(() -> print(z ^ -1), "division by zero")
  print("0 ^ -1 traps")
  assert_traps(() -> print(2 ^ 63), "int64 overflow")
  print("2 ^ 63 traps")
  print((-2) ^ 63)
  val u: uint8 = 2
  print(u ^ 7)
  assert_traps(() -> print(u ^ 8), "uint8 overflow")
  print("uint8 2 ^ 8 traps")
  val x = 2.0
  print(x ^ -1)
  print(x ^ 0.5)
