// A unit's name written against a literal: `10mm` is `10<mm>`. One name is the whole unit, and a
// compound unit is bracketed.

unit tooth

def gear_pitch(teeth: real<tooth>, diameter: real<mm>): real<mm/tooth> = pi * diameter / teeth

def main() =
    // A plate in millimetres, with an inch-sized hole: the inch converts to the left operand's unit.
    val width = 120mm
    val hole = 0.25in
    print(width - hole)
    print(width + 2.5e-1in)

    // A negative literal, a power, and a bracketed compound unit beside the shorthand.
    val depth = -3mm
    print(depth)
    print(10mm^2)
    val g = 9.81<m/s^2>
    print(g * 2s * 2s)

    // An angle in radians and a time in milliseconds.
    print(sin(strip(0.5rad)))
    print(to<s>(1500ms))

    // A local named like a unit does not change what `3m` means; `3 * m` multiplies by it.
    val m = 2.0
    print(3m)
    print(3 * m)

    // A unit the program declares, and the literal's width taken from context.
    print(gear_pitch(20tooth, 40mm))
    val thin: real32<mm> = 0.1mm
    print(thin + 1in)

    // A comparison chain and a range of measured literals.
    val x = 7mm
    print(0mm < x < 1cm)
    for k in 1..3
        print(k * 1.5ft)
