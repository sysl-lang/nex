// Stencils written with `cshift` and `eoshift` (DESIGN §4.3, §7.1): a periodic 1-D Jacobi sweep
// assigned back to the array it shifts, against the same sweep written as a loop over indices; the
// stencil `0.5 * (cshift(u, 1) + cshift(u, -1)) - u` and a fixed-boundary one with `eoshift`; a
// periodic five-point Laplacian on a matrix; `real32`; a shift of a strided window; and shifts
// inside a `parallel for` and a `parallel` expression, each equal to the sequential answer.

def jacobi_loop(u: [real]): [real] =
  val n = length(u)
  var w: [real] = zeros(n)
  for i in 1..n
    val l = if i == 1 then u[n] else u[i - 1]
    val r = if i == n then u[1] else u[i + 1]
    w[i] = 0.5 * (l + r)
  w

def main() =
  val n = 9
  var u: [real] = zeros(n)
  for i in 1..n do u[i] = real(i * i) / 7.0

  // A Jacobi sweep, fifty times.
  var a = u
  var b = u
  for _ in 1..50
    a = jacobi_loop(a)
    b = 0.5 * (cshift(b, -1) + cshift(b, 1))
  print(b)
  print(all(a == b))

  // The second difference, periodic and with fixed ends.
  val s = 0.5 * (cshift(u, 1) + cshift(u, -1)) - u
  var t: [real] = zeros(n)
  for i in 1..n
    val l = if i == 1 then u[n] else u[i - 1]
    val r = if i == n then u[1] else u[i + 1]
    t[i] = 0.5 * (r + l) - u[i]
  print(s)
  print(all(s == t))
  val fixed = eoshift(u, 1) - 2.0 * u + eoshift(u, -1, 1.0)
  print(fixed)
  print(fixed[1] == u[2] - 2.0 * u[1] + 1.0)
  print(fixed[n] == 0.0 - 2.0 * u[n] + u[n - 1])

  // A periodic five-point Laplacian.
  val g0: [real; :, :] = reshape(linspace(1.0, 12.0, 12), (3, 4))
  val g = g0 * g0
  val lap = cshift(g, 1) + cshift(g, -1) + cshift(g, 1, dim = 2) + cshift(g, -1, dim = 2) - 4.0 * g
  var want: [real; :, :] = zeros((3, 4))
  for i in 1..3
    for j in 1..4
      val dn = if i == 3 then g[1, j] else g[i + 1, j]
      val up = if i == 1 then g[3, j] else g[i - 1, j]
      val rt = if j == 4 then g[i, 1] else g[i, j + 1]
      val lf = if j == 1 then g[i, 4] else g[i, j - 1]
      want[i, j] = dn + up + rt + lf - 4.0 * g[i, j]
  print(lap)
  print(all(lap == want))

  // `real32`, and a strided window.
  val h: [real32] = [1.0, 4.0, 9.0, 16.0, 25.0]
  print(0.5 * (cshift(h, 1) + cshift(h, -1)) - h)
  print(cshift(u[1..end by 2], 2) - u[1..end by 2])

  // Inside `parallel`.
  var p: [real] = zeros(n)
  var q: [real] = zeros(n)
  parallel for i in 1..n do p[i] = sum(cshift(u, i) * u)
  for i in 1..n do q[i] = sum(cshift(u, i) * u)
  print(all(p == q))
  val w = parallel 0.5 * (cshift(u, 1) + cshift(u, -1)) - u
  print(all(w == s))
