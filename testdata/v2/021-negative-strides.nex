// Negative strides (DESIGN §5.4): every row of the section's example, a reversed column, the
// bounds read in the direction of travel, empty and out-of-bounds windows, a reversed slice as an
// assignment target, `reverse(a)` and `reverse(a, k)`, and reversed views passed and reduced.

def total(v: [integer]) = sum(v)

def last_of(v: [integer]) = v[end]

def main() =
  val a = [10, 20, 30, 40, 50, 60, 70]
  print(a[5..2 by -1])
  print(a[5..<2 by -1])
  print(a[.. by -1])
  print(a[end..1 by -1])
  print(a[.. by -2])
  print(a[end-1.. by -3])
  print(a[..3 by -2])
  print(a[4..4 by -1])

  // Empty windows: the stop one past the start, going down.
  print(length(a[1..2 by -1]))
  print(length(a[3..<3 by -1]))
  assert_traps(() -> print(a[8..1 by -1]), "out of bounds")
  assert_traps(() -> print(a[5..0 by -1]), "out of bounds")
  assert_traps(() -> print(a[2..5 by -1]), "out of bounds")
  print("windows outside the axis trap")

  // Reversed views are views: passed, indexed, reduced, viewed again.
  val r = a[.. by -1]
  print(s"${r[1]} ${r[end]} ${r[2..3]}")
  print(s"${total(r)} ${last_of(r)} ${sum(r[.. by -2])}")
  print(r[.. by -1])
  print(r[2..6 by 2])
  print(r[.. by -1][2..3])

  val m = [[1, 2, 3], [4, 5, 6]]
  print(m[:, end..1 by -1])
  print(m[end..1 by -1, :])
  print(m[.. by -1, .. by -2])
  print(m[2, .. by -1])
  print(sum(m[:, end..1 by -1], dim = 2))

  // As assignment targets, back to front.
  var b = [1, 2, 3, 4]
  b[.. by -1] = [7, 8, 9, 10]
  print(b)
  b[4..1 by -2] = 0
  print(b)
  b[3..1 by -1] += [100, 200, 300]
  print(b)
  var g = zeros((2, 3))
  g[:, end..1 by -1] = [[1, 2, 3], [4, 5, 6]]
  print(g)

  print(reverse(a))
  print(reverse(m, 1))
  print(reverse(m, 2))
  var k = 2
  print(reverse(m, k))
  k = 3
  assert_traps(() -> print(reverse(m, k)), "not an axis")
  print("reverse along a third axis of a matrix traps")
