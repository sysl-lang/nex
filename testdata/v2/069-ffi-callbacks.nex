// C calling nex back (DESIGN §10.2.1): a quadrature routine integrating a `def` and a lambda passed
// as bare function pointers, and capturing closures passed with their user data — one integrating
// inside another; a qsort-style sort by a `def`, and by a closure whose user data C passes first;
// complexes, narrow integers and a `bool` crossing to callbacks and back; a callback with no result
// writing what it captures; libm's `cos` passed as itself, as a closure and as a function value; and
// traps inside callbacks, each raised where C was called once C has returned, the callbacks C makes
// after it not run.

@link("nexffi")
extern def nf_integrate(f: (real, c_ptr) -> real, data: @data(f) c_ptr, a: real, b: real, n: int32): real

@link("nexffi")
extern def nf_integrate_plain(f: (real) -> real, a: real, b: real, n: int32): real

@link("nexffi")
extern def nf_sort(n: int32, x: inout [real], cmp: (real, real) -> int32)

@link("nexffi")
extern def nf_sort_r(n: int32, x: inout [real], data: @data(cmp) c_ptr, cmp: (c_ptr, real, real) -> int32)

@link("nexffi")
extern def nf_twice(f: (complex) -> complex, z: complex): complex

@link("nexffi")
extern def nf_twice32(f: (complex[real32], c_ptr) -> complex[real32], data: @data(f) c_ptr, z: complex[real32]): complex[real32]

@link("nexffi")
extern def nf_count_if(n: int32, x: [int8], pred: (int8, uint16, c_ptr) -> bool, data: @data(pred) c_ptr, k: uint16): int32

@link("nexffi")
extern def nf_each(n: int32, f: (int32, c_ptr) -> void, data: @data(f) c_ptr)

@link("nexffi")
extern def nf_sum_calls(f: (real, c_ptr) -> real, data: @data(f) c_ptr, n: int32): real

@link("nexffi")
extern def nf_calls_made(): int32

@link("m")
extern def cos(x: real): real

def square(x: real): real = x * x

def ascending(a: real, b: real): int32 = if a < b then -1 else if a > b then 1 else 0

// A callback that prints its argument and traps past 3.
def step(x: real): real =
  print(x)
  assert(x < 3.0, s"callback at $x")
  x

def main() =
  val pi = 3.141592653589793

  // Bare function pointers: a `def`, and a lambda that captures nothing.
  print(nf_integrate_plain(square, 0.0, 3.0, 6))
  print(abs(nf_integrate_plain(x -> 4.0 / (1.0 + x * x), 0.0, 1.0, 100) - pi) < 1e-12)

  // With user data: a `def`, closures, a function value, and a closure integrating another.
  val k = 3.0
  print(nf_integrate(square, 0.0, 3.0, 6))
  print(nf_integrate(x -> k * x, 0.0, 2.0, 4))
  val f: (real) -> real = if k > 2.0 then square else (x -> x)
  print(nf_integrate(f, 0.0, 3.0, 6))
  print(nf_integrate(x -> nf_integrate(y -> x * y, 0.0, 2.0, 2), 0.0, 1.0, 2))

  // An extern passed as itself, wrapped as a closure, and as a value.
  print(abs(nf_integrate_plain(cos, 0.0, pi / 2.0, 100) - 1.0) < 1e-8)
  print(abs(nf_integrate(cos, 0.0, pi / 2.0, 100) - 1.0) < 1e-8)
  val c = cos
  print(c(0.0))

  // A comparator for a qsort-style sort, bare and with its data first.
  var xs = [3.0, -1.0, 2.5, 0.0, 10.0]
  nf_sort(5, xs, ascending)
  print(xs)
  var near = [3.0, -1.0, 2.5, 0.0, 10.0]
  val centre = 2.0
  nf_sort_r(5, near, (a, b) -> ascending(abs(a - centre), abs(b - centre)))
  print(near)

  // Complexes by value both ways; narrow integers and a bool; no result.
  print(nf_twice(z -> z * 1i, 1 + 2i))
  val w: complex[real32] = 2 + 1i
  print(nf_twice32(z -> z * w, 1 - 1i))
  val bytes: [int8] = [-5, 3, 120, -128, 7]
  val limit: int32 = 12
  print(nf_count_if(5, bytes, (b, m) -> int32(b) + int32(m) > limit, 10))
  var total = 0
  def add(j: int32) =
    total += j * j
  nf_each(4, add)
  print(total)

  // A trap inside a callback: the calls after it are made by C and do not run.
  assert_traps(() -> print(nf_sum_calls(x -> step(x), 5)), "callback at 3.0")
  print(nf_calls_made())
  // In a callback of a callback: it ends the inner call, then the outer one.
  assert_traps(() -> print(nf_integrate(x -> nf_integrate(y -> step(x + y + 2.5), 0.0, 1.0, 2), 0.0, 1.0, 2)), "callback at 3.5")
  print(nf_sum_calls(x -> step(x), 2))
