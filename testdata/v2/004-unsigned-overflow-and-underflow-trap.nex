def main() =
  val a: uint8 = 255
  assert_traps(() -> print(a + 1), "uint8 overflow")
  print("255 + 1 traps")
  val z: uint8 = 0
  assert_traps(() -> print(z - 1), "uint8 overflow")
  print("0 - 1 traps")
  val b: uint16 = 65535
  print(b - 1)
  val c: uint32 = 65536
  assert_traps(() -> print(c * c), "uint32 overflow")
  print("65536 * 65536 traps")
  val d: uint64 = 9223372036854775807
  print(d + d + 1)
  assert_traps(() -> print(d + d + 2), "uint64 overflow")
  print("2^64 traps")
  val e: uint64 = 0
  assert_traps(() -> print(e - 1), "uint64 overflow")
  print("uint64 0 - 1 traps")
  print(a div 2)
  print(a % 7)
  val f: uint8 = 0
  assert_traps(() -> print(a div f), "division by zero")
  print("done")
