// DESIGN §7.3: `modulo(a, p)` has the sign of `p`, as Fortran's MODULO, where `%` has the sign of
// the dividend, as Fortran's MOD. Integers trap on a zero `p` as `%` does; reals follow gfortran,
// `fmod`'s exact remainder moved into `p`'s sign, a zero result taking `p`'s sign.

def main() =
  // Integers, every pair of signs, beside `%`.
  for (x, y) in [(7, 3), (-7, 3), (7, -3), (-7, -3), (0, 5), (6, 3), (-6, -3), (13, -4)]
    print(s"$x $y ${modulo(x, y)} ${x % y}")

  // At the ends of a type's range: `min` by -1 is 0, and adding `p` never overflows.
  val lo: int8 = -128
  print(modulo(lo, int8(-1)))
  print(modulo(lo, int8(3)))
  print(modulo(int8(127), int8(-128)))
  val big: uint64 = 18446744073709551615
  print(modulo(big, uint64(10)))
  print(modulo(uint8(250), uint8(7)))

  // A zero divisor traps, scalar and element by element.
  val z = 0
  assert_traps(() -> print(modulo(5, z)), "`modulo` by zero")
  assert_traps(() -> print(modulo([1, 2], [3, z])), "`modulo` by zero")
  assert_traps(() -> print(modulo(int8(1), int8(z))), "`modulo` by zero")

  // Reals: signed zeros, halves, a tiny negative that rounds up to `p`, a large dividend.
  for (x, y) in [(-0.0, 3.0), (0.0, -3.0), (5.5, -2.0), (-5.5, 2.0), (5.5, 2.0), (-5.5, -2.0), (-6.0, 3.0), (-3.0, -3.0), (1.0e-20, 3.0), (-1.0e-20, 3.0), (1.0e20, 3.0)]
    print(s"$x $y ${modulo(x, y)}")
  // A zero result's sign, shown by what 1 divided by it gives: `p`'s, as gfortran gives it.
  print(s"${1.0 / modulo(-0.0, 3.0)} ${1.0 / modulo(0.0, -3.0)} ${1.0 / modulo(-6.0, 3.0)} ${1.0 / modulo(-3.0, -3.0)} ${1.0 / modulo([6.0], -3.0)}")
  print(modulo(0.1, 0.01))
  print(modulo(-0.1, 0.01))
  print(modulo(2.5, 0.1))
  print(modulo(1.0, 0.0))
  print(modulo(inf, 2.0))
  print(modulo(3.0, inf))
  print(modulo(-3.0, inf))

  // real32 and real16 round once at their width.
  print(modulo(real32(-7.25), real32(2.0)))
  print(modulo(real32(7.25), real32(-2.0)))
  print(modulo(real32(-1.0e-30), real32(3.0)))
  print(modulo(real16(-0.1), real16(3.0)))

  // An integer and a real meet in real64.
  print(modulo(7, -2.5))

  // Element by element: rank 1 and 2, a scalar broadcasting either way, inside an expression.
  val a = [-7, -1, 0, 1, 7]
  print(modulo(a, 3))
  print(modulo(10, [3, -3, 4]))
  print(modulo([[-1.5, 2.5], [3.5, -4.5]], -2.0))
  print(modulo(a, 3) + a % 3)
  print(modulo([-0.5, 0.5, -2.0], [1.0, -1.0, 2.0]) * 2.0)
  print(modulo(a[end..1 by -2], -4))

  // Units: one dimension, the result in the first's unit.
  print(modulo(250.0<cm>, 1.0<m>))
  print(modulo(-0.25<m>, 10.0<cm>))
  print(modulo([370.0<deg>, -10.0<deg>], 360.0<deg>))

  // Inside a `parallel for`.
  var out: [integer] = zeros(5)
  parallel for i in 1..5
    out[i] = modulo(a[i], -3)
  print(out)
  print("done")
