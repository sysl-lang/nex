// The prelude's `Option` and `Result` (DESIGN §17.1, §17.2): built by their variants, matched,
// compared and printed; `get_or`, `is_some`, `is_none`, `is_ok` and `is_err`; `!` taking the value
// out or trapping with the error's message; `?` returning `None` or the same `Err` from the `def`
// around it, at any depth, from a local `def`, out of a loop; both on arrays, on a struct's field
// and inside a `parallel for`.

enum Problem =
  Negative(n: integer)
  Odd(n: integer)

struct Reading
  label: string
  value: Result[real, Problem]

def half(n: integer): Option[integer] =
  if n % 2 == 0 then Some(n div 2) else None

def quarter(n: integer): Option[integer] =
  val h = half(n)?
  half(h)

def eighth(n: integer): Option[integer] = half(half(half(n)?)?)

def checked(n: integer): Result[integer, Problem] =
  if n < 0 then return Err(Negative(n))
  if n % 2 == 1 then Err(Odd(n)) else Ok(n)

def sum_checked(xs: [integer]): Result[integer, Problem] =
  var total = 0
  for x in xs
    total += checked(x)?
  Ok(total)

def scaled(n: integer): Result[[real], Problem] =
  def inner(k: integer): Result[integer, Problem] =
    val c = checked(k)?
    Ok(c * 10)
  val m = inner(n)?
  Ok([real(m), real(m) / 4.0])

def first_even(xs: [integer]): Option[integer] =
  for x in xs
    if x % 2 == 0 then return Some(x)
  None

def doubled[T: Numeric](o: Option[T]): Option[T] =
  val v = o?
  Some(v + v)

def forced[T](r: Result[T, string]): T = r!

def message_of(r: Result[integer, string]): string =
  r match
    Ok(v)  -> s"ok $v"
    Err(e) -> s"failed: $e"

def main() =
  print(half(4))
  print(half(3))
  val none: Option[integer] = None
  print(none)
  print(half(4) == Some(2))
  print(half(3) == none)
  print(quarter(8))
  print(quarter(6))
  print(eighth(16))
  print(eighth(12))

  print(checked(4))
  print(checked(-3))
  print(checked(5))
  print(sum_checked([2, 4, 6]))
  print(sum_checked([2, 3, -1]))
  print(scaled(2))
  print(scaled(-2))
  print(first_even([1, 3, 8, 10]))
  print(first_even([1, 3]))

  print(get_or(half(3), -1))
  print(get_or(half(10), -1))
  print(get_or(checked(7), 0))
  print(get_or(checked(8), 0))
  print(is_some(half(2)))
  print(half(3).is_some())
  print(is_none(half(3)))
  print(is_ok(checked(2)))
  print(checked(2).is_err())
  print(is_err(checked(-2)))

  print(half(10)! + 1)
  print(-half(6)!)
  print([half(2)!, half(4)!, half(6)!])
  val o: Option[[real]] = Some([1.0, 2.0, 3.0])
  print(o)
  print(sum(o!))
  print(scaled(4)!)

  val rs = [Reading("a", Ok(1.5)), Reading("b", Err(Odd(3)))]
  print(rs[1])
  print(rs[2].value)
  print(rs[1].value!)
  print(doubled(Some(2.5)))
  print(doubled(half(3)))
  val good: Result[integer, string] = Ok(9)
  print(forced(good))
  print(message_of(Ok(3)))
  print(message_of(Err("no luck")))

  var halves: [integer] = zeros(4)
  parallel for i in 1..4
    halves[i] = half(2 * i)!
  print(halves)

  val _ = checked(1)

  assert_traps(() -> print(half(3)!), "`!` found None")
  assert_traps(() -> print(checked(-5)!), "Negative(-5)")
  val s: Result[integer, string] = Err("the reason")
  assert_traps(() -> print(s!), "the reason")
  assert_traps(() -> print(rs[2].value!), "Odd(3)")
  print("done")
