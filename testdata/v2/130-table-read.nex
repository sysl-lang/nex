// args: a scratch directory
// `read_table` (DESIGN §17.7) on the forms a table's text takes: fields separated by runs of blanks
// (spaces and tabs, before the first field and after the last too) or, where the first row has a
// comma, by commas with blanks around them; CRLF line ends and a last line without one; `#` lines,
// indented or not, and blank lines skipped; `skip` header lines, by position and by name, and more
// of them than the file has; an empty file and one of comments only, `0 x 0`; one row, one column
// and one value; Fortran's `d` exponents, `inf`, `nan`, `-0.0` and `_` between digits.

def shape(a: [real; :, :]): string = s"${extent(a, 1)}x${extent(a, 2)}"

def show(dir: string, name: string, text: string) =
  val path = s"$dir/$name.dat"
  write_text(path, text)!
  read_table(path) match
    Ok(a) -> print(s"$name: ${shape(a)} $a")
    Err(e) -> print(s"$name: ${replace(message(e), dir, "<dir>")}")
  remove(path)!

def main(args: [string]) =
  val dir = args[1]

  print("-- separators")
  show(dir, "blanks", "1 2 3\n4 5 6\n")
  show(dir, "tabs", "1\t2\t\t3\n4 \t 5      6\n")
  show(dir, "outer-blanks", "   1 2 3   \n\t4 5 6\t\n")
  show(dir, "commas", "1,2,3\n4,5,6\n")
  show(dir, "comma-blanks", " 1 , 2,\t3 \n4 ,5  ,  6\n")

  print("-- line ends")
  show(dir, "crlf", "1 2\r\n3 4\r\n")
  show(dir, "crlf-commas", "1,2\r\n3,4\r\n")
  show(dir, "unended", "1 2\n3 4")

  print("-- comments and blank lines")
  show(dir, "comments", "# x y\n1 2\n   # indented\n\t#tabbed\n3 4\n#\n")
  show(dir, "blank-lines", "\n\n1 2\n\n  \n\t\n3 4\n\n")
  show(dir, "comma-after-comments", "# a, b\n\n1 2\n3 4\n")

  print("-- no rows")
  show(dir, "empty", "")
  show(dir, "comments-only", "# nothing here\n\n   \n")

  print("-- one row, one column, one value")
  show(dir, "row", "1 2 3 4 5")
  show(dir, "column", "1\n2\n3\n")
  show(dir, "value", "42\n")
  val column = s"$dir/column.dat"
  write_lines(column, ["10", "20", "30"])!
  val c = read_table(column)!
  print(s"a column: ${c[:, 1]}, ${extent(c, 1)} rows")
  remove(column)!

  print("-- numbers")
  show(dir, "fortran", "1.5d0 -2.5D-3 1e2 3E-1\n")
  show(dir, "specials", "inf -inf nan -0.0\nInfinity NaN 0.0 +1.0\n")
  show(dir, "digits", "1_000 2_500.5 -3_0\n")
  val specials = s"$dir/specials.dat"
  write_text(specials, "-0.0 nan -inf\n")!
  val s = read_table(specials)!
  print(s"negative zero: ${1.0 / s[1, 1]}, nan: ${is_nan(s[1, 2])}, -inf: ${s[1, 3] < -huge(0.0)}")
  remove(specials)!

  print("-- skip")
  val header = s"$dir/header.dat"
  write_text(header, "time value\n# units: s m\n0.0 1.5\n1.0 2.5\n")!
  print(read_table(header, skip = 1)!)
  print(read_table(header, 2)!)
  print(read_table(header, skip = 3)!)
  print(shape(read_table(header, skip = 10)!))
  read_table(header) match
    Ok(a) -> print(a)
    Err(e) -> print(replace(message(e), dir, "<dir>"))
  remove(header)!
