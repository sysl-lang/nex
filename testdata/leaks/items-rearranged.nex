struct P
  name: string
  n: integer

struct Grid
  cells: [string; :, :]

def join2(a: string, b: string): string = a + b

def last_of(ws: [string]): string =
  reduce(ws, "", (a, b) -> if b == "" then a else b)

def first_after(ws: [string; :, :], after: string): string =
  var seen = false
  for w in filter(ws, x -> x != "b")
    if seen
      return w
    seen = w == after
  "none"

def tally(ps: [P]): P = reduce(ps, P("", 0), (acc, p) -> P(acc.name + p.name, acc.n + p.n))

def main() =
  val m = [["a", "b", "c"], ["d", "e", "f"]]
  var acc = ""
  var g = m
  for k in 1..3
    g = transpose(g)
    acc = acc + reduce(g, "", join2)
    val kept = filter(g, x -> x != "a")
    val spread = flatMap(kept, x -> [x, acc])
    val back = reshape(permute(reshape(flatten(g), (3, 2)), (2, 1)), 6)
    print(length(spread))
    print(back)
  print(acc)
  print(first_after(m, "d"))
  print(first_after(m, "z"))
  print(last_of(flatten(m)))
  val ps = [P("x", 1), P("y", 2)]
  print(tally(filter(ps, p -> p.n > 0)))
  print(tally(flatMap(ps, p -> [p, p])))
  var grids = [Grid(m), Grid(transpose(m))]
  grids[2] = Grid(transpose(grids[2].cells))
  print(grids[1] == grids[2])
  print(reduce([1, 2], P("", 0), (p, k) -> P(p.name + m[1, k], p.n + k)))
  val fs = flatMap([1, 2], k -> [(x: integer) -> x + k])
  print(reduce(fs, 0, (s, f) -> f(s)))
