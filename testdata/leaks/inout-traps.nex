// What a callee writes through an `inout` argument before it traps stays written once the trap is
// caught (DESIGN §8.4): whole arrays, windows strided and reversed, elements, fields, module-level
// arrays, through function values, two levels down, whole assignments of the parameter of the shape
// it has and of another shape, and through lambdas capturing the parameter. The arrays live in the
// cells of lambdas `assert_traps` runs, so the caller sees them after the trap; caught many times
// over, the traps leave nothing held.

struct Grid
  cells: [integer]
  name: string

struct Pair
  xs: [real]
  n: integer

var shared = [1, 2, 3, 4]

def wt(v: inout [integer]) =
  v[1] = 99
  assert(false, "boom")

def bump_all(v: inout [integer]) =
  for k in 1..length(v)
    v[k] += 10
    if k == 2 then assert(false, "boom")

def set_el(x: inout integer) =
  x = 42
  assert(false, "boom")

def set_real(x: inout real) =
  x = 0.5
  assert(false, "boom")

def set_bool(x: inout bool) =
  x = true
  assert(false, "boom")

def set_complex(x: inout complex) =
  x = 3 + 4i
  assert(false, "boom")

def mid(v: inout [integer]) =
  v[2] = 7
  wt(v)

def outer(v: inout [integer]) =
  mid(v)

def doubled(v: inout [integer]) =
  v = v * 2
  assert(false, "boom")

def replaced(v: inout [integer]) =
  v = [5, 6, 7, 8]
  assert(false, "boom")

def added(v: inout [integer]) =
  v += 1
  assert(false, "boom")

def regrown(v: inout [integer]) =
  v = [5, 6, 7]
  v = [7, 8, 9, 10, 11]

def twice(x: inout integer, y: inout integer) =
  x = 1
  y = 2
  assert(false, "boom")

def window_and_element(v: inout [integer], x: inout integer) =
  v[1] = 31
  x = 32
  assert(false, "boom")

def pair_trap(p: inout Pair) =
  p.xs[2] = 9.5
  p.n = 3
  assert(false, "boom")

def inc(x: inout integer) =
  x += 100

def bump(v: inout [integer]) =
  for k in 1..length(v)
    v[k] += 1

def bumped(v: inout [integer]): integer =
  bump(v)
  v[1]

def whole() =
  var a = [1, 2, 3, 4]
  assert_traps(() -> wt(a), "boom")
  print(a)

def windows() =
  var w1 = [1, 2, 3, 4, 5, 6]
  assert_traps(() -> bump_all(w1[2..5]), "boom")
  print(w1)
  var w2 = [1, 2, 3, 4, 5, 6]
  assert_traps(() -> bump_all(w2[1..end by 2]), "boom")
  print(w2)
  var w3 = [1, 2, 3, 4, 5, 6]
  assert_traps(() -> bump_all(w3[.. by -1]), "boom")
  print(w3)
  var m1 = [[1, 2, 3], [4, 5, 6]]
  assert_traps(() -> bump_all(m1[:, 2]), "boom")
  print(m1)
  var m2 = [[1, 2, 3], [4, 5, 6]]
  assert_traps(() -> bump_all(m2[2, :]), "boom")
  print(m2)

def elements() =
  var e1 = [1, 2, 3, 4]
  assert_traps(() -> set_el(e1[2]), "boom")
  print(e1)
  var e2 = [1, 2, 3, 4]
  assert_traps(() -> set_el(e2[3..][2]), "boom")
  print(e2)
  var m1 = [[1, 2, 3], [4, 5, 6]]
  assert_traps(() -> set_el(m1[1, 3]), "boom")
  print(m1)
  var m2 = [[1, 2, 3], [4, 5, 6]]
  assert_traps(() -> set_el(m2[:, 1][2]), "boom")
  print(m2)
  var m3 = [[1, 2, 3], [4, 5, 6]]
  assert_traps(() -> set_el(m3[.. by -1, 2..][1, 2]), "boom")
  print(m3)
  var r = [1.0, 2.0]
  assert_traps(() -> set_real(r[2]), "boom")
  print(r)
  var b = [false, false]
  assert_traps(() -> set_bool(b[1]), "boom")
  print(b)
  var z = [1 + 1i, 2 + 2i]
  assert_traps(() -> set_complex(z[2]), "boom")
  print(z)

def fields() =
  var g = Grid([1, 2, 3], "g")
  assert_traps(() -> wt(g.cells), "boom")
  print(g.cells)
  var h = Grid([1, 2, 3], "h")
  assert_traps(() -> set_el(h.cells[3]), "boom")
  print(h.cells)
  var p = Pair([1.0, 2.0], 0)
  assert_traps(() -> pair_trap(p), "boom")
  print(p.xs)
  print(p.n)

def nested() =
  var n = [1, 2, 3, 4]
  assert_traps(() -> outer(n), "boom")
  print(n)

def module_level() =
  assert_traps(() -> wt(shared), "boom")
  assert_traps(() -> set_el(shared[4]), "boom")
  print(shared)

def through_values() =
  var f = [1, 2, 3, 4]
  val through = wt
  assert_traps(() -> through(f), "boom")
  print(f)
  var l = [1, 2, 3, 4]
  def local(v: inout [integer]) =
    v[3] = 0
    assert(false, "boom")
  assert_traps(() -> local(l[2..]), "boom")
  print(l)

def sharing() =
  var s = [1, 2, 3, 4]
  val view = s
  assert_traps(() -> wt(s), "boom")
  print(s)
  print(view)

def several() =
  var t = [1, 2, 3, 4]
  assert_traps(() -> twice(t[1], t[4]), "boom")
  print(t)
  var u = [1, 2, 3, 4]
  assert_traps(() -> window_and_element(u[1..2], u[4]), "boom")
  print(u)
  var x = 1
  assert_traps(() -> set_el(x), "boom")
  print(x)

def assigned() =
  var d = [1, 2, 3, 4]
  assert_traps(() -> doubled(d), "boom")
  print(d)
  var s = [1, 2, 3, 4]
  assert_traps(() -> replaced(s), "boom")
  print(s)
  var w = [1, 2, 3, 4]
  assert_traps(() -> added(w[2..3]), "boom")
  print(w)
  var g = [1, 2, 3, 4]
  val grow = () -> regrown(g)
  grow()
  print(g)

def repeated() =
  var r = [1, 2, 3, 4]
  for k in 1..300
    assert_traps(() -> bump_all(r[2..3]), "boom")
  print(r)
  var e = [1, 2, 3, 4]
  for k in 1..300
    assert_traps(() -> set_el(e[k % 4 + 1]), "boom")
  print(e)

def set_text(v: inout [string]) =
  v[1] = "z"
  assert(false, "boom")

def set_word(x: inout string) =
  x = "q"
  assert(false, "boom")

def strings() =
  var s = ["a", "b", "c"]
  assert_traps(() -> set_text(s[2..3]), "boom")
  print(s)
  var t = ["a", "b", "c"]
  assert_traps(() -> set_text(t), "boom")
  print(t)
  var u = ["a", "b", "c"]
  assert_traps(() -> set_word(u[3]), "boom")
  print(u)

// Without a trap: what a statement read of an array before lending it is what it had then, and a loop
// over an array walks the elements it had when the loop began.
def reads_around_calls() =
  var a = [1, 2, 3, 4]
  val f = () ->
    val old = a[2]
    inc(a[2])
    print(old)
    print(a[2])
    inc(a[2])
    print(a[2] + a[2])
  f()
  print(a)
  val x = shared[1] + bumped(shared) + shared[1]
  print(x)
  print(shared)
  var total = 0
  for y in shared
    bump(shared)
    total += y
  print(total)
  print(shared)

// A callee rebinding its parameter to an array of another shape: the caller's place holds the new
// array from the rebinding on, through a trap too, and the callee's later writes land in it; a
// window or an element cannot take another shape, so rebinding one traps where it is made.
def regrow(v: inout [integer]) =
  v = [5, 6, 7]

def regrow_trap(v: inout [integer]) =
  v[1] = 8
  v = [5, 6, 7]
  v[1] = 50
  assert(false, "boom")

def back_and_forth(v: inout [integer]) =
  v = [1]
  v = [9, 9, 9, 9]
  v[2] = 0

def back_and_forth_trap(v: inout [integer]) =
  back_and_forth(v)
  v[3] = 3
  assert(false, "boom")

def forwarded(v: inout [integer]) =
  regrow(v)
  v[2] = 60
  assert(false, "boom")

def forwarded_through(f: (inout [integer]) -> void, v: inout [integer]) =
  f(v)
  v[3] = 70
  assert(false, "boom")

def regrid(m: inout [integer; :, :]) =
  m = [[1, 2, 3], [4, 5, 6]]
  m[2, 2] = 0
  assert(false, "boom")

def regrow_then_print(v: inout [integer]) =
  v = [1, 2, 3, 4, 5]
  print("not reached")

def reshaped() =
  var a = [1, 2, 3, 4]
  regrow(a)
  print(a)
  var b = [1, 2, 3, 4]
  assert_traps(() -> regrow_trap(b), "boom")
  print(b)
  var c = [1, 2, 3, 4]
  assert_traps(() -> back_and_forth_trap(c), "boom")
  print(c)
  var c2 = [1, 2, 3, 4]
  back_and_forth(c2)
  print(c2)
  var d = [1, 2, 3, 4]
  assert_traps(() -> forwarded(d), "boom")
  print(d)
  var e = [1, 2, 3, 4]
  assert_traps(() -> forwarded_through(regrow, e), "boom")
  print(e)
  var f = [1, 2, 3, 4]
  val through = regrow
  through(f)
  print(f)
  assert_traps(() -> regrow_trap(shared), "boom")
  print(shared)
  var g = Grid([1], "g")
  assert_traps(() -> forwarded(g.cells), "boom")
  print(g.cells)
  var m = fill((1, 1), 0)
  assert_traps(() -> regrid(m), "boom")
  print(m)
  var w = [1, 2, 3, 4, 5, 6]
  assert_traps(() -> regrow_then_print(w[2..4]), "shape")
  print(w)
  var w2 = [1, 2, 3, 4, 5, 6]
  assert_traps(() -> regrow_then_print(w2[.. by -1]), "shape")
  print(w2)
  var r = [[1, 2], [3, 4]]
  assert_traps(() -> regrow_then_print(r[:, 1]), "shape")
  print(r)
  shared = [1, 2, 3, 4]

// An `inout` array parameter a lambda passed straight as an argument captures: the lambda reads
// and writes the caller's array, rebinds it, and passes it on; a trap the lambda raises past the
// parameter's function leaves every write in place, a window's too.
def divide(v: inout [integer]) =
  v[1] = 0
  v[2] = 1 % v[1]

def captured(v: inout [integer]) =
  assert_traps(() -> divide(v), "zero")
  v[3] = 33

def captured_writes(v: inout [integer]) =
  assert_traps(() ->
    v[2] = 22
    v = [7, 7, 7, 7, 7]
    divide(v)
  , "zero")
  v[3] = 3

def captured_in_map(v: inout [integer]) =
  val w = map([1, 2, 3], (x) -> x + v[1])
  v[1] = w[3]

def captured_escaping(v: inout [integer]) =
  assert_traps(() -> divide(v), "zero")
  v[2] = 44
  assert(false, "boom")

def captured_rebound(v: inout [integer]) =
  assert_traps(() -> divide(v), "zero")
  v = [8, 8, 8, 8, 8, 8]

def captured_window_kept(v: inout [integer]) =
  assert_traps(() -> regrow(v), "shape")
  assert_traps(() ->
    v = [1, 2, 3, 4, 5]
  , "shape")
  v[1] = 9

def captures() =
  var p = [1, 2, 3]
  captured(p)
  print(p)
  var q = [1, 2, 3]
  captured_writes(q)
  print(q)
  var r = [1, 2, 3]
  captured_in_map(r)
  print(r)
  var s = [1, 2, 3, 4]
  assert_traps(() -> captured_escaping(s), "boom")
  print(s)
  var t = [1, 2, 3, 4]
  assert_traps(() -> captured_escaping(t[2..4]), "boom")
  print(t)
  var u = [1, 2, 3]
  captured_rebound(u)
  print(u)
  var w = [1, 2, 3, 4]
  assert_traps(() -> captured_rebound(w[1..3]), "shape")
  print(w)
  captured_window_kept(w[2..3])
  print(w)
  captured(shared)
  print(shared)
  val f = captured
  var x = [1, 2, 3]
  f(x)
  print(x)
  val h = captured_rebound
  var y = [1, 2, 3]
  h(y)
  print(y)
  for k in 1..100
    var z = [1, 2, 3, 4]
    assert_traps(() -> captured_escaping(z[1..2]), "boom")
    var z2 = [1, 2, 3, 4]
    assert_traps(() -> captured_escaping(z2), "boom")
  shared = [1, 2, 3, 4]

def main() =
  whole()
  windows()
  elements()
  fields()
  nested()
  module_level()
  through_values()
  sharing()
  several()
  assigned()
  repeated()
  strings()
  reads_around_calls()
  reshaped()
  captures()
