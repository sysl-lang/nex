// The project `nex test` is run on in tests_modules.sysl: tests that pass, fail, trap and stop, in
// the root module, in the module `stats` and in its test module `stats.tests`.

import stats.{mean}

var counter = 0

def bump() =
    counter += 1

@test
def test_mean() = assert_eq(mean(2, 4), 3)

@test
def test_fails() = assert_eq(1 + 1, 3)

@test
def test_traps() =
    val xs = [1, 2, 3]
    print(xs[4])

@test
def test_stops() =
    stop 3

// Each test starts from the module-level bindings' initial values.
@test
def test_fresh_state_a() =
    bump()
    assert_eq(counter, 1)

@test
def test_fresh_state_b() =
    bump()
    assert_eq(counter, 1)

def main() = print(mean(1, 3))
