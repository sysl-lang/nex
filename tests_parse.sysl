@tests

// The tree the parser builds, in the S-expression form `nex parse` prints. An expression is checked as
// the right-hand side of a `val` (`expr_tree` strips the `val r` around it), a declaration whole.

@test("literals")
literals()
    assert_eq(expr_tree("42"), "42")
    assert_eq(expr_tree("3.14"), "3.14")
    assert_eq(expr_tree("true"), "true")
    assert_eq(expr_tree("\"plain\""), "\"plain\"")
    assert_eq(expr_tree("()"), "()")

@test("an interpolated string splits into its text and its expressions")
parse_interpolated_strings()
    assert_eq(expr_tree("s\"hi $name ${x + 1} $$\""), "(s \"hi \" name \" \" (+ x 1) \" $\")")
    assert_eq(expr_tree("s\"\""), "(s)")

@test("additive and multiplicative chains associate to the left, a power to the right")
associativity()
    assert_eq(expr_tree("1 + 2 + 3"), "(+ (+ 1 2) 3)")
    assert_eq(expr_tree("2 ^ 3 ^ 2"), "(^ 2 (^ 3 2))")
    assert_eq(expr_tree("7 div 2 * 3"), "(* (div 7 2) 3)")

@test("a tighter operator binds first")
precedence()
    assert_eq(expr_tree("1 + 2 * 3"), "(+ 1 (* 2 3))")
    assert_eq(expr_tree("2 * 3 ^ 2"), "(* 2 (^ 3 2))")
    assert_eq(expr_tree("a and b or c and not d"), "(or (and a b) (and c (not d)))")
    assert_eq(expr_tree("A @ B @ C"), "(@ (@ A B) C)")
    assert_eq(expr_tree("a * b @ c"), "(@ (* a b) c)")

@test("a run of comparisons is one chained comparison")
chained_comparison()
    assert_eq(expr_tree("a < b"), "(< a b)")
    assert_eq(expr_tree("a < b < c"), "(chain a < b < c)")
    assert_eq(expr_tree("a < b <= c > d"), "(chain a < b <= c > d)")

@test("`..` includes its upper bound and `..<` stops before it")
ranges()
    assert_eq(expr_tree("1..10"), "(.. 1 10)")
    assert_eq(expr_tree("0..<10"), "(..< 0 10)")
    assert_eq(expr_tree("lo + 1..hi - 1"), "(.. (+ lo 1) (- hi 1))")
    assert_eq(expr_tree("-2..12"), "(.. (- 2) 12)")

@test("a range is an array value: it takes parentheses, call arguments and comparisons")
range_as_value()
    assert_eq(expr_tree("(0..<n)[3..6]"), "(index (..< 0 n) (.. 3 6))")
    assert_eq(expr_tree("2 * (0..<n)"), "(* 2 (..< 0 n))")
    assert_eq(expr_tree("(0..<n) < 3"), "(< (..< 0 n) 3)")
    assert_eq(expr_tree("0..<n < 3"), "(< (..< 0 n) 3)")
    assert_eq(expr_tree("length(lo..<hi)"), "(call length (..< lo hi))")
    assert_eq(expr_tree("sum(1..n)"), "(call sum (.. 1 n))")
    assert_eq(expr_tree("range(0, n)"), "(call range 0 n)")

@test("a subscript range may leave off either bound of `..` and the lower one of `..<`")
open_ranges()
    assert_eq(expr_tree("a[..3]"), "(index a (.. _ 3))")
    assert_eq(expr_tree("a[2..]"), "(index a (.. 2 _))")
    assert_eq(expr_tree("a[..]"), "(index a (.. _ _))")
    assert_eq(expr_tree("a[..<k]"), "(index a (..< _ k))")
    assert_eq(expr_tree("a[1..<n]"), "(index a (..< 1 n))")
    assert_eq(expr_tree("m[2.., ..<3]"), "(index m (.. 2 _) (..< _ 3))")

@test("any range form in a subscript takes a stride, negative to walk downward")
strides()
    assert_eq(expr_tree("a[1..10 by 2]"), "(index a (.. 1 10 by 2))")
    assert_eq(expr_tree("a[1..<10 by 3]"), "(index a (..< 1 10 by 3))")
    assert_eq(expr_tree("a[.. by 5]"), "(index a (.. _ _ by 5))")
    assert_eq(expr_tree("a[2.. by k]"), "(index a (.. 2 _ by k))")
    assert_eq(expr_tree("a[..<k by 2]"), "(index a (..< _ k by 2))")
    assert_eq(expr_tree("a[5..2 by -1]"), "(index a (.. 5 2 by (- 1)))")
    assert_eq(expr_tree("a[.. by -2]"), "(index a (.. _ _ by (- 2)))")
    assert_eq(expr_tree("m[1..5 by 2, 2..]"), "(index m (.. 1 5 by 2) (.. 2 _))")
    assert_eq(expr_tree("t[:, :, 1..10 by 3]"), "(index t : : (.. 1 10 by 3))")
    assert_eq(expr_tree("a[1..n by k + 1]"), "(index a (.. 1 n by (+ k 1)))")

@test("`by` and `reduce` stay names outside the clauses they open")
contextual_words_as_names()
    assert_eq(expr_tree("by + reduce(xs, 0, f)"), "(+ by (call reduce xs 0 f))")
    assert_eq(expr_tree("a[by]"), "(index a by)")

@test("a `..<` with nothing to stop before is refused")
half_open_without_bound()
    assert_eq(parsed("val r = a[k..<]"), "error: `..<` needs the bound it stops before: `a[k..]` runs to the end @1:12")
    assert_eq(parsed("val r = a[..< by 2]"), "error: `..<` needs the bound it stops before: `a[k..]` runs to the end @1:11")

@test("`..=` is not a range operator")
no_inclusive_equals()
    assert_eq(parsed("val r = a[1..=3]"), "error: there is no `..=`: `a..b` already includes `b`, and `a..<b` stops before it @1:12")
    assert_eq(parsed("def f() =\n  for k in 1..=n do g(k)\n"), "error: there is no `..=`: `a..b` already includes `b`, and `a..<b` stops before it @2:13")

@test("`end` in a subscript is that axis's last index, in any expression")
end_in_subscripts()
    assert_eq(expr_tree("a[end]"), "(index a end)")
    assert_eq(expr_tree("a[end - 1]"), "(index a (- end 1))")
    assert_eq(expr_tree("a[end-2..]"), "(index a (.. (- end 2) _))")
    assert_eq(expr_tree("a[..end-1]"), "(index a (.. _ (- end 1)))")
    assert_eq(expr_tree("a[..<end]"), "(index a (..< _ end))")
    assert_eq(expr_tree("a[end..1 by -1]"), "(index a (.. end 1 by (- 1)))")
    assert_eq(expr_tree("m[:, end]"), "(index m : end)")
    assert_eq(expr_tree("m[end, 1]"), "(index m end 1)")
    assert_eq(expr_tree("t[:, :, end]"), "(index t : : end)")
    assert_eq(expr_tree("a[(end + 1) div 2]"), "(index a (div (+ end 1) 2))")
    assert_eq(expr_tree("a[b[end]]"), "(index a (index b end))")
    assert_eq(expr_tree("a[f(end)]"), "(index a (call f end))")
    assert_eq(expr_tree("a[2..4][end]"), "(index (index a (.. 2 4)) end)")

@test("`end` at the head of a line inside a subscript is the index, not a block's end")
end_on_a_continuation_line()
    assert_eq(parsed("val x = a[1,\nend]"), "(val x (index a 1 end))")
    assert_eq(parsed("val x = m[end,\n  end - 1]"), "(val x (index m end (- end 1)))")
    assert_eq(parsed("def f() =\n  for i in 1..n\n    x = a[i]\n  end for\n  x\n"), "(def f () _ (block (for i (.. 1 n) (= x (index a i))) x))")
    assert_eq(parsed("def f() =\n  for i in 1..n\n    a[i] = b[end]\n  end\n"), "(def f () _ (for i (.. 1 n) (= (index a i) (index b end))))")

@test("`end` outside a subscript is refused")
end_outside_a_subscript()
    val message = "error: `end` is only an index here inside `a[...]`"

    assert_eq(parsed("val n = end"), s"${message} @1:9")
    assert_eq(parsed("val xs = [end]"), s"${message} @1:11")
    assert_eq(parsed("val xs = a[[end]]"), s"${message} @1:13")
    assert_eq(parsed("val n = f(end)"), s"${message} @1:11")
    assert_eq(parsed("def f() =\n  for i in 1..end do g(i)\n"), s"${message} @2:15")

@test("array types: any rank, run-time or static extents, `[T]` short for rank 1")
array_types()
    assert_eq(parsed("val v: [real] = x"), "(val v : [real] x)")
    assert_eq(parsed("val v: [real; :] = x"), "(val v : [real] x)")
    assert_eq(parsed("val m: [real; :, :] = x"), "(val m : [real; :, :] x)")
    assert_eq(parsed("val t: [int32; :, :, :] = x"), "(val t : [int32; :, :, :] x)")
    assert_eq(parsed("val r: [real; 3, 3] = x"), "(val r : [real; 3, 3] x)")
    assert_eq(parsed("val r: [real32; 3, :] = x"), "(val r : [real32; 3, :] x)")
    assert_eq(parsed("val c: [complex; N] = x"), "(val c : [complex; N] x)")
    assert_eq(parsed("def f[T: Numeric, R: Rank](a: [T; R]): T = a"), "(def f[T: Numeric, R: Rank] ((a [T; R])) T a)")

@test("the sized type names are ordinary names, and a complex type names its part's kind")
sized_types()
    assert_eq(parsed("val b: [uint8] = zeros(4)"), "(val b : [uint8] (call zeros 4))")
    assert_eq(parsed("val z: complex[real32] = x"), "(val z : complex[real32] x)")
    assert_eq(parsed("val zs: [complex[real16]; :, :] = x"), "(val zs : [complex[real16]; :, :] x)")
    assert_eq(parsed("def f(a: int8, b: uint64, c: real16): int64 = 0"), "(def f ((a int8) (b uint64) (c real16)) int64 0)")

@test("an array of arrays is not a type")
nested_array_type()
    assert_eq(parsed("val m: [[real]] = x"), "error: an array element is a scalar; a matrix is `[real; :, :]` @1:9")
    assert_eq(parsed("def f(m: [[integer; :, :]]) = m"), "error: an array element is a scalar; a matrix is `[integer; :, :, :]` @1:11")

@test("an axis is `:`, a whole number or a name")
bad_axis()
    assert_eq(parsed("val m: [real; 1.5] = x"), "error: expected an axis (`:`, an integer literal or a const name), found '1.5' @1:15")
    assert_eq(parsed("val m: [real; ] = x"), "error: expected an axis (`:`, an integer literal or a const name), found ']' @1:15")
    assert_eq(parsed("val m: [real; 2, 1e3] = x"), "error: expected an axis (`:`, an integer literal or a const name), found '1e3' @1:18")
    assert_eq(parsed("val m: [real; 0xFFFF_FFFF_FFFF_FFFF] = x"), "error: expected an axis (`:`, an integer literal or a const name), found '0xFFFFFFFFFFFFFFFF' @1:15")
    assert_eq(parsed("val m: [real; 0x10, 0b11] = x"), "(val m : [real; 16, 3] x)")
@test("literals nest to any rank")
rank_3_literals()
    assert_eq(expr_tree("[[1, 2], [3, 4]]"), "(array (array 1 2) (array 3 4))")
    assert_eq(expr_tree("[[[1, 2], [3, 4]], [[5, 6], [7, 8]]]"), "(array (array (array 1 2) (array 3 4)) (array (array 5 6) (array 7 8)))")

@test("an `inout` parameter, and `inout` in a function type")
inout_params()
    assert_eq(parsed("def bump(x: inout real) = x += 1"), "(def bump ((x inout real)) _ (+= x 1))")
    assert_eq(parsed("def f(a: [real], b: inout [real; :, :]) = b"), "(def f ((a [real]) (b inout [real; :, :])) _ b)")
    assert_eq(parsed("def apply(g: (inout [real], real) -> unit) = g"), "(def apply ((g ((inout [real], real) -> unit))) _ g)")
    assert_eq(parsed("val g: (inout [real]) -> unit = h"), "(val g : (inout [real] -> unit) h)")

@test("`mut` is not a mode, and `inout` belongs only to a parameter")
inout_misplaced()
    assert_eq(parsed("def bump(x: mut real) = x"), "error: `mut` is not a parameter mode: a parameter the callee writes is `inout` @1:13")
    assert_eq(parsed("val x: inout real = 1"), "error: `inout` is a parameter's mode: it belongs before a parameter's type or a function type's parameter @1:8")

@test("`parallel for` over one or more index ranges")
parallel_for()
    assert_eq(parsed("def f() =\n  parallel for i in 1..n do y[i] = a * x[i] + y[i]\n"), "(def f () _ (parallel-for (i (.. 1 n)) (= (index y i) (+ (* a (index x i)) (index y i)))))")
    assert_eq(parsed("def f() =\n  parallel for j in 1..cols(m)\n    m[:, j] = m[:, j] / norm(m[:, j])\n"), "(def f () _ (parallel-for (j (.. 1 (call cols m))) (= (index m : j) (/ (index m : j) (call norm (index m : j))))))")
    assert_eq(parsed("def f() =\n  parallel for i in 1..rows(c), j in 1..cols(c)\n    c[i, j] = 0\n  end for\n"), "(def f () _ (parallel-for (i (.. 1 (call rows c))) (j (.. 1 (call cols c))) (= (index c i j) 0)))")

@test("a `parallel for` names its reductions: built-in operators, minloc and maxloc, or a function")
parallel_reductions()
    assert_eq(parsed("def f() =\n  parallel for i in 1..n reduce total: +, peak: max\n    total += x[i]\n"), "(def f () _ (parallel-for (i (.. 1 n)) (reduce (total +) (peak max)) (+= total (index x i))))")
    assert_eq(parsed("def f() =\n  parallel for i in 1..n reduce p: *, lo: min, all: and, any: or do g(i)\n"), "(def f () _ (parallel-for (i (.. 1 n)) (reduce (p *) (lo min) (all and) (any or)) (call g i)))")
    assert_eq(parsed("def f() =\n  parallel for i in 1..n reduce worst: maxloc, best: minloc do g(i)\n"), "(def f () _ (parallel-for (i (.. 1 n)) (reduce (worst maxloc) (best minloc)) (call g i)))")
    assert_eq(parsed("def f() =\n  parallel for i in 1..n reduce s: kahan_add do s = kahan_add(s, x[i])\n"), "(def f () _ (parallel-for (i (.. 1 n)) (reduce (s kahan_add)) (= s (call kahan_add s (index x i)))))")

@test("a reduction needs an operator, and a parallel loop an index")
parallel_errors()
    assert_eq(parsed("def f() =\n  parallel for i in 1..n reduce s: - do g(i)\n"), "error: a reduction's operator is `+`, `*`, `and`, `or`, `min`, `max`, `minloc`, `maxloc` or a function's name @2:36")
    assert_eq(parsed("def f() =\n  parallel for i in 1..n reduce s do g(i)\n"), "error: expected ':', found 'do' @2:35")
    assert_eq(parsed("def f() =\n  parallel for (i, j) in xs do g(i)\n"), "error: expected a loop index, found '(' @2:16")

@test("`parallel` before an expression computes it in parallel")
parallel_expressions()
    assert_eq(expr_tree("parallel sum(x * y)"), "(parallel (call sum (* x y)))")
    assert_eq(expr_tree("parallel map(xs, x -> x * x)"), "(parallel (call map xs (fn (x) (* x x))))")

@test("`extern def` declares a C function, with its attributes")
extern_functions()
    assert_eq(parsed("extern def cos(x: real64): real64"), "(extern def cos ((x real64)) real64)")
    assert_eq(parsed("extern def srand(seed: uint32)"), "(extern def srand ((seed uint32)) _)")
    assert_eq(parsed("@link(\"m\")\nextern def cbrt(x: real): real"), "(@link(\"m\") extern def cbrt ((x real)) real)")
    assert_eq(parsed("@link(framework = \"Accelerate\")\n@symbol(\"cblas_ddot\")\nextern def ddot(n: int32, @strided x: [real], @strided y: [real]): real"), "(@link(framework = \"Accelerate\") @symbol(\"cblas_ddot\") extern def ddot ((n int32) (@strided x [real]) (@strided y [real])) real)")
    assert_eq(parsed("@pure\nextern def dgesv(n: int32, a: inout [real; :, :]): int32"), "(@pure extern def dgesv ((n int32) (a inout [real; :, :])) int32)")

@test("an `extern def` has no body")
extern_with_body()
    assert_eq(parsed("extern def f(x: real): real = x"), "error: an `extern def` has no body: it declares a C function, which is defined in C @1:29")
    assert_eq(parsed("extern f(x: real): real"), "error: expected 'def', found 'f' @1:8")

@test("`origin` and `rebase` are calls")
offset_views()
    assert_eq(parsed("def f() =\n  val w = origin(kernel, -r)\n  rebase(w)[1]\n"), "(def f () _ (block (val w (call origin kernel (- r))) (index (call rebase w) 1)))")
    assert_eq(expr_tree("origin(grid, 0, 0)"), "(call origin grid 0 0)")

@test("a number beside a name or a bracket multiplies, tighter than * and looser than ^")
juxtaposition()
    assert_eq(expr_tree("2x"), "(juxt 2 x)")
    assert_eq(expr_tree("2(x + 1)"), "(juxt 2 (+ x 1))")
    assert_eq(expr_tree("2x^3"), "(juxt 2 (^ x 3))")
    assert_eq(expr_tree("2x * 3"), "(* (juxt 2 x) 3)")
    assert_eq(expr_tree("1/2x"), "(/ 1 (juxt 2 x))")
    assert_eq(expr_tree("2a + b"), "(+ (juxt 2 a) b)")

@test("a minus before a number folds into the coefficient, and a binary minus stays binary")
signed_juxtaposition()
    assert_eq(expr_tree("5 - 2"), "(- 5 2)")
    assert_eq(expr_tree("3 - 4i"), "(- 3 (juxt 4 i))")
    assert_eq(expr_tree("-4i"), "(juxt -4 i)")
    assert_eq(expr_tree("-2.5pi"), "(juxt -2.5 pi)")
    assert_eq(expr_tree("-3(x + 1)"), "(juxt -3 (+ x 1))")

@test("a unary minus binds tighter than a power")
unary_operators()
    assert_eq(expr_tree("-2^2"), "(^ (- 2) 2)")
    assert_eq(expr_tree("-x"), "(- x)")
    assert_eq(expr_tree("- x + 1"), "(+ (- x) 1)")
    assert_eq(expr_tree("not x"), "(not x)")

@test("calls, indexing and fields chain from the left")
postfix()
    assert_eq(expr_tree("f(1, 2)"), "(call f 1 2)")
    assert_eq(expr_tree("f(1)(2)"), "(call (call f 1) 2)")
    assert_eq(expr_tree("a[1]"), "(index a 1)")
    assert_eq(expr_tree("a[1, 2]"), "(index a 1 2)")
    assert_eq(expr_tree("p.x"), "(. p x)")
    assert_eq(expr_tree("p.length()"), "(method p length)")
    assert_eq(expr_tree("a.b().c()"), "(method (method a b) c)")
    assert_eq(expr_tree("a.b[1].c(2)"), "(method (index (. a b) 1) c 2)")
    assert_eq(expr_tree("t.0"), "(. t 0)")
    assert_eq(expr_tree("a.b.0.1"), "(. (. (. a b) 0) 1)")

@test("a lambda takes bare or parenthesised parameters, typed or not, and nests to the right")
lambdas()
    assert_eq(expr_tree("x -> x * x"), "(fn (x) (* x x))")
    assert_eq(expr_tree("(x, y) -> x + y"), "(fn (x y) (+ x y))")
    assert_eq(expr_tree("(x: real) -> x"), "(fn ((x real)) x)")
    assert_eq(expr_tree("(a: real, b) -> a"), "(fn ((a real) b) a)")
    assert_eq(expr_tree("x -> y -> x + y"), "(fn (x) (fn (y) (+ x y)))")
    assert_eq(expr_tree("f(x -> x, y)"), "(call f (fn (x) x) y)")
    assert_eq(expr_tree("data.map(x -> x * 2).filter(x -> x > 3)"), "(method (method data map (fn (x) (* x 2))) filter (fn (x) (> x 3)))")

@test("a lambda with a block body")
lambda_blocks()
    assert_eq(parsed("val g = (x, y) ->\n  val s = x + y\n  s * 2\n"), "(val g (fn (x y) (block (val s (+ x y)) (* s 2))))")

@test("a comma makes a tuple, parentheses only group")
tuples()
    assert_eq(expr_tree("1, 2, 3"), "(tuple 1 2 3)")
    assert_eq(expr_tree("(1, 2, 3)"), "(tuple 1 2 3)")
    assert_eq(expr_tree("(1)"), "1")
    assert_eq(expr_tree("f((1, 2))"), "(call f (tuple 1 2))")
    assert_eq(expr_tree("f(1, 2), 3"), "(tuple (call f 1 2) 3)")
    assert_eq(expr_tree("[1, 2], [3]"), "(tuple (array 1 2) (array 3))")

@test("the commas of a call, an array and an index are not tuple commas")
commas_that_are_not_tuples()
    assert_eq(expr_tree("f(1, 2)"), "(call f 1 2)")
    assert_eq(expr_tree("[1, 2, 3]"), "(array 1 2 3)")
    assert_eq(expr_tree("a[1, 2]"), "(index a 1 2)")

@test("arrays nest and may break across lines")
arrays()
    assert_eq(expr_tree("[]"), "(array)")
    assert_eq(expr_tree("[[1, 2], [3, 4]]"), "(array (array 1 2) (array 3 4))")
    assert_eq(parsed("val xs = [1, 2,\n  3]\n"), "(val xs (array 1 2 3))")

@test("if/then/else takes a trailing comma outside itself")
if_expressions()
    assert_eq(parsed("def f() =\n  if a then b else c, d\n"), "(def f () _ (tuple (if a b c) d))")
    assert_eq(parsed("def f() =\n  if a then b\n"), "(def f () _ (if a b))")
    assert_eq(parsed("def f() = if a then 1 else 2\n"), "(def f () _ (if a 1 2))")

@test("elif is an else holding an if, in both the inline and the block form")
elif_chains()
    assert_eq(parsed("def f() =\n  if a then 1 elif b then 2 elif c then 3 else 4\n"), "(def f () _ (if a 1 (if b 2 (if c 3 4))))")
    assert_eq(parsed("def f() =\n  if a\n    1\n  elif b\n    2\n  else\n    3\n"), "(def f () _ (if a 1 (if b 2 3)))")

@test("a bare tuple is the value of a block, an if branch and a for body")
tuples_in_blocks()
    assert_eq(parsed("def f(a: real) =\n  a, 1\n"), "(def f ((a real)) _ (tuple a 1))")
    assert_eq(parsed("val f = x ->\n  1\n  x, 2\n"), "(val f (fn (x) (block 1 (tuple x 2))))")
    assert_eq(parsed("def f() =\n  if c\n    1, 2\n  else\n    3\n"), "(def f () _ (if c (tuple 1 2) 3))")
    assert_eq(parsed("def f() =\n  for i in xs\n    i, 1\n"), "(def f () _ (for i xs (tuple i 1)))")
    assert_eq(parsed("def f(): real =\n  return 1, 2\n"), "(def f () real (return (tuple 1 2)))")

@test("val, var and const, with and without a type")
bindings()
    assert_eq(parsed("val x = 1"), "(val x 1)")
    assert_eq(parsed("val x: real = 1"), "(val x : real 1)")
    assert_eq(parsed("var n = 0"), "(var n 0)")
    assert_eq(parsed("const K = 3"), "(const K 3)")

@test("a binding takes a tuple pattern with or without parentheses")
destructuring()
    assert_eq(parsed("val a, b = t"), "(val (tuple a b) t)")
    assert_eq(parsed("val _, b = t"), "(val (tuple _ b) t)")
    assert_eq(parsed("val (a, b): (real, real) = t"), "(val (tuple a b) : (real, real) t)")
    assert_eq(parsed("def f() =\n  val a, b = 1, 2\n  var c, d = 3, 4\n"), "(def f () _ (block (val (tuple a b) (tuple 1 2)) (var (tuple c d) (tuple 3 4)) ()))")

@test("a binding may take an indented block as its value")
binding_blocks()
    assert_eq(parsed("val x =\n  val y = 1\n  y\n"), "(val x (block (val y 1) y))")

@test("a semicolon separates declarations on a line, and a repeated or trailing one is nothing")
semicolons()
    assert_eq(parsed("val a = 1; val b = 2"), "(val a 1)\n(val b 2)")
    assert_eq(parsed("val a = 1;; val b = 2;"), "(val a 1)\n(val b 2)")
    assert_eq(parsed("def f() =\n  val a = 1; val b = 2\n  a; b;\n"), "(def f () _ (block (val a 1) (val b 2) a b))")

@test("an assignment keeps its operator")
assignments()
    assert_eq(parsed("def bump(x: inout real) = x = x + 1"), "(def bump ((x inout real)) _ (= x (+ x 1)))")
    assert_eq(parsed("def f() =\n  x += 1\n  p.x -= 2\n  a[1] *= 3\n  x /= 2\n  x %= 2\n"), "(def f () _ (block (+= x 1) (-= (. p x) 2) (*= (index a 1) 3) (/= x 2) (%= x 2)))")
    assert_eq(parsed("def f() =\n  a[2..4] = b\n  m[:, end] = c\n  a[.. by -1] = b\n  a[2..4][1] = 9\n"), "(def f () _ (block (= (index a (.. 2 4)) b) (= (index m : end) c) (= (index a (.. _ _ by (- 1))) b) (= (index (index a (.. 2 4)) 1) 9)))")
    assert_eq(parsed("def f() =\n  a[i] = x\n  s.field = y\n  val z = 1\n  z\n"), "(def f () _ (block (= (index a i) x) (= (. s field) y) (val z 1) z))")
    assert_eq(parsed("def f() =\n  x += a + b\n"), "(def f () _ (+= x (+ a b)))")

@test("a function: parameters with a mode and a type, a result type, a body")
functions()
    assert_eq(parsed("def f() = 1"), "(def f () _ 1)")
    assert_eq(parsed("def f(a: real, b: real): real = a + b"), "(def f ((a real) (b real)) real (+ a b))")
    assert_eq(parsed("def main() =\n  print(\"Hello\")\n"), "(def main () _ (call print \"Hello\"))")
    assert_eq(parsed("private def f() = 1"), "(private def f () _ 1)")
    assert_eq(parsed("def f[T: Num, U](x: T) = x"), "(def f[T: Num, U] ((x T)) _ x)")

@test("return, with and without a value")
returns()
    assert_eq(parsed("def f() =\n  return 1\n"), "(def f () _ (return 1))")
    assert_eq(parsed("def f() =\n  while a\n    b\n  for i in 1..3\n    c\n  return\n  return 1\n"), "(def f () _ (block (while a b) (for i (.. 1 3) c) (return) (return 1)))")

@test("break and continue")
break_and_continue()
    assert_eq(parsed("def f() =\n  break\n  continue\n"), "(def f () _ (block break continue))")

@test("for and while take do on one line and a block on the next")
loops()
    assert_eq(parsed("def f() =\n  for k, x in enumerate(arr) do\n    print(k)\n"), "(def f () _ (for (tuple k x) (call enumerate arr) (call print k)))")
    assert_eq(parsed("def f() =\n  for i in 1..10 do print(i)\n"), "(def f () _ (for i (.. 1 10) (call print i)))")
    assert_eq(parsed("def f() =\n  for i in 0..<n do print(i)\n"), "(def f () _ (for i (..< 0 n) (call print i)))")
    assert_eq(parsed("def f() =\n  for (i, j) in xs do i\n"), "(def f () _ (for (tuple i j) xs i))")
    assert_eq(parsed("def f() =\n  while i < 3 do\n    i += 1\n"), "(def f () _ (while (< i 3) (+= i 1)))")

@test("a struct, with and without type parameters and its end marker")
structs()
    assert_eq(parsed("struct Point\n  x: real\n  y: real\nend Point"), "(struct Point (x real) (y real))")
    assert_eq(parsed("private struct P\n  x: real\n"), "(private struct P (x real))")
    assert_eq(parsed("struct Box[T]\n  v: T\nend Box"), "(struct Box[T] (v T))")
    assert_eq(parsed("struct S[T: Num, U]\n  a: T\n"), "(struct S[T: Num, U] (a T))")

@test("an enum of bare variants")
enums()
    assert_eq(parsed("enum Color =\n  Red\n  Green\n"), "(enum Color Red Green)")

@test("match arms take variant patterns, nested ones and a wildcard")
match_arms()
    assert_eq(parsed("def f() =\n  c match\n    Red -> 1\n    Converged(x) -> x\n    MaxIters(n, last) -> last\n    _ -> -1.0\n"), "(def f () _ (match c (Red 1) ((Converged x) x) ((MaxIters n last) last) (_ (- 1.0))))")
    assert_eq(parsed("def f() =\n  x match\n    Some(Circle(r)) -> r\n    _ -> 0\n  end match\n"), "(def f () _ (match x ((Some (Circle r)) r) (_ 0)))")
    assert_eq(parsed("val t = (1, 2) match\n  _ -> 1\n"), "(val t (match (tuple 1 2) (_ 1)))")

@test("a tuple as an arm body is parenthesised or on its own indented lines")
match_arm_tuples()
    assert_eq(parsed("def f() =\n  s match\n    A -> (x, x)\n    B ->\n      0.0, 0.0\n"), "(def f () _ (match s (A (tuple x x)) (B (tuple 0.0 0.0))))")

@test("modules and imports")
modules_and_imports()
    assert_eq(parsed("module m"), "(module m)")
    assert_eq(parsed("import a"), "(import a)")
    assert_eq(parsed("import a.{b, c as d}"), "(import a b (c as d))")
    assert_eq(parsed("import a.*"), "(import a *)")
    assert_eq(parsed("import a.b.*"), "(import a.b *)")

@test("attributes, with and without arguments, on a function with or without a body")
parse_attributes()
    assert_eq(parsed("@test\ndef t() =\n  assert_eq(2 + 2, 4)\n"), "(@test def t () _ (call assert_eq (+ 2 2) 4))")
    assert_eq(parsed("@intrinsic(\"a\", \"b\")\ndef f(x: real): real\n"), "(@intrinsic(\"a\", \"b\") def f ((x real)) real _)")

@test("small programs")
parse_small_programs()
    assert_eq(expr_tree("sqrt(a^2 + b^2)"), "(call sqrt (+ (^ a 2) (^ b 2)))")
    assert_eq(parsed("val t = (1, 2)\nval u = t.0 + t.1"), "(val t (tuple 1 2))\n(val u (+ (. t 0) (. t 1)))")

// What the parser refuses, and where it says so.

@test("a declaration that is missing a name")
missing_name()
    assert_eq(parsed("val = 1"), "error: expected a name to bind, found '=' @1:5")
    assert_eq(parsed("val 1 = 2"), "error: expected a name to bind, found '1' @1:5")
    assert_eq(parsed("def f( = 1"), "error: expected a parameter name, found '=' @1:8")

@test("an expression cut off by the end of its line")
cut_off_expression()
    assert_eq(parsed("val x = (1 + \n"), "error: expected an expression, found the end of the line @2:1")
    assert_eq(parsed("val x = f(1,\n"), "error: expected an expression, found the end of the line @2:1")
    assert_eq(parsed("val x = s\"${1 +}\"\n"), "error: expected an expression, found the end of the line @1:16")

@test("a bare expression is not a declaration")
expression_at_top_level()
    assert_eq(parsed("1 + 2"), "error: expected a declaration, found '1' @1:1")
    assert_eq(parsed("for i in xs do i"), "error: expected a declaration, found 'for' @1:1")

@test("a parameter must say its type, and a field its colon")
missing_type()
    assert_eq(parsed("def g(x) = x"), "error: expected ':', found ')' @1:8")
    assert_eq(parsed("struct P\n  x real\nend P"), "error: expected ':', found 'real' @2:5")

@test("a declaration ends where its expression does")
trailing_tokens()
    assert_eq(parsed("def f(a: real, b: real) -> real = a + b"), "error: expected the end of the declaration, found '->' @1:25")

@test("a match with no arms on the following lines")
match_without_arms()
    assert_eq(parsed("val r = a match"), "error: expected the match's arms on indented lines, found the end of the line @1:16")

@test("a lexical error surfaces through the parser")
lexical_error_through_parse()
    assert_eq(parsed("val x = 1 $ 2"), "error: illegal character @1:11")
    assert_eq(parsed("def f() =\n    a\n  b\n"), "error: this line is indented to column 2, which lines up with no open block — the block it closed starts at column 4 and the one around it at column 0 @3:3")
