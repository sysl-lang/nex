// Emission of structs, tuples and enums, `match`, destructuring and tuple assignment.
//
// **A struct or a tuple is an LLVM struct value** of its fields' stored forms, in declaration order,
// so a field is one `llvm.extractvalue` and a field of a place one `llvm.getelementptr`. Nothing in it
// is boxed: no struct or enum contains itself (DESIGN §11.4), so every one has a size the compiler
// knows.
//
// **An enum is its tag and a payload**: `!llvm.struct<(i64, array<W x i64>)>`, where the payload is
// wide enough for the largest variant's fields. A variant's fields are an LLVM struct written into
// the payload's storage and read back out of it, through an entry-block slot that LLVM's SROA dissolves.
// `match` is an `scf.index_switch` on the tag.

import sysl.buf.{Buf, buf}
import sysl.math.max
import sysl.text.{split, str_builder}
import sh.sysl.parsing.Span

// A `match` case written aside: its head, its operations, the array values as it leaves them and its
// value (`""` for none).
struct Case
    head: string
    text: string
    arr: Buf[string]
    value: string

impl Emitter
    struct_of(*self, name: string) -> Option[TStruct]
        for d in self.prog.decls
            d match
                StructDecl(s) -> if s.name == name then return Some(s)
                _ -> ()

        None

    enum_of(*self, name: string) -> Option[TEnum]
        for d in self.prog.decls
            d match
                EnumDecl(e) -> if e.name == name then return Some(e)
                _ -> ()

        None

    // The enum `t` names, if it names one.
    enum_ty(*self, t: Ty) -> Option[TEnum] = t match
        Nominal(name, _) -> self.enum_of(name)
        _ -> None

    // -- types ------------------------------------------------------------------------------------

    agg_ty(*self, span: Span, t: Ty) -> string
        t match
            Tuple(es) -> return self.fields_ty(span, es)
            Nominal(name, _) ->
                self.struct_of(name) match
                    Some(s) -> return self.payload_ty(span, s.fields)
                    None -> ()

                self.enum_of(name) match
                    Some(e) -> return s"!llvm.struct<(i64, array<${self.words(t) - 1} x i64>)>"
                    None -> ()
            _ -> ()

        self.later(span, s"a value of type ${show_ty(t)}")
        "i64"

    fields_ty(*self, span: Span, ts: Buf[Ty]) -> string
        var out = ""

        for t in ts
            if out != "" then out += ", "
            out += self.mem_ty(span, t)

        s"!llvm.struct<($out)>"

    payload_ty(*self, span: Span, fields: Buf[FieldInfo]) -> string = self.fields_ty(span, field_types(fields))

    // A bound on the size of a stored `t` in 8-byte words. No field is aligned to more than 8 bytes,
    // so the fields' words added up bound a struct; an enum is its tag's word and its largest
    // variant's.
    words(*self, t: Ty) -> usize
        base_of(t) match
            Complex(b) -> return if b == 64 then 2 else 1
            Fn(_) -> return 2
            Tuple(es) -> return self.words_of(es)
            Nominal(name, _) ->
                self.struct_of(name) match
                    Some(s) -> return self.field_words(s.fields)
                    None -> ()

                self.enum_of(name) match
                    Some(e) ->
                        var widest = 0

                        for v in e.variants
                            widest = max(widest, self.field_words(v.fields))

                        return 1 + widest
                    None -> ()
            _ -> ()

        1

    words_of(*self, ts: Buf[Ty]) -> usize
        var n = 0

        for t in ts
            n += self.words(t)

        n

    field_words(*self, fields: Buf[FieldInfo]) -> usize
        var n = 0

        for f in fields
            n += self.words(f.ty)

        n

    // -- values -----------------------------------------------------------------------------------

    // Field `k` of `v`, an aggregate of MLIR type `m`, as a value of `t`.
    field(*self, v: string, m: string, k: usize, t: Ty) -> string = self.from_mem(self.def(s"llvm.extractvalue $v[$k] : $m"), t)

    // An aggregate of MLIR type `m` from its fields' values.
    make(*self, m: string, vals: Buf[string], tys: Buf[Ty]) -> string
        var v = self.def(s"llvm.mlir.undef : $m")

        for k in 0..<vals.len()
            v = self.def(s"llvm.insertvalue ${self.to_mem(vals[k], tys[k])}, $v[$k] : $m")

        v

    // `Point(x, y)` or `(a, b)`: each element in order.
    aggregate(*self, span: Span, t: Ty, elems: Buf[TExpr]) -> string
        var vals: Buf[string] = buf()
        var tys: Buf[Ty] = buf()

        for e in elems
            vals.push(self.ex(e))
            tys.push(e.ty)

        for v in vals
            if v == "" then return ""

        self.make(self.ty(span, t), vals, tys)

    // The tag of enum value `v` as an index.
    tag_index(*self, v: string, m: string) -> string = self.def(s"arith.index_cast ${self.def(s"llvm.extractvalue $v[0] : $m")} : i64 to index")

    // The fields of the variant enum value `v` of type `t` holds, as the struct `payload_ty` names.
    payload(*self, v: string, t: Ty, fields: Buf[FieldInfo]) -> string
        val span = Span(0, 0)
        val m = self.ty(span, t)
        val slot = self.alloca(m)

        self.op(s"llvm.store $v, $slot : $m, !llvm.ptr")

        val p = self.def(s"llvm.getelementptr $slot[0, 1] : (!llvm.ptr) -> !llvm.ptr, $m")

        self.def(s"llvm.load $p : !llvm.ptr -> ${self.payload_ty(span, fields)}")

    // `Converged(x)`: the tag, and the fields written into the payload.
    variant(*self, span: Span, t: Ty, tag: usize, args: Buf[TExpr]) -> string
        val m = self.ty(span, t)
        var vals: Buf[string] = buf()

        for a in args
            vals.push(self.ex(a))

        val slot = self.alloca(m)

        self.op(s"llvm.store ${self.def(s"llvm.mlir.zero : $m")}, $slot : $m, !llvm.ptr")
        self.op(s"llvm.store ${self.def(s"arith.constant $tag : i64")}, $slot : i64, !llvm.ptr")

        if args.len() > 0
            var tys: Buf[Ty] = buf()

            for a in args
                tys.push(a.ty)

            val pt = self.fields_ty(span, tys)
            val p = self.def(s"llvm.getelementptr $slot[0, 1] : (!llvm.ptr) -> !llvm.ptr, $m")

            self.op(s"llvm.store ${self.make(pt, vals, tys)}, $p : $pt, !llvm.ptr")

        self.def(s"llvm.load $slot : !llvm.ptr -> $m")

    // -- match ------------------------------------------------------------------------------------

    match_expr(*self, e: TExpr, scrutinee: TExpr, arms: Buf[TArm]) -> string
        val s = self.ex(scrutinee)
        val st = scrutinee.ty
        val rt = self.ty(e.span, e.ty)
        val entry = self.dirty

        // The elaborator matches nothing but an enum.
        val en = self.enum_ty(st).unwrap()
        val idx = self.tag_index(s, self.ty(e.span, st))
        var fallback: Option[TArm] = None
        // Each case is written aside, since what it yields is known only once every case is: its
        // value, and every array value held as an SSA value that some case changes.
        val outer = self.body
        val before = copy_strings(self.arr)
        var cases: Buf[Case] = buf()

        for arm in arms
            arm.pat match
                PVariant(_, tag, binds) ->
                    val fields = en.variants[tag].fields

                    self.body = str_builder()
                    self.arr = copy_strings(before)
                    self.dirty = entry

                    if fields.len() > 0
                        val p = self.payload(s, st, fields)
                        val pt = self.payload_ty(e.span, fields)
                        // A view a binding takes of a stored array is the case's own.
                        val m = self.mark()

                        for k in 0..<binds.len()
                            binds[k] match
                                Some(id) -> self.bind_value(e.span, id, self.field(p, pt, k, fields[k].ty), fields[k].ty)
                                None -> ()

                        self.release_from(m)

                    val v = if rt == "" then self.region(arm.body) else self.region_value(arm.body, e.ty)

                    cases.push(Case(s"case $tag", self.body.finish(), copy_strings(self.arr), if rt == "" then "" else v))
                PAny(_) -> if fallback.is_none() then fallback = Some(arm)

        self.body = str_builder()
        self.arr = copy_strings(before)
        self.dirty = entry

        // Where every variant has its arm the tag is never another, and the default yields zeros.
        val dv = fallback match
            Some(arm) ->
                self.bind_whole(e.span, arm.pat, s, st)
                if rt == "" then self.region(arm.body) else self.region_value(arm.body, e.ty)
            None -> ""

        cases.push(Case("default", self.body.finish(), copy_strings(self.arr), dv))
        self.body = outer

        var ids: Buf[usize] = buf()

        for k in 0..<before.len()
            if before[k] == "" then continue

            for c in cases
                if c.arr[k] != before[k]
                    ids.push(k)
                    break

        var tys: Buf[string] = buf()

        for id in ids
            tys.push(self.tensor_ty(e.span, self.carried_ty(id)))

        if rt != "" then tys.push(rt)

        val n = tys.len()
        val r = self.fresh()

        self.op(s"${result_def(r, n)}scf.index_switch $idx${if n == 0 then "" else s" -> ${joined(tys)}"}")

        for c in cases
            self.op(s"${c.head} {")
            self.body.push(c.text)

            var vals: Buf[string] = buf()

            for id in ids
                vals.push(c.arr[id])

            if rt != "" then vals.push(if c.value == "" then self.zero_of(e.span, e.ty) else c.value)
            self.op(if n == 0 then "scf.yield" else s"scf.yield ${joined(vals)} : ${joined(tys)}")
            self.op("}")

        self.arr = before

        for k in 0..<ids.len()
            self.arr.set(ids[k], result_name(r, k, n))

        self.dirty = entry
        if rt == "" then "" else self.own(result_name(r, n - 1, n), e.ty)
    end match_expr

    // `name -> ...`: the whole value bound.
    bind_whole(*self, span: Span, pat: TPat, s: string, t: Ty)
        pat match
            PAny(Some(id)) -> self.bind_value(span, id, s, t)
            _ -> ()


    // -- destructuring ----------------------------------------------------------------------------

    // `val a, (b, _) = v`: each name bound to its element of `v`, of type `t`.
    destructure(*self, span: Span, pat: TBind, v: string, t: Ty)
        pat match
            BLocal(id) -> self.bind_value(span, id, v, t)
            BGlobal(name) -> self.keep(span, self.global_storage(span, name, t), v, t)
            BSkip -> ()
            BTuple(elems) ->
                val m = self.ty(span, t)

                t match
                    Tuple(es) ->
                        for k in 0..<elems.len()
                            self.destructure(span, elems[k], self.field(v, m, k, es[k]), es[k])
                    _ -> self.later(span, s"destructuring a ${show_ty(t)}")

    // `a, b = b, a`: the right side whole, then every new value retained before any place lets go of
    // its old one, so a value moving from one target to another survives the move.
    assign_tuple(*self, span: Span, target: TTarget, value: TExpr)
        val v = self.ex(value)
        var ptrs: Buf[string] = buf()
        var vals: Buf[string] = buf()
        var tys: Buf[Ty] = buf()

        self.targets(span, target, v, value.ty, &ptrs, &vals, &tys)

        val guarded = self.dirty

        if guarded
            self.op(s"scf.if ${self.flowing()} {")
            self.dirty = false

        var olds: Buf[string] = buf()

        for k in 0..<ptrs.len()
            self.retain(vals[k], tys[k])

        for k in 0..<ptrs.len()
            olds.push(if self.managed(tys[k]) then self.load(span, ptrs[k], tys[k]) else "")
            self.store(span, ptrs[k], vals[k], tys[k])

        for k in 0..<ptrs.len()
            if olds[k] != "" then self.release(olds[k], tys[k])

        if guarded
            self.dirty = true
            self.op("}")

    // The places a tuple assignment stores into, each with its value and type.
    targets(*self, span: Span, target: TTarget, v: string, t: Ty, ptrs: *Buf[string], vals: *Buf[string], tys: *Buf[Ty])
        target match
            TPlace(place) ->
                // An array local held as a value is rebound at once: the right side is whole already.
                *place.kind match
                    TLocal(id) ->
                        if self.in_ssa(id)
                            self.arr.set(id, self.copied(span, v, t))
                            return
                    _ -> ()

                ptrs.push(self.place_ptr(place))
                vals.push(v)
                tys.push(t)
            TDrop -> ()
            TTargets(elems) ->
                val m = self.ty(span, t)

                t match
                    Tuple(es) ->
                        for k in 0..<elems.len()
                            self.targets(span, elems[k], self.field(v, m, k, es[k]), es[k], ptrs, vals, tys)
                    _ -> self.later(span, s"assigning a ${show_ty(t)} to a list of places")

    // -- equality ---------------------------------------------------------------------------------

    // `a == b` or `a != b` on two structs, tuples or enums of type `t`, field by field.
    aggregate_compare(*self, span: Span, op: string, a: string, b: string, t: Ty) -> string
        val eq = self.aggregate_equal(span, a, b, t)

        if op == "==" then eq else self.not(eq)

    // Whether the aggregates `a` and `b` of type `t` are equal: every field equal, and for an enum
    // the same variant first.
    aggregate_equal(*self, span: Span, a: string, b: string, t: Ty) -> string
        if self.holds_array(t) then return self.unsupported(span, s"`==` on a struct, tuple or enum holding an array (${show_ty(t)})")

        val m = self.ty(span, t)

        t match
            Tuple(es) -> return self.fields_equal(span, a, b, m, es)
            Nominal(name, _) ->
                self.struct_of(name) match
                    Some(s) -> return self.fields_equal(span, a, b, m, field_types(s.fields))
                    None -> ()

                self.enum_of(name) match
                    Some(e) -> return self.variants_equal(span, a, b, t, e)
                    None -> ()
            _ -> ()

        self.unsupported(span, s"`==` on ${show_ty(t)}")

    // Whether an aggregate of type `t` has an array among its parts, at any depth. No struct or enum
    // holds itself (DESIGN §11.4), so the walk ends.
    holds_array(*self, t: Ty) -> bool
        t match
            Array(_, _) -> return true
            Tuple(es) ->
                for e in es
                    if self.holds_array(e) then return true
            Nominal(name, _) ->
                self.struct_of(name) match
                    Some(s) ->
                        for f in s.fields
                            if self.holds_array(f.ty) then return true
                    None -> ()

                self.enum_of(name) match
                    Some(e) ->
                        for v in e.variants
                            for f in v.fields
                                if self.holds_array(f.ty) then return true
                    None -> ()
            _ -> ()

        false

    // Field by field, each compared as `==` compares its type, the results anded.
    fields_equal(*self, span: Span, a: string, b: string, m: string, ts: Buf[Ty]) -> string
        var all = self.def("arith.constant true")

        for k in 0..<ts.len()
            val eq = self.binary(span, "==", self.field(a, m, k, ts[k]), self.field(b, m, k, ts[k]), ts[k])

            all = self.def(s"arith.andi $all, $eq : i1")

        all

    // The same tag, then the payloads of that variant compared field by field.
    variants_equal(*self, span: Span, a: string, b: string, t: Ty, e: TEnum) -> string
        val m = self.ty(span, t)
        val ta = self.def(s"llvm.extractvalue $a[0] : $m")
        val tb = self.def(s"llvm.extractvalue $b[0] : $m")
        val same = self.def(s"arith.cmpi eq, $ta, $tb : i64")
        val r = self.fresh()

        self.op(s"$r = scf.if $same -> (i1) {")

        val s = self.fresh()

        self.op(s"$s = scf.index_switch ${self.tag_index(a, m)} -> i1")

        for tag in 0..<e.variants.len()
            val fields = e.variants[tag].fields

            self.op(s"case $tag {")

            val eq = if fields.len() == 0 then self.def("arith.constant true")
                     else self.fields_equal(span, self.payload(a, t, fields), self.payload(b, t, fields), self.payload_ty(span, fields), field_types(fields))

            self.op(s"scf.yield $eq : i1")
            self.op("}")

        self.op("default {")
        self.op(s"scf.yield ${self.def("arith.constant true")} : i1")
        self.op("}")
        self.op(s"scf.yield $s : i1")
        self.op("} else {")
        self.op(s"scf.yield $same : i1")
        self.op("}")
        r
    end variants_equal

    // -- printing ---------------------------------------------------------------------------------

    put_text(*self, sink: string, text: string)
        self.call("nex_put_str", s"$sink, ${self.string_ref(text)}", "i64, !llvm.ptr", "")

    // A tuple as `(a, b)`, a struct as `Point { x=1.0, y=2.0 }` (a generic one by its own name, without
    // its type arguments), a variant as `Converged(3.14)`.
    put_aggregate(*self, span: Span, sink: string, v: string, t: Ty)
        val m = self.ty(span, t)

        t match
            Tuple(es) ->
                self.put_text(sink, "(")

                for k in 0..<es.len()
                    if k > 0 then self.put_text(sink, ", ")
                    self.put_value(span, sink, self.field(v, m, k, es[k]), es[k])

                self.put_text(sink, ")")
                return
            Nominal(name, _) ->
                self.struct_of(name) match
                    Some(s) ->
                        self.put_text(sink, s"${split(s.name, "[")[0]} { ")

                        for k in 0..<s.fields.len()
                            if k > 0 then self.put_text(sink, ", ")
                            self.put_text(sink, s"${s.fields[k].name}=")
                            self.put_value(span, sink, self.field(v, m, k, s.fields[k].ty), s.fields[k].ty)

                        self.put_text(sink, " }")
                        return
                    None -> ()

                self.enum_of(name) match
                    Some(e) ->
                        self.op(s"scf.index_switch ${self.tag_index(v, m)}")

                        for tag in 0..<e.variants.len()
                            val fields = e.variants[tag].fields

                            self.op(s"case $tag {")
                            self.put_text(sink, e.variants[tag].name)

                            if fields.len() > 0
                                val p = self.payload(v, t, fields)
                                val pt = self.payload_ty(span, fields)

                                self.put_text(sink, "(")

                                for k in 0..<fields.len()
                                    if k > 0 then self.put_text(sink, ", ")
                                    self.put_value(span, sink, self.field(p, pt, k, fields[k].ty), fields[k].ty)

                                self.put_text(sink, ")")

                            self.op("scf.yield")
                            self.op("}")

                        self.op("default {")
                        self.op("scf.yield")
                        self.op("}")
                        return
                    None -> ()
            _ -> ()

        self.later(span, s"printing ${show_ty(t)}")
    end put_aggregate
end Emitter

private field_types(fields: Buf[FieldInfo]) -> Buf[Ty]
    var out: Buf[Ty] = buf()

    for f in fields
        out.push(f.ty)

    out
